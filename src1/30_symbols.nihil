// =============================================================================
// Symbol table — a stack: the most recent wins (inner scopes)
// =============================================================================

// lookup: name in source[start .. start+n) → symbol index, or -1
lookup(start = 0, n = 0) {
    k = n_sym;
    * k > 0 {
        k = k - 1;
        s_len[k] == n {
            o = s_ofs[k];
            i = 0;
            equal = true;
            * equal && i < n {
                source[o + i] != source[start + i] { equal = false; }
                i = i + 1;
            }
            equal { : k; }
        }
    }
    : -1;
}

// the method "MODEL.name": km = the model's symbol, the name at source[start .. start+n)
// → symbol index, or -1
lookup_model_method(km = 0, start = 0, n = 0) {
    mo = s_ofs[km];
    ml = s_len[km];
    k = n_sym;
    * k > 0 {
        k = k - 1;
        s_len[k] == ml + 1 + n && s_flags[k] & FLAG_METHOD != 0 {
            o = s_ofs[k];
            equal = source[o + ml] == '.';
            i = 0;
            * equal && i < ml { source[o + i] != source[mo + i] { equal = false; } i = i + 1; }
            i = 0;
            * equal && i < n { source[o + ml + 1 + i] != source[start + i] { equal = false; } i = i + 1; }
            equal { : k; }
        }
    }
    : -1;
}

// symbol whose name is the STRING s (for the prelude's methods) → index, or -1
lookup_text(s = "") {
    k = n_sym;
    * k > 0 {
        k = k - 1;
        s_len[k] == #s {
            o = s_ofs[k];
            i = 0;
            equal = true;
            * equal && i < #s {
                source[o + i] != s[i] { equal = false; }
                i = i + 1;
            }
            equal { : k; }
        }
    }
    : -1;
}

// a call from the method being compiled (or the top level) to method k: what
// the program reaches, so prelude methods nobody calls can be left out
note_call(k = 0) {
    final_pass && s_skip[k] != 0 { error_general("internal error: a call to a prelude method that was left out"); }
    n_calls < MAX_CALLS {
        call_from[n_calls] = method_current;
        call_to[n_calls] = k;
    }
    n_calls = n_calls + 1;
}

// after a pass: the prelude methods the program reaches (from the top level or
// from its own methods, through any chain of calls) stay; the others are left
// out of the next pass. Changing that set means another pass.
prune_prelude() {
    prelude_end == 0 { :; }
    k = 0;
    n_sym_base { s_reach[k] = 0; k = k + 1; }
    n_calls > MAX_CALLS {
        k = 0;
        n_sym_base { s_reach[k] = 1; k = k + 1; }   // too many calls to follow: keep everything
    }
    changed = true;
    * changed {
        changed = false;
        i = 0;
        * i < n_calls && i < MAX_CALLS {
            f = call_from[i];
            t = call_to[i];
            s_reach[t] == 0 && (f < 0 || s_ofs[f] >= prelude_end || s_reach[f] != 0) {
                s_reach[t] = 1;
                changed = true;
            }
            i = i + 1;
        }
    }
    k = 0;
    * k < n_sym_base {
        s_flags[k] & FLAG_METHOD != 0 && s_ofs[k] < prelude_end {
            s_reach[k] == 0 && s_skip[k] == 0 && s_kept[k] == 0 {
                s_skip[k] = 1;
                discovered = true;
                altered = true;
            }
            s_reach[k] != 0 && s_skip[k] != 0 {
                s_skip[k] = 0;                 // needed after all (a type changed): for good
                s_kept[k] = 1;
                discovered = true;
                altered = true;
            }
        }
        k = k + 1;
    }
}

// calls a prelude method (the arguments are already pushed)
call_prelude(name = "", bytes_args = 0) {
    k = lookup_text(name);
    k < 0 || s_flags[k] & FLAG_METHOD == 0 {
        error_general("internal error: the prelude was not included");
    }
    note_call(k);
    emit(0xE8);
    register_fixup(size_code, k, true);
    emit_d(0);
    bytes_args > 0 {
        eb(0x48, 0x81, 0xC4);               // add rsp, bytes_args
        emit_d(bytes_args);
    }
}

new_symbol(start = 0, n = 0, t = 0) {
    n_sym >= MAX_SYM { error("too many symbols"); }
    n > 0xFFFF { error("name too long"); }
    k = n_sym;
    s_ofs[k] = start;
    s_len[k] = n;
    s_ord[k] = 64;
    s_type[k] = t;
    s_flags[k] = 0;
    s_nparam[k] = 0;
    s_end[k] = 0;
    s_extra[k] = 0;
    n_sym = n_sym + 1;
    : k;
}

create_global(start = 0, n = 0, t = 0) {
    k = new_symbol(start, n, t);
    s_flags[k] = FLAG_GLOBAL;
    s_end[k] = GLOBALS + n_globals * 8;
    n_globals = n_globals + 1;
    : k;
}

// local: takes a new frame slot (rbp - 8 × slot)
// local: in a register (optimized, inside a method) or in a frame slot
create_local(start = 0, n = 0, t = 0) {
    o = 64;
    method_current >= 0 {
        o = n_decl;
        n_decl = n_decl + 1;
        o >= 64 { o = 64; }
    }
    r = -1;
    // the locals most used in loops get the registers (s_pref, from the previous pass)
    p = 0;
    method_current >= 0 { p = s_pref[method_current]; }
    p == 0 || o < 64 && (p >> o) & 1 != 0 { r = take_register(); }
    r >= 0 {
        k = new_symbol(start, n, t);
        s_ord[k] = o;
        s_end[k] = r;
        s_flags[k] = FLAG_REG;
        : k;
    }
    d = new_slot();
    k = new_symbol(start, n, t);
    s_end[k] = d;
    s_ord[k] = o;
    : k;
}

// a use of the variable k: a local's weight grows 8 times with each loop around it
note_use(k = 0) {
    o = s_ord[k];
    o < 64 && method_current >= 0 {
        d = loop_depth;
        d > 6 { d = 6; }
        decl_w[o] = decl_w[o] + (1 << (d * 3));
    }
}

// at the end of a method: the locals with the 5 largest weights (and any as heavy) → their bits
prefer_locals() {
    n = n_decl;
    n > 64 { n = 64; }
    n <= 5 { : 0; }                         // registers enough for all of them
    // the 5th largest weight
    t = 0;
    j = 0;
    * j < 5 {
        best = -1;
        i = 0;
        * i < n {
            w = decl_w[i];
            (j == 0 || w < t) && w > best { best = w; }
            i = i + 1;
        }
        best < 0 { j = 5; } || { t = best; j = j + 1; }
    }
    m = 0;
    i = 0;
    * i < n {
        decl_w[i] >= t && decl_w[i] > 0 { m = m | (1 << i); }
        i = i + 1;
    }
    m == 0 { : 0; }
    : m;
}

// counts a register candidate and returns a free one, or -1
take_register() {
    !optimize || method_current < 0 { : -1; }
    candidates = candidates + 1;
    candidates > demand && demand < 5 { demand = candidates; }
    n_regs >= limit_regs { : -1; }
    r = REGS[n_regs];
    n_regs = n_regs + 1;
    : r;
}

create_param(start = 0, n = 0, t = 0, d = 0) {
    k = new_symbol(start, n, t);
    s_end[k] = d;
    s_flags[k] = FLAG_PARAM;
    : k;
}

// optional local: 2 slots (value at d, presence at d + 8)
create_local_opt(start = 0, n = 0, t = 0) {
    new_slot();
    d = new_slot();
    k = new_symbol(start, n, t);
    s_end[k] = d;
    s_flags[k] = FLAG_OPT;
    : k;
}

new_slot() {
    slots = slots + 1;
    slots > max_slots { max_slots = slots; }
    slots > 0x0FFFFFFF { error("too many local variables"); }
    : -(slots * 8) - base_frame;
}
