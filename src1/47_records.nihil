// =============================================================================
// Data models and records (SPEC §20)
//   NAME = @[field: TYPE(width); …];      a model (top level only)
//   NAME(a, b, …)                          a new record (omitted fields: 0, "", false, 0.0)
//   r.field   r.field = v;                 fields
//   NAME @ path   NAME @? path             reads a table file: ARRAY of NAME
//   $r   $rows   @>> path, r   @+>> …      the fixed-width text of records
// A record is a block of 8-byte slots like an ARRAY ([length][slots]); its value
// points to the first slot. Its type is TYPE_REC | (model << 8). The text
// conversions live in the prelude, which gets the model as constants.
// =============================================================================

model_type(m = 0) {
    : TYPE_REC | (m << 8);
}

is_rec(t = 0) {
    : t & (TYPE_REC | TYPE_ARR | TYPE_OPT) == TYPE_REC;
}

is_rec_array(t = 0) {
    : t & (TYPE_REC | TYPE_ARR | TYPE_OPT) == TYPE_REC | TYPE_ARR;
}

is_model(k = 0) {
    : k >= 0 && s_flags[k] & FLAG_MODEL != 0;
}

// source[start .. start+n) is the text s
name_is(start = 0, n = 0, s = "") {
    n != #s { : false; }
    i = 0;
    * i < n {
        source[start + i] != s[i] { : false; }
        i = i + 1;
    }
    : true;
}

same_source(a = 0, b = 0, n = 0) {
    i = 0;
    * i < n {
        source[a + i] != source[b + i] { : false; }
        i = i + 1;
    }
    : true;
}

const_put_q(v = 0) {
    i = 0;
    8 { const_put_byte((v >> (i * 8)) & 255); i = i + 1; }
}

// ---- prescan: every NAME = @[ … ]; at the top level becomes a model ----------
prescan_models() {
    sc = size_const;                     // the strings this scan decodes do not stay
    init_lexer();
    next_token();
    braces = 0;
    parens = 0;
    * tok_type != T_END {
        t = tok_type;
        t == T_IDENT && parens == 0 && peek_type() == '=' && model_ahead() {
            braces != 0 { error("a data model NAME = @[…]; is declared at the top level, outside any block"); }
            parse_model();
            t = tok_type;
        }
        t == '{' { braces = braces + 1; }
        t == '}' { braces = braces - 1; }
        t == '(' || t == '[' { parens = parens + 1; }
        t == ')' || t == ']' { parens = parens - 1; }
        next_token();
    }
    size_const = sc;
    m = 0;
    n_models {
        m_parent[m] >= 0 { m_tagged[m] = 1; m_tagged[m_parent[m]] = 1; }
        m = m + 1;
    }
    m = 0;
    n_models { model_constants(m); m = m + 1; }
}

// an abstract method a record of model m would lack (SPEC §20.11): for some method name, the nearest
// model, m itself or above it, that declares it, declares it abstract; -1 when m is concrete
missing_method(m = 0) {
    k = 0;
    * k < n_sym {
        s_abstract[k] != 0 {
            d = 0;
            * d < s_len[k] && source[s_ofs[k] + d] != '.' { d = d + 1; }
            ka = lookup(s_ofs[k], d);
            a = -1;
            is_model(ka) { a = s_extra[ka]; }
            a >= 0 && (a == m || descends(m, a)) {
                e = m;
                ke = -1;
                * ke < 0 && e >= 0 { ke = lookup_model_method(m_sym[e], s_ofs[k] + d + 1, s_len[k] - d - 1); e = m_parent[e]; }
                ke >= 0 && s_abstract[ke] != 0 { : ke; }
            }
        }
        k = k + 1;
    }
    : -1;
}

// a record of model m is about to be made (what: how, for the message): an error when m is abstract
refuse_abstract(m = 0, what = "") {
    k = missing_method(m);
    k < 0 { :; }
    d = 0;
    * d < s_len[k] && source[s_ofs[k] + d] != '.' { d = d + 1; }
    error_start();
    put_source(s_ofs[m_sym[m]], s_len[m_sym[m]]);
    put_str(" is abstract (it does not implement ");
    put_source(s_ofs[k] + d + 1, s_len[k] - d - 1);
    put_str(", which ");
    put_source(s_ofs[k], d);
    put_str(" leaves abstract): ");
    put_str(what);
    error_end();
}

// the model's tag: (m + 1) in the top 16 bits of a record's block header, for a model in a
// hierarchy; 0 for the others, whose records carry no model (nothing dispatches on them)
model_tag(m = 0) {
    m_tagged[m] == 0 { : 0; }
    : (m + 1) << 48;
}

// rax = a record just allocated: its model into the header (mov r64, imm64 and or between
// registers: a 64-bit or takes no 64-bit immediate, and the macOS translator takes no or into memory)
emit_model_tag(m = 0) {
    m_tagged[m] == 0 { :; }
    op_ld(R_CX, R_AX, -16, 0);              // mov rcx, [rax - 16]
    op_imm64(R_DX, model_tag(m));           // mov rdx, tag
    op_alu(ALU_OR, R_CX, R_DX);             // or rcx, rdx
    op_st(R_AX, -16, R_CX, 0);              // mov [rax - 16], rcx
}

// tok = name: is it followed by "= @ ["?
model_ahead() {
    save_lexer();
    next_token();
    next_token();
    r = tok_type == '@' && peek_type() == '[';
    back_lexer();
    drop_lexer();
    : r;
}

// tok = name of NAME = @[ … ]; → registers the model; the lexer stops on the ";"
parse_model() {
    n_models >= MAX_MODEL { error("too many data models (limit 1024)"); }
    k = lookup(tok_start, tok_len);
    k >= 0 {
        error_start();
        put_str("'");
        put_source(tok_start, tok_len);
        put_str("' is already a data model");
        error_end();
    }
    m = n_models;
    k = new_symbol(tok_start, tok_len, 0);
    s_flags[k] = FLAG_MODEL;
    s_extra[k] = m;
    m_sym[m] = k;
    m_first[m] = n_fields;
    m_n[m] = 0;
    m_key[m] = -1;
    m_auto[m] = 0;
    n_models = n_models + 1;
    next_token();                        // name → "="
    next_token();                        // → "@"
    next_token();                        // → "["
    next_token();
    // CHILD = @[PARENT; …]: the parent's fields come first, in its order and with its key, so its
    // methods read a child as they read a parent (SPEC §20.8). The parent is declared before.
    m_parent[m] = -1;
    tok_type == T_IDENT && (peek_type() == ';' || peek_type() == ']') {
        kp = lookup(tok_start, tok_len);
        !is_model(kp) || s_extra[kp] == m {
            error_start();
            put_str("'");
            put_source(tok_start, tok_len);
            put_str("' is not a data model declared before this one (a parent comes first: CHILD = @[PARENT; field: TYPE(width)])");
            error_end();
        }
        p = s_extra[kp];
        m_parent[m] = p;
        j = 0;
        * j < m_n[p] {
            e = m_first[p] + j;
            n_fields >= MAX_FIELD { error("too many fields in the data models"); }
            f_start[n_fields] = f_start[e];
            f_len[n_fields] = f_len[e];
            f_type[n_fields] = f_type[e];
            f_width[n_fields] = f_width[e];
            f_owner[n_fields] = f_owner[e];
            n_fields = n_fields + 1;
            j = j + 1;
        }
        m_n[m] = m_n[p];
        m_key[m] = m_key[p];
        m_auto[m] = m_auto[p];
        next_token();
        tok_type == ';' { next_token(); }
    }
    * tok_type != ']' {
        is_key = tok_type == '#';
        is_auto = false;
        is_key {
            m_key[m] >= 0 { error("a data model has only one key field (#)"); }
            next_token();
            tok_type == '+' { is_auto = true; next_token(); }
        }
        tok_type != T_IDENT { error_expected("a field: name: TYPE(width)"); }
        fs = tok_start; fl = tok_len; fn = tok_line; fli = tok_lstart;
        j = m_first[m];
        * j < n_fields {
            f_len[j] == fl && same_source(f_start[j], fs, fl) {
                error_start();
                put_str("the field '");
                put_source(fs, fl);
                put_str("' appears twice in this model");
                error_end();
            }
            j = j + 1;
        }
        next_token();
        expect(':', "':' after the field name (name: TYPE)");
        tok_type != T_IDENT { error_expected("a field type: INT(width), STRING(width), FLOAT(width) or BOOL"); }
        ty = 0;
        name_is(tok_start, tok_len, "INT") { ty = TYPE_INT; }
        || name_is(tok_start, tok_len, "STRING") { ty = TYPE_STR; }
        || name_is(tok_start, tok_len, "FLOAT") { ty = TYPE_FLOAT; }
        || name_is(tok_start, tok_len, "BOOL") { ty = TYPE_BOOL; }
        || { error_expected("a field type: INT(width), STRING(width), FLOAT(width) or BOOL"); }
        next_token();
        w = 1;
        ty != TYPE_BOOL {
            tok_type != '(' {
                error_start();
                put_str("the field '");
                put_source(fs, fl);
                put_str("' needs its width in the file, like ");
                put_type(ty);
                put_str("(10)");
                error_end();
            }
            next_token();
            tok_type != T_INT { error_expected("the width: a whole number"); }
            w = tok_value;
            max = 65535;
            ty == TYPE_INT { max = 20; }
            ty == TYPE_FLOAT { max = 40; }
            w < 1 || w > max {
                error_start();
                put_str("the width of a ");
                put_type(ty);
                put_str(" field goes from 1 to ");
                put_num(max);
                ty == TYPE_INT { put_str(" (a 64-bit INT has up to 20 characters with the sign)"); }
                error_end();
            }
            next_token();
            expect(')', "')' after the width");
        } || tok_type == '(' {
            error("a BOOL field takes no width: it is always one character, T or F");
        }
        is_key && ty != TYPE_INT && ty != TYPE_STR {
            restore_pos(fs, fl, fn, fli);
            error("the key field (#) must be INT or STRING");
        }
        is_auto && ty != TYPE_INT {
            restore_pos(fs, fl, fn, fli);
            error("an automatic key (#+) must be INT: it is numbered 1, 2, 3, …");
        }
        is_key { m_key[m] = m_n[m]; m_auto[m] = 0; is_auto { m_auto[m] = 1; } }
        n_fields >= MAX_FIELD { error("too many fields in the data models"); }
        f_start[n_fields] = fs;
        f_len[n_fields] = fl;
        f_type[n_fields] = ty;
        f_width[n_fields] = w;
        f_owner[n_fields] = m;
        n_fields = n_fields + 1;
        m_n[m] = m_n[m] + 1;
        tok_type == ';' {
            next_token();
        } || tok_type != ']' {
            error_expected("';' between the fields, or ']'");
        }
    }
    m_n[m] == 0 { error("a data model needs at least one field"); }
    next_token();                        // "]" → ";"
    tok_type != ';' { error_expected("';' after the data model"); }
}

// the constants the prelude reads: schema, field names and the model's name
model_constants(m = 0) {
    k = m_sym[m];
    const_init();
    const_put_q(m_n[m]);
    j = 0;
    m_n[m] {
        const_put_q(f_type[m_first[m] + j]);
        const_put_q(f_width[m_first[m] + j]);
        j = j + 1;
    }
    const_put_q(model_tag(m));             // schema[1 + 2n]: what the prelude and rt_rec_parse put in the header
    put_qword_cst(const_head, 2 + 2 * m_n[m]);
    m_schema[m] = const_head + 8;
    const_init();
    j = 0;
    m_n[m] {
        j > 0 { const_put_byte(' '); }
        const_put_source(f_start[m_first[m] + j], f_len[m_first[m] + j]);
        j = j + 1;
    }
    m_names[m] = const_close();
    const_init();
    const_put_source(s_ofs[k], s_len[k]);
    m_title[m] = const_close();
}

// in the code pass: tok = name of the declaration → skips it
skip_model() {
    * tok_type != ']' { next_token(); }
    next_token();
    expect(';', "';'");
}

// ---- fields ------------------------------------------------------------------
find_field(m = 0, start = 0, n = 0) {
    j = 0;
    * j < m_n[m] {
        e = m_first[m] + j;
        f_len[e] == n && same_source(f_start[e], start, n) { : j; }
        j = j + 1;
    }
    : -1;
}

// tok = a field name of a record of type t → index in f_*
field_index(t = 0) {
    m = t >> 8;
    j = find_field(m, tok_start, tok_len);
    j < 0 {
        error_start();
        put_type(t);
        put_str(" has no field '");
        put_source(tok_start, tok_len);
        put_str("' (its fields: ");
        i = 0;
        m_n[m] {
            i > 0 { put_str(", "); }
            put_source(f_start[m_first[m] + i], f_len[m_first[m] + i]);
            i = i + 1;
        }
        put_str(")");
        error_end();
    }
    : m_first[m] + j;
}

// a field whose name starts with _ is private to its model (SPEC §20.7): only the model's own
// methods, MODEL.name(…), read or change it. e = the field (index in f_*), m = its model; the
// token is the field's name, where the error points
check_private(m = 0, e = 0) {
    source[f_start[e]] != '_' { :; }
    km = m_sym[f_owner[e]];                 // private to the model that declared it, not its children
    ml = s_len[km];
    mc = method_current;
    mc >= 0 && s_len[mc] > ml + 1 && source[s_ofs[mc] + ml] == '.' && same_source(s_ofs[mc], s_ofs[km], ml) { :; }
    error_start();
    put_str("the field '");
    put_source(f_start[e], f_len[e]);
    put_str("' is private to ");
    put_source(s_ofs[km], ml);
    put_str(": only its methods (");
    put_source(s_ofs[km], ml);
    put_str(".name(…) { … }) read or change it");
    error_end();
}

not_a_record(t = 0) {
    error_start();
    put_str("only records have fields, but the expression is ");
    put_type(t);
    t & TYPE_ARR != 0 && t & TYPE_REC != 0 { put_str(" (pick one first: rows[i].field)"); }
    error_end();
}

// tok = "." after a value of type t (in rax) → loads the field; returns its type
field_access(t = 0) {
    next_token();
    tok_type != T_IDENT { error_expected("a field name after '.'"); }
    t == TYPE_UNKNOWN {
        next_token();
        op_ld(R_AX, R_AX, 0, 0);               // mov rax, [rax] (the type is not known yet)
        : TYPE_UNKNOWN;
    }
    !is_rec(t) { not_a_record(t); }
    e = field_index(t);
    check_private(t >> 8, e);
    next_token();
    op_ld(R_AX, R_AX, (e - m_first[t >> 8]) * 8, 1);                   // mov rax, [rax + disp32]
    : f_type[e];
}

// tok = "." : is it ". name =" (the field being assigned)?
field_then_equals() {
    save_lexer();
    next_token();
    next_token();
    r = tok_type == '=';
    back_lexer();
    drop_lexer();
    : r;
}

// tok = name: does the command have the form name ( [ … ] | .field )* .field = … ?
field_assign_ahead() {
    save_lexer();
    next_token();
    last = 0;
    going = true;
    * going {
        tok_type == '[' {
            depth = 0;
            searching = true;
            * searching {
                tok_type == T_END {
                    searching = false;
                    going = false;
                } || {
                    tok_type == '[' { depth = depth + 1; }
                    tok_type == ']' {
                        depth = depth - 1;
                        depth == 0 { searching = false; }
                    }
                    next_token();
                }
            }
            last = '[';
        } || tok_type == '.' {
            next_token();
            tok_type == T_IDENT {
                next_token();
                last = '.';
            } || {
                going = false;
                last = 0;
            }
        } || {
            going = false;
        }
    }
    r = last == '.' && tok_type == '=';
    back_lexer();
    drop_lexer();
    : r;
}

// r.field = expr ;   rows[i].field = expr ;
cmd_field_assign() {
    t = postfix_rest(primary(), true);
    next_token();                        // "." → field
    fi = tok_start; fl = tok_len; fn = tok_line; fli = tok_lstart;
    ft = TYPE_UNKNOWN;
    disp = 0;
    t != TYPE_UNKNOWN {
        !is_rec(t) { not_a_record(t); }
        e = field_index(t);
        check_private(t >> 8, e);
        ft = f_type[e];
        disp = (e - m_first[t >> 8]) * 8;
    }
    next_token();                        // field → "="
    next_token();
    op_push(R_AX);                            // push rax (the record)
    pi = tok_start; pl = tok_len; pn = tok_line; pli = tok_lstart;
    v = expression();
    v != TYPE_UNKNOWN && ft != TYPE_UNKNOWN && v != ft {
        restore_pos(pi, pl, pn, pli);
        error_start();
        put_str("the field '");
        put_source(fi, fl);
        put_str("' is ");
        put_type(ft);
        put_str(" and cannot receive ");
        put_type(v);
        ft == TYPE_FLOAT && v == TYPE_INT { put_str(" (write 12.0, or .n to convert)"); }
        error_end();
    }
    op_pop(R_CX); op_st(R_CX, disp, R_AX, 1);             // pop rcx ; mov [rcx + disp32], rax
    expect(';', "';'");
}

// ---- new records ---------------------------------------------------------------
// rax = a new record of model m: zeros, and "" in the STRING fields
emit_alloc_record(m = 0) {
    op_load(OP_IMM, R_CX, m_n[m]);                            // mov ecx, n
    
    emit_call_rt(RT_ALLOC);
    arm_native && rec_flat(m) { op_sti(R_AX, -16, 4, 0); }   // -native: no address in it (the collector skips it)
    emit_model_tag(m);                                        // (ORed in: the 4 stays)
    j = 0;
    m_n[m] {
        f_type[m_first[m] + j] == TYPE_STR {
            op_lea_const(R_CX, const_empty);           // lea rcx, [rip + ""]
            op_st(R_AX, j * 8, R_CX, 1);           // mov [rax + disp32], rcx
        }
        j = j + 1;
    }
}

// every field of model m (its parent's too: they come first in its list) is an INT, a FLOAT or a
// BOOL: its record never holds an address, whatever is assigned to it
rec_flat(m = 0) {
    j = 0;
    * j < m_n[m] {
        t = f_type[m_first[m] + j];
        t != TYPE_INT && t != TYPE_FLOAT && t != TYPE_BOOL { : false; }
        j = j + 1;
    }
    : true;
}

// tok = model name, followed by "(" → NAME(a, b, …)
new_record(k = 0) {
    m = s_extra[k];
    refuse_abstract(m, "no record of it is made; make one of a model below it");
    n = m_n[m];
    next_token();
    next_token();
    i = 0;
    * tok_type != ')' {
        i >= n {
            error_start();
            put_type(model_type(m));
            put_str(" has ");
            put_num(n);
            put_str(" field(s), but the call passes more");
            error_end();
        }
        ai = tok_start; al = tok_len; an = tok_line; ali = tok_lstart;
        u = expression();
        e = m_first[m] + i;
        u != f_type[e] && u != TYPE_UNKNOWN {
            restore_pos(ai, al, an, ali);
            error_start();
            put_str("the field '");
            put_source(f_start[e], f_len[e]);
            put_str("' of ");
            put_type(model_type(m));
            put_str(" is ");
            put_type(f_type[e]);
            put_str(", but argument ");
            put_num(i + 1);
            put_str(" is ");
            put_type(u);
            f_type[e] == TYPE_FLOAT && u == TYPE_INT { put_str(" (write 12.0, or .n to convert)"); }
            error_end();
        }
        op_push(R_AX);                        // push rax
        i = i + 1;
        tok_type == ',' {
            next_token();
            tok_type == ')' { error_expected("an expression"); }
        } || tok_type != ')' {
            error_expected("',' or ')'");
        }
    }
    next_token();                        // ")"
    emit_alloc_record(m);
    r = i;
    * r > 0 {
        r = r - 1;
        op_pop(R_CX); op_st(R_AX, r * 8, R_CX, 1);         // pop rcx ; mov [rax + disp32], rcx
    }
    : model_type(m);
}

// tok = the model's name of MODEL.from_json(text) or MODEL.from_json_items(text) (SPEC §26)
model_from_json(k = 0) {
    m = s_extra[k];
    refuse_abstract(m, "it is not read from JSON; read a model below it");
    next_token();                        // name → "."
    next_token();                        // "." → the method
    ns = tok_start; nl = tok_len;
    items = name_is(ns, nl, "from_json_items");
    !items && !name_is(ns, nl, "from_json") {
        error_start();
        put_str("a data model has from_json(text) and from_json_items(text): '");
        put_source(ns, nl);
        put_str("' is not one of them");
        error_end();
    }
    next_token();
    tok_type != '(' { error_expected("'('"); }
    next_token();
    pi = tok_start; pl = tok_len; pn = tok_line; pli = tok_lstart;
    u = expression();
    u != TYPE_STR && u != TYPE_UNKNOWN { error_op_types(pi, pl, pn, pli, u, 0); }
    expect(')', "')'");
    op_push(R_AX);
    push_model(m);
    items {
        call_prelude("__nihil_r_from_json_items", 32);
        : model_type(m) | TYPE_ARR;
    }
    call_prelude("__nihil_r_from_json", 32);
    : model_type(m);
}

// ---- files and text ----------------------------------------------------------
push_const(c = 0) {
    op_lea_const(R_AX, c);                   // lea rax, [rip + constant] ; push rax
    op_push(R_AX);
}

push_model(m = 0) {
    push_const(m_schema[m]);
    push_const(m_names[m]);
    push_const(m_title[m]);
}

// rax = a record or an ARRAY of records (type t) → rax = its fixed-width text
emit_rec_text(t = 0) {
    m = (t & ~TYPE_ARR) >> 8;
    op_push(R_AX);
    push_model(m);
    is_rec(t) {
        call_prelude("__nihil_rec_text", 32);
    } || {
        call_prelude("__nihil_table_text", 32);
    }
}

// the width of a line of model m in a file (the fields and the "\n")
line_width(m = 0) {
    w = 1;
    j = 0;
    m_n[m] { w = w + f_width[m_first[m] + j]; j = j + 1; }
    : w;
}

// the path after NAME @ … : a STRING expression (unary)
model_path(m = 0, form = "") {
    pi = tok_start; pl = tok_len; pn = tok_line; pli = tok_lstart;
    u = unary();
    u != TYPE_STR && u != TYPE_UNKNOWN {
        restore_pos(pi, pl, pn, pli);
        error_start();
        put_str("'");
        put_type(model_type(m));
        put_str(" ");
        put_str(form);
        put_str("' needs the path of the file as a STRING, but the expression is ");
        put_type(u);
        error_end();
    }
}

// tok = model name, followed by "@" or "@?":
//   NAME @ path      → ARRAY of NAME (the whole table)
//   NAME @[i] path   → NAME (only record i)      NAME @?[i] path → NAME?
//   NAME @# path     → INT (how many records)
table_read(k = 0) {
    m = s_extra[k];
    next_token();                        // name → "@"
    opt = tok_type == T_AT_OPT;
    next_token();
    tok_type == '#' && !opt { : record_count(m); }    // counts lines: makes no record
    refuse_abstract(m, "a table of it is not read; read a table of a model below it");
    tok_type == '[' { : record_at(m, opt); }
    tok_type == '{' { : record_by_key(m, opt); }
    model_path(m, "@");
    op_push(R_AX);                            // push rax (the path)
    opt { op_load(OP_IMM, R_AX, 1);  } || { op_load(OP_IMM, R_AX, 0);  }   // mov eax, @? or @
    op_push(R_AX);
    push_model(m);
    call_prelude("__nihil_table_load", 40);   // read in parts (the file is never whole in memory)
    : model_type(m) | TYPE_ARR;
}

// tok = "[" of NAME @[i] path / NAME @?[i] path: reads only record i (pread)
record_at(m = 0, opt = false) {
    next_token();
    pi = tok_start; pl = tok_len; pn = tok_line; pli = tok_lstart;
    u = expression();
    u != TYPE_INT && u != TYPE_UNKNOWN {
        restore_pos(pi, pl, pn, pli);
        error_start();
        put_str("the record number in '@[i]' must be INT, but it is ");
        put_type(u);
        error_end();
    }
    expect(']', "']'");
    op_push(R_AX);                            // push rax (i)
    model_path(m, "@[i]");
    op_push(R_AX);                            // push rax (path)
    w = line_width(m);
    op_ld(R_CX, R_SP, 8, 0);       // mov rcx, [rsp + 8] (i)
    op_muli(R_CX, R_CX, w);                   // imul rcx, rcx, width
    op_load(OP_IMM, R_DX, w);                            // mov edx, width
    emit_call_rt(RT_READ_AT);             // rax = the line (0: no file), rdx = size
    op_push(R_AX); op_push(R_DX);                         // push rax ; push rdx
    push_model(m);
    opt { op_load(OP_IMM, R_AX, 1); } || { op_zero(R_AX); }
    op_push(R_AX);                            // push the "optional" flag
    call_prelude("__nihil_rec_at", 64);
    opt {
        op_zero(R_DX); op_test(R_AX); op_setcc(CC_NE, R_DX);   // xor edx,edx ; test rax,rax ; setne dl
        : model_type(m) | TYPE_OPT;
    }
    : model_type(m);
}

// tok = "#" of NAME @# path: how many records (from the size; 0 if no file)
record_count(m = 0) {
    next_token();
    model_path(m, "@#");
    op_push(R_AX);                            // push rax (path)
    op_zero(R_CX); op_zero(R_DX);             // xor ecx, ecx ; xor edx, edx (read nothing)
    emit_call_rt(RT_READ_AT);
    op_push(R_DX);                            // push rdx (size)
    push_const(m_schema[m]);
    push_const(m_title[m]);
    call_prelude("__nihil_rec_count", 32);
    : TYPE_INT;
}

// @[i]>> path, r;  writes record r as line i of the file, in place (pwrite):
// the other lines stay as they are. i may be the count (one line more).
cmd_write_record() {
    next_token();                        // "@" → "["
    next_token();
    pi = tok_start; pl = tok_len; pn = tok_line; pli = tok_lstart;
    u = expression();
    u != TYPE_INT && u != TYPE_UNKNOWN {
        restore_pos(pi, pl, pn, pli);
        error_start();
        put_str("the record number in '@[i]>>' must be INT, but it is ");
        put_type(u);
        error_end();
    }
    expect(']', "']'");
    expect(T_SHR, "'>>' after '@[i]'");
    op_push(R_AX);                            // push rax (i)
    pi = tok_start; pl = tok_len; pn = tok_line; pli = tok_lstart;
    u = expression();
    write_file_arg(u, "@[i]>>", "the path", pi, pl, pn, pli);
    expect(',', "',' between the path and the record");
    op_push(R_AX);                            // push rax (path)
    op_pushm(R_SP, 8, 0);             // push [rsp + 8] (i, for the prelude)
    op_pushm(R_SP, 8, 0);             // push [rsp + 8] (path)
    pi = tok_start; pl = tok_len; pn = tok_line; pli = tok_lstart;
    t = expression();
    is_rec(t) {
        m = t >> 8;
        w = line_width(m);
        m_key[m] >= 0 {
            op_push(R_AX);                    // push rax (the record)
            push_model(m);
            op_load(OP_IMM, R_AX, m_key[m]);                    // mov eax, key field ; push rax
            
            op_push(R_AX);
            call_prelude("__nihil_key_write_at", 56);   // writes it and keeps the index right
            op_stack(0x10);     // add rsp, 16 (i, path)
            expect(';', "';'");
            :;
        }
        op_push(R_AX);                        // push rax (the record)
        op_ld(R_AX, R_SP, 8, 0);   // mov rax, [rsp + 8] (path)
        op_zero(R_CX); op_zero(R_DX);         // xor ecx, ecx ; xor edx, edx (only the size)
        emit_call_rt(RT_READ_AT);
        op_push(R_DX);                        // push rdx (size)
        push_model(m);
        call_prelude("__nihil_rec_place", 56);   // rax = the line (with a "\n" before it, if the last line lacks one)
        op_mov(R_CX, R_AX);               // mov rcx, rax (the text)
        op_ld(R_DX, R_SP, 8, 0);   // mov rdx, [rsp + 8] (i)
        op_addi(R_DX, 1);               // inc rdx
        op_muli(R_DX, R_DX, w);               // imul rdx, rdx, width
        op_subm(R_DX, R_CX, -8, 0);         // sub rdx, [rcx - 8]: the line ends where line i ends
        op_pop(R_AX);                        // pop rax (path)
        op_stack(0x08);         // add rsp, 8 (i)
        emit_call_rt(RT_WRITE_AT);
    } || {
        t != TYPE_UNKNOWN {
            restore_pos(pi, pl, pn, pli);
            error_start();
            put_str("'@[i]>>' writes a record, but the expression is ");
            put_type(t);
            is_rec_array(t) { put_str(" (write one record: rows[j], or the whole table with @>>)"); }
            error_end();
        }
        op_stack(0x20);         // add rsp, 32
    }
    expect(';', "';'");
}

// the key field of model m; an error if it has none
model_key(m = 0) {
    m_key[m] < 0 {
        error_start();
        put_str("'");
        put_type(model_type(m));
        put_str("' has no key field: mark one with #, like @[#code: INT(6); …]");
        error_end();
    }
    : m_key[m];
}

// tok = "{" of NAME @{key} path / NAME @?{key} path: the record with that key,
// found through the index "<path>.nihil-idx" (built when missing or old)
record_by_key(m = 0, opt = false) {
    kf = key_expression(m);
    model_path(m, "@{key}");
    op_push(R_AX);                            // push rax (path)
    push_model(m);
    op_load(OP_IMM, R_AX, kf);                            // mov eax, key field ; push rax
    
    op_push(R_AX);
    opt { op_load(OP_IMM, R_AX, 1); } || { op_zero(R_AX); }
    op_push(R_AX);                            // push the "optional" flag
    call_prelude("__nihil_key_get", 56);
    opt {
        op_zero(R_DX); op_test(R_AX); op_setcc(CC_NE, R_DX);   // xor edx,edx ; test rax,rax ; setne dl
        : model_type(m) | TYPE_OPT;
    }
    : model_type(m);
}

// tok = "{" of @{key}: the key expression, checked against the key field of
// model m and pushed; → the key field
key_expression(m = 0) {
    kf = model_key(m);
    next_token();
    pi = tok_start; pl = tok_len; pn = tok_line; pli = tok_lstart;
    u = expression();
    kt = f_type[m_first[m] + kf];
    u != kt && u != TYPE_UNKNOWN {
        restore_pos(pi, pl, pn, pli);
        error_start();
        put_str("the key of ");
        put_type(model_type(m));
        put_str(" is '");
        put_source(f_start[m_first[m] + kf], f_len[m_first[m] + kf]);
        put_str("' (");
        put_type(kt);
        put_str("), but the expression is ");
        put_type(u);
        error_end();
    }
    expect('}', "'}'");
    op_push(R_AX);                            // push rax (the key)
    : kf;
}

// tok = model name, followed by "@{" or "@?{": is it NAME @{k} path = _; ?
key_delete_ahead() {
    save_lexer();
    next_token();
    next_token();
    r = tok_type == '{';
    back_lexer();
    drop_lexer();
    : r;
}

// NAME @{k} path = _;  deletes the record with key k (an error if there is
// none; NAME @?{k} path = _; does nothing then). The last record takes its
// place, and the file gets one line shorter.
cmd_key_delete(k = 0) {
    m = s_extra[k];
    next_token();                        // name → "@"
    opt = tok_type == T_AT_OPT;
    next_token();                        // → "{"
    kf = key_expression(m);
    model_path(m, "@{key}");
    op_push(R_AX);                            // push rax (path)
    push_model(m);
    op_load(OP_IMM, R_AX, kf);                            // mov eax, key field ; push rax
    
    op_push(R_AX);
    opt { op_load(OP_IMM, R_AX, 1); } || { op_zero(R_AX); }
    op_push(R_AX);
    expect('=', "'= _;' (NAME @{key} path = _; deletes that record)");
    tok_type != T_UNDERSCORE { error_expected("'_': a record is deleted with NAME @{key} path = _; and written with @{}>> path, r;"); }
    next_token();
    call_prelude("__nihil_key_delete", 56);
    expect(';', "';'");
}

// @{}>> path, r;  writes r under its key: replaces the record with the same
// key in place, or adds r at the end of the table
cmd_put_key() {
    next_token();                        // "@" → "{"
    next_token();
    expect('}', "'}' (the key comes from the record: @{}>> path, r;)");
    expect(T_SHR, "'>>' after '@{}'");
    pi = tok_start; pl = tok_len; pn = tok_line; pli = tok_lstart;
    u = expression();
    write_file_arg(u, "@{}>>", "the path", pi, pl, pn, pli);
    expect(',', "',' between the path and the record");
    op_push(R_AX);                            // push rax (path)
    pi = tok_start; pl = tok_len; pn = tok_line; pli = tok_lstart;
    t = expression();
    is_rec(t) {
        m = t >> 8;
        m_key[m] < 0 { restore_pos(pi, pl, pn, pli); }
        kf = model_key(m);
        op_push(R_AX);                        // push rax (the record)
        push_model(m);
        op_load(OP_IMM, R_AX, kf);                        // mov eax, key field ; push rax
        
        op_push(R_AX);
        m_auto[m] != 0 { call_prelude("__nihil_key_put_auto", 48); } || { call_prelude("__nihil_key_put", 48); }
    } || {
        t != TYPE_UNKNOWN {
            restore_pos(pi, pl, pn, pli);
            error_start();
            put_str("'@{}>>' writes a record, but the expression is ");
            put_type(t);
            error_end();
        }
        op_stack(0x08);         // add rsp, 8
    }
    expect(';', "';'");
}

// file access for the prelude: __nihil_fsize(path) → INT (-1: no file),
// __nihil_fstamp(path) → INT, __nihil_pread(path, offset, n) → INT (STRING
// address, 0: no file), __nihil_pwrite(path, offset, text) (pwrite + fsync),
// __nihil_pwrite_ns(path, offset, text) (no fsync), __nihil_truncate(path, size)
// (ftruncate + fsync), __nihil_truncate_ns(path, size) (no fsync)
file_intrinsic(kind = 0) {
    next_token();                        // name → "("
    next_token();
    expression();
    kind <= 2 {
        op_zero(R_CX); op_zero(R_DX);         // xor ecx, ecx ; xor edx, edx
        emit_call_rt(RT_READ_AT);
        kind == 1 { op_mov(R_AX, R_DX); } || { op_mov(R_AX, R_CX); }   // mov rax, rdx | rcx
        expect(')', "')'");
        : TYPE_INT;
    }
    op_push(R_AX);
    expect(',', "','");
    expression();
    kind >= 6 {                            // __nihil_truncate(path, size), _ns
        op_mov(R_DX, R_AX); op_pop(R_AX);         // mov rdx, rax ; pop rax
        kind == 7 { emit_call_rt(RT_TRUNCATE_NS); } || { emit_call_rt(RT_TRUNCATE); }
        call_end = size_code;
        expect(')', "')'");
        : TYPE_NONE;
    }
    op_push(R_AX);
    expect(',', "','");
    expression();
    kind == 3 {
        op_mov(R_DX, R_AX); op_pop(R_CX); op_pop(R_AX);   // mov rdx, rax ; pop rcx ; pop rax
        emit_call_rt(RT_READ_AT);
        expect(')', "')'");
        : TYPE_INT;
    }
    op_mov(R_CX, R_AX); op_pop(R_DX); op_pop(R_AX);       // mov rcx, rax ; pop rdx ; pop rax
    kind == 5 { emit_call_rt(RT_WRITE_AT_NS); } || { emit_call_rt(RT_WRITE_AT); }
    call_end = size_code;                // a command by itself, like a call
    expect(')', "')'");
    : TYPE_NONE;
}

// network for the prelude (SPEC §23): __nihil_listen(port, every) → INT, __nihil_accept(fd) →
// INT, __nihil_fd_read(fd, most) → INT (STRING address), __nihil_fd_send(fd, text) → INT,
// __nihil_fd_close(fd), __nihil_connect(address, port) → INT
net_intrinsic(kind = 0) {
    next_token();                        // name → "("
    next_token();
    expression();
    kind == 2 || kind == 5 {
        kind == 2 { emit_call_rt(RT_NET_ACCEPT); } || { emit_call_rt(RT_FD_CLOSE); }
        call_end = size_code;
        expect(')', "')'");
        kind == 5 { : TYPE_NONE; }
        : TYPE_INT;
    }
    op_push(R_AX);
    expect(',', "','");
    expression();
    op_mov(R_CX, R_AX); op_pop(R_AX);             // mov rcx, rax ; pop rax
    kind == 1 { emit_call_rt(RT_NET_LISTEN); }
    kind == 3 { emit_call_rt(RT_FD_READ); }
    kind == 4 { emit_call_rt(RT_FD_SEND); }
    kind == 6 { emit_call_rt(RT_NET_CONNECT); }
    call_end = size_code;                // may stand alone as a command, like a call
    expect(')', "')'");
    : TYPE_INT;
}

// native copies for the prelude: __nihil_sub_rt(s, a, b) → STRING (kind 1),
// __nihil_put_rt(r, at, t) → INT (kind 2)
copy_intrinsic(kind = 0) {
    next_token();                        // name → "("
    next_token();
    expression();
    op_push(R_AX);
    expect(',', "','");
    expression();
    op_push(R_AX);
    expect(',', "','");
    expression();
    op_mov(R_DX, R_AX); op_pop(R_CX); op_pop(R_AX);       // mov rdx, rax ; pop rcx ; pop rax
    kind == 1 { emit_call_rt(RT_SUB); }
    kind == 2 { emit_call_rt(RT_PUT); }
    kind == 3 { emit_call_rt(RT_REC_PARSE); }
    call_end = size_code;
    expect(')', "')'");
    kind == 1 { : TYPE_STR; }
    : TYPE_INT;
}

// JSON and tables for the prelude: __nihil_json_end_rt(s, i) → INT (kind 1, the native
// inner loop, §21.2); __nihil_lines_rt(text, width) → INT (kind 2, §20)
json_intrinsic(kind = 0) {
    next_token();                        // name → "("
    next_token();
    expression();
    op_push(R_AX);
    expect(',', "','");
    expression();
    op_mov(R_CX, R_AX); op_pop(R_AX);             // mov rcx, rax ; pop rax
    kind == 1 { emit_call_rt(RT_JSON_END); } || { emit_call_rt(RT_LINES); }
    expect(')', "')'");
    : TYPE_INT;
}

// the kernel, for the prelude only (directories and processes are coming): __nihil_syscall([n, a1 … a6]) → INT
// A list written there, [n, a1 … a6], is built on the stack instead of as a new ARRAY: the same
// words rt_syscall reads (the count at -8, then the values), with nothing to allocate.
//   sub rsp, 64 ; each value: … ; mov [rsp + 8 + 8i], rax ; mov qword [rsp], count ;
//   lea rax, [rsp + 8] ; call rt_syscall ; add rsp, 64
syscall_intrinsic() {
    next_token();                        // name → "("
    next_token();
    tok_type == '[' && optimize {
        next_token();
        op_stack(-0x40);         // sub rsp, 64
        n = 0;
        * tok_type != ']' {
            n == 7 { error("__nihil_syscall takes [n, a1 … a6]"); }
            pi = tok_start; pl = tok_len; pn = tok_line; pli = tok_lstart;
            u = expression();
            u != TYPE_INT && u != TYPE_UNKNOWN { type_wrong(pi, pl, pn, pli, TYPE_INT, u); }
            op_st(R_SP, 8 + 8 * n, R_AX, 0);   // mov [rsp + 8 + 8n], rax
            n = n + 1;
            tok_type == ',' { next_token(); } || tok_type != ']' { error_expected("',' or ']'"); }
        }
        next_token();                    // "]"
        op_sti(R_SP, 0, n, 0);         // mov qword [rsp], n
        op_lea(R_AX, R_SP, 8, 0);   // lea rax, [rsp + 8]
        emit_call_rt(RT_SYSCALL);
        op_stack(0x40);         // add rsp, 64
        call_end = size_code;
        expect(')', "')'");
        : TYPE_INT;
    }
    expression();
    emit_call_rt(RT_SYSCALL);
    call_end = size_code;                // may stand alone as a command, like a call
    expect(')', "')'");
    : TYPE_INT;
}

// text for the prelude, one byte per character: __nihil_bytes(n) → a new
// STRING of n zero bytes; __nihil_poke(s, i, b) puts byte b at s[i] (only in a
// STRING the prelude has just made: STRING values do not change)
bytes_intrinsic(kind = 0) {
    next_token();                        // name → "("
    next_token();
    expression();
    kind == 1 {
        op_push(R_AX);                        // push rax (n)
        op_lea(R_CX, R_AX, 8, 0);         // lea rcx, [rax + 8]
        op_shri(R_CX, 3);         // shr rcx, 3: n + 1 bytes, in qwords
        emit_call_rt(RT_ALLOC);            // zeroed memory
        op_pop(R_CX); op_st(R_AX, -8, R_CX, 0);   // pop rcx ; mov [rax - 8], rcx
        expect(')', "')'");
        : TYPE_STR;
    }
    op_push(R_AX);
    expect(',', "','");
    expression();
    op_push(R_AX);
    expect(',', "','");
    expression();
    op_pop(R_CX); op_pop(R_DX); op_stbx(R_DX, R_CX, R_AX);       // pop rcx ; pop rdx ; mov [rdx + rcx], al
    call_end = size_code;
    expect(')', "')'");
    : TYPE_NONE;
}

// memory at an address, for the runtime written in Nihil: __nihil_peek(a) → the 8 bytes at a (an
// INT); __nihil_poke8(a, v) puts v's 8 bytes there
peek_intrinsic() {
    next_token();                        // name → "("
    next_token();
    expression();
    op_ld(R_AX, R_AX, 0, 0);             // mov rax, [rax]
    call_end = size_code;
    expect(')', "')'");
    : TYPE_INT;
}

// __nihil_prefetch(a): the memory at a asked for ahead of its use (the collector's mark)
prefetch_intrinsic() {
    next_token();
    next_token();
    expression();
    at = size_code;
    eb(0x0F, 0x18, 0x08);                 // prefetcht0 [rax]
    op_note(OP_PREFETCH, R_AX, 0, at);
    call_end = size_code;
    expect(')', "')'");
    : TYPE_NONE;
}

// __nihil_peekb(a) → the byte at a
peekb_intrinsic() {
    next_token();
    next_token();
    expression();
    op_load(OP_IMM, R_CX, 0);            // mov ecx, 0
    op_ldbx(R_AX, R_AX, R_CX);           // movzx eax, byte [rax + rcx]
    call_end = size_code;
    expect(')', "')'");
    : TYPE_INT;
}

poke8_intrinsic() {
    next_token();
    next_token();
    expression();
    op_push(R_AX);
    expect(',', "','");
    expression();
    op_pop(R_CX); op_st(R_CX, 0, R_AX, 0);   // pop rcx ; mov [rcx], rax
    call_end = size_code;
    expect(')', "')'");
    : TYPE_NONE;
}

// -native only: a function of the system's C library (libSystem) — __nihil_c("name", a1 … a8) →
// its result (x0), __nihil_c32 → its int result (32 bits, sign-extended). Each argument an INT
// (an address: __nihil_addr), pushed; the operation (OP_CCALL: r arguments, the name at source[v …
// v + o)) takes them into x0 … x7. A function with variable arguments (openat's mode, fcntl's
// argument): __nihil_cvar("name", F, …), F the fixed ones, a number; the others go on C's stack.
ccall_intrinsic(int32 = false) {
    !arm_native { error("__nihil_c is only for -native (macOS: the system's C library)"); }
    var = name_is(tok_start, tok_len, "__nihil_cvar");
    next_token();                        // name → "("
    next_token();
    tok_type != T_STR { error_expected("the function's name, a STRING"); }
    name_at = tok_start + 1;
    name_n = tok_len - 2;
    next_token();
    fixed = -1;
    var {
        expect(',', "','");
        tok_type != T_INT { error_expected("how many fixed arguments, a number"); }
        fixed = tok_value;
        next_token();
    }
    n = 0;
    * tok_type == ',' {
        next_token();
        n == 8 { error("__nihil_c takes at most 8 arguments"); }
        pi = tok_start; pl = tok_len; pn = tok_line; pli = tok_lstart;
        u = expression();
        u != TYPE_INT && u != TYPE_BOOL && u != TYPE_UNKNOWN { type_wrong(pi, pl, pn, pli, TYPE_INT, u); }
        op_push(R_AX);
        n = n + 1;
    }
    at = size_code;
    eb(0x0F, 0x0B);                      // (ud2: no x86 for it)
    k = OP_CCALL;
    int32 { k = OP_CCALL32; }
    op_note(k, n + 256 * (fixed + 1), name_at, at, name_n);   // r: the arguments (+ 256 · (fixed + 1))
    call_end = size_code;
    expect(')', "')'");
    : TYPE_INT;
}

// a record's model (SPEC §20.12): __nihil_set_model(r, tag) ORs tag (a schema's last word) into the
// header of r, a block just made; __nihil_model_of(r) → the model + 1 its header holds, 0 for none
model_intrinsic(kind = 0) {
    next_token();                        // name → "("
    next_token();
    expression();
    kind == 1 {
        op_push(R_AX);                     // push rax (the record)
        expect(',', "','");
        expression();
        op_mov(R_DX, R_AX); op_pop(R_AX);   // mov rdx, rax ; pop rax
        op_ld(R_CX, R_AX, -16, 0);          // mov rcx, [rax - 16]
        op_alu(ALU_OR, R_CX, R_DX);         // or rcx, rdx
        op_st(R_AX, -16, R_CX, 0);          // mov [rax - 16], rcx
        call_end = size_code;
        expect(')', "')'");
        : TYPE_NONE;
    }
    op_ld(R_AX, R_AX, -16, 0);              // mov rax, [rax - 16]
    op_shri(R_AX, 48);                      // shr rax, 48
    expect(')', "')'");
    : TYPE_INT;
}

// ---- casts for the prelude (no code): __nihil_addr(x) → INT,
// __nihil_str_at(INT) → STRING, __nihil_arr_at(INT) → ARRAY of INT
intrinsic(r = 0) {
    next_token();                        // name → "("
    next_token();
    expression();
    expect(')', "')'");
    : r;
}
