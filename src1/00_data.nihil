// =============================================================================
// nihilc1 — compiler for the Nihil language written in Nihil (stage 1)
//
// Mirrors the stage 0 compiler (src/nihilc.asm) and produces exactly the
// same bytes. Input (stdin): the path of the source file, on one line.
// Output (stdout): the ELF64 executable. Errors go to stderr, with exit code 1.
// The nihilc1.sh wrapper gives it the same command line as nihilc.
//
// src1/nihilc1.nihil includes the other files in order; this one creates the globals.
//
// Careful when writing methods: a name assigned at the top level is global, and
// inside a method an assignment to that name changes the global. That is why
// globals have long names and locals short ones.
// =============================================================================

// ---- tokens (a one-character token uses its own ASCII code) ----
T_END = 0;
T_IDENT = 256;
T_INT = 257;
T_STR = 258;
T_TRUE = 259;
T_FALSE = 260;
T_UNDERSCORE = 261;
T_EQ = 262;
T_NE = 263;
T_LE = 264;
T_GE = 265;
T_SHL = 266;
T_SHR = 267;
T_BYTE_IN = 268;
T_BYTE_OUT = 269;
T_AND = 270;
T_OR = 271;
T_EXIT = 272;
T_ERROR_OUT = 273;
T_AT_OPT = 274;
T_FLOAT = 275;
T_PAUSE = 276;     // ...
T_WRITE_FILE = 277;    // @>>
T_APPEND_FILE = 278;   // @+>>

// ---- tipos ----
TYPE_INT = 1;
TYPE_BOOL = 2;
TYPE_STR = 3;
TYPE_NONE = 4;
TYPE_UNKNOWN = 5;
TYPE_ARR = 16;
TYPE_ABSENT = 6;   // type of the literal _
TYPE_FLOAT = 7;     // double, kept as 64 bits in rax
TYPE_OPT = 32;      // T? = TYPE_OPT | T
TYPE_REC = 64;      // a record of model m: TYPE_REC | (m << 8)
TYPE_MAP = 128;     // a MAP of map type n: TYPE_MAP | (n << 8) (§22)
MAX_MAPT = 4096;
mt_key = [0 ; MAX_MAPT];       // key type of each map type
mt_val = [0 ; MAX_MAPT];       // value type
n_mapt = 0;

// ---- symbol flags ----
FLAG_GLOBAL = 1;
FLAG_METHOD = 2;
FLAG_CREATED = 4;
FLAG_PARAM = 8;
FLAG_OPT = 16;      // optional: 2 words (value, presence)
FLAG_REG = 32;      // local kept in a register (s_end = register number)
FLAG_MODEL = 64;    // a data model NAME = @[…]; (s_extra = model number)
FLAG_TOP = 128;     // a global no method uses: kept in the top level's frame or in a register

// ---- binary operator modes ----
MODE_INT = 1;
MODE_EQUAL = 2;
MODE_ORDER = 3;

// ---- generated executable (src/layout.inc) ----
BASE_CODE = 0x400000;
SIZE_HEADER = 0xB0;
BASE_DATA = 0x40000000;
OFS_GLOBALS = 0x21000;
GLOBALS = BASE_DATA + OFS_GLOBALS;
RT_DIV = 5;
RT_MOD = 10;
RT_PRINT_INT = 15;
RT_PRINT_BOOL = 20;
RT_PRINT_STR = 25;
RT_EXIT = 30;
RT_ERROR = 35;
RT_ALLOC = 40;
RT_ARRAY_REP = 45;
RT_ERROR_INDEX = 50;
RT_WRITE_BYTE = 55;
RT_READ_BYTE = 60;
RT_STR_EQUAL = 65;
RT_ERROR_INT = 70;
RT_ERROR_BOOL = 75;
RT_ERROR_STR = 80;
RT_READ_FILE = 85;
RT_TEXT = 90;
RT_PRINT_INT_OPT = 95;
RT_PRINT_BOOL_OPT = 100;
RT_PRINT_STR_OPT = 105;
RT_ERROR_INT_OPT = 110;
RT_ERROR_BOOL_OPT = 115;
RT_ERROR_STR_OPT = 120;
RT_READ_FILE_OPT = 125;
RT_CONCAT = 130;
RT_SLEEP = 135;
RT_WRITE_FILE = 140;
RT_APPEND_FILE = 145;
RT_READ_AT = 150;
RT_WRITE_AT = 155;
RT_WRITE_AT_NS = 160;
RT_TRUNCATE = 165;
RT_TRUNCATE_NS = 170;
RT_INT_TEXT = 175;
RT_ARRAY_CONCAT = 180;
RT_NET_LISTEN = 185;
RT_NET_ACCEPT = 190;
RT_FD_READ = 195;
RT_FD_SEND = 200;
RT_FD_CLOSE = 205;
RT_SYSCALL = 210;
RT_JSON_END = 215;
RT_SUB = 220;
RT_PUT = 225;
RT_REC_PARSE = 230;
RT_LINES = 235;
RT_NET_CONNECT = 240;
RT_PROTECT = 245;       // protected calls (SPEC §25): rax = where to resume after a runtime error
RT_UNPROTECT = 250;
RT_ERR_TEXT = 255;      // ?! → rax = a new STRING
RT_FAIL = 260;          // rax = STRING: a runtime error with that message
RT_CONCAT_INT = 265;    // rax = STRING, rcx = INT → "…" + $n in one block
last_int_text = -1;     // where the code of the last $ of an INT ends (binary fuses it with a "…" +)

// ---- limits (the same as the stage 0 arenas) ----
SIZE_SOURCE = 16 << 20;
SIZE_CODE = 16 << 20;
SIZE_CONST = 16 << 20;
SIZE_FIX = 4 << 20;
MAX_SYM = 131072;
MAX_FIX = 262144;
MAX_PARAM = 65536;
SIZE_RAW = 16 << 20;
SIZE_NAMES = 1 << 20;
MAX_NAMES = 4096;
MAX_SEG = 4096;

// ---- arenas (bytes kept in INTs; [0 ; n] does not touch the memory) ----
source = [0 ; SIZE_SOURCE + 16];
n_source = 0;

// ---- inclusions: raw files, paths and segments of the expanded source ----
raw = [0 ; SIZE_RAW + 16];
size_raw = 0;
raw_got = 0;
names = [0 ; SIZE_NAMES + 4096];
size_names = 0;
name_start = [0 ; MAX_NAMES];
name_len = [0 ; MAX_NAMES];
n_names = 0;
resolve_new = false;
path_seg_at = [0 ; MAX_NAMES];          // normalize_path: where each segment written starts
path_seg_up = [0 ; MAX_NAMES];          // … and 1 if it is a ".." that could not go up
seg_start = [0 ; MAX_SEG];
seg_name = [0 ; MAX_SEG];
seg_bline = [0 ; MAX_SEG];
seg_fline = [0 ; MAX_SEG];
n_seg = 0;
lines_buf = 0;
expanding = false;
uses_prelude = false;   // the program uses FLOAT or <<: it gets the prelude
index_prelude = -1;
name_current = 0;
error_name = 0;
code = [0 ; SIZE_CODE + 16];
size_code = 0;
cst = [0 ; SIZE_CONST + 16];
size_const = 0;
const_head = 0;
fix_pos = [0 ; MAX_FIX];
fix_val = [0 ; MAX_FIX];
fix_method = [false ; MAX_FIX];
n_fix = 0;

// ---- the operations last emitted (40_emit.nihil): what the optimizations read, instead of the x86
// bytes, so that another backend can emit the same operations. A ring of the last OPS_RING.
OP_IMM = 1;             // r ← v, a constant
OP_LOCAL = 2;           // r ← the local at frame offset v
OP_GLOBAL = 3;          // r ← the global at address v
OP_REG = 4;             // r ← the register v (rbx, r12 … r15: a local kept in a register)
                        // (OP_LOCAL, OP_GLOBAL with o = 1: an optional, its presence into rdx too)
OP_CMP_SET = 5;         // rax ← rax ?v rcx (INT comparison, v a condition), 0 or 1
OP_CMP = 6;             // the flags ← rax - rcx
OP_CALL_RT = 7;         // a call of the runtime's routine v
OP_ALU = 8;             // r ← r op o (v: ALU_*), registers
ALU_ADD = 0x01;         // (the values are x86's opcodes, for its encoder)
ALU_SUB = 0x29;
ALU_AND = 0x21;
ALU_OR = 0x09;
ALU_XOR = 0x31;
CC_E = 4;               // conditions, in x86's numbering (a condition ^ 1 is its opposite)
CC_NE = 5;
CC_L = 12;
CC_GE = 13;
CC_LE = 14;
CC_G = 15;
R_AX = 0;               // the registers, in x86's numbering: rax, the value
R_CX = 1;               // rcx, the second operand
OPS_RING = 256;
op_at = [0 ; OPS_RING];     // where its code starts
op_end = [0 ; OPS_RING];    // where its code ends
op_k = [0 ; OPS_RING];
op_r = [0 ; OPS_RING];
op_v = [0 ; OPS_RING];
op_o = [0 ; OPS_RING];
n_ops = 0;              // operations noted so far; the ring holds those from ops_low on
ops_low = 0;

// ---- symbol table (one column per field) ----
s_ofs = [0 ; MAX_SYM];
s_len = [0 ; MAX_SYM];
s_type = [0 ; MAX_SYM];
s_flags = [0 ; MAX_SYM];
s_nparam = [0 ; MAX_SYM];
s_end = [0 ; MAX_SYM];
s_extra = [0 ; MAX_SYM];
s_regs = [0 ; MAX_SYM];   // methods: saved registers (learned in the previous pass)
s_ord = [0 ; MAX_SYM];    // locals: their place among the method's locals (64: none)
s_pref = [0 ; MAX_SYM];   // methods: which locals (bits by s_ord) get registers, learned in the
                          // previous pass from their uses; 0: not known yet, every local may
decl_w = [0 ; 64];        // the current method's locals: their uses, weighted by loop depth
n_decl = 0;               // locals created so far in the current method
loop_depth = 0;           // loops around the code being compiled
// globals of the top level that no method uses become the top level's own (a frame slot, or one of
// the registers for the 5 most used in loops), learned from the previous pass
g_addr = [0 ; MAX_SYM];   // a global's address in the data segment
g_meth = [false ; MAX_SYM];      // a method used it in the previous pass
g_meth_cur = [false ; MAX_SYM];  // … in this pass
g_w = [0 ; MAX_SYM];      // its uses at the top level, weighted by loop depth
g_reg = [0 ; MAX_SYM];    // the register it gets (0: none)
g_redo = false;           // a method met a global kept at the top level: another pass
n_sym = 0;
n_globals = 0;

// ---- data models (records): NAME = @[field: TYPE(width); …]; ----
MAX_MODEL = 1024;
MAX_FIELD = 16384;
m_sym = [0 ; MAX_MODEL];      // symbol of the model's name
m_first = [0 ; MAX_MODEL];    // first field in f_*
m_n = [0 ; MAX_MODEL];        // number of fields
m_schema = [0 ; MAX_MODEL];   // constant: ARRAY of INT [n, type1, width1, type2, width2, …]
m_names = [0 ; MAX_MODEL];    // constant: STRING with the field names separated by spaces
m_title = [0 ; MAX_MODEL];    // constant: STRING with the model's name
m_key = [0 ; MAX_MODEL];      // the key field (#name), or -1
m_auto = [false ; MAX_MODEL]; // the key is automatic (#+name): @{}>> numbers a record whose key is 0
n_models = 0;
f_start = [0 ; MAX_FIELD];
f_len = [0 ; MAX_FIELD];
f_type = [0 ; MAX_FIELD];
f_width = [0 ; MAX_FIELD];
n_fields = 0;

// ---- method parameters ----
p_type = [0 ; MAX_PARAM];
p_default = [0 ; MAX_PARAM];
p_start = [0 ; MAX_PARAM];    // the parameter's name in the source (for tools(), SPEC §27)
p_len = [0 ; MAX_PARAM];
n_param = 0;
lit_type = 0;
lit_value = 0;

// ---- lexer (lx_buf: the expanded source, or the raw arena during expansion) ----
lx_buf = source;
lx_pos = 0;
lx_end = 0;
lx_line = 1;
lx_lstart = 0;
lx_backslash = 0;
esc_q = 0;
tok_type = 0;
tok_start = 0;
tok_len = 0;
tok_value = 0;
tok_line = 1;
tok_lstart = 0;
copies_lexer = [0 ; 12 * 64];
n_copies_lexer = 0;

// ---- passadas ----
final_pass = false;
unknowns = 0;
discovered = false;
altered = false;    // an already known type changed (e.g. INT → INT?): redo the pass
n_passes = 0;
const_base = 0;
n_sym_base = 0;
const_empty = 0;
pos_init = 0;

// ---- compilation in progress ----
method_current = -1;
saw_value = false;
saw_empty = false;
saw_absent = false;
call_end = -1;
prelude_end = 0;             // the prelude is source[0 … prelude_end) (0: no prelude)
MAX_CALLS = 262144;
call_from = [0 ; MAX_CALLS];   // the calls of this pass: method making it (-1: top level) …
call_to = [0 ; MAX_CALLS];     // … and method called
n_calls = 0;
s_reach = [0 ; MAX_SYM];       // reached from the program in this pass
s_skip = [0 ; MAX_SYM];        // a prelude method left out of this pass (not reached in the last)
s_kept = [0 ; MAX_SYM];        // left out once and then needed: never left out again
q_model = -1;                // inside a query: the model whose field names stand for the element
q_elem = 0;                  // … and the hidden local holding the element
q_depth = 0;                 // queries around the code being compiled (inside each other's expression)
lib_k = -1;                  // the library method being called (its errors say .name)
lib_name_start = 0;
lib_name_len = 0;
level = 0;
slots = 0;
max_slots = 0;
pos_frame = 0;
pending = [0 ; 65536];
n_pending = 0;

// ---- prescan ----
pv_type = 0;
pv_start = 0;
pv_len = 0;
pv_line = 0;
pv2_type = 0;
pv2_start = 0;
pv2_len = 0;
pv2_line = 0;

// ---- optimizations (M9) ----
optimize = true;                 // "-O0 " before the path turns them off (the same bytes as stage 0)
want_map = false;                // "-map " before the path: where the code ends, on stderr (for the macOS translator)
code_end = 0;                    // where the program's code ends and its constants begin
REGS = [3, 12, 13, 14, 15];     // rbx, r12 … r15 (preserved by the runtime)
n_regs = 0;                     // registers in use in the current method
limit_regs = 0;                // how many the current method saved in its prologue
candidates = 0;                 // live locals that would fit in a register
demand = 0;                    // largest number of candidates at the same time (up to 5)
base_frame = 0;                // bytes of the saved registers, below rbp
last_target = -1;               // last position some jump points to
start_assignment = -1;         // the code of an assignment's expression starts here

// ---- error message being built ----
msg = [0 ; 1024];
msg_len = 0;
