    __nihil_c("memset", __b, 0, 144);
    __nihil_poke8(__b, __nihil_rt_peek4(__st));                              // st_dev
    __nihil_poke8(__b + 8, __nihil_peek(__st + 8));                          // st_ino
    __nihil_rt_poke4(__b + 24, __nihil_rt_peek4(__st + 4) & 0xFFFF);         // st_mode
    __nihil_poke8(__b + 48, __nihil_peek(__st + 96));                        // st_size
    __nihil_poke8(__b + 88, __nihil_peek(__st + 48));                        // st_mtime
    __nihil_poke8(__b + 96, __nihil_peek(__st + 56));                        // st_mtime_nsec
