}

__nihil_rt_close(fd = 0) {
    fd >= 0 && fd < 256 && __nihil_rt_dirs[fd] != 0 {
        __nihil_c32("closedir", __nihil_rt_dirs[fd]);
        __nihil_rt_dirs[fd] = 0;
    }
    __nihil_c32("close", fd);
}

// fstat / newfstatat into Linux's struct stat at b (144 bytes): dev, ino, mode, size, mtime
__nihil_rt_stat(kind = 0, x1 = 0, x2 = 0, x3 = 0, x4 = 0) {
    __st = __nihil_c("calloc", 1, 144);
    __r = 0;
    __b = 0;
    kind == 5 {
        __r = __nihil_c32("fstat", x1, __st);
        __b = x2;
    } || {
        __fl = 0;
        x4 & 0x100 != 0 { __fl = 0x20; }
