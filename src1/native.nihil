// =============================================================================
// native.nihil — the runtime of programs compiled with -native (macOS, ARM64), written in Nihil.
//
// A routine RT_<NAME> of the runtime (00_data.nihil) is the method __nihil_rt_<name> here, when
// there is one (42_arm.nihil: rt_method); the others are still in C (macos/native/rt.c). Its
// arguments are the registers the routine reads, in the order rax, rcx, rdx, rsi, rdi (rt_reads),
// all INTs: addresses of texts and arrays are INTs here (a text's length is the 8 bytes before
// it). The system is reached through its C library: __nihil_c("name", …) (memcpy, write, mmap …).
//
// A routine must not use what compiles to itself: no + of texts in __nihil_rt_concat, no $ in
// __nihil_rt_int_text, no == of texts in __nihil_rt_str_equal.
// =============================================================================

// a new text of n bytes (and the 0 after them), zeroed; the collector does not look inside it
__nihil_rt_new_text(__n = 0) {
    __n < 0 { __n = 0; }
    __t = __nihil_addr(__nihil_bytes(__n));
    __nihil_poke8(__t - 16, 4);
    : __t;
}

__nihil_rt_concat(a = 0, b = 0) {
    __la = __nihil_peek(a - 8);
    __lb = __nihil_peek(b - 8);
    __t = __nihil_rt_new_text(__la + __lb);
    __nihil_c("memcpy", __t, a, __la);
    __nihil_c("memcpy", __t + __la, b, __lb);
    : __nihil_str_at(__t);
}

__nihil_rt_str_equal(a = 0, b = 0) {
    a == b { : true; }
    __n = __nihil_peek(a - 8);
    __n != __nihil_peek(b - 8) { : false; }
    : __nihil_c32("memcmp", a, b, __n) == 0;
}

// how many characters v takes in decimal
__nihil_rt_width(v = 0) {
    __n = 1;
    v < 0 { __n = 2; }
    * v >= 10 || v <= -10 { v = v / 10; __n = __n + 1; }
    : __n;
}

// v in decimal into the text at t, ending before t[end]
__nihil_rt_put_int(__t = 0, end = 0, v = 0) {
    __s = __nihil_str_at(__t);
    __neg = v < 0;
    __i = end;
    __going = true;
    * __going {
        __d = v % 10;
        __d < 0 { __d = -__d; }
        __i = __i - 1;
        __nihil_poke(__s, __i, '0' + __d);
        v = v / 10;
        __going = v != 0;
    }
    __neg { __nihil_poke(__s, __i - 1, '-'); }
}

__nihil_rt_int_text(v = 0) {
    __n = __nihil_rt_width(v);
    __t = __nihil_rt_new_text(__n);
    __nihil_rt_put_int(__t, __n, v);
    : __nihil_str_at(__t);
}

__nihil_rt_concat_int(a = 0, v = 0) {
    __la = __nihil_peek(a - 8);
    __n = __nihil_rt_width(v);
    __t = __nihil_rt_new_text(__la + __n);
    __nihil_c("memcpy", __t, a, __la);
    __nihil_rt_put_int(__t, __la + __n, v);
    : __nihil_str_at(__t);
}

// s[from … to)
__nihil_rt_sub(__s = 0, from = 0, to = 0) {
    __n = to - from;
    __n < 0 { __n = 0; }
    __t = __nihil_rt_new_text(__n);
    __nihil_c("memcpy", __t, __s + from, __n);
    : __nihil_str_at(__t);
}

// the text s into the text being made at dst, from at → where it ends
__nihil_rt_put(dst = 0, at = 0, __s = 0) {
    __n = __nihil_peek(__s - 8);
    __nihil_c("memmove", dst + at, __s, __n);
    : at + __n;
}

__nihil_rt_array_concat(a = 0, b = 0) {
    __na = __nihil_peek(a - 8);
    __nb = __nihil_peek(b - 8);
    __r = [0 ; __na + __nb];
    __t = __nihil_addr(__r);
    __nihil_c("memcpy", __t, a, 8 * __na);
    __nihil_c("memcpy", __t + 8 * __na, b, 8 * __nb);
    : __r;
}

// ---- the system: Linux's calls (their numbers, flags, layouts and errno values), made with macOS's ----
// The prelude speaks Linux (it is the same on both systems): __nihil_syscall([n, a1 … a6]) comes
// here (RT_SYSCALL) and is made with the functions of macOS's C library.

__nihil_rt_dirs = [0 ; 256];               // a directory read by getdents64: its DIR (opendir)

// the byte b at the address a + i
__nihil_rt_pokeb(a = 0, i = 0, b = 0) { __nihil_poke(__nihil_str_at(a), i, b); }

// the 4 bytes at a, as an unsigned number / v's 4 bytes there
__nihil_rt_peek4(a = 0) { : __nihil_peek(a) & 0xFFFFFFFF; }
__nihil_rt_poke4(a = 0, v = 0) {
    __i = 0;
    * __i < 4 { __nihil_rt_pokeb(a, __i, (v >> (8 * __i)) & 255); __i = __i + 1; }
}

// macOS's errno → Linux's (1 … 34 are the same)
__nihil_rt_errno() {
    __e = __nihil_rt_peek4(__nihil_c("__error"));
    __e == 35 { : 11; } __e == 11 { : 35; } __e == 63 { : 36; } __e == 77 { : 37; } __e == 78 { : 38; }
    __e == 66 { : 39; } __e == 62 { : 40; } __e == 91 { : 42; } __e == 90 { : 43; } __e == 99 { : 60; }
    __e == 96 { : 61; } __e == 101 { : 62; } __e == 98 { : 63; } __e == 97 { : 67; } __e == 100 { : 71; }
    __e == 95 { : 72; } __e == 94 { : 74; } __e == 84 { : 75; } __e == 92 { : 84; } __e == 68 { : 87; }
    __e == 38 { : 88; } __e == 39 { : 89; } __e == 40 { : 90; } __e == 41 { : 91; } __e == 42 { : 92; }
    __e == 43 { : 93; } __e == 44 { : 94; } __e == 102 { : 95; } __e == 46 { : 96; } __e == 47 { : 97; }
    __e == 48 { : 98; } __e == 49 { : 99; } __e == 50 { : 100; } __e == 51 { : 101; } __e == 52 { : 102; }
    __e == 53 { : 103; } __e == 54 { : 104; } __e == 55 { : 105; } __e == 56 { : 106; } __e == 57 { : 107; }
    __e == 58 { : 108; } __e == 59 { : 109; } __e == 60 { : 110; } __e == 61 { : 111; } __e == 64 { : 112; }
    __e == 65 { : 113; } __e == 37 { : 114; } __e == 36 { : 115; } __e == 70 { : 116; } __e == 69 { : 122; }
    __e == 89 { : 125; } __e == 105 { : 130; } __e == 104 { : 131; }
    : __e;
}

// a result of C: negative → -Linux's errno
__nihil_rt_res(r = 0) {
    r < 0 { : -__nihil_rt_errno(); }
    : r;
}

__nihil_rt_cloexec(fd = 0) { __nihil_cvar("fcntl", 2, fd, 2, 1); }   // F_SETFD, FD_CLOEXEC

// Linux's open flags → macOS's
__nihil_rt_open_flags(l = 0) {
    __f = l & 3;
    l & 0x40 != 0 { __f = __f | 0x200; }
    l & 0x80 != 0 { __f = __f | 0x800; }
    l & 0x200 != 0 { __f = __f | 0x400; }
    l & 0x400 != 0 { __f = __f | 0x8; }
    l & 0x800 != 0 { __f = __f | 0x4; }
    l & 0x10000 != 0 { __f = __f | 0x100000; }
    l & 0x20000 != 0 { __f = __f | 0x100; }
    l & 0x80000 != 0 { __f = __f | 0x1000000; }
    : __f;
}

__nihil_rt_at_dir(d = 0) {
    d == -100 { : -2; }
    : d;
}

// a new socket or connection: closed on exec when asked; a peer that went away is an error on
// send, not SIGPIPE (macOS has no MSG_NOSIGNAL)
__nihil_rt_own_socket(fd = 0, flags = 0) {
    fd < 0 { : -__nihil_rt_errno(); }
    flags & 0x80000 != 0 { __nihil_rt_cloexec(fd); }
    __one = __nihil_c("malloc", 8);
    __nihil_rt_poke4(__one, 1);
    __nihil_c32("setsockopt", fd, 0xFFFF, 0x1022, __one, 4);   // SOL_SOCKET, SO_NOSIGPIPE
    __nihil_c("free", __one);
    : fd;
}

// Linux's sockaddr_in at l (u16 family, u16 port, u32 address) → macOS's, in a new buffer (free it)
__nihil_rt_sockaddr(l = 0) {
    __a = __nihil_c("calloc", 1, 16);
    __nihil_rt_pokeb(__a, 0, 16);
    __nihil_rt_pokeb(__a, 1, 2);
    __nihil_c("memcpy", __a + 2, l + 2, 6);
    : __a;
}

// one of the Linux files programs read (/proc/self/environ, /proc/uptime, /proc/sys/kernel/random/
// uuid): a file of its own, already removed, with the contents, read from the start; else -2
__nihil_rt_virtual_fd(path = 0) {
    __b = __nihil_c("calloc", 1, 64);
    __n = 0;
    __nihil_rt_is(path, "/proc/self/environ") == true {
        __env = __nihil_peek(__nihil_c("_NSGetEnviron"));
        __k = 0;
        * __nihil_peek(__env + 8 * __k) != 0 { __n = __n + __nihil_c("strlen", __nihil_peek(__env + 8 * __k)) + 1; __k = __k + 1; }
        __nihil_c("free", __b);
        __b = __nihil_c("calloc", 1, __n + 1);
        __at = 0;
        __k = 0;
        * __nihil_peek(__env + 8 * __k) != 0 {
            __e = __nihil_peek(__env + 8 * __k);
            __m = __nihil_c("strlen", __e) + 1;
            __nihil_c("memcpy", __b + __at, __e, __m);
            __at = __at + __m;
            __k = __k + 1;
        }
    } || __nihil_rt_is(path, "/proc/uptime") == true {
        __ts = __nihil_c("calloc", 1, 16);
        __nihil_c32("clock_gettime", 6, __ts);
        __n = __nihil_rt_put_dec(__b, 0, __nihil_peek(__ts));
        __nihil_rt_pokeb(__b, __n, '.');
        __cs = __nihil_peek(__ts + 8) / 10000000;
        __nihil_rt_pokeb(__b, __n + 1, '0' + __cs / 10);
        __nihil_rt_pokeb(__b, __n + 2, '0' + __cs % 10);
        __nihil_c("memcpy", __b + __n + 3, __nihil_addr(" 0.00\n"), 6);
        __n = __n + 9;
        __nihil_c("free", __ts);
    } || __nihil_rt_is(path, "/proc/sys/kernel/random/uuid") == true {
        __u = __nihil_c("calloc", 1, 16);
        __nihil_c("arc4random_buf", __u, 16);
        __nihil_rt_pokeb(__u, 6, (__nihil_peekb(__u + 6) & 0x0F) | 0x40);
        __nihil_rt_pokeb(__u, 8, (__nihil_peekb(__u + 8) & 0x3F) | 0x80);
        __hex = "0123456789abcdef";
        __i = 0;
        * __i < 16 {
            __i == 4 || __i == 6 || __i == 8 || __i == 10 { __nihil_rt_pokeb(__b, __n, '-'); __n = __n + 1; }
            __v = __nihil_peekb(__u + __i);
            __nihil_rt_pokeb(__b, __n, __hex[__v >> 4]);
            __nihil_rt_pokeb(__b, __n + 1, __hex[__v & 15]);
            __n = __n + 2;
            __i = __i + 1;
        }
        __nihil_rt_pokeb(__b, __n, 10);
        __n = __n + 1;
        __nihil_c("free", __u);
    } || {
        __nihil_c("free", __b);
        : -2;                                   // ENOENT: maps, pagemap …
    }
    __name = __nihil_c("calloc", 1, 32);
    __nihil_c("memcpy", __name, __nihil_addr("/tmp/nihil-proc-XXXXXX"), 22);
    __fd = __nihil_c32("mkstemp", __name);
    __fd >= 0 {
        __nihil_c32("unlink", __name);
        __at = 0;
        * __at < __n {
            __w = __nihil_c("write", __fd, __b + __at, __n - __at);
            __w <= 0 { __at = __n; } || { __at = __at + __w; }
        }
        __nihil_c("lseek", __fd, 0, 0);
        __nihil_rt_cloexec(__fd);
    }
    __nihil_c("free", __name);
    __nihil_c("free", __b);
    __fd < 0 { : -2; }
    : __fd;
}

// the C text at p is the text s
__nihil_rt_is(p = 0, s = "") {
    __nihil_c("strlen", p) != #s { : false; }
    : __nihil_c32("memcmp", p, __nihil_addr(s), #s) == 0;
}

// v (not negative) in decimal into the buffer at b, from at → where it ends
__nihil_rt_put_dec(b = 0, at = 0, v = 0) {
    __w = __nihil_rt_width(v);
    __i = at + __w;
    * __i > at { __i = __i - 1; __nihil_rt_pokeb(b, __i, '0' + v % 10); v = v / 10; }
    : at + __w;
}

// getdents64(fd, buf, cap): Linux's records (d_ino, d_off, d_reclen, d_type, d_name), from readdir
__nihil_rt_getdents(fd = 0, buf = 0, cap = 0) {
    fd < 0 || fd >= 256 { : -9; }
    __nihil_rt_dirs[fd] == 0 {
        __copy = __nihil_c32("dup", fd);
        __d = 0;
        __copy >= 0 { __d = __nihil_c("fdopendir", __copy); }
        __d == 0 { : -__nihil_rt_errno(); }
        __nihil_rt_dirs[fd] = __d;
    }
    __dir = __nihil_rt_dirs[fd];
    __used = 0;
    * true {
        __pos = __nihil_c("telldir", __dir);
        __e = __nihil_c("readdir", __dir);
        __e == 0 { : __used; }
        __len = __nihil_c("strlen", __e + 21);
        __rec = (19 + __len + 1 + 7) & -8;
        __used + __rec > cap { __nihil_c("seekdir", __dir, __pos); : __used; }
        __r = buf + __used;
        __nihil_c("memset", __r, 0, __rec);
        __nihil_poke8(__r, __nihil_peek(__e));
        __nihil_rt_pokeb(__r, 16, __rec & 255);
        __nihil_rt_pokeb(__r, 17, __rec >> 8);
        __nihil_rt_pokeb(__r, 18, __nihil_peekb(__e + 20));
        __nihil_c("memcpy", __r + 19, __e + 21, __len);
        __used = __used + __rec;
    }
