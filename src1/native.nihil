    __n == 17 { : __nihil_rt_res(__nihil_c("pread", a1, a2, a3, a4)); }
    __n == 18 { : __nihil_rt_res(__nihil_c("pwrite", a1, a2, a3, a4)); }
    __n == 21 { : __nihil_rt_res(__nihil_c32("access", a1, a2)); }
