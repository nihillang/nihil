// mincore(start, len, vec): Linux's 4 KiB pages, from macOS's (16 KiB); a page never written
// reports only MINCORE_ANONYMOUS: nothing there
__nihil_rt_mincore(start = 0, len = 0, vec = 0) {
    __pg = __nihil_c32("getpagesize");
    __first = start & -__pg;
    __n = (start + len - __first + __pg - 1) / __pg;
    __v = __nihil_c("malloc", __n);
    __v == 0 { : -12; }
    __nihil_c32("mincore", __first, __n * __pg, __v) != 0 { __e = __nihil_rt_errno(); __nihil_c("free", __v); : -__e; }
    __pages = (len + 4095) / 4096;
    __i = 0;
    * __i < __pages {
        __s = __nihil_peekb(__v + (start + __i * 4096 - __first) / __pg) & 0x7F;
        __s != 0 { __nihil_rt_pokeb(vec, __i, 1); } || { __nihil_rt_pokeb(vec, __i, 0); }
        __i = __i + 1;
    }
    __nihil_c("free", __v);
    : 0;
}

// x: [n, a1 … a6] (an array: as many as it has, the others 0)
__nihil_rt_arg(x = 0, i = 0) {
    i < __nihil_peek(x - 8) { : __nihil_peek(x + 8 * i); }
    : 0;
}

__nihil_rt_syscall(x = 0) {
    __n = __nihil_rt_arg(x, 0);
    a1 = __nihil_rt_arg(x, 1);
    a2 = __nihil_rt_arg(x, 2);
    a3 = __nihil_rt_arg(x, 3);
    a4 = __nihil_rt_arg(x, 4);
    a5 = __nihil_rt_arg(x, 5);
