// =============================================================================
// native.nihil — the runtime of programs compiled with -native (macOS, ARM64), written in Nihil.
//
// A routine RT_<NAME> of the runtime (00_data.nihil) is the method __nihil_rt_<name> here, when
// there is one (42_arm.nihil: rt_method); the others are still in C (macos/native/rt.c). Its
// arguments are the registers the routine reads, in the order rax, rcx, rdx, rsi, rdi (rt_reads),
// all INTs: addresses of texts and arrays are INTs here (a text's length is the 8 bytes before
// it). The system is reached through its C library: __nihil_c("name", …) (memcpy, write, mmap …).
//
// A routine must not use what compiles to itself: no + of texts in __nihil_rt_concat, no $ in
// __nihil_rt_int_text, no == of texts in __nihil_rt_str_equal.
// =============================================================================

// ---- the heap and its collector (first in the file: their globals are set before any block is made) ----
// As macos/native/rt.c's was: conservative mark, no sweep. Blocks of 41 size classes live in pages
// of 64 KiB, one class to a page; a larger one takes whole pages. Whether a block is in use is in a
// map, a byte for each 32 bytes of the arena (`used`); a mark sets the bytes of the used blocks it
// reaches in the other map (`marked`), then the two swap and the old one is cleared. A class hands
// out the next block whose byte is clear, in the pages the mark left with room; a page with nothing
// marked goes back to the system unread. From 64 MB live a child process (fork) marks while the
// program goes on (`marked` is shared with it); the program marks there what it hands out
// meanwhile. The roots: the globals, the program's stack (x28 to its top), the registers x19 … x28
// and the records of the protected calls. All of it is memory of its own (mmap, calloc), not blocks.
__nihil_gc_arena = 0;
__nihil_gc_pkind = 0;                      // a byte a page: 0 free, 1 small, 2 large (head), 3 large (rest)
__nihil_gc_pclass = 0;                     // a byte a page: its class
__nihil_gc_pspan = 0;                      // 8 bytes a page: a large block's pages (head) or its head
__nihil_gc_pnext = 0;                      // 8 bytes a page: the next page with room of its class (+ 1)
__nihil_gc_free = 0;                       // single free pages below high (8 bytes each)
__nihil_gc_nfree = 0;
__nihil_gc_high = 0;                       // pages in use or used before
__nihil_gc_csize = 0;                      // the 41 classes' sizes (8 bytes each)
__nihil_gc_cls = 0;                        // the class of a block of b bytes: a byte at (b + 7) / 8
__nihil_gc_cur = 0;                        // a class's page it hands out of (+ 1), its next slot, its pages with room
__nihil_gc_slot = 0;
__nihil_gc_room = 0;
__nihil_gc_used = 0;
__nihil_gc_marked = 0;
__nihil_gc_marked_high = 0;
__nihil_gc_allocated = 0;
__nihil_gc_live = 0;
__nihil_gc_live_small = 0;
__nihil_gc_live_large = 0;
__nihil_gc_next_at = 0;
__nihil_gc_threshold = 0;
__nihil_gc_child = 0;
__nihil_gc_wait_at = 0;
__nihil_gc_fork_min = 0;
__nihil_gc_poll = 0;
__nihil_gc_stats = false;
__nihil_gc_torture = false;
__nihil_gc_stack = 0;                      // the mark's stack of blocks to scan (8 bytes each)
__nihil_gc_sn = 0;
__nihil_gc_scap = 0;
__nihil_gc_regs = 0;                       // x19 … x28 at a mark (nh_regs)
__nihil_gc_line = 0;                       // a line of statistics being made
__nihil_rt_high_fd = 2;                    // the highest descriptor a call made: a marking child closes them
__nihil_out = 0;                           // the output not written yet (64 KiB of its own) and its length
__nihil_out_n = 0;
__nihil_err_buf = 0;                       // inside a protected call: the error's text, kept for ?! (4000 bytes)
__nihil_err_n = 0;
__nihil_err_capture = false;
__nihil_prot = 0;                          // the protected calls' records: x28, x29, where to resume, x19 … x26
__nihil_prot_depth = 0;

// 64 GiB of address space, 2 GiB for each map: only what is used becomes memory
__nihil_gc_init() {
    __nihil_gc_arena = __nihil_c("mmap", 0, 1 << 36, 3, 0x1042, -1, 0);   // PRIVATE | ANON | NORESERVE
    __nihil_gc_pkind = __nihil_c("calloc", 1, 1 << 20);
    __nihil_gc_pclass = __nihil_c("calloc", 1, 1 << 20);
    __nihil_gc_pspan = __nihil_c("calloc", 8, 1 << 20);
    __nihil_gc_pnext = __nihil_c("calloc", 8, 1 << 20);
    __nihil_gc_free = __nihil_c("calloc", 8, 1 << 20);
    __nihil_gc_csize = __nihil_c("calloc", 8, 41);
    __nihil_gc_cls = __nihil_c("calloc", 1, 4097);
    __nihil_gc_cur = __nihil_c("calloc", 8, 41);
    __nihil_gc_slot = __nihil_c("calloc", 8, 41);
    __nihil_gc_room = __nihil_c("calloc", 8, 41);
    __nihil_gc_regs = __nihil_c("calloc", 8, 10);
    __nihil_gc_line = __nihil_c("calloc", 1, 256);
    __nihil_gc_arena == -1 || __nihil_gc_pkind == 0 || __nihil_gc_pspan == 0 || __nihil_gc_free == 0 { __nihil_gc_oom(); }
    __nihil_gc_used = __nihil_gc_map_new();
    __nihil_gc_marked = __nihil_gc_map_new();
    __s = 32;
    __c = 0;
    __d = 8;
    * __c < 41 {                           // 32, 40, 48, 56, 64, 80 … 32768: four to a doubling
        __nihil_poke8(__nihil_gc_csize + 8 * __c, __s);
        __s == 8 * __d { __d = 2 * __d; }
        __s = __s + __d;
        __c = __c + 1;
    }
    __q = 0;
    __c = 0;
    * __q <= 4096 {                        // the smallest class that holds 8 · q bytes
        * __nihil_peek(__nihil_gc_csize + 8 * __c) < 8 * __q { __c = __c + 1; }
        __nihil_rt_pokeb(__nihil_gc_cls, __q, __c);
        __q = __q + 1;
    }
    __nihil_gc_next_at = 16 << 20;
    __nihil_gc_threshold = 16 << 20;
    __nihil_gc_fork_min = 64 << 20;
    __nihil_gc_poll = 4 << 20;
    __nihil_gc_stats = __nihil_gc_env("NIHIL_GC_STATS");
    __nihil_gc_torture = __nihil_gc_env("NIHIL_GC_TORTURE");
    __nihil_gc_torture {
        __nihil_gc_threshold = 65536;
        __nihil_gc_next_at = 65536;
        __nihil_gc_fork_min = 1 << 20;
        __nihil_gc_poll = 256 << 10;
    }
}

// the variable of the environment named s is set
__nihil_gc_env(s = "") {
    __b = __nihil_c("calloc", 1, #s + 1);
    __nihil_c("memcpy", __b, __nihil_addr(s), #s);
    __r = __nihil_c("getenv", __b) != 0;
    __nihil_c("free", __b);
    : __r;
}

__nihil_gc_oom() {
    __nihil_c("write", 2, __nihil_addr("nihil: out of memory\n"), 21);
    __nihil_c("_exit", 2);
}

__nihil_gc_map_new() {
    __m = __nihil_c("mmap", 0, 4096 + (1 << 31), 3, 0x1041, -1, 0);       // SHARED | ANON | NORESERVE
    __m == -1 { __nihil_gc_oom(); }
    : __m;
}

// the first bytes of a map, for n pages, zero again (their memory back to the system)
__nihil_gc_map_clear(m = 0, n = 0) {
    __len = (4096 + ((n << 16) >> 5) + 16383) & -16384;
    __nihil_c("mmap", m, __len, 3, 0x1011, -1, 0) == -1 { __nihil_gc_oom(); }   // FIXED | SHARED | ANON
}

// the pages p … p + n - 1 back to the system: zero when used again
__nihil_gc_release(p = 0, n = 0) {
    __nihil_c("mmap", __nihil_gc_arena + (p << 16), n << 16, 3, 0x1012, -1, 0) == -1 { __nihil_gc_oom(); }   // FIXED | PRIVATE | ANON
    __nihil_c("memset", __nihil_gc_pkind + p, 0, n);
}

// n contiguous free pages (zeroed) → the first
__nihil_gc_pages(n = 0) {
    n == 1 {
        * __nihil_gc_nfree > 0 {
            __nihil_gc_nfree = __nihil_gc_nfree - 1;
            __p = __nihil_peek(__nihil_gc_free + 8 * __nihil_gc_nfree);
            __nihil_peekb(__nihil_gc_pkind + __p) == 0 { : __p; }
        }
    } || __nihil_gc_nfree >= n {           // a run among the free pages
        __run = 0;
        __p = 0;
        * __p < __nihil_gc_high {
            __nihil_peekb(__nihil_gc_pkind + __p) == 0 { __run = __run + 1; } || { __run = 0; }
            __run == n { : __p - n + 1; }
            __p = __p + 1;
        }
    }
    __nihil_gc_high + n > (1 << 20) { __nihil_rt_failed("out of memory"); }
    __p = __nihil_gc_high;
    __nihil_gc_high = __nihil_gc_high + n;
    : __p;
}

// alloc(n): a block of n words. The usual case, as a leaf (it calls nothing, so its 8 slots stay in
// x1 … x8 and it saves no register): a small block, no collection due, its class's page with room
// (its next slot clear in `used`), zeroed 8 bytes at a time. 0: anything else, and the call
// (42_arm.nihil, arm_call_nihil) then takes __nihil_rt_alloc_slow.
__nihil_rt_alloc(n = 0) {
    __nihil_gc_arena == 0 || n < 0 || n > 62 { : 0; }   // (n itself: n · 8 could overflow)
    __b = n * 8 + 16;                                     // its bytes
    __a = __nihil_gc_allocated + __b;
    __a > __nihil_gc_threshold { : 0; }
    __c = __nihil_peekb(__nihil_gc_cls + (__b >> 3));
    __p = __nihil_peek(__nihil_gc_cur + 8 * __c);
    __p == 0 { : 0; }
    __s = __nihil_peek(__nihil_gc_csize + 8 * __c);
    __m = __nihil_gc_used + 4096 + ((__p - 1) << 11);
    __o = __nihil_peek(__nihil_gc_slot + 8 * __c) * __s;
    * __o + __s <= 65536 && __nihil_peekb(__m + (__o >> 5)) != 0 { __o = __o + __s; }
    __o + __s > 65536 { : 0; }
    __nihil_poke8(__nihil_gc_slot + 8 * __c, __o / __s + 1);
    __nihil_gc_allocated = __a;
    __nihil_poke(__nihil_str_at(__m), __o >> 5, 1);       // used
    __nihil_gc_child != 0 {                               // a child marks: this block lives (as in gc_alloc)
        __nihil_poke(__nihil_str_at(__m + (__nihil_gc_marked - __nihil_gc_used)), __o >> 5, 1);
    }
    __p = __nihil_gc_arena + ((__p - 1) << 16) + __o;     // the block
    __o = __p + __s;
    __b = __p;
    * __b < __o { __nihil_poke8(__b, 0); __b = __b + 8; }
    __nihil_poke8(__p + 8, n);
    : __p + 16;
}

// alloc(n) when the usual case does not hold: a collection due, a new page, a large block
__nihil_rt_alloc_slow(n = 0) { : __nihil_gc_alloc(n, true); }

// [fill ; n]. A large one is filled by the system's memset_pattern8 (fill's 8 bytes, from
// __nihil_rt_pat: made at the start, so not for the runtime's own first arrays)
__nihil_rt_pat = [0 ; 1];
__nihil_rt_array_rep(n = 0, fill = 0) {
    __a = __nihil_rt_alloc(n);              // the usual case first (a small block: lazy does not matter)
    __a == 0 { __a = __nihil_gc_alloc(n, fill == 0); }
    fill != 0 && n >= 512 && #__nihil_rt_pat == 1 {
        __nihil_rt_pat[0] = fill;
        __nihil_c("memset_pattern8", __a, __nihil_addr(__nihil_rt_pat), 8 * n);
        : __a;
    }
    fill != 0 {
        __p = __a;
        __end = __a + 8 * n;
        * __p < __end { __nihil_poke8(__p, fill); __p = __p + 8; }
    }
    : __a;
}

// a block for n words → its words (zeroed; its length n). lazy: the caller may write only part of a
// large one (a big array of zeros): its pages count when written, not now
__nihil_gc_alloc(n = 0, lazy = false) {
    n < 0 { __nihil_rt_failed("negative array size"); }
    n >= 1 << 40 { __nihil_rt_failed("array too large"); }
    __nihil_gc_arena == 0 { __nihil_gc_init(); }
    __bytes = n * 8 + 16;
    lazy && __bytes > 32768 { __nihil_gc_allocated = __nihil_gc_allocated + 65536; }
    || { __nihil_gc_allocated = __nihil_gc_allocated + __bytes; }
    __nihil_gc_allocated > __nihil_gc_threshold { __nihil_gc_collect(); }
    __b = 0;
    __bytes <= 32768 {
        __c = __nihil_peekb(__nihil_gc_cls + (__bytes >> 3));
        __s = __nihil_peek(__nihil_gc_csize + 8 * __c);
        __b = __nihil_gc_small(__c, __s);
        __s <= 512 { __z = __b; * __z < __b + __s { __nihil_poke8(__z, 0); __z = __z + 8; } }
        || { __nihil_c("memset", __b, 0, __s); }
    } || {
        __np = (__bytes + 65535) >> 16;
        __p = __nihil_gc_pages(__np);
        __nihil_rt_pokeb(__nihil_gc_pkind, __p, 2);
        __nihil_poke8(__nihil_gc_pspan + 8 * __p, __np);
        __i = 1;
        * __i < __np {
            __nihil_rt_pokeb(__nihil_gc_pkind, __p + __i, 3);
            __nihil_poke8(__nihil_gc_pspan + 8 * (__p + __i), __p);
            __i = __i + 1;
        }
        __b = __nihil_gc_arena + (__p << 16);
    }
    __nihil_poke8(__b + 8, n);
    __m = 4096 + ((__b - __nihil_gc_arena) >> 5);
    __nihil_rt_pokeb(__nihil_gc_used, __m, 1);
    __nihil_gc_child != 0 { __nihil_rt_pokeb(__nihil_gc_marked, __m, 1); }   // a child marks: this block lives
    : __b + 16;
}

// a free block of the class c (its size s) → its address
__nihil_gc_small(c = 0, s = 0) {
    __k = 65536 / s;
    * true {
        __cp = __nihil_peek(__nihil_gc_cur + 8 * c);
        __cp != 0 {
            __p = __cp - 1;
            __i = __nihil_peek(__nihil_gc_slot + 8 * c);
            __m = __nihil_gc_used + 4096 + (__p << 11);
            * __i < __k && __nihil_peekb(__m + ((__i * s) >> 5)) != 0 { __i = __i + 1; }
            __i < __k {
                __nihil_poke8(__nihil_gc_slot + 8 * c, __i + 1);
                : __nihil_gc_arena + (__p << 16) + __i * s;
            }
            __nihil_poke8(__nihil_gc_cur + 8 * c, 0);
        }
        __r = __nihil_peek(__nihil_gc_room + 8 * c);
        __r != 0 {
            __p = __r - 1;
            __nihil_poke8(__nihil_gc_room + 8 * c, __nihil_peek(__nihil_gc_pnext + 8 * __p));
            __nihil_poke8(__nihil_gc_cur + 8 * c, __p + 1);
            __nihil_poke8(__nihil_gc_slot + 8 * c, 0);
        } || {
            __p = __nihil_gc_pages(1);     // a new page of that class
            __nihil_rt_pokeb(__nihil_gc_pkind, __p, 1);
            __nihil_rt_pokeb(__nihil_gc_pclass, __p, c);
            __nihil_poke8(__nihil_gc_cur + 8 * c, __p + 1);
            __nihil_poke8(__nihil_gc_slot + 8 * c, 0);
        }
    }
    : 0;
}

// ---- the mark ----

// the words from from to to: each one that points into a used block not marked yet marks it and
// puts it on the stack (its words scanned later)
__nihil_gc_mark_range(from = 0, to = 0) {
    __arena = __nihil_gc_arena;
    __top = __arena + (__nihil_gc_high << 16);
    __p = (from + 7) & -8;
    * __p + 8 <= to {
        __w = __nihil_peek(__p);
        __p = __p + 8;
        __w >= __arena && __w < __top {
            __off = __w - __arena;
            __pg = __off >> 16;
            __kind = __nihil_peekb(__nihil_gc_pkind + __pg);
            __b = 0;
            __s = 0;
            __kind == 1 {
                __s = __nihil_peek(__nihil_gc_csize + 8 * __nihil_peekb(__nihil_gc_pclass + __pg));
                __i = (__off & 65535) / __s;
                (__i + 1) * __s <= 65536 { __b = __arena + (__pg << 16) + __i * __s; }
            } || __kind == 3 {
                __b = __arena + (__nihil_peek(__nihil_gc_pspan + 8 * __pg) << 16);
            } || __kind == 2 {
                __b = __arena + (__pg << 16);
            }
            __b != 0 {
                __m = 4096 + ((__b - __arena) >> 5);
                __nihil_peekb(__nihil_gc_used + __m) != 0 && __nihil_peekb(__nihil_gc_marked + __m) == 0 {
                    __nihil_rt_pokeb(__nihil_gc_marked, __m, 1);
                    __kind == 1 { __nihil_gc_live_small = __nihil_gc_live_small + __s; }
                    __kind != 1 || __nihil_peek(__b) & 4 == 0 {   // a small one not scanned (a text, numbers only): marked is all
                        __nihil_gc_sn == __nihil_gc_scap {
                            __nihil_gc_scap == 0 { __nihil_gc_scap = 65536; } || { __nihil_gc_scap = 2 * __nihil_gc_scap; }
                            __nihil_gc_stack = __nihil_c("realloc", __nihil_gc_stack, 8 * __nihil_gc_scap);
                            __nihil_gc_stack == 0 { __nihil_gc_oom(); }
                        }
                        __nihil_poke8(__nihil_gc_stack + 8 * __nihil_gc_sn, __b);
                        __nihil_gc_sn = __nihil_gc_sn + 1;
                    }
                }
            }
        }
    }
}

// a block's words (none for a text); of a large one, only the system's pages ever written
// (mincore): the others are zero, and reading them would make them real
__nihil_gc_mark_block(b = 0) {
    __pg = (b - __nihil_gc_arena) >> 16;
    __bytes = 0;
    __nihil_peekb(__nihil_gc_pkind + __pg) == 1 { __bytes = __nihil_peek(__nihil_gc_csize + 8 * __nihil_peekb(__nihil_gc_pclass + __pg)); }
    || { __bytes = __nihil_peek(__nihil_gc_pspan + 8 * __pg) << 16; }
    __nihil_peek(b) & 4 != 0 {             // a text: not scanned; a large one still counts (written whole)
        __bytes > 32768 { __nihil_gc_live_large = __nihil_gc_live_large + __bytes; }
        :;
    }
    __bytes <= 32768 { __nihil_gc_mark_range(b + 16, b + __bytes); :; }
    __sp = __nihil_c32("getpagesize");
    __vec = __nihil_c("malloc", 65536);
    __end = b + __bytes;
    __chunk = b;
    * __chunk < __end {
        __n = (__end - __chunk) / __sp;
        __n > 65536 { __n = 65536; }
        __nihil_c32("mincore", __chunk, __n * __sp, __vec) != 0 {
            __nihil_gc_live_large = __nihil_gc_live_large + __n * __sp;
            __from = __chunk;
            __chunk == b { __from = b + 16; }
            __nihil_gc_mark_range(__from, __chunk + __n * __sp);
        } || {
            __i = 0;
            * __i < __n {
                __nihil_peekb(__vec + __i) & 0x7F != 0 {
                    __nihil_gc_live_large = __nihil_gc_live_large + __sp;
                    __from = __chunk + __i * __sp;
                    __to = __from + __sp;
                    __from == b { __from = b + 16; }
                    __nihil_gc_mark_range(__from, __to);
                }
                __i = __i + 1;
            }
        }
        __chunk = __chunk + __n * __sp;
    }
    __nihil_c("free", __vec);
}

__nihil_gc_mark_all() {
    __nihil_gc_live_small = 0;
    __nihil_gc_live_large = 0;
    __nihil_c("nh_regs", __nihil_gc_regs);
    __nihil_gc_mark_range(__nihil_gc_regs, __nihil_gc_regs + 80);
    __g = __nihil_c("nh_globals_start");
    __nihil_gc_mark_range(__g, __g + __nihil_c("nh_globals_bytes"));
    __nihil_gc_mark_range(__nihil_peek(__nihil_gc_regs + 72), __nihil_c("nh_stack_top"));   // x28 …
    __nihil_prot != 0 { __nihil_gc_mark_range(__nihil_prot, __nihil_prot + 88 * __nihil_prot_depth); }
    * __nihil_gc_sn > 0 {
        __nihil_gc_sn = __nihil_gc_sn - 1;
        __nihil_gc_mark_block(__nihil_peek(__nihil_gc_stack + 8 * __nihil_gc_sn));
    }
}

__nihil_gc_now_us() {
    __ts = __nihil_c("calloc", 1, 16);
    __nihil_c32("clock_gettime", 6, __ts);
    __t = __nihil_peek(__ts) * 1000000 + __nihil_peek(__ts + 8) / 1000;
    __nihil_c("free", __ts);
    : __t;
}

// a line of statistics on stderr: its parts (texts, numbers) put one by one (no block made)
__nihil_gc_at = 0;
__nihil_gc_say(s = "") { __nihil_c("memcpy", __nihil_gc_line + __nihil_gc_at, __nihil_addr(s), #s); __nihil_gc_at = __nihil_gc_at + #s; }
__nihil_gc_num(v = 0) { __nihil_gc_at = __nihil_rt_put_dec(__nihil_gc_line, __nihil_gc_at, v); }
__nihil_gc_said() { __nihil_c("write", 2, __nihil_gc_line, __nihil_gc_at); __nihil_gc_at = 0; }

// after a mark (in `marked`): it becomes `used`; the pages with nothing marked go back to the system
// (past 256 kept), the others with room wait for their class; since: bytes made after the mark began
__nihil_gc_after_mark(t0 = 0, t_mark = 0, ended = false, since = 0) {
    __t = __nihil_gc_used;
    __nihil_gc_used = __nihil_gc_marked;
    __nihil_gc_marked = __t;
    __kept = 0;
    __nihil_gc_nfree = 0;
    __nihil_c("memset", __nihil_gc_cur, 0, 8 * 41);
    __nihil_c("memset", __nihil_gc_room, 0, 8 * 41);
    __p = 0;
    * __p < __nihil_gc_high {
        __kind = __nihil_peekb(__nihil_gc_pkind + __p);
        __kind == 1 {
            __c = __nihil_peekb(__nihil_gc_pclass + __p);
            __k = 65536 / __nihil_peek(__nihil_gc_csize + 8 * __c);
            __w = __nihil_gc_used + 4096 + (__p << 11);
            __end = __w + 2048;
            __n = 0;
            * __w < __end { __n = __n + ((__nihil_peek(__w) * 0x0101010101010101) >> 56); __w = __w + 8; }   // bytes 0 or 1
            __n == 0 && __kept >= 256 {
                __nihil_gc_release(__p, 1);
                __nihil_poke8(__nihil_gc_free + 8 * __nihil_gc_nfree, __p);
                __nihil_gc_nfree = __nihil_gc_nfree + 1;
            } || __n < __k {
                __n == 0 { __kept = __kept + 1; }
                __nihil_poke8(__nihil_gc_pnext + 8 * __p, __nihil_peek(__nihil_gc_room + 8 * __c));
                __nihil_poke8(__nihil_gc_room + 8 * __c, __p + 1);
            }
            __p = __p + 1;
        } || __kind == 2 {
