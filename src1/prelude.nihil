__nihil_same_line(s = "", a = 0, b = 0, n = 0) {
    __i = 0;
    * __i < n {
        s[a + __i] != s[b + __i] { : false; }
        __i = __i + 1;
    }
    : true;
}

// The index this program last found to match its table: the table's path, its size and stamp
// then, and the index's capacity. A key operation on a table that has not changed since (same
// size and stamp, which every write changes) uses it without reading the index's header again;
// a slot that cannot be read drops it. __nihil_kf_line is the line of the record that
// __nihil_key_find found last, so a lookup reads it once.
__nihil_kc_path = "";
__nihil_kc_size = -1;
__nihil_kc_stamp = 0;
__nihil_kc_cap = 0;
__nihil_kf_line = "";
__nihil_kt_cof = "";                            // key_stat: the path __nihil_kt_cpath ends with 0
__nihil_kt_cpath = "";
__nihil_kt_sbuf = "";                           // and its stat buffer
__nihil_kf_j = 0;                               // key_find's slot (where the key is, or where it would go)
__nihil_kf_c = 0;                               // and the index's capacity
__nihil_kc_idx = "";                            // the index's path for __nihil_kc_idxof (made once)
__nihil_kc_idxof = "";
__nihil_kslot = "";                             // a slot read into here (4 bytes, reused)
__nihil_kline = "";                             // a record's line read into here (reused while the width is the same)

// The table and its index, kept open by the key operations themselves, so a lookup is one stat of
// the table and two reads (the slot, the record): __nihil_kt_* is the table as the last stat saw it
// (path, fd, size and stamp: while a caller's stamp is that one, the fd is the file at the path),
// __nihil_ki_* its index (used only while the index is known to match the table, see key_find).
__nihil_kt_path = "";
__nihil_kt_fd = -1;
__nihil_kt_dev = 0;
__nihil_kt_ino = 0;
__nihil_kt_stamp = 0;
__nihil_kt_rw = false;                          // the table's fd can write (else read only)
__nihil_ki_path = "";
__nihil_ki_fd = -1;
__nihil_ki_rw = false;

// one stat of the table: its size (-1: no file), its stamp in __nihil_kt_stamp, computed as the
// runtime's (mtime in nanoseconds + inode × 0x9E3779B97F4A7C15), and the table open in __nihil_kt_fd
// (the same file as before, or opened again)
__nihil_key_stat(path = "") {
