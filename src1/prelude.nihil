    }
    __tfd = -1;                                     // the table's fd, while the caller's stamp is the last stat's
    __nihil_kt_path == path && __nihil_kt_stamp == stamp { __tfd = __nihil_kt_fd; }
    __w = __nihil_rec_width(schema) + 1;
