// reads the whole table and writes a new index (atomically); → its capacity.
// Two records with the same key are an error.
__nihil_key_rebuild(path = "", size = 0, stamp = 0, schema = [0], names = "", model = "", kf = 0) {
    __n = __nihil_rec_count(path, size, schema, model);
    __c = 16;
    * __c < 2 * (__n + 1) { __c = __c * 2; }
    __w = __nihil_rec_width(schema) + 1;
    __text = "";
    size > 0 { __text = __nihil_str_at(__nihil_pread(path, 0, size)); }
    __slots = [0 ; __c];
    __hs = [0 ; __n + 1];                           // each record's key hash: a probe compares these first
    __ka = 0;                                       // where the key field starts in a line, and its width
    __i = 0;
    kf { __ka = __ka + schema[2 + __i * 2]; __i = __i + 1; }
    __kw = schema[2 + kf * 2];
    __int = schema[1 + kf * 2] == 1;
    __i = 0;
    * __i < __n {
        __at = __i * __w;
        __at + __w <= #__text && __text[__at + __w - 1] != 10 {
            __nihil_table_bad(path, __i + 1, "the line does not have the width of a " + model + " record");
        }
        __h = __nihil_key_hash_at(__text, __at + __ka, __kw, __int);
        __h == 0 { __h = __nihil_key_hash(__nihil_key_at(__text, __at, schema, names, path, __i + 1, kf)); }
        __hs[__i] = __h;
        __j = __h & (__c - 1);
        * __slots[__j] != 0 {
            __o = __slots[__j] - 1;
            __hs[__o] == __h && __nihil_key_at(__text, __o * __w, schema, names, path, __o + 1, kf) == __nihil_key_at(__text, __at, schema, names, path, __i + 1, kf) {
                __i == __n - 1 && __nihil_same_line(__text, __o * __w, __at, __w - 1) {
                    // a deletion that stopped after moving the last record into
                    // place: finish it, and index the table it leaves
                    __nihil_truncate(path, __at);
                    : __nihil_key_rebuild(path, __nihil_fsize(path), __nihil_fstamp(path), schema, names, model, kf);
                }
