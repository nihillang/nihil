        __nihil_kc_idxof = path;
    }
    __idx = __nihil_kc_idx;
    __c = 0;
    __cached = __nihil_kc_path == path && __nihil_kc_size == size && __nihil_kc_stamp == stamp;
    __cached { __c = __nihil_kc_cap; }
    // the index kept open is used only while the index is known to match this table: otherwise
    // it may have been rebuilt (a new file), so it is opened again below
