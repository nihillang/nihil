    __b - __s != #key { : false; }
    __k = 0;
    * __k < #key {
        t[__s + __k] != key[__k] { : false; }
        __k = __k + 1;
    }
    : true;
}

// ---- writes by key, one program at a time (SPEC §20.5) ------------------------------------------
// A write by key reads the table and the index and then changes them, so two programs doing it at
// once could both add a record at the same place, or leave the index out of step. Each one holds an
// exclusive lock (flock) on "<path>.nihil-lock" for the whole operation: a file of its own, because
// the table itself is replaced by @>> and a lock on the old file would no longer guard the new one.
// The lock is cooperative: programs that do not take it (an editor) are not held back. Reads take no
// lock; the stat before each operation shows them what a writer did. A failure caught by a protected
// call (SPEC §25) may leave the lock held: the program's next operation by key gives it back (a
// lookup too), and the system does when the program ends.
__nihil_klock_fd = -1;
__nihil_klock_of = "";
__nihil_klock_held = false;

__nihil_key_lock(path = "") {
    __nihil_key_unlock();
    __nihil_klock_of != path {
        __nihil_klock_fd >= 0 { __nihil_syscall([3, __nihil_klock_fd]); }
        __p = path + ".nihil-lock\0";
        __nihil_klock_fd = __nihil_syscall([257, -100, __nihil_addr(__p), 0x80042, 420]);   // O_RDWR|O_CREAT|O_CLOEXEC, 0644
        __nihil_klock_of = path;
        __nihil_klock_fd < 0 { __nihil_klock_fd = -1; }                                    // no lock file: no lock
    }
    __nihil_klock_fd >= 0 {
        __r = __nihil_syscall([73, __nihil_klock_fd, 2]);                                  // flock(LOCK_EX): wait for it
        * __r == -4 { __r = __nihil_syscall([73, __nihil_klock_fd, 2]); }                  // -EINTR: again
        __nihil_klock_held = __r == 0;
    }
}

__nihil_key_unlock() {
    __nihil_klock_held {
        __nihil_syscall([73, __nihil_klock_fd, 8]);                                        // LOCK_UN
        __nihil_klock_held = false;
    }
}

__nihil_key_put(path = "", r = 0, schema = [0], names = "", model = "", kf = 0) {
    __nihil_key_lock(path);
    __nihil_key_put_now(path, r, schema, names, model, kf);
    __nihil_key_unlock();
}

__nihil_key_put_auto(path = "", r = 0, schema = [0], names = "", model = "", kf = 0) {
    __nihil_key_lock(path);                         // the counter too: two programs never take one number
    __nihil_key_put_auto_now(path, r, schema, names, model, kf);
    __nihil_key_unlock();
}

__nihil_key_write_at(i = 0, path = "", r = 0, schema = [0], names = "", model = "", kf = 0) {
    __nihil_key_lock(path);
    __nihil_key_write_at_now(i, path, r, schema, names, model, kf);
    __nihil_key_unlock();
}

__nihil_key_delete(k = 0, path = "", schema = [0], names = "", model = "", kf = 0, opt = false) {
    __nihil_key_lock(path);
    __nihil_key_delete_now(k, path, schema, names, model, kf, opt);
    __nihil_key_unlock();
}

// NAME @{k} path / NAME @?{k} path → the record's address, or 0 (= _)
__nihil_key_get(k = 0, path = "", schema = [0], names = "", model = "", kf = 0, opt = false) {
    __nihil_klock_held { __nihil_key_unlock(); }    // left by a caught failure
    __size = __nihil_key_stat(path);                // one stat: the size, the stamp, the table open
    __size < 0 {
        opt { : 0; }
        __nihil_fail("could not read '" + path + "'");
    }
    __ty = schema[1 + kf * 2];
    __key = __nihil_key_value(k, __ty);
    __o = __nihil_key_find(__key, path, __size, __nihil_kt_stamp, schema, names, model, kf);
    __o < 0 {
        opt { : 0; }
        __q = __key;
        __ty == 3 { __q = "\"" + __key + "\""; }
        __nihil_fail("'" + path + "' has no " + model + " with " + __nihil_word(names, kf) + " = " + __q);
    }
    : __nihil_rec_parse(__nihil_kf_line, 0, schema, names, path, __o + 1);   // the line key_find read
}

// @{}>> path, r : replaces the record with r's key, or adds r at the end
__nihil_key_put_now(path = "", r = 0, schema = [0], names = "", model = "", kf = 0) {
    __text = __nihil_rec_text(r, schema, names, model);   // a value that does not fit stops here
    __key = __nihil_key_value(__nihil_arr_at(r)[kf], schema[1 + kf * 2]);
