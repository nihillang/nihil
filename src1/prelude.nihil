// the hash of a key straight from the line, when its text there is already the key's text
// (__nihil_key_at's): an INT written as plain digits with no leading zero (or a lone 0), a sign
// only before a digit that is not 0; a STRING without spaces at its end. 0 when it is not so
// (then the caller takes the key's text the long way).
__nihil_key_hash_at(text = "", a = 0, width = 0, int = false) {
    __b = a + width;
