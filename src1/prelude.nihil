// closes the table and the index kept open
__nihil_key_forget() {
    __nihil_kt_fd >= 0 { __nihil_syscall([3, __nihil_kt_fd]); }
    __nihil_ki_fd >= 0 { __nihil_syscall([3, __nihil_ki_fd]); }
    __nihil_kt_path = "";
    __nihil_kt_fd = -1;
    __nihil_ki_path = "";
    __nihil_ki_fd = -1;
}

// text written at an offset of path, through fd when it can write (-1: no), synced if sync: as the
// runtime's __nihil_pwrite / __nihil_pwrite_ns, which it falls back on (and which reports a failure)
__nihil_key_write(path = "", fd = -1, at = 0, text = "", sync = true) {
    fd >= 0 && __nihil_syscall([18, fd, __nihil_addr(text), #text, at]) == #text {     // pwrite64
        !sync || __nihil_syscall([74, fd]) == 0 { :; }                                  // fsync
    }
