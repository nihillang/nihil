        __nihil_kt_cpath = path + "\0";
        __nihil_kt_cof = path;
    }
    __p = __nihil_kt_cpath;
    #__nihil_kt_sbuf != 144 { __nihil_kt_sbuf = __nihil_bytes(144); }
    __b = __nihil_kt_sbuf;                          // read at once below: one buffer serves
    __nihil_syscall([262, -100, __nihil_addr(__p), __nihil_addr(__b), 0]) < 0 {   // newfstatat
        __nihil_kt_path == path { __nihil_key_forget(); }
        : -1;
