// the key field of a line (at a, width w) is key: compared in place when its text there is already
// the key's text (as __nihil_key_hash_at checks it), else through __nihil_key_at
__nihil_key_same(t = "", a = 0, w = 0, int = false, key = "", schema = [0], names = "", path = "", line = 0, kf = 0) {
    __b = a + w;
    __s = a;
    int { * __s < __b && t[__s] == ' ' { __s = __s + 1; } }
    * __b > __s && t[__b - 1] == ' ' { __b = __b - 1; }
    __plain = true;
    int {
        __d = __s;
        __d < __b && t[__d] == '-' { __d = __d + 1; }
        __d == __b || (t[__d] == '0' && (__b - __d > 1 || __d > __s)) { __plain = false; }
        __k = __d;
        * __plain && __k < __b {
            t[__k] < '0' || t[__k] > '9' { __plain = false; }
            __k = __k + 1;
        }
    }
