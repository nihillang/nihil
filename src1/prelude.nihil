// the index's header after a write by key: one stat of the table (its size and stamp), written
// through the index's fd; then the index is known to match the table (key_find reads no header)
__nihil_key_note(path = "") {
    __size = __nihil_key_stat(path);
    __size < 0 { :; }
    __ifd = -1;
    __nihil_ki_path == path && __nihil_ki_rw { __ifd = __nihil_ki_fd; }
    __nihil_key_write(path + ".nihil-idx", __ifd, 0, __nihil_le(__size, 8) + __nihil_le(__nihil_kt_stamp, 8), false);
    __nihil_kc_path == path {
        __nihil_kc_size = __size;
        __nihil_kc_stamp = __nihil_kt_stamp;
    }
}

// n bytes at an offset of an open file, or "" if they are not all there
__nihil_key_pread(fd = 0, at = 0, n = 0) {
    __b = __nihil_bytes(n);
    __nihil_syscall([17, fd, __nihil_addr(__b), n, at]) != n { : ""; }        // pread64
    : __b;
}

// slot j of the index (0 = empty)
__nihil_key_slot(idx = "", j = 0) {
    __p = __nihil_pread(idx, 16 + j * 4, 4);
    __p == 0 { : 0; }
    __s = __nihil_str_at(__p);
    #__s != 4 { : 0; }
    : __nihil_le_at(__s, 0, 4);
}

// where the key is: [record number or -1, its slot (or the empty one where it
// would go), the capacity]. Every slot found is checked against the record.
// where the key is: its record number, or -1; __nihil_kf_j is its slot (or the empty one where it
// would go) and __nihil_kf_c the capacity. Every slot found is checked against the record. The slots
// and lines are read into reused buffers and the key compared in place, so a lookup allocates nothing
// here (the record found is left in __nihil_kf_line, which the next lookup reuses).
__nihil_key_find(key = "", path = "", size = 0, stamp = 0, schema = [0], names = "", model = "", kf = 0) {
