        __d = a;
        text[__d] == '-' { __d = __d + 1; }
        __d == __b || (text[__d] == '0' && (__b - __d > 1 || __d > a)) { : 0; }
        __k = __d;
        * __k < __b {
            text[__k] < '0' || text[__k] > '9' { : 0; }
            __k = __k + 1;
