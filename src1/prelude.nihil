    __c == 0 { __c = __nihil_key_current(__idx, size, stamp); }
    __c == 0 { __c = __nihil_key_rebuild(path, size, stamp, schema, names, model, kf); }
    __nihil_kc_path = path;
    __nihil_kc_size = size;
    __nihil_kc_stamp = stamp;
