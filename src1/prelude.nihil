    // works; when chdir or execve fails the child writes a byte to it first, and the parent
    // gives _ (before, it gave a process that ended with 127: ["/"].run() was 127)
    __eb = __nihil_bytes(8);
    __nihil_syscall([293, __nihil_addr(__eb), 0x80000]) < 0 {
        __nihil_syscall([3, __rd]); __nihil_syscall([3, __wr]);
        __ofd >= 0 { __nihil_syscall([3, __ofd]); }
        __efd >= 0 && __efd != __ofd { __nihil_syscall([3, __efd]); }
        : _;
    }
    __er = __nihil_u32_at(__eb, 0);
    __ew = __nihil_u32_at(__eb, 4);
    __dfl = [0, 0, 0, 0];                                                 // sigaction: SIG_DFL
    __ign = [1, 0, 0, 0];                                                 // SIG_IGN
    ... 0;                                                                // the output so far goes out first
    __pid = __nihil_syscall([57]);                                        // fork
    __pid == 0 {
        __nihil_syscall([33, __rd, 0]);                                   // dup2: the pipe is its input
        __ofd >= 0 { __nihil_syscall([33, __ofd, 1]); }
        __efd >= 0 { __nihil_syscall([33, __efd, 2]); }
        #dir > 0 && __nihil_syscall([80, __nihil_addr(__dirz)]) < 0 {    // chdir
            __nihil_start_failed(__ew);
        }
        __nihil_syscall([13, 13, __nihil_addr(__dfl), 0, 8]);             // SIGPIPE back to the default
        __nihil_syscall([436, 3, __ew - 1, 0]);                           // close_range: nothing else leaks,
        __nihil_syscall([436, __ew + 1, 4294967295, 0]);                  // but the pipe that says it started
        __nihil_syscall([59, __nihil_addr(__progz), __nihil_addr(__argv), __nihil_addr(__envp)]);    // execve
        __nihil_start_failed(__ew);                                       // it did not start
    }
    __nihil_syscall([3, __ew]);
    __started = true;
    __pid >= 0 {
        __one = __nihil_bytes(8);
        __got = -4;
        * __got == -4 { __got = __nihil_syscall([0, __er, __nihil_addr(__one), 1]); }   // read (again after EINTR)
        __got > 0 { __started = false; }
    }
    __nihil_syscall([3, __er]);
    !__started {                                                          // the child ended: reaped here
        __st2 = __nihil_bytes(8);
        __w2 = -4;
        * __w2 == -4 { __w2 = __nihil_syscall([61, __pid, __nihil_addr(__st2), 0, 0]); }   // wait4 (again after EINTR)
        __nihil_syscall([3, __rd]); __nihil_syscall([3, __wr]);
        __ofd >= 0 { __nihil_syscall([3, __ofd]); }
        __efd >= 0 && __efd != __ofd { __nihil_syscall([3, __efd]); }
        : _;
    }
    __nihil_syscall([3, __rd]);
    __ofd >= 0 { __nihil_syscall([3, __ofd]); }
    __efd >= 0 && __efd != __ofd { __nihil_syscall([3, __efd]); }
    __pid < 0 { __nihil_syscall([3, __wr]); : _; }
    __nihil_syscall([13, 13, __nihil_addr(__ign), 0, 8]);                 // a child that closes its input must not stop us
    : __pid * 65536 + __wr;
}

// in the child, when chdir or execve failed: one byte to the parent (again after EINTR), then exit 127
__nihil_start_failed(fd = 0) {
    __r = -4;
    * __r == -4 { __r = __nihil_syscall([1, fd, __nihil_addr("!"), 1]); }
    __nihil_syscall([231, 127]);
}

// cmd.run() → INT?: runs it with this program's output and waits; its exit code (_ if it
// could not start)
__nihil_as_run(cmd = [""]) {
    __p? = __nihil_as_start(cmd, "", "", "");
    __p == _ { : _; }
    __pp = __p || 0;
    __nihil_i_close_input(__pp);
    : __nihil_i_wait(__pp);
}

// p.write(text) → BOOL: all of text went to the process's input (false: it closed it)
__nihil_i_write(p = 0, t = "") {
    __fd = p % 65536;
    __base = __nihil_addr(t);
    __o = 0;
    * __o < #t {
        __r = __nihil_syscall([1, __fd, __base + __o, #t - __o]);
        __r == -4 { __r = 0; }                                            // EINTR: again
        __r < 0 { : false; }
        __o = __o + __r;
    }
    : true;
}

// p.close_input(): the process sees the end of its input
__nihil_i_close_input(p = 0) {
    __nihil_syscall([3, p % 65536]);
}

// the exit code from a wait4 status: the code, or 128 + the signal that ended it
__nihil_exit_code(st = 0) {
    st & 0x7F == 0 { : (st >> 8) & 0xFF; }
    : 128 + (st & 0x7F);
}

// p.done() → INT?: the exit code if the process has finished (given once), _ while it runs
__nihil_i_done(p = 0) {
    __b = __nihil_bytes(8);
    __r = __nihil_syscall([61, p / 65536, __nihil_addr(__b), 1, 0]);    // wait4(WNOHANG)
    __r != p / 65536 { : _; }
    : __nihil_exit_code(__nihil_u32_at(__b, 0));
}

// p.wait() → INT: waits for the process to finish; its exit code (-1 if it was already seen)
__nihil_i_wait(p = 0) {
    __b = __nihil_bytes(8);
    __out? = 0;
    __out = _;
    * __out == _ {
        __r = __nihil_syscall([61, p / 65536, __nihil_addr(__b), 0, 0]);
        __r == p / 65536 { __out = __nihil_exit_code(__nihil_u32_at(__b, 0)); }
        || __r != -4 { __out = -1; }
    }
    : __out || -1;
}

// p.kill() → BOOL: the process was told to stop at once (SIGKILL)
__nihil_i_kill(p = 0) {
    : __nihil_syscall([62, p / 65536, 9]) == 0;
}
