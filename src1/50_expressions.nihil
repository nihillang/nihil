// =============================================================================
// Expressions — each method emits the code that leaves the value in rax and returns
// the TYPE of the value
// =============================================================================

is_bool(t = 0) {
    : t == TYPE_BOOL || t == TYPE_UNKNOWN;
}

is_element(t = 0) {
    : t == TYPE_INT || t == TYPE_BOOL || t == TYPE_STR || t == TYPE_FLOAT || t == TYPE_UNKNOWN || is_rec(t);
}

// An ARRAY of BOOL holds one byte per element (SPEC §2): its block is a text's. bool_array_of: rax,
// an ARRAY of words 0 or 1 → the same as bytes; bool_array_made: -native marks it (header bit 4,
// as a text's) so the collector does not look inside it
bool_array_of() {
    op_push(R_AX);
    call_prelude("__nihil_ab_of", 8);
    bool_array_made();
}

bool_array_made() {
    arm_native { op_sti(R_AX, -16, 4, 0); }
}

// cmp rax, 0 ; jl → the jump, to patch
op_jcc_after_cmp0() {
    op_cmpi(R_AX, 0);
    : op_jcc(CC_L);
}

expression() {
    : expr_or();
}

// or ::= and ( "||" and )*      — BOOL, short-circuit
expr_or() {
    t = expr_and();
    * tok_type == T_OR {
        pi = tok_start; pl = tok_len; pn = tok_line; pli = tok_lstart;
        is_opt(t) {
            // fallback: the value of t if present, otherwise the right one
            next_token();
            op_test(R_DX);               // test rdx, rdx
            jump_at = size_code;
            pos = op_jcc(CC_NE);           // jnz end
            after = size_code;
            u = expr_and();
            b = base_opt(t);
            r = 0;
            u == b && load_simple(after) >= 0 {
                // no jump: mov rcx, fallback ; cmovz rax, rcx
                simple_to_rcx(after, jump_at);
                op_cmov(CC_E, R_AX, R_CX);     // cmovz rax, rcx
                label_drop(pos);
                pos = -1;
                r = b;
            } || u == b || u == TYPE_UNKNOWN {
                r = b;
            } || u == t || u == TYPE_ABSENT {
                r = t;
            } || {
                restore_pos(pi, pl, pn, pli);
                error_start();
                put_str("the fallback value of '||' for ");
                put_type(t);
                put_str(" must be ");
                put_type(b);
                put_str(" or ");
                put_type(t);
                put_str(", but it is ");
                put_type(u);
                error_end();
            }
            pos >= 0 { patch_here(pos); }
            t = r;
        } || {
            // logical OR, with short-circuit
            !is_bool(t) { error_op_types(pi, pl, pn, pli, t, 0); }
            next_token();
            op_test(R_AX); pos = op_jcc(CC_NE);   // test rax, rax ; jnz end
            u = expr_and();
            or_unknown = t == TYPE_UNKNOWN && !is_bool(u);
            or_unknown {
                u = TYPE_BOOL;                  // may be a fallback: decided in the next pass
            }
            !is_bool(u) { error_op_types(pi, pl, pn, pli, t, u); }
            t = TYPE_BOOL;
            or_unknown { t = TYPE_UNKNOWN; }    // so nothing locks BOOL from it
            patch_here(pos);
        }
    }
    : t;
}

// and ::= comp ( "&&" comp )*  — BOOL, short-circuit
expr_and() {
    t = binary(0);
    * tok_type == T_AND {
        pi = tok_start; pl = tok_len; pn = tok_line; pli = tok_lstart;
        !is_bool(t) { error_op_types(pi, pl, pn, pli, t, 0); }
        next_token();
        op_test(R_AX); pos = op_jcc(CC_E);   // test rax, rax ; jz end
        u = binary(0);
        !is_bool(u) { error_op_types(pi, pl, pn, pli, t, u); }
        t = TYPE_BOOL;
        patch_here(pos);
    }
    : t;
}

// operator of the level (0 = comparisons … 6 = * / %), or -1. The id is the token.
find_op(nv = 0, t = 0) {
    nv == 0 {
        t == T_EQ || t == T_NE || t == '<' || t == '>' || t == T_LE || t == T_GE { : t; }
        : -1;
    }
    nv == 1 { t == '|' { : t; } : -1; }
    nv == 2 { t == '^' { : t; } : -1; }
    nv == 3 { t == '&' { : t; } : -1; }
    nv == 4 { t == T_SHL || t == T_SHR { : t; } : -1; }
    nv == 5 { t == '+' || t == '-' { : t; } : -1; }
    nv == 6 { t == '*' || t == '/' || t == '%' { : t; } : -1; }
    : -1;
}

mode_op(t = 0) {
    t == T_EQ || t == T_NE { : MODE_EQUAL; }
    t == '<' || t == '>' || t == T_LE || t == T_GE { : MODE_ORDER; }
    : MODE_INT;
}

// left in rax, right in rcx
emit_op(t = 0) {
    t == T_EQ { op_cmp_set(CC_E); }
    || t == T_NE { op_cmp_set(CC_NE); }
    || t == '<' { op_cmp_set(CC_L); }
    || t == '>' { op_cmp_set(CC_G); }
    || t == T_LE { op_cmp_set(CC_LE); }
    || t == T_GE { op_cmp_set(CC_GE); }
    || t == '|' { op_alu(ALU_OR, R_AX, R_CX); }
    || t == '^' { op_alu(ALU_XOR, R_AX, R_CX); }
    || t == '&' { op_alu(ALU_AND, R_AX, R_CX); }
    || t == T_SHL { op_shl(R_AX); }
    || t == T_SHR { op_sar(R_AX); }
    || t == '+' { op_alu(ALU_ADD, R_AX, R_CX); }
    || t == '-' { op_alu(ALU_SUB, R_AX, R_CX); }
    || t == '*' { op_mul(R_AX, R_CX); }
    || t == '/' { emit_call_rt(RT_DIV); }
    || t == '%' { emit_call_rt(RT_MOD); }
}

// FLOAT × FLOAT (rax, rcx = bits): SSE2 in xmm0, xmm1 → type of the result
emit_op_float(op = 0, pi = 0, pl = 0, pn = 0, pli = 0) {
    op == '%' || op == '|' || op == '^' || op == '&' || op == T_SHL || op == T_SHR {
        error_op_types(pi, pl, pn, pli, TYPE_FLOAT, TYPE_FLOAT);
    }
    op_xmov(0, R_AX);       // movq xmm0, rax
    op_xmov(1, R_CX);       // movq xmm1, rcx
    op == '+' || op == '-' || op == '*' || op == '/' {
        op == '+' { op_xop(XOP_ADD, 0, 1); }       // addsd
        || op == '-' { op_xop(XOP_SUB, 0, 1); }    // subsd
        || op == '*' { op_xop(XOP_MUL, 0, 1); }    // mulsd
        || { op_xop(XOP_DIV, 0, 1); }              // divsd
        op_rmovx(R_AX, 0);   // movq rax, xmm0
        : TYPE_FLOAT;
    }
    op_fcmp_set(op);                      // comparisons (NaN: only != is true)
    : TYPE_BOOL;
}

// the code at a … is one load of a constant or of a local in a register (rbx, r12 … r15, which
// the runtime and every method keep, and which only this method changes) → its length, else 0.
// Not a global (a method the right side calls may change it), and not a local in memory: there
// the processor runs push … pop faster than a late load (measured). → its place in the ring, or -1.
left_late(a = 0) {
    i = load_simple(a);
    i < 0 { : -1; }
    op_k[i] == OP_IMM { : i; }
    op_k[i] == OP_REG && (op_v[i] == 3 || op_v[i] >= 12) { : i; }
    : -1;
}

// the code from a on is the call emit_call_rt(rt) made at a
is_call_rt(a = 0, rt = 0) {
    a < 0 { : false; }
    i = op_last_at(a);
    : i >= 0 && op_k[i] == OP_CALL_RT && op_v[i] == rt;
}

// binary: level 0 … 6; from 7 on it becomes unary
binary(nv = 0) {
    nv >= 7 { : unary(); }
    ls = size_code;
    t = binary(nv + 1);
    op = find_op(nv, tok_type);
    * op >= 0 {
        pi = tok_start; pl = tok_len; pn = tok_line; pli = tok_lstart;
        nv == 0 && (op == T_EQ || op == T_NE) && peek_type() == T_UNDERSCORE {
            // x == _  /  x != _  — tests for presence
            !is_opt(t) && t != TYPE_UNKNOWN {
                restore_pos(pi, pl, pn, pli);
                error_start();
                put_str("only optionals can be compared with '_', but the expression is ");
                put_type(t);
                error_end();
            }
            next_token();
            next_token();
            op_test(R_DX);               // test rdx, rdx
            op == T_EQ {
                op_setcc(CC_E, R_AX); op_zxb(R_AX);   // sete al ; movzx eax, al
            } || {
                op_setcc(CC_NE, R_AX); op_zxb(R_AX);  // setne al ; movzx eax, al
            }
            t = TYPE_BOOL;
            op = find_op(nv, tok_type);
            op >= 0 { error("comparisons cannot be chained (use '&&')"); }
            : t;
        }
        next_token();
        // the left side is a constant or a local (which only this method can change: the right
        // side cannot, whatever it calls): it is loaded after the right side, without the stack
        li = left_late(ls);
        late = li >= 0;
        lk = 0;                            // its operation, kept in this call: the right side
        lv = 0;                            // compiles other binary operations
        late {
            lk = op_k[li];
            lv = op_v[li];
            code_cut(ls);
        }
        pos_push = size_code;
        !late { op_push(R_AX); }              // push rax
        after_push = size_code;
        u = binary(nv + 1);
        // "…" + $n: the $ (the right side's last code, a call to RT_INT_TEXT) is dropped and the
        // two go to RT_CONCAT_INT together, which writes the digits straight into the result
        fused = false;
        lc = op_last_start();
        optimize && t == TYPE_STR && op == '+' && u == TYPE_STR && last_int_text == size_code
            && lc >= 0 && is_call_rt(lc, RT_INT_TEXT)
            && last_target <= lc && (n_fix == 0 || fix_pos[n_fix - 1] < lc) {
            code_cut(lc);
            fused = true;
        }
        ri = -1;
        late { ri = load_simple(pos_push); }
        ri >= 0 {
            // both simple: the left one into rax, then the right one into rcx, in this order (as
            // x = x + 1 is recognized by increment, and as the processor runs it fastest)
            rk = op_k[ri];
            rv = op_v[ri];
            code_cut(pos_push);
            op_load(lk, R_AX, lv);
            op_load(rk, R_CX, rv);
        } || late {
            op_load(OP_REG, R_CX, R_AX);    // mov rcx, rax ; the left one into rax
            op_load(lk, R_AX, lv);
        } || load_simple(after_push) >= 0 {
            // the right side is a simple load: load it straight into rcx
            simple_to_rcx(after_push, pos_push);
        } || {
            op_mov(R_CX, R_AX); op_pop(R_AX);     // mov rcx, rax ; pop rax
        }
        mode = mode_op(op);
        r = 0;
        t == TYPE_NONE || u == TYPE_NONE { error_op_types(pi, pl, pn, pli, t, u); }
        t == TYPE_UNKNOWN || u == TYPE_UNKNOWN {
            // one side has no type yet: a comparison gives BOOL; the rest stays
            // provisional (it may be INT, FLOAT or STRING)
            r = TYPE_UNKNOWN;
            mode == MODE_EQUAL || mode == MODE_ORDER { r = TYPE_BOOL; }
            emit_op(op);
        } || t == TYPE_FLOAT && u == TYPE_FLOAT {
            r = emit_op_float(op, pi, pl, pn, pli);
        } || t == TYPE_STR && u == TYPE_STR && op == '+' {
            fused { emit_call_rt(RT_CONCAT_INT); } || { emit_call_rt(RT_CONCAT); }   // STRING + STRING
            r = TYPE_STR;
        } || op == '+' && t == u && t == TYPE_ARR | TYPE_BOOL {
            emit_call_rt(RT_CONCAT);       // ARRAY of BOOL: bytes, as a STRING's
            r = t;
        } || op == '+' && t == u && t & TYPE_ARR != 0 && !is_opt(t) {
            emit_call_rt(RT_ARRAY_CONCAT); // ARRAY + ARRAY of the same type: a new one
            r = t;
        } || mode == MODE_EQUAL {
            t != u || t & (TYPE_ARR | TYPE_REC | TYPE_MAP) != 0 || is_opt(t) || t == TYPE_ABSENT { error_op_types(pi, pl, pn, pli, t, u); }
            r = TYPE_BOOL;
            t == TYPE_STR {
                emit_call_rt(RT_STR_EQUAL);        // STRING: compares the contents
                op == T_NE { op_notb(R_AX); }
            } || {
                emit_op(op);
            }
        } || {
            t != TYPE_INT || u != TYPE_INT { error_op_types(pi, pl, pn, pli, t, u); }
            r = TYPE_INT;
            mode == MODE_ORDER { r = TYPE_BOOL; }
            emit_op(op);
        }
        t = r;
        op = find_op(nv, tok_type);
        nv == 0 && op >= 0 { error("comparisons cannot be chained (use '&&')"); }
    }
    : t;
}

// unario ::= ( "-" | "!" | "~" | "#" | "@" | "@?" | "$" | "." ) unario | posfixo
unary() {
    t = tok_type;
    t == '-' || t == '!' || t == '~' || t == '#' || t == '@' || t == '$' || t == T_AT_OPT || t == '.' {
        pi = tok_start; pl = tok_len; pn = tok_line; pli = tok_lstart;
        next_token();
        u = unary();
        ok = u == TYPE_UNKNOWN;
        t == '#' && u & TYPE_ARR != 0 && !is_opt(u) { ok = true; }
        t == '#' && (is_map(u) || is_list(u)) {
            op_ld(R_AX, R_AX, 0, 0);           // mov rax, [rax]: the count, first word of the map (or list)
            : TYPE_INT;
        }
        t == T_AT_OPT {
            !ok && u != TYPE_STR { error_op_types(pi, pl, pn, pli, u, 0); }
            emit_call_rt(RT_READ_FILE_OPT);   // @? path → STRING? (_ if it does not open)
            op_zero(R_DX); op_test(R_AX); op_setcc(CC_NE, R_DX);   // xor edx,edx ; test rax,rax ; setne dl
            : TYPE_STR | TYPE_OPT;
        }
        t == '-' && u == TYPE_FLOAT {
            op_fneg(R_AX);   // btc rax, 63 (flips the sign)
            : TYPE_FLOAT;
        }
        t == '.' {
            !ok && u != TYPE_INT { error_op_types(pi, pl, pn, pli, u, 0); }
            op_i2f(0, R_AX);   // cvtsi2sd xmm0, rax
            op_rmovx(R_AX, 0);   // movq rax, xmm0
            : TYPE_FLOAT;
        }
        t == '#' && u == TYPE_FLOAT {
            op_xmov(0, R_AX);   // movq xmm0, rax
            op_f2i(R_AX, 0);   // cvttsd2si rax, xmm0 (trunca)
            : TYPE_INT;
        }
        t == '-' {
            !ok && u != TYPE_INT { error_op_types(pi, pl, pn, pli, u, 0); }
            op_neg(R_AX);           // neg rax
            : TYPE_INT;
        }
        t == '!' {
            !ok && u != TYPE_BOOL { error_op_types(pi, pl, pn, pli, u, 0); }
            op_notb(R_AX);           // xor eax, 1
            : TYPE_BOOL;
        }
        t == '~' {
            !ok && u != TYPE_INT { error_op_types(pi, pl, pn, pli, u, 0); }
            op_not(R_AX);           // not rax
            : TYPE_INT;
        }
        t == '@' {
            !ok && u != TYPE_STR { error_op_types(pi, pl, pn, pli, u, 0); }
            emit_call_rt(RT_READ_FILE);   // @ path → contents of the file
            : TYPE_STR;
        }
        t == '$' && (is_rec(u) || is_rec_array(u)) {
            emit_rec_text(u);             // $ record → its line; $ rows → the table
            : TYPE_STR;
        }
        t == '$' && u == TYPE_INT {
            emit_call_rt(RT_INT_TEXT);    // $ n → its decimal text
            last_int_text = size_code;
            : TYPE_STR;
        }
        t == '$' && u == TYPE_FLOAT {
            op_push(R_AX);
            call_prelude("__nihil_ft_text", 8);   // $ x → the shortest text that reads back as x
            : TYPE_STR;
        }
        t == '$' && u == TYPE_BOOL {
            op_mov(R_DX, R_AX);           // mov rdx, rax
            op_lea_const(R_AX, bool_text(true));           // lea rax, [rip + "true"]
            op_lea_const(R_CX, bool_text(false));           // lea rcx, [rip + "false"]
            op_test(R_DX); op_cmov(CC_E, R_AX, R_CX);   // test rdx, rdx ; cmovz rax, rcx
            : TYPE_STR;
        }
        t == '$' {
            !ok && u != (TYPE_ARR | TYPE_INT) { error_op_types(pi, pl, pn, pli, u, 0); }
            emit_call_rt(RT_TEXT);        // $ bytes → STRING
            : TYPE_STR;
        }
        !ok && u != TYPE_STR { error_op_types(pi, pl, pn, pli, u, 0); }
        op_ld(R_AX, R_AX, -8, 0);         // mov rax, [rax-8]
        : TYPE_INT;
    }
    : postfix();
}

// ---- protected calls (SPEC §25) ----------------------------------------------------
// tok = "?": ?! (the last caught error's text) or ?call(…). The runtime keeps where to resume
// (the code right after the call) with the stack and the registers; a runtime error inside the
// call goes back there with rax = rdx = 0 (_), and the call that ends normally empties ?!.
protected_expr() {
    peek_type() == '!' {
        next_token();                    // "?" → "!"
        next_token();
        emit_call_rt(RT_ERR_TEXT);
        : TYPE_STR;
    }
    pi = tok_start; pl = tok_len; pn = tok_line; pli = tok_lstart;
    next_token();                        // "?" → the call
    resume_pos = op_lea_fwd(R_AX);       // lea rax, [rip + resume]
    emit_call_rt(RT_PROTECT);
    start = size_code;
    t = postfix();
    call_end != size_code || size_code == start {
        restore_pos(pi, pl, pn, pli);
        error("'?' goes before a call");
    }
    emit_call_rt(RT_UNPROTECT);
    t != TYPE_NONE && t != TYPE_UNKNOWN && !is_opt(t) { op_load(OP_IMM, R_DX, 1); }   // mov edx, 1
    patch_to_here(resume_pos);
    last_target = size_code;             // the runtime lands here
    call_end = size_code;                // may stand alone as a command, like a call
    t == TYPE_NONE || t == TYPE_UNKNOWN { : t; }
    : t | TYPE_OPT;
}

// __nihil_fail_rt(message): a runtime error (the prelude's errors), which ?f() catches
fail_intrinsic() {
    next_token();                        // name → "("
    next_token();
    expression();
    emit_call_rt(RT_FAIL);
    call_end = size_code;
    expect(')', "')'");
    : TYPE_NONE;
}

// record.name(…) through a model some descendants replace name in (SPEC §20.10): the receiver,
// pushed first, is read back from under the arguments; the model in its block header (m + 1, the
// top 16 bits) picks the call; anything else (k's own models, a record with no model) calls k.
// Only compares, direct calls and jumps (what the macOS translator takes); every branch ends at
// one place, where the caller removes the arguments.
emit_dispatch(k = 0, base = 0, np = 0, dn = 0, dm = [0], dt = [0]) {
    a = 0;
    j = 1;
    np { j < np { a = a + size_param(base + j); } j = j + 1; }
    op_ld(R_AX, R_SP, a, 1);                // mov rax, [rsp + a]: the receiver
    op_ld(R_CX, R_AX, -16, 0);              // mov rcx, [rax - 16]
    op_shri(R_CX, 48);                      // shr rcx, 48: its model + 1
    jumps = [0 ; dn];
    j = 0;
    * j < dn {
        op_cmpi(R_CX, dm[j] + 1);           // cmp rcx, model + 1
        jumps[j] = op_jcc(CC_E);            // je its call
        j = j + 1;
    }
    op_call_method(k);                      // call k: every other model
    ends = [0 ; dn + 1];
    ends[0] = op_jmp();                     // jmp done
    j = 0;
    * j < dn {
        patch_here(jumps[j]);
        note_call(dt[j]);
        op_call_method(dt[j]);              // call the method of model dm[j]
        ends[j + 1] = op_jmp();
        j = j + 1;
    }
    j = 0;
    * j <= dn { patch_here(ends[j]); j = j + 1; }
}

// tok = a model's name: is it "NAME() ; *" (list: an empty LIST) or "NAME() ;" (else: the value of
// an empty MAP {k: NAME() ; n}) with NAME abstract (SPEC §20.11)? Then the record only gives the
// type: nothing is made (rax = 0, the sample the literal drops) and the type is returned; else -1,
// the lexer untouched
type_only_record(list = false) {
    tok_type != T_IDENT { : -1; }
    k = lookup(tok_start, tok_len);
    !is_model(k) || missing_method(s_extra[k]) < 0 { : -1; }
    save_lexer();
    next_token();
    ok = tok_type == '(';
    ok { next_token(); ok = tok_type == ')'; }
    ok { next_token(); ok = tok_type == ';'; }
    ok && list { next_token(); ok = tok_type == '*'; }
    back_lexer();
    drop_lexer();
    !ok { : -1; }
    next_token();                        // name → "("
    next_token();                        // "(" → ")"
    next_token();                        // ")" → ";"
    op_zero(R_AX);                          // xor eax, eax: no record
    : model_type(s_extra[k]);
}

// postfix ::= primary ( "[" expression "]" | "." field )*
postfix() {
    : postfix_rest(primary(), false);
}

// stop: halts before a final ". field =" (the target of a field assignment)
postfix_rest(t = 0, stop = false) {
    going = true;
    * going {
        tok_type == '.' {
            stop && field_then_equals() { : t; }
            library_ahead() { t = library_call(t); } || { t = field_access(t); }
        } || tok_type != '[' {
            going = false;
        } || {
            t = index_step(t);
        }
    }
    : t;
}

// tok = "[" after a value of type t (in rax) → the element; returns its type
index_step(t = 0) {
    is_map(t) { : map_get(t); }
    is_list(t) { : list_get(t); }
    target_ok = t == TYPE_STR || t == TYPE_UNKNOWN || t & TYPE_ARR != 0 && !is_opt(t);
    !target_ok {
        error_start();
        put_str("only ARRAY and STRING can be indexed, but the expression is ");
        put_type(t);
        error_end();
    }
    pos_push = size_code;
    op_push(R_AX);                        // push rax
    after_push = size_code;
    next_token();
    u = expression();
    u != TYPE_INT && u != TYPE_UNKNOWN {
        error_start();
        put_str("the index must be INT, but it is ");
        put_type(u);
        error_end();
    }
    expect(']', "']'");
    load_simple(after_push) >= 0 {
        simple_to_rcx(after_push, pos_push);    // a simple index: straight into rcx, no stack
    } || {
        op_mov(R_CX, R_AX); op_pop(R_AX);     // mov rcx, rax ; pop rax
    }
    emit_check_limit();
    t == TYPE_STR {
        op_ldbx(R_AX, R_AX, R_CX);     // movzx eax, byte [rax + rcx]
        t = TYPE_INT;
    } || t == TYPE_ARR | TYPE_BOOL {
        op_ldbx(R_AX, R_AX, R_CX);     // movzx eax, byte [rax + rcx]: one byte each
        t = TYPE_BOOL;
    } || {
        op_ldx(R_AX, R_AX, R_CX);     // mov rax, [rax + rcx*8]
        t = t & ~TYPE_ARR;
    }
    : t;
}

primary() {
    t = tok_type;
    t == '?' { : protected_expr(); }
    t == T_INT {
        emit_immediate(tok_value);
        next_token();
        : TYPE_INT;
    }
    t == T_FLOAT {
        emit_immediate(tok_value);          // the bits of the double
        next_token();
        : TYPE_FLOAT;
    }
    t == T_TRUE {
        op_load(OP_IMM, R_AX, 1);           // mov eax, 1
        next_token();
        : TYPE_BOOL;
    }
    t == T_FALSE {
        op_zero(R_AX);                     // xor eax, eax
        next_token();
        : TYPE_BOOL;
    }
    t == T_STR {
        op_lea_const(R_AX, tok_value);               // lea rax, [rip + rel32]
        next_token();
        : TYPE_STR;
    }
    t == T_IDENT { : primary_name(); }
    t == '(' {
        next_token();
        u = expression();
        expect(')', "')'");
        : u;
    }
    t == T_UNDERSCORE {
        op_zero(R_AX); op_zero(R_DX);         // xor eax, eax ; xor edx, edx
        next_token();
        : TYPE_ABSENT;
    }
    t == '[' { : primary_array(); }
    t == '{' { : map_literal(); }
    error_expected("an expression");
    : 0;
}

primary_name() {
    pi = tok_start; pl = tok_len; pn = tok_line; pli = tok_lstart;
    q_model >= 0 {
        qt = query_field();                // inside rows.where(…): a field of the element
        qt >= 0 { : qt; }
    }
    k = lookup(tok_start, tok_len);
    e = peek_type();
    e == '(' {
        k < 0 && name_is(pi, pl, "__nihil_addr") { : intrinsic(TYPE_INT); }
        k < 0 && name_is(pi, pl, "__nihil_str_at") { : intrinsic(TYPE_STR); }
        k < 0 && name_is(pi, pl, "__nihil_arr_at") { : intrinsic(TYPE_ARR | TYPE_INT); }
        k < 0 && name_is(pi, pl, "__nihil_fsize") { : file_intrinsic(1); }
        k < 0 && name_is(pi, pl, "__nihil_fstamp") { : file_intrinsic(2); }
        k < 0 && name_is(pi, pl, "__nihil_pread") { : file_intrinsic(3); }
        k < 0 && name_is(pi, pl, "__nihil_pwrite") { : file_intrinsic(4); }
        k < 0 && name_is(pi, pl, "__nihil_pwrite_ns") { : file_intrinsic(5); }
        k < 0 && name_is(pi, pl, "__nihil_truncate") { : file_intrinsic(6); }
        k < 0 && name_is(pi, pl, "__nihil_truncate_ns") { : file_intrinsic(7); }
        k < 0 && name_is(pi, pl, "__nihil_listen") { : net_intrinsic(1); }
        k < 0 && name_is(pi, pl, "__nihil_accept") { : net_intrinsic(2); }
        k < 0 && name_is(pi, pl, "__nihil_fd_read") { : net_intrinsic(3); }
        k < 0 && name_is(pi, pl, "__nihil_fd_send") { : net_intrinsic(4); }
        k < 0 && name_is(pi, pl, "__nihil_fd_close") { : net_intrinsic(5); }
        k < 0 && name_is(pi, pl, "__nihil_connect") { : net_intrinsic(6); }
        k < 0 && name_is(pi, pl, "__nihil_syscall") { : syscall_intrinsic(); }
        k < 0 && name_is(pi, pl, "__nihil_json_end_rt") { : json_intrinsic(1); }
        k < 0 && name_is(pi, pl, "__nihil_lines_rt") { : json_intrinsic(2); }
        k < 0 && name_is(pi, pl, "__nihil_rec_parse_rt") { : copy_intrinsic(3); }
        k < 0 && name_is(pi, pl, "__nihil_sub_rt") { : copy_intrinsic(1); }
        k < 0 && name_is(pi, pl, "__nihil_put_rt") { : copy_intrinsic(2); }
        k < 0 && name_is(pi, pl, "__nihil_bytes") { : bytes_intrinsic(1); }
        k < 0 && name_is(pi, pl, "__nihil_poke") { : bytes_intrinsic(2); }
        k < 0 && name_is(pi, pl, "__nihil_fail_rt") { : fail_intrinsic(); }
        k < 0 && name_is(pi, pl, "__nihil_peek") { : peek_intrinsic(); }
        k < 0 && name_is(pi, pl, "__nihil_peekb") { : peekb_intrinsic(); }
        k < 0 && name_is(pi, pl, "__nihil_prefetch") { : prefetch_intrinsic(); }
        k < 0 && name_is(pi, pl, "__nihil_poke8") { : poke8_intrinsic(); }
        k < 0 && name_is(pi, pl, "__nihil_c") { : ccall_intrinsic(false); }
        k < 0 && name_is(pi, pl, "__nihil_c32") { : ccall_intrinsic(true); }
        k < 0 && name_is(pi, pl, "__nihil_cvar") { : ccall_intrinsic(false); }
        k < 0 && name_is(pi, pl, "__nihil_set_model") { : model_intrinsic(1); }
        k < 0 && name_is(pi, pl, "__nihil_model_of") { : model_intrinsic(2); }
        k < 0 && name_is(pi, pl, "tools") { : tools_text(); }
        k < 0 && name_is(pi, pl, "call_tool") { : call_tool_call(); }
        is_model(k) { : new_record(k); }
        : call_method(k);
    }
    is_model(k) {
        e == '@' || e == T_AT_OPT { : table_read(k); }
        e == '.' { : model_from_json(k); }
        error_start();
        put_str("'");
        put_source(pi, pl);
        put_str("' is a data model: create a record with ");
        put_source(pi, pl);
        put_str("(…) or read a table with ");
        put_source(pi, pl);
        put_str(" @ \"file\"");
        error_end();
    }
    k < 0 {
        restore_pos(pi, pl, pn, pli);
        error_start();
        put_str("variable '");
        put_source(pi, pl);
        put_str("' does not exist");
        error_end();
    }
    s_flags[k] & FLAG_METHOD != 0 {
        restore_pos(pi, pl, pn, pli);
        error_start();
        put_str("'");
        put_source(pi, pl);
        put_str("' is a method; call it as '");
        put_source(pi, pl);
        put_str("(…)'");
        error_end();
    }
    next_token();
    s_flags[k] & FLAG_GLOBAL != 0 {
        method_current >= 0 {
            s_type[k] == 0 {
                emit_load_var(k);
                : global_unknown(k);
            }
        } || s_flags[k] & FLAG_CREATED == 0 {
            // top level: only after the creation in the text
            restore_pos(pi, pl, pn, pli);
            error_start();
            put_str("variable '");
            put_source(pi, pl);
            put_str("' does not exist here yet (it is created on line ");
            put_line(s_extra[k]);
            put_str(")");
            error_end();
        }
    }
    emit_load_var(k);
    s_type[k] == 0 { : TYPE_UNKNOWN; }        // created with a provisional value
    : s_type[k];
}

// a global used in a method before its type is known
global_unknown(k = 0) {
    final_pass {
        error_start();
        put_str("could not find out the type of the global '");
        put_name_method(k);
        put_str("'");
        error_end();
    }
    unknowns = unknowns + 1;
    : TYPE_UNKNOWN;
}

primary_array() {
    next_token();
    tok_type == ']' { error("'[]' has no type; for an empty array use [0 ; 0]"); }
    pi = tok_start; pl = tok_len; pn = tok_line; pli = tok_lstart;
    t = type_only_record(true);            // [NAME() ; *] of an abstract model: only the type
    t < 0 { t = expression(); }
    !is_element(t) {
        restore_pos(pi, pl, pn, pli);
        error_start();
        put_str("array elements must be INT, BOOL, STRING, FLOAT or records (arrays of arrays are not supported yet), but this one is ");
        put_type(t);
        error_end();
    }
    tok_type == ';' {
        // [value ; n]
        op_push(R_AX);
        next_token();
        tok_type == '*' { : list_literal(t); }   // [value ; *]: an empty LIST (SPEC §28)
        pi = tok_start; pl = tok_len; pn = tok_line; pli = tok_lstart;
        u = expression();
        u != TYPE_INT && u != TYPE_UNKNOWN {
            restore_pos(pi, pl, pn, pli);
            error_start();
            put_str("the size in [value ; size] must be INT, but it is ");
            put_type(u);
            error_end();
        }
        is_rec(t) {
            // [record ; n]: n independent copies of the record
            refuse_abstract(t >> 8, "no copies of it are made ([NAME() ; *] is an empty LIST of it)");
            op_push(R_AX);
            push_const(m_schema[t >> 8]);
            call_prelude("__nihil_rec_rep", 24);
        } || t == TYPE_BOOL {
            // [b ; n] of BOOL: one byte each (SPEC §2), in (n + 8) / 8 words filled with b in each
            // byte (the runtime's [x ; n]), then its length n and the 0 after the last; a negative
            // n goes to the runtime as it is (its error)
            op_mov(R_CX, R_AX);                       // mov rcx, rax
            p_neg = op_jcc_after_cmp0();              // cmp rax, 0 ; jl …
            op_lea(R_CX, R_AX, 8, 0);                 // lea rcx, [rax + 8]
            op_shri(R_CX, 3);                         // shr rcx, 3
            patch_here(p_neg);
            op_pop(R_DX);                             // pop rdx (b: 0 or 1)
            op_push(R_AX);                            // push rax (n)
            op_load(OP_IMM, R_AX, 0x0101010101010101); // mov rax, imm64
            op_mul(R_DX, R_AX);                       // imul rdx, rax
            emit_call_rt(RT_ARRAY_REP);
            op_pop(R_CX); op_st(R_AX, -8, R_CX, 0);   // pop rcx ; mov [rax - 8], rcx
            op_load(OP_IMM, R_DX, 0);
            op_stbx(R_AX, R_CX, R_DX);                // mov [rax + rcx], dl
            bool_array_made();
        } || {
            op_mov(R_CX, R_AX); op_pop(R_DX);     // mov rcx, rax ; pop rdx
            emit_call_rt(RT_ARRAY_REP);
            // -native: an array of FLOAT holds no address, so the collector does not look inside
            // it (its header's bit 4, as a text's; a new block's header is 0). Not INT: the
            // prelude keeps addresses in INT arrays (__nihil_addr: rows, maps)
            arm_native && t == TYPE_FLOAT { op_sti(R_AX, -16, 4, 0); }
        }
        expect(']', "']' (in [value ; size])");
    } || {
        // [a, b, c]: pushes the values, allocates, pops from the last to the first
        op_push(R_AX);
        n = 1;
        * tok_type == ',' {
            next_token();
            pi = tok_start; pl = tok_len; pn = tok_line; pli = tok_lstart;
            u = expression();
            u != t && u != TYPE_UNKNOWN && t != TYPE_UNKNOWN {
                restore_pos(pi, pl, pn, pli);
                error_start();
                put_str("all array elements must be ");
                put_type(t);
                put_str(", but this one is ");
                put_type(u);
                error_end();
            }
            op_push(R_AX);
            n = n + 1;
        }
        expect(']', "']'");
        t == TYPE_BOOL {
            // [a, b] of BOOL: one byte each, in zeroed words (a text's block: its length, a 0 after)
            op_load(OP_IMM, R_CX, (n + 8) / 8);       // mov ecx, words
            emit_call_rt(RT_ALLOC);
            op_sti(R_AX, -8, n, 0);                   // mov qword [rax - 8], n
            r = n;
            * r > 0 {
                r = r - 1;
                op_pop(R_CX); op_load(OP_IMM, R_DX, r); op_stbx(R_AX, R_DX, R_CX);   // pop rcx ; mov edx, r ; mov [rax + rdx], cl
            }
            bool_array_made();
            : t | TYPE_ARR;
        }
        op_load(OP_IMM, R_CX, n);                        // mov ecx, n
        
        emit_call_rt(RT_ALLOC);
        r = n;
        * r > 0 {
            r = r - 1;
            op_pop(R_CX); op_st(R_AX, r * 8, R_CX, 1);     // pop rcx ; mov [rax + disp32], rcx
        }
    }
    t == TYPE_UNKNOWN { : t; }
    : t | TYPE_ARR;
}

// -----------------------------------------------------------------------------
// call_method: k = symbol of the name (or -1); tok = name, followed by "(".
// Pushes the arguments from left to right (the omitted ones get their
// default), calls and removes the arguments. Returns the return type.
call_method(k = 0, pre = 0) {
    pi = tok_start; pl = tok_len; pn = tok_line; pli = tok_lstart;
    // a dispatch table from model_method_call, taken now: the arguments may hold calls of their own
    dn = disp_n;
    disp_n = 0;
    dm = [0 ; dn];
    dt = [0 ; dn];
    j = 0;
    * j < dn { dm[j] = disp_model[j]; dt[j] = disp_target[j]; j = j + 1; }
    k < 0 {
        restore_pos(pi, pl, pn, pli);
        error_start();
        put_str("method '");
        put_source(pi, pl);
        put_str("' does not exist");
        level == 0 {
            put_str(" (to declare one, every parameter needs a default value: ");
            put_source(pi, pl);
            put_str("(x = 0) { … })");
        }
        error_end();
    }
    s_flags[k] & FLAG_METHOD == 0 {
        restore_pos(pi, pl, pn, pli);
        error_start();
        put_str("'");
        put_source(pi, pl);
        put_str("' is not a method");
        error_end();
    }
    next_token();
    next_token();
    np = s_nparam[k];
    base = s_extra[k];
    i = pre;                             // pre: arguments already pushed (v.name(…) passes v)
    * tok_type != ')' {
        i >= np {
            error_start();
            put_str("'");
            put_name_method(k);
            put_str("' takes ");
            put_num(np - pre);
            put_str(" parameter(s), but the call passes more");
            error_end();
        }
        ai = tok_start; al = tok_len; an = tok_line; ali = tok_lstart;
        u = expression();
        pt = p_type[base + i];
        !convert_argument(u, pt) {
            restore_pos(ai, al, an, ali);
            error_start();
            put_str("argument ");
            put_num(i + 1 - pre);
            put_str(" of '");
            put_name_method(k);
            put_str("' must be ");
            put_type(pt);
            put_str(", but it is ");
            put_type(u);
            error_end();
        }
        is_opt(pt) { op_push(R_DX); }         // push rdx (presence)
        op_push(R_AX);                        // push rax
        i = i + 1;
        tok_type == ',' {
            next_token();
            tok_type == ')' { error_expected("an expression"); }
        } || tok_type != ')' {
            error_expected("',' or ')'");
        }
    }
    // defaults of the omitted ones
    * i < np {
        e = base + i;
        p_type[e] & TYPE_ARR != 0 {
            // ARRAY: a new one-element array on every call
            op_load(OP_IMM, R_CX, 1);           // mov ecx, 1
            emit_call_rt(RT_ALLOC);
            op_push(R_AX);
            emit_default(e);
            op_ld(R_CX, R_SP, 0, 0); op_st(R_CX, 0, R_AX, 0); op_pop(R_AX);   // mov rcx,[rsp] ; mov [rcx],rax ; pop rax
        } || {
            emit_default(e);
        }
        is_opt(p_type[e]) {
            op_load(OP_IMM, R_DX, 1);           // mov edx, 1 (the default is present)
            op_push(R_DX);                    // push rdx
        }
        op_push(R_AX);
        i = i + 1;
    }
    next_token();                        // consome ")"
    note_call(k);
    dn == 0 {
        op_call_method(k);                 // call method (patched at the end of the pass)
    } || {
        emit_dispatch(k, base, np, dn, dm, dt);
    }
    np > 0 {
        total = 0;
        j = 0;
        np { total = total + size_param(base + j); j = j + 1; }
        op_stack(total, 1);               // add rsp, size of the arguments
        
    }
    call_end = size_code;
    r = s_type[k];
    r == 0 {
        // return type not known yet (body not seen, or dependent)
        final_pass {
            restore_pos(pi, pl, pn, pli);
            error_start();
            put_str("could not find out what '");
            put_name_method(k);
            put_str("' returns: every ':' in it depends on calls that have no type yet");
            error_end();
        }
        unknowns = unknowns + 1;
        : TYPE_UNKNOWN;
    }
    : r;
}

emit_default(e = 0) {
    b = p_type[e] & ~(TYPE_ARR | TYPE_OPT);
    b & TYPE_REC != 0 {
        refuse_abstract(b >> 8, "its default here would make one, so pass this argument");
        emit_alloc_record(b >> 8);        // NAME(): a new empty record on every call
        :;
    }
    is_map(b) {
        emit_new_map(b);                  // {k: v}: a new empty map on every call
        :;
    }
    is_list(b) {
        emit_new_list();                  // [x ; *]: a new empty list on every call
        :;
    }
    b == TYPE_STR {
        op_lea_const(R_AX, p_default[e]);               // lea rax, [rip + string]
    } || {
        emit_immediate(p_default[e]);
    }
}
