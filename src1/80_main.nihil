// =============================================================================
// Main program: loads the source, compiles in passes and writes the ELF
// =============================================================================

// -profile: the symbols the executable writes with its samples, a line each, "start end name"
// (addresses, decimal): the runtime's routines, each method of this pass and the top level
// (the rest of the program's code, around the methods)
profile_symbols() {
    base = BASE_CODE + SIZE_HEADER;
    const_init();
    i = 0;
    start = 0;
    w = 0;
    n = #runtime_sym_names;
    * i <= n {
        i == n || runtime_sym_names[i] == ' ' {
            const_put_num(base + runtime_sym_ofs[w]);
            const_put_byte(' ');
            w + 1 < #runtime_sym_ofs { const_put_num(base + runtime_sym_ofs[w + 1]); } || { const_put_num(base + #runtime_bin); }
            const_put_byte(' ');
            j = start;
            * j < i { const_put_byte(runtime_sym_names[j]); j = j + 1; }
            const_put_byte(10);
            w = w + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    k = 0;
    * k < n_sym {
        s_flags[k] & FLAG_METHOD != 0 && s_skip[k] == 0 && s_end[k] > 0 && s_mend[k] > s_end[k] {
            const_put_num(BASE_CODE + s_end[k]);
            const_put_byte(' ');
            const_put_num(BASE_CODE + s_mend[k]);
            const_put_byte(' ');
            const_put_source(s_ofs[k], s_len[k]);
            const_put_byte(10);
        }
        k = k + 1;
    }
    const_put_num(base + #runtime_bin);
    const_put_byte(' ');
    const_put_num(BASE_CODE + size_code);
    const_put_str(" (top level)");
    const_put_byte(10);
    register_fixup(pos_profile, const_close(), false);
}

const_put_num(v = 0) {
    v == 0 { const_put_byte('0'); :; }
    d = [0 ; 20];
    c = 0;
    * v > 0 { d[c] = v % 10; v = v / 10; c = c + 1; }
    * c > 0 { c = c - 1; const_put_byte('0' + d[c]); }
}

compile() {
    prescan();
    const_base = size_const;
    n_sym_base = n_sym;
    done = false;
    * !done {
        n_passes = n_passes + 1;
        n_passes > 1000 { error("types did not settle after 1000 passes"); }
        one_pass();
        globals_learn();
        g_redo {                           // this pass kept a global a method uses: not final
            g_redo = false;
            altered = true;
            final_pass = false;
        }
        !final_pass { prune_prelude(); }
        final_pass || unknowns == 0 && !altered {
            done = true;                   // final, or nothing provisional: it already counts as final
        } || !discovered {
            final_pass = true;           // nothing left to discover: the next one is strict
        }
    }
}

// a global that may be kept at the top level: a plain variable (not optional, not a method or model)
top_candidate(i = 0) {
    f = s_flags[i];
    : f & FLAG_GLOBAL != 0 && f & (FLAG_METHOD | FLAG_OPT | FLAG_MODEL | FLAG_PARAM) == 0;
}

// at the start of a pass: each global back at its address, then the ones no method used in the
// previous pass into a register (g_reg) or a slot of the top level's frame
globals_place() {
    i = 0;
    n_sym_base {
        top_candidate(i) {
            g_addr[i] == 0 { g_addr[i] = s_end[i]; }
            s_end[i] = g_addr[i];
            s_flags[i] = s_flags[i] & ~(FLAG_TOP | FLAG_REG);
            optimize && n_passes > 1 && !g_meth[i] {
                g_reg[i] != 0 {
                    s_flags[i] = s_flags[i] | FLAG_TOP | FLAG_REG;
                    s_end[i] = g_reg[i];
                } || {
                    s_flags[i] = s_flags[i] | FLAG_TOP;
                    s_end[i] = new_slot();
                }
            }
            g_meth_cur[i] = false;
            g_w[i] = 0;
        }
        i = i + 1;
    }
}

// at the end of a pass: which globals the methods used, and which of the others get registers
globals_learn() {
    !optimize { :; }
    i = 0;
    n_sym_base {
        top_candidate(i) && g_meth_cur[i] != g_meth[i] {
            g_meth[i] = g_meth_cur[i];
            altered = true;
        }
        i = i + 1;
    }
    // the 5 heaviest of the others get rbx, r12 … r15 (in that order); none when the top level has
    // a protected block ?{ … } (cmd_protected_block)
    j = 0;
    prot_at_top { j = 5; }
    last = -1;
    lastw = 0;
    taken = [0 ; 5];
    q = 0;
    5 { taken[q] = -1; q = q + 1; }
    * j < 5 {
        best = -1;
        bw = 0;
        i = 0;
        n_sym_base {
            top_candidate(i) && !g_meth[i] && g_w[i] > 0 {
                w = g_w[i];
                free = true;
                q = 0;
                * q < j { taken[q] == i { free = false; } q = q + 1; }
                free && w > bw { best = i; bw = w; }
            }
            i = i + 1;
        }
        best < 0 { j = 5; } || { taken[j] = best; j = j + 1; }
    }
    i = 0;
    n_sym_base {
        top_candidate(i) {
            r = 0;
            q = 0;
            * q < 5 { taken[q] == i { r = REGS[q]; } q = q + 1; }
            r != g_reg[i] {
                g_reg[i] = r;
                altered = true;
            }
        }
        i = i + 1;
    }
}

// compiles the whole program from scratch (code, constants and fixups are
// redone; types discovered for methods and globals persist)
one_pass() {
    size_code = 0;
    prot_at_top = false;
    prot_depth = 0;
    n_fix = 0;
    last_target = -1;
    slots = 0;
    max_slots = 0;
    level = 0;
    method_current = -1;
    unknowns = 0;
    discovered = false;
    altered = false;
    n_calls = 0;
    last_int_text = -1;
    size_const = const_base;
    n_sym = n_sym_base;
    i = 0;
    n_sym {                                // no global has been created yet
        s_flags[i] = s_flags[i] & ~FLAG_CREATED;
        i = i + 1;
    }
    const_init();                         // "" to initialize STRING/ARRAY globals
    const_empty = const_close();
    globals_place();

    emit_header();
    i = 0;
    #runtime_bin { emit(runtime_bin[i]); i = i + 1; }
    put_d(SIZE_HEADER + 1, size_code - (SIZE_HEADER + 5));   // jmp programa

    // top-level frame: push rbp ; mov rbp, rsp ; sub rsp, imm32 (patched at the end)
    eb(0x55, 0x48, 0x89, 0xE5, 0x48, 0x81, 0xEC);
    pos_frame = size_code;
    emit_d(0);
    emit(0xE8);                            // call inicializa_globais
    pos_init = size_code;
    emit_d(0);
    want_profile {
        eb(0x48, 0x8D, 0x05);               // lea rax, [rip + symbols] (made at the end of the pass)
        pos_profile = size_code;
        emit_d(0);
        emit_call_rt(RT_PROF_START);
    }

    init_lexer();
    next_token();
    * tok_type != T_END { command(); }

    put_d(pos_frame, (max_slots * 8 + 15) & -16);
    eb(0x31, 0xFF);                         // xor edi, edi
    emit_call_rt(RT_EXIT);

    // inicializa_globals: every STRING or ARRAY global starts empty
    patch_here(pos_init);
    i = 0;
    n_sym_base {
        s_flags[i] & FLAG_TOP != 0 {
            // kept at the top level: created by its first assignment, before any read
        } || s_flags[i] & FLAG_GLOBAL != 0 && (s_type[i] == TYPE_STR || s_type[i] & TYPE_ARR != 0) {
            eb(0x48, 0x8D, 0x05);           // lea rax, [rip + ""]
            register_fixup(size_code, const_empty, false);
            emit_d(0);
            emit_store_global(s_end[i]);
        }
        s_flags[i] & FLAG_TOP == 0 && s_flags[i] & FLAG_GLOBAL != 0 && is_map(s_type[i]) {
            emit_new_map(s_type[i]);           // a MAP global starts as an empty map
            emit_store_global(s_end[i]);
        }
        s_flags[i] & FLAG_TOP == 0 && s_flags[i] & FLAG_GLOBAL != 0 && is_list(s_type[i]) {
            emit_new_list();                   // a LIST global starts as an empty list
            emit_store_global(s_end[i]);
        }
        s_flags[i] & FLAG_TOP == 0 && s_flags[i] & FLAG_GLOBAL != 0 && is_rec(s_type[i]) {
            emit_alloc_record(s_type[i] >> 8);    // a record global starts as an empty record
            emit_store_global(s_end[i]);
        }
        i = i + 1;
    }
    emit(0xC3);                            // ret
    want_profile { profile_symbols(); }
    emit_constantes();
    close_elf();
}

// once the types settled: a method that replaces an inherited one (SPEC §20.10) returns the same
// type, so a call through the parent gets what it expects whichever model's runs; checked also for
// a replacement no call reaches
check_replacements() {
    k = 0;
    * k < n_sym_base {
        s_flags[k] & FLAG_METHOD != 0 {
            d = 0;
            * d < s_len[k] && source[s_ofs[k] + d] != '.' { d = d + 1; }
            km = -1;
            d < s_len[k] { km = lookup(s_ofs[k], d); }
            km >= 0 && is_model(km) {
                ns = s_ofs[k] + d + 1;
                nl = s_len[k] - d - 1;
                p = m_parent[s_extra[km]];
                ko = -1;
                * ko < 0 && p >= 0 { ko = lookup_model_method(m_sym[p], ns, nl); p = m_parent[p]; }
                ko >= 0 && s_type[k] != s_type[ko] {
                    msg_len = 0;
                    put_str("nihilc: ");
                    put_source(s_ofs[k], s_len[k]);
                    put_str(" returns ");
                    put_type(s_type[k]);
                    put_str(", but the method it replaces, ");
                    put_source(s_ofs[ko], s_len[ko]);
                    put_str(", returns ");
                    put_type(s_type[ko]);
                    put_str(": a replacement returns the same type");
                    error_end();
                }
            }
        }
        k = k + 1;
    }
}

load_program();
compile();
check_replacements();
// -map: the runtime ends after the header and its block, the program's code at code_end, the
// constants follow (8-aligned) up to the end of the file
// (written with the message buffer: stage 0, which builds this compiler, has no $ for INT)
want_map {
    msg_len = 0;
    put_str("nihil-map "); put_num(SIZE_HEADER + #runtime_bin);
    put_byte(' '); put_num(code_end);
    put_byte(' '); put_num(size_code);
    put_byte(10);
    map_line = [0 ; msg_len];
    i_map = 0;
    msg_len { map_line[i_map] = msg[i_map]; i_map = i_map + 1; }
    !>> $map_line;
}
output_byte = 0;
size_code {
    >>> code[output_byte];
    output_byte = output_byte + 1;
}
