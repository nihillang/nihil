// =============================================================================
// 48_library — value.name(…): the library (SPEC §21). The methods are written
// in Nihil in the prelude, as __nihil_s_* (STRING), __nihil_ai_* (ARRAY of
// INT), __nihil_af_* (FLOAT) and __nihil_as_* (STRING); the value goes as the
// first argument. The names exist only after a ".", so they take no name away
// from the program.
// =============================================================================

// the constant "true" or "false" (for $b)
bool_text(b = false) {
    const_init();
    b { const_put_str("true"); } || { const_put_str("false"); }
    : const_close();
}

// tok = "." : is it ". name (" (a library call) rather than a field?
library_ahead() {
    save_lexer();
    next_token();
    r = tok_type == T_IDENT;
    r {
        next_token();
        r = tok_type == '(';
    }
    back_lexer();
    drop_lexer();
    : r;
}

// the prelude method for value type t and the name at s (n bytes); "" if none
lib_target(t = 0, s = 0, n = 0) {
    t == TYPE_STR {
        name_is(s, n, "find") { : "__nihil_s_find"; }
        name_is(s, n, "contains") { : "__nihil_s_has"; }
        name_is(s, n, "starts_with") { : "__nihil_s_starts"; }
        name_is(s, n, "ends_with") { : "__nihil_s_ends"; }
        name_is(s, n, "has") { : "__nihil_s_has"; }          // older names, kept as synonyms
        name_is(s, n, "starts") { : "__nihil_s_starts"; }
        name_is(s, n, "ends") { : "__nihil_s_ends"; }
        name_is(s, n, "slice") { : "__nihil_s_slice"; }
        name_is(s, n, "split") { : "__nihil_s_split"; }
        name_is(s, n, "replace") { : "__nihil_s_replace"; }
        name_is(s, n, "trim") { : "__nihil_s_trim"; }
        name_is(s, n, "upper") { : "__nihil_s_upper"; }
        name_is(s, n, "lower") { : "__nihil_s_lower"; }
        name_is(s, n, "repeat") { : "__nihil_s_repeat"; }
        name_is(s, n, "int") { : "__nihil_s_int"; }
        name_is(s, n, "float") { : "__nihil_s_float"; }
        name_is(s, n, "json") { : "__nihil_s_json"; }
        name_is(s, n, "json_items") { : "__nihil_s_json_items"; }
        name_is(s, n, "json_keys") { : "__nihil_s_json_keys"; }
        name_is(s, n, "json_values") { : "__nihil_s_json_values"; }
        name_is(s, n, "json_text") { : "__nihil_s_json_text"; }
        name_is(s, n, "json_quote") { : "__nihil_s_json_quote"; }
        name_is(s, n, "http_method") { : "__nihil_s_http_method"; }
        name_is(s, n, "http_path") { : "__nihil_s_http_path"; }
        name_is(s, n, "http_param") { : "__nihil_s_http_param"; }
        name_is(s, n, "http_header") { : "__nihil_s_http_header"; }
        name_is(s, n, "http_status") { : "__nihil_s_http_status"; }
        name_is(s, n, "http_get") { : "__nihil_s_http_get"; }
        name_is(s, n, "http_post") { : "__nihil_s_http_post"; }
        name_is(s, n, "http_request") { : "__nihil_s_http_request"; }
        name_is(s, n, "http_open") { : "__nihil_s_http_open"; }
        name_is(s, n, "connect") { : "__nihil_s_connect"; }
        name_is(s, n, "http_host_is_local") { : "__nihil_s_http_host_is_local"; }
        name_is(s, n, "http_body") { : "__nihil_s_http_body"; }
        name_is(s, n, "url_decode") { : "__nihil_s_url_decode"; }
        name_is(s, n, "list") { : "__nihil_s_list"; }              // paths (SPEC §24)
        name_is(s, n, "is_dir") { : "__nihil_s_is_dir"; }
        name_is(s, n, "is_file") { : "__nihil_s_is_file"; }
        name_is(s, n, "make_dir") { : "__nihil_s_make_dir"; }
        name_is(s, n, "remove") { : "__nihil_s_remove"; }
        name_is(s, n, "read_from") { : "__nihil_s_read_from"; }
        name_is(s, n, "size") { : "__nihil_s_size"; }
        : "";
    }
    t == TYPE_INT {                      // a port or a connection (SPEC §23)
        name_is(s, n, "listen") { : "__nihil_i_listen"; }
        name_is(s, n, "listen_all") { : "__nihil_i_listen_all"; }
        name_is(s, n, "accept") { : "__nihil_i_accept"; }
        name_is(s, n, "receive") { : "__nihil_i_receive"; }
        name_is(s, n, "read") { : "__nihil_i_read"; }
        name_is(s, n, "send") { : "__nihil_i_send"; }
        name_is(s, n, "respond") { : "__nihil_i_respond"; }
        name_is(s, n, "close") { : "__nihil_i_close"; }
        name_is(s, n, "write") { : "__nihil_i_write"; }            // a process (SPEC §24)
        name_is(s, n, "close_input") { : "__nihil_i_close_input"; }
        name_is(s, n, "done") { : "__nihil_i_done"; }
        name_is(s, n, "wait") { : "__nihil_i_wait"; }
        name_is(s, n, "kill") { : "__nihil_i_kill"; }
        : "";
    }
    t == TYPE_ARR | TYPE_INT {
        name_is(s, n, "sort") { : "__nihil_ai_sort"; }
        name_is(s, n, "find") { : "__nihil_ai_find"; }
        name_is(s, n, "contains") { : "__nihil_ai_has"; }
        name_is(s, n, "has") { : "__nihil_ai_has"; }        // older name, kept as a synonym
        name_is(s, n, "reverse") { : "__nihil_ai_reverse"; }
        name_is(s, n, "sum") { : "__nihil_ai_sum"; }
        name_is(s, n, "min") { : "__nihil_ai_min"; }
        name_is(s, n, "max") { : "__nihil_ai_max"; }
        : "";
    }
    t == TYPE_ARR | TYPE_FLOAT {
        name_is(s, n, "sort") { : "__nihil_af_sort"; }
        name_is(s, n, "find") { : "__nihil_af_find"; }
        name_is(s, n, "contains") { : "__nihil_af_has"; }
        name_is(s, n, "has") { : "__nihil_af_has"; }        // older name, kept as a synonym
        name_is(s, n, "reverse") { : "__nihil_af_reverse"; }
        name_is(s, n, "sum") { : "__nihil_af_sum"; }
        name_is(s, n, "min") { : "__nihil_af_min"; }
        name_is(s, n, "max") { : "__nihil_af_max"; }
        : "";
    }
    t == TYPE_ARR | TYPE_STR {
        name_is(s, n, "sort") { : "__nihil_as_sort"; }
        name_is(s, n, "find") { : "__nihil_as_find"; }
        name_is(s, n, "contains") { : "__nihil_as_has"; }
        name_is(s, n, "has") { : "__nihil_as_has"; }        // older name, kept as a synonym
        name_is(s, n, "reverse") { : "__nihil_as_reverse"; }
        name_is(s, n, "join") { : "__nihil_as_join"; }
        name_is(s, n, "start") { : "__nihil_as_start"; }          // a command (SPEC §24)
        name_is(s, n, "run") { : "__nihil_as_run"; }
        : "";
    }
    : "";
}

lib_missing(t = 0, s = 0, n = 0) {
    error_start();
    put_type(t);
    t == TYPE_STR {
        put_str(" has no method '");
        put_source(s, n);
        put_str("': it has find, contains, starts_with, ends_with, slice, split, replace, trim, upper, lower, repeat, int, float, json, json_items, json_keys, json_values, json_text, json_quote, http_method, http_path, http_param, http_header, http_host_is_local, http_body, http_status, http_get, http_post, http_request, http_open, connect, url_decode, list, is_dir, is_file, make_dir, remove, read_from and size");
        error_end();
    }
    t == TYPE_INT {
        put_str(" has no method '");
        put_source(s, n);
        put_str("': it has listen, listen_all, accept, receive, read, send, respond and close (a port or a connection), write, close_input, done, wait and kill (a process)");
        error_end();
    }
    t == TYPE_ARR | TYPE_INT || t == TYPE_ARR | TYPE_FLOAT {
        put_str(" has no method '");
        put_source(s, n);
        put_str("': it has sort, find, contains, reverse, sum, min and max");
        error_end();
    }
    t == TYPE_ARR | TYPE_STR {
        put_str(" has no method '");
        put_source(s, n);
        put_str("': it has sort, find, contains, reverse, join, start and run");
        error_end();
    }
    put_str(" has no methods (the library works on STRING and on ARRAY of INT, FLOAT or STRING)");
    error_end();
}

// x.to_json() (SPEC §26), x of type t in rax (and its presence in rdx, for T?): the prelude
// gets the value, its presence, the type as a chain of INTs and the model, if the chain has one
to_json_call(t = 0) {
    next_token();                        // name → "("
    next_token();
    expect(')', "')': .to_json() takes nothing");
    : emit_to_json(t);
}

// the value of type t in rax (rdx) → its JSON text in rax
emit_to_json(t = 0) {
    t == TYPE_UNKNOWN { : TYPE_STR; }
    is_opt(t) { op_push(R_AX); op_push(R_DX); } || { op_push(R_AX); op_pushi(1); }   // push rax ; push rdx (or push 1)
    b = base_opt(t);
    m = -1;
    const_init();
    n = 0;
    going = true;
    * going {
        b & TYPE_ARR != 0 {
            const_put_q(16); n = n + 1;
            b = b & ~TYPE_ARR;
        } || is_map(b) {
            const_put_q(8); const_put_q(map_kind(b)); n = n + 2;
            b = map_val(b);
        } || is_list(b) {
            const_put_q(32); n = n + 1;
            b = list_elem(b);
        } || is_rec(b) {
            const_put_q(64); n = n + 1;
            m = b >> 8;
            going = false;
        } || b == TYPE_INT || b == TYPE_BOOL || b == TYPE_STR || b == TYPE_FLOAT {
            const_put_q(b); n = n + 1;
            going = false;
        } || {
            error_start();
            put_type(t);
            put_str(" cannot be written as JSON");
            error_end();
        }
    }
    put_qword_cst(const_head, n);
    d = const_head + 8;
    push_const(d);
    m >= 0 { push_const(m_schema[m]); push_const(m_names[m]); } || { push_const(d); push_const(d); }
    call_prelude("__nihil_to_json", 40);
    : TYPE_STR;
}

// ---- tools from methods (SPEC §27) ----------------------------------------------

// a STRING constant's length (its bytes start at cst[v])
cst_len(v = 0) {
    n = 0;
    i = 0;
    8 { n = n | (cst[v - 8 + i] << (i * 8)); i = i + 1; }
    : n;
}

// method k's name starts with the prefix (a constant at pv, n bytes) and is longer
tool_named(k = 0, pv = 0, n = 0) {
    s_flags[k] & FLAG_METHOD == 0 || s_len[k] <= n { : false; }
    i = 0;
    * i < n {
        source[s_ofs[k] + i] != cst[pv + i] { : false; }
        i = i + 1;
    }
    : true;
}

// a byte inside a JSON string, escaped
const_put_json_byte(c = 0) {
    c == '"' || c == 92 { const_put_byte(92); const_put_byte(c); :; }
    c == 10 { const_put_str("\\n"); :; }
    c == 9 { const_put_str("\\t"); :; }
    c < 32 { const_put_byte(' '); :; }
    const_put_byte(c);
}

const_put_json_source(start = 0, n = 0) {
    i = 0;
    n { const_put_json_byte(source[start + i]); i = i + 1; }
}

const_put_int(v = 0) {
    v < 0 { const_put_byte('-'); v = -v; }
    v == 0 { const_put_byte('0'); :; }
    dig = [0 ; 24];
    k = 0;
    * v > 0 { dig[k] = '0' + v % 10; v = v / 10; k = k + 1; }
    * k > 0 { k = k - 1; const_put_byte(dig[k]); }
}

// the "//" lines right above method k, joined with spaces
tool_description(k = 0) {
    i = s_ofs[k];
    * i > 0 && source[i - 1] != 10 { i = i - 1; }
    starts = [0 ; 64];
    ends = [0 ; 64];
    n = 0;
    going = true;
    * going && i > 0 && n < 64 {
        e = i - 1;                       // the "\n" before the line below
        b = e;
        * b > 0 && source[b - 1] != 10 { b = b - 1; }
        p = b;
        * p < e && (source[p] == ' ' || source[p] == 9) { p = p + 1; }
        e - p >= 2 && source[p] == '/' && source[p + 1] == '/' {
            p = p + 2;
            * p < e && (source[p] == ' ' || source[p] == 9) { p = p + 1; }
            q = e;
            * q > p && (source[q - 1] == ' ' || source[q - 1] == 9 || source[q - 1] == 13) { q = q - 1; }
            starts[n] = p;
            ends[n] = q;
            n = n + 1;
            i = b;
        } || {
            going = false;
        }
    }
    first = true;
    * n > 0 {
        n = n - 1;
        ends[n] > starts[n] {
            !first { const_put_byte(' '); }
            first = false;
            const_put_json_source(starts[n], ends[n] - starts[n]);
        }
    }
}

// a tool's parameter e of method k: its JSON type, or an error
tool_param_type(k = 0, e = 0) {
    t = p_type[e];
    t == TYPE_INT { : "integer"; }
    t == TYPE_FLOAT { : "number"; }
    t == TYPE_BOOL { : "boolean"; }
    t == TYPE_STR { : "string"; }
    error_start();
    put_str("parameter '");
    put_source(p_start[e], p_len[e]);
    put_str("' of ");
    put_source(s_ofs[k], s_len[k]);
    put_str(" is ");
    put_type(t);
    put_str(": a tool takes INT, FLOAT, BOOL or STRING");
    error_end();
    : "";
}

// the default of parameter e as JSON; a FLOAT goes as byte 1 and 16 hex digits of its bits,
// made into text at run time (__nihil_tools_fix)
const_put_default(e = 0) {
    t = p_type[e];
    v = p_default[e];
    t == TYPE_INT { const_put_int(v); :; }
    t == TYPE_BOOL { v != 0 { const_put_str("true"); } || { const_put_str("false"); } :; }
    t == TYPE_STR {
        const_put_byte('"');
        n = cst_len(v);
        i = 0;
        n { const_put_json_byte(cst[v + i]); i = i + 1; }
        const_put_byte('"');
        :;
    }
    const_put_byte(1);
    i = 15;
    * i >= 0 {
        d = (v >> (i * 4)) & 15;
        d < 10 { const_put_byte('0' + d); } || { const_put_byte('a' + d - 10); }
        i = i - 1;
    }
}

// tok = "(" of tools(…) or call_tool(…) → the prefix (a literal STRING), tok after it
tool_prefix() {
    next_token();
    tok_type != T_STR { error("tools() takes the prefix as a literal text"); }
    : tok_value;
}

// tools("prefix") (SPEC §27): tok = "tools" → a STRING, the JSON array MCP's tools/list wants
tools_text() {
    next_token();                        // name → "("
    pv = tool_prefix();
    pn = cst_len(pv);
    next_token();
    expect(')', "')': tools() takes the prefix");
    const_init();
    const_put_str("[");
    first = true;
    k = 0;
    * k < n_sym {
        tool_named(k, pv, pn) {
            !first { const_put_str(", "); }
            first = false;
            const_put_str("{\"name\": \"");
            const_put_json_source(s_ofs[k] + pn, s_len[k] - pn);
            const_put_str("\", \"description\": \"");
            tool_description(k);
            const_put_str("\", \"inputSchema\": {\"type\": \"object\", \"properties\": {");
            j = 0;
            * j < s_nparam[k] {
                e = s_extra[k] + j;
                ty = tool_param_type(k, e);
                j > 0 { const_put_str(", "); }
                const_put_byte('"');
                const_put_json_source(p_start[e], p_len[e]);
                const_put_str("\": {\"type\": \"");
                const_put_str(ty);
                const_put_str("\", \"default\": ");
                const_put_default(e);
                const_put_str("}");
                j = j + 1;
            }
            const_put_str("}}}");
        }
        k = k + 1;
    }
    const_put_str("]");
    push_const(const_close());
    call_prelude("__nihil_tools_fix", 8);
    : TYPE_STR;
}

// call_tool("prefix", name, arguments) (SPEC §27): tok = "call_tool" → STRING? in rax/rdx.
// The tool's index comes from the prelude; then one branch per tool reads its parameters from
// the JSON object, calls it and makes its result a STRING
call_tool_call() {
    next_token();                        // name → "("
    pv = tool_prefix();
    pn = cst_len(pv);
    next_token();
    expect(',', "',' and the tool's name");
    ai = tok_start; al = tok_len; an = tok_line; ali = tok_lstart;
    u = expression();
    u != TYPE_STR && u != TYPE_UNKNOWN { error_op_types(ai, al, an, ali, u, 0); }
    op_push(R_AX);                          // push rax: the name
    expect(',', "',' and the arguments (a JSON object)");
    ai = tok_start; al = tok_len; an = tok_line; ali = tok_lstart;
    u = expression();
    u != TYPE_STR && u != TYPE_UNKNOWN { error_op_types(ai, al, an, ali, u, 0); }
    expect(')', "')'");
    op_push(R_AX);                          // push rax: the arguments; [rsp] arguments, [rsp+8] name
    // the names, separated by spaces → the index of the one asked for (or -1)
    const_init();
    count = 0;
    k = 0;
    * k < n_sym {
        tool_named(k, pv, pn) {
            count > 0 { const_put_byte(' '); }
            const_put_source(s_ofs[k] + pn, s_len[k] - pn);
            count = count + 1;
        }
        k = k + 1;
    }
    tool_names = const_close();
    push_const(tool_names);
    op_pushm(R_SP, 16, 1);    // push qword [rsp + 16]: the name
    call_prelude("__nihil_tool_index", 16);
    dones = [0 ; count + 1];
    nd = 0;
    i = 0;
    k = 0;
    * k < n_sym {
        tool_named(k, pv, pn) {
            op_cmpi(R_AX, i);   // cmp rax, i
            next_pos = op_jcc(CC_NE);              // jne the next tool
            j = 0;
            * j < s_nparam[k] {
                e = s_extra[k] + j;
                ty = tool_param_type(k, e);
                op_pushm(R_SP, 8 * j, 1);     // push qword [rsp + 8j]: the arguments
                const_init();
                const_put_source(p_start[e], p_len[e]);
                push_const(const_close());
                t = p_type[e];
                t == TYPE_STR {
                    push_const(p_default[e]);
                    call_prelude("__nihil_tool_str", 24);
                } || {
                    op_imm64(R_AX, p_default[e]);   // mov rax, default ; push rax
                    op_push(R_AX);
                    t == TYPE_INT { call_prelude("__nihil_tool_int", 24); }
                    t == TYPE_FLOAT { call_prelude("__nihil_tool_float", 24); }
                    t == TYPE_BOOL { call_prelude("__nihil_tool_bool", 24); }
                }
                op_push(R_AX);
                j = j + 1;
            }
            note_call(k);
            op_call_method(k);
            s_nparam[k] > 0 { op_stack(8 * s_nparam[k], 1);  }
            r = s_type[k];
            r == 0 {
                final_pass {
                    error_start();
                    put_str("could not find out what '");
                    put_name_method(k);
                    put_str("' returns");
                    error_end();
                }
                unknowns = unknowns + 1;
            } || r == TYPE_NONE {
                const_init();
                push_const(const_close());
                op_pop(R_AX);              // pop rax: ""
            } || r != TYPE_STR {
                emit_to_json(r);
            }
            op_load(OP_IMM, R_DX, 1);        // mov edx, 1
            dones[nd] = op_jmp();        // jmp the end
            nd = nd + 1;
            patch_here(next_pos);
            i = i + 1;
        }
        k = k + 1;
    }
    op_zero(R_AX); op_zero(R_DX);          // xor eax, eax ; xor edx, edx: no such tool
    d = 0;
    * d < nd { patch_here(dones[d]); d = d + 1; }
    op_stack(16);            // add rsp, 16
    call_end = size_code;                // a call: ?call_tool(…) protects it
    : TYPE_STR | TYPE_OPT;
}

// tok = "." of value.name(…), with the value (type t) in rax → the result's type
library_call(t = 0) {
    next_token();                        // "." → name
    ns = tok_start; nl = tok_len;
    t == TYPE_UNKNOWN {
        // the value has no type yet: skip the arguments (they may use field
        // names) and decide in the next pass
        sc = size_const;
        next_token();                    // name → "("
        depth = 0;
        going = true;
        * going {
            tok_type == T_END { error_expected("')'"); }
            tok_type == '(' || tok_type == '[' || tok_type == '{' { depth = depth + 1; }
            tok_type == ')' || tok_type == ']' || tok_type == '}' {
                depth = depth - 1;
                depth == 0 { going = false; }
            }
            next_token();
        }
        size_const = sc;
        unknowns = unknowns + 1;
        : TYPE_UNKNOWN;
    }
    is_list(t) && !name_is(ns, nl, "to_json") {
        // a LIST: v.array() copies its items to an ARRAY; every other method is the ARRAY's, on that copy
        op_push(R_AX);
        call_prelude("__nihil_list_array", 8);
        name_is(ns, nl, "array") {
            next_token();                // name → "("
            next_token();
            expect(')', "')': .array() takes nothing");
            : list_elem(t) | TYPE_ARR;
        }
        a = list_elem(t) | TYPE_ARR;
        !is_rec_array(a) && #lib_target(a, ns, nl) == 0 {
            error_start();
            put_type(t);
            put_str(" has no method '");
            put_source(ns, nl);
            put_str("': it has array(), and the methods of ");
            put_type(a);
            put_str(", on a copy of its items");
            error_end();
        }
        t = a;
    }
    name_is(ns, nl, "to_json") { : to_json_call(t); }
    is_rec_array(t) { : query_call(t); }
    is_map(t) { : map_method(t, ns, nl); }
    is_rec(t) { : model_method_call(t, ns, nl); }
    target = lib_target(t, ns, nl);
    #target == 0 { lib_missing(t, ns, nl); }
    k = lookup_text(target);
    k < 0 || s_flags[k] & FLAG_METHOD == 0 { error_general("internal error: the library was not included"); }
    op_push(R_AX);                            // push rax: the value is the first argument
    sv_k = lib_k; sv_s = lib_name_start; sv_l = lib_name_len;
    lib_k = k; lib_name_start = ns; lib_name_len = nl;
    r = call_method(k, 1);
    lib_k = sv_k; lib_name_start = sv_s; lib_name_len = sv_l;
    t == TYPE_STR && name_is(ns, nl, "float") { r = TYPE_FLOAT | TYPE_OPT; }   // the prelude gives the bits
    : r;
}

// record.name(…): the method "MODEL.name" of the record's model (SPEC §20.6), with the record
// as its first argument. Resolved here, at compile time: a plain call.
model_method_call(t = 0, ns = 0, nl = 0) {
    km = m_sym[t >> 8];
    k = lookup_model_method(km, ns, nl);
    p = m_parent[t >> 8];                    // a method a parent declared (SPEC §20.8)
    * k < 0 && p >= 0 { k = lookup_model_method(m_sym[p], ns, nl); p = m_parent[p]; }
    k < 0 {
        error_start();
        put_source(s_ofs[km], s_len[km]);
        put_str(" has no method '");
        put_source(ns, nl);
        put_str("'");
        listed = 0;
        j = 0;
        * j < n_sym {
            s_flags[j] & FLAG_METHOD != 0 && s_len[j] > s_len[km] + 1 && source[s_ofs[j] + s_len[km]] == '.'
                && same_source(s_ofs[j], s_ofs[km], s_len[km]) {
                listed == 0 { put_str(": it has "); } || { put_str(", "); }
                put_source(s_ofs[j] + s_len[km] + 1, s_len[j] - s_len[km] - 1);
                listed = listed + 1;
            }
            j = j + 1;
        }
        listed == 0 {
            put_str(" (declare one: ");
            put_source(s_ofs[km], s_len[km]);
            put_str(".");
            put_source(ns, nl);
            put_str("(self = ");
            put_source(s_ofs[km], s_len[km]);
            put_str("()) { … })");
        }
        error_end();
    }
    op_push(R_AX);                            // push rax: the record is the first argument
    // the descendants of the static model whose own (or nearest inherited) method is not k: the
    // call tests the record's real model for them (SPEC §20.10); none: a plain call, as before
    s = t >> 8;
    dn = 0;
    o = 0;
    * o < n_models {
        descends(o, s) {
            e = o;
            ke = -1;
            * ke < 0 && e != s { ke = lookup_model_method(m_sym[e], ns, nl); e = m_parent[e]; }
            ke >= 0 && ke != k && dn < 1024 { disp_model[dn] = o; disp_target[dn] = ke; dn = dn + 1; }
        }
        o = o + 1;
    }
    disp_n = dn;
    sv_k = lib_k; sv_s = lib_name_start; sv_l = lib_name_len;
    lib_k = k; lib_name_start = ns; lib_name_len = nl;
    r = call_method(k, 1);
    lib_k = sv_k; lib_name_start = sv_s; lib_name_len = sv_l;
    : r;
}

// ---- queries on an ARRAY of records (SPEC §21.1) ---------------------------------
// rows.where(cond), rows.count(cond), rows.first(cond), rows.sort(key),
// rows.sum(expr): the argument is compiled once, inside a loop over the
// elements, with the model's field names standing for the fields of the
// current element. It can use any other name of the program, locals included.

// hidden locals of the loop: [rbp + d] with d from new_slot() (negative), or a register
// (d > 0: rbx, r12 … r15, from take_register, inside a method)
q_load(r = 0, d = 0) {                  // mov rax|rcx|rdx, [rbp + d] / mov rax|rcx|rdx, R  (r: 0, 1, 2)
    d > 0 { op_mov(r, d); :; }
    op_ld(r, R_BP, d, 1);
}

q_store(d = 0) {                        // mov [rbp + d], rax / mov R, rax
    d > 0 { op_mov(d, R_AX); :; }
    op_st(R_BP, d, R_AX, 1);
}

q_zero(d = 0) {                         // mov qword [rbp + d], 0 / mov R, 0
    d > 0 { op_imms(d, 0); :; }
    op_sti(R_BP, d, 0, 1);
}

q_inc(d = 0) {                          // inc qword [rbp + d] / inc R
    d > 0 { op_addi(d, 1); :; }
    op_addim(R_BP, d, 1, 1);
}

// a hidden local of a query: a register if the method has one free, else a frame slot
q_slot() {
    r = take_register();
    r >= 0 { : r; }
    : new_slot();
}

// inside a query: a field name of the current element → its value
query_field() {
    q_model < 0 || peek_type() == '(' { : -1; }
    j = find_field(q_model, tok_start, tok_len);
    j < 0 { : -1; }
    check_private(q_model, m_first[q_model] + j);
    q_load(0, q_elem);
    op_ld(R_AX, R_AX, j * 8, 1);                   // mov rax, [rax + disp32]
    next_token();
    : f_type[m_first[q_model] + j];
}

query_missing(t = 0, s = 0, n = 0) {
    error_start();
    put_type(t);
    put_str(" has no method '");
    put_source(s, n);
    put_str("': it has where, count, first, sort and sum, with an expression of the fields (rows.where(price > 10.0))");
    error_end();
}

// tok = name of rows.name(…), the ARRAY (type t) in rax → the result's type
query_call(t = 0) {
    ns = tok_start; nl = tok_len;
    kind = 0;
    name_is(ns, nl, "where") { kind = 1; }
    name_is(ns, nl, "count") { kind = 2; }
    name_is(ns, nl, "first") { kind = 3; }
    name_is(ns, nl, "sort") { kind = 4; }
    name_is(ns, nl, "sum") { kind = 5; }
    kind == 0 { query_missing(t, ns, nl); }
    m = (t & ~TYPE_ARR) >> 8;
    next_token();                        // name → "("
    next_token();
    tok_type == ')' {
        error_start();
        put_str("'.");
        put_source(ns, nl);
        put_str("' needs an expression of the fields of ");
        put_type(model_type(m));
        put_str(", like rows.");
        put_source(ns, nl);
        kind == 4 || kind == 5 { put_str("(price)"); } || { put_str("(price > 10.0)"); }
        error_end();
    }
    sv_slots = slots;
    sv_regs = n_regs;
    sv_cand = candidates;
    d_el = q_slot();                       // read for every field: the first register
    d_i = q_slot();
    d_arr = q_slot();
    d_n = q_slot();
    d_res = new_slot();
    q_depth = q_depth + 1;
    calls0 = n_calls;
    // the FLOAT sum: in xmm8 (xmm9 for a query inside another one's expression), which neither the
    // generated code (xmm0, xmm1) nor the runtime touches, nor the Mac's (d8, d9: kept by C), as
    // long as the expression calls no method (which might run a query of its own)
    xs = 0;
    kind == 5 && q_depth <= 2 { xs = 7 + q_depth; }
    q_store(d_arr);
    q_zero(d_i);
    q_zero(d_n);
    q_zero(d_res);
    xs > 0 {
        op_xld(xs, d_res);   // movq xmm8|9, [rbp + d_res] (0.0)
    }
    kind == 1 || kind == 4 {
        op_ld(R_CX, R_AX, -8, 0);         // mov rcx, [rax - 8]
        emit_call_rt(RT_ALLOC);            // the result (where) or the keys (sort)
        q_store(d_res);
    }
    align_loop();
    top = label_here();
    last_target = size_code;               // the loop comes back here
    q_load(0, d_i);
    q_load(1, d_arr);
    op_cmpm(R_AX, R_CX, -8, 0);             // cmp rax, [rcx - 8]
    p_end = op_jcc(CC_GE);                         // jge end
    op_ldx(R_AX, R_CX, R_AX);             // mov rax, [rcx + rax*8]
    q_store(d_el);
    sv_m = q_model; sv_e = q_elem;
    q_model = m; q_elem = d_el;
    pi = tok_start; pl = tok_len; pn = tok_line; pli = tok_lstart;
    loop_depth = loop_depth + 1;            // the names it uses run once per element
    u = expression();
    loop_depth = loop_depth - 1;
    q_model = sv_m; q_elem = sv_e;
    p_next = -1;
    p_break = -1;
    kind <= 3 {
        u != TYPE_BOOL && u != TYPE_UNKNOWN { query_type(ns, nl, u, "a BOOL condition", pi, pl, pn, pli); }
        op_test(R_AX); p_next = op_jcc(CC_E);   // test rax, rax ; jz next
        kind == 1 {
            q_load(1, d_res);
            q_load(2, d_n);
            q_load(0, d_el);
            op_stx(R_CX, R_DX, R_AX);     // mov [rcx + rdx*8], rax
            q_inc(d_n);
        }
        kind == 2 { q_inc(d_n); }
        kind == 3 {
            q_load(0, d_el);
            q_store(d_res);
            q_inc(d_n);
            p_break = op_jmp();                    // jmp end: the first one is enough
        }
    }
    kind == 4 {
        u != TYPE_INT && u != TYPE_FLOAT && u != TYPE_STR && u != TYPE_UNKNOWN {
            query_type(ns, nl, u, "an INT, FLOAT or STRING key", pi, pl, pn, pli);
        }
        q_load(1, d_res);
        q_load(2, d_i);
        op_stx(R_CX, R_DX, R_AX);         // mov [rcx + rdx*8], rax (the key)
    }
    kind == 5 {
        u != TYPE_INT && u != TYPE_FLOAT && u != TYPE_UNKNOWN { query_type(ns, nl, u, "an INT or FLOAT", pi, pl, pn, pli); }
        u == TYPE_FLOAT && xs > 0 && n_calls == calls0 {
            op_xmov(1, R_AX);   // movq xmm1, rax
            op_xop(XOP_ADD, xs, 1);   // addsd xmm8|9, xmm1
        } || u == TYPE_FLOAT {
            xs = 0;                         // (the expression calls a method: in memory)
            d_n > 0 {
                q_load(0, d_n);
                op_xmov(0, R_AX);   // movq xmm0, rax
            } || {
                op_xld(0, d_n);     // movq xmm0, [rbp + d_n]
            }
            op_xmov(1, R_AX);   // movq xmm1, rax
            op_xop(XOP_ADD, 0, 1);     // addsd xmm0, xmm1
            op_rmovx(R_AX, 0);   // movq rax, xmm0
            q_store(d_n);
        } || d_n > 0 {
            xs = 0;
            op_alu(ALU_ADD, d_n, R_AX);   // add R, rax
        } || {
            xs = 0;
            op_addtom(R_BP, d_n, R_AX, 1);           // add [rbp + d_n], rax
        }
    }
    p_next >= 0 { patch_here(p_next); }
    q_inc(d_i);
    emit_jmp_to(top);
    patch_here(p_end);
    p_break >= 0 { patch_here(p_break); }
    expect(')', "')' (one expression of the fields)");
    r = t;
    kind == 1 {
        q_load(0, d_res);
        q_load(1, d_n);
        op_st(R_AX, -8, R_CX, 0);         // mov [rax - 8], rcx: the elements that passed
    }
    kind == 2 { q_load(0, d_n); r = TYPE_INT; }
    kind == 3 {
        q_load(0, d_res);
        q_load(2, d_n);                    // presence: 1 if one was found
        r = model_type(m) | TYPE_OPT;
    }
    kind == 4 {
        q_load(0, d_arr);
        op_push(R_AX);
        q_load(0, d_res);
        op_push(R_AX);
        key_kind = u;                      // mov eax, kind of key ; push rax
        u == TYPE_UNKNOWN { key_kind = 1; }
        op_load(OP_IMM, R_AX, key_kind);
        op_push(R_AX);
        call_prelude("__nihil_sort_by", 24);
    }
    kind == 5 {
        xs > 0 {
            op_rmovx(R_AX, xs);   // movq rax, xmm8|9
        } || {
            q_load(0, d_n);
        }
        r = TYPE_INT;
        u == TYPE_FLOAT { r = TYPE_FLOAT; }
        u == TYPE_UNKNOWN { r = TYPE_UNKNOWN; }
    }
    slots = sv_slots;
    n_regs = sv_regs;
    candidates = sv_cand;
    q_depth = q_depth - 1;
    : r;
}

query_type(ns = 0, nl = 0, u = 0, what = "", pi = 0, pl = 0, pn = 0, pli = 0) {
    restore_pos(pi, pl, pn, pli);
    error_start();
    put_str("'.");
    put_source(ns, nl);
    put_str("' needs ");
    put_str(what);
    put_str(", but the expression is ");
    put_type(u);
    error_end();
}
