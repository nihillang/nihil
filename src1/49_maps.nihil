// =============================================================================
// 49_maps — MAP: a hash table in memory (SPEC §22). A map type is TYPE_MAP |
// (n << 8), with the key and value types of map type n in mt_key / mt_val (the
// same scheme as records). The table itself is prelude code (__nihil_map_*).
// A LIST (SPEC §28, at the end) is a map type with key 0: mt_val is its element.
// =============================================================================

// the map type with keys of type k and values of type v (made once)
map_type(k = 0, v = 0) {
    k == TYPE_UNKNOWN || v == TYPE_UNKNOWN { : TYPE_UNKNOWN; }
    i = 0;
    * i < n_mapt {
        mt_key[i] == k && mt_val[i] == v { : TYPE_MAP | (i << 8); }
        i = i + 1;
    }
    n_mapt >= MAX_MAPT { error("too many MAP types (limit 4096)"); }
    mt_key[n_mapt] = k;
    mt_val[n_mapt] = v;
    n_mapt = n_mapt + 1;
    : TYPE_MAP | ((n_mapt - 1) << 8);
}

is_map(t = 0) {
    : t & (TYPE_MAP | TYPE_ARR | TYPE_OPT) == TYPE_MAP && mt_key[t >> 8] != 0;
}

map_key(t = 0) { : mt_key[t >> 8]; }
map_val(t = 0) { : mt_val[t >> 8]; }

// the key kind the prelude takes: 1 INT, 3 STRING
map_kind(t = 0) {
    map_key(t) == TYPE_STR { : 3; }
    : 1;
}

emit_kind(kind = 0) {                   // mov eax, kind ; push rax
    op_load(OP_IMM, R_AX, kind);
    
    op_push(R_AX);
}

// a new empty map of type t in rax (globals, parameter defaults)
emit_new_map(t = 0) {
    op_zero(R_AX); op_push(R_AX);                   // xor eax, eax ; push rax (room for: any)
    emit_kind(map_kind(t));
    call_prelude("__nihil_map_new", 16);
}

key_ok(k = 0) {
    : k == TYPE_INT || k == TYPE_STR || k == TYPE_UNKNOWN;
}

value_ok(v = 0) {
    : v != TYPE_NONE && v != TYPE_ABSENT && !is_opt(v);
}

// tok = "{" at the start of an expression:
//   { k: v, k: v, … }   a map with those entries (the types come from the first pair)
//   { k: v ; n }        an empty map of that type, with room for n entries
map_literal() {
    next_token();
    sv_slots = slots;
    d = new_slot();
    pi = tok_start; pl = tok_len; pn = tok_line; pli = tok_lstart;
    kt = expression();
    !key_ok(kt) {
        restore_pos(pi, pl, pn, pli);
        error_start();
        put_str("a MAP key is INT or STRING, but this one is ");
        put_type(kt);
        error_end();
    }
    op_push(R_AX);                            // push rax (key)
    expect(':', "':' between the key and the value ({key: value})");
    pi = tok_start; pl = tok_len; pn = tok_line; pli = tok_lstart;
    vt = type_only_record(false);          // {k: NAME() ; n} of an abstract model: only the type
    vt < 0 { vt = expression(); }
    !value_ok(vt) {
        restore_pos(pi, pl, pn, pli);
        error_start();
        put_str("a MAP value cannot be ");
        put_type(vt);
        error_end();
    }
    op_push(R_AX);                            // push rax (value)
    t = map_type(kt, vt);
    kind = 1;
    kt == TYPE_STR { kind = 3; }
    tok_type == ';' {
        // {k: v ; n}: the pair only gives the types
        next_token();
        pi = tok_start; pl = tok_len; pn = tok_line; pli = tok_lstart;
        u = expression();
        u != TYPE_INT && u != TYPE_UNKNOWN {
            restore_pos(pi, pl, pn, pli);
            error_start();
            put_str("the room of an empty MAP ({key: value ; n}) is an INT, but it is ");
            put_type(u);
            error_end();
        }
        op_push(R_AX);
        emit_kind(kind);
        call_prelude("__nihil_map_new", 16);
        op_stack(0x10);         // add rsp, 16 (the sample pair)
        expect('}', "'}'");
        slots = sv_slots;
        : t;
    }
    op_zero(R_AX); op_push(R_AX);                   // xor eax, eax ; push rax (room: grows by itself)
    emit_kind(kind);
    call_prelude("__nihil_map_new", 16);
    q_store(d);
    op_push(R_AX);
    emit_kind(kind);
    call_prelude("__nihil_map_put", 32);   // (key, value, map, kind)
    * tok_type == ',' {
        next_token();
        tok_type == '}' { error_expected("a pair key: value"); }
        pi = tok_start; pl = tok_len; pn = tok_line; pli = tok_lstart;
        u = expression();
        u != kt && u != TYPE_UNKNOWN && kt != TYPE_UNKNOWN { map_mismatch("key", t, u, pi, pl, pn, pli); }
        op_push(R_AX);
        expect(':', "':' between the key and the value");
        pi = tok_start; pl = tok_len; pn = tok_line; pli = tok_lstart;
        u = expression();
        u != vt && u != TYPE_UNKNOWN && vt != TYPE_UNKNOWN { map_mismatch("value", t, u, pi, pl, pn, pli); }
        op_push(R_AX);
        q_load(0, d);
        op_push(R_AX);
        emit_kind(kind);
        call_prelude("__nihil_map_put", 32);
    }
    expect('}', "',' or '}'");
    q_load(0, d);
    slots = sv_slots;
    : t;
}

map_mismatch(what = "", t = 0, u = 0, pi = 0, pl = 0, pn = 0, pli = 0) {
    restore_pos(pi, pl, pn, pli);
    error_start();
    put_str("this ");
    put_type(t);
    put_str(" takes ");
    what == "key" { put_type(map_key(t)); } || { put_type(map_val(t)); }
    put_str(" as ");
    put_str(what);
    put_str(", but it is ");
    put_type(u);
    error_end();
}

// tok = "[" after a map (type t, in rax): m[k] → the value, or _ (V?)
map_get(t = 0) {
    op_push(R_AX);                            // push rax (map)
    next_token();
    pi = tok_start; pl = tok_len; pn = tok_line; pli = tok_lstart;
    u = expression();
    u != map_key(t) && u != TYPE_UNKNOWN { map_mismatch("key", t, u, pi, pl, pn, pli); }
    expect(']', "']'");
    op_push(R_AX);
    emit_kind(map_kind(t));
    map_kind(t) == 1 {
        call_prelude("__nihil_map_get_int", 24);   // the same, with no call inside: a leaf
    } || {
        call_prelude("__nihil_map_get", 24);   // rax = value, rdx = present
    }
    : map_val(t) | TYPE_OPT;
}

// ---- m[k] = (m[k] || d) + e; in one call (docs/map-upsert.md) ----------------------
// Only for an INT map, k and e made of names (no call), numbers, fields, indexes and arithmetic,
// so that evaluating k once instead of twice, and e before the look-up instead of after, cannot
// be seen; and e one term of the sum (no + or - outside parentheses but a leading -), so that it
// is compiled exactly as in the sum and any error it has is the same one, at the same place.

// tok: a token k or e may hold
up_token_ok(t = 0) {
    : t == T_IDENT || t == T_INT || t == '.' || t == '[' || t == ']' || t == '(' || t == ')'
        || t == '+' || t == '-' || t == '*' || t == '/' || t == '%';
}

// tok = the key's first token: its tokens up to the "]" noted (up_*), the lexer where it was.
// → false: not a key the form takes
up_key_scan() {
    save_lexer();
    up_n = 0;
    depth = 0;
    ok = true;
    * ok && !(tok_type == ']' && depth == 0) {
        !up_token_ok(tok_type) || up_n >= UP_MAX { ok = false; }
        ok && tok_type == T_IDENT && peek_type() == '(' { ok = false; }   // a call
        ok {
            tok_type == '[' || tok_type == '(' { depth = depth + 1; }
            tok_type == ']' || tok_type == ')' { depth = depth - 1; }
            up_type[up_n] = tok_type;
            up_start[up_n] = tok_start;
            up_len[up_n] = tok_len;
            up_n = up_n + 1;
            next_token();
        }
    }
    back_lexer();
    drop_lexer();
    : ok && up_n > 0;
}

// the token is t with the text at s (n bytes)
up_same(t = 0, s = 0, n = 0) {
    : tok_type == t && tok_len == n && same_source(tok_start, s, n);
}

// tok = the first token after "=": is it ( m [ k ] || d ) + e ; with m the map k, the same key
// tokens, d an INT literal and e as above? → yes: tok = e's first token (the "+" noted), else the
// lexer where it was
up_match(k = 0) {
    save_lexer();
    ok = tok_type == '(';
    ok { next_token(); ok = tok_type == T_IDENT && tok_len == s_len[k] && same_source(tok_start, s_ofs[k], s_len[k]); }
    ok { next_token(); ok = tok_type == '['; }
    i = 0;
    * ok && i < up_n { next_token(); ok = up_same(up_type[i], up_start[i], up_len[i]); i = i + 1; }
    ok { next_token(); ok = tok_type == ']'; }
    ok { next_token(); ok = tok_type == T_OR; }
    sign = 1;
    ok { next_token(); tok_type == '-' { sign = -1; next_token(); } ok = tok_type == T_INT; up_d = sign * tok_value; }
    ok { next_token(); ok = tok_type == ')'; }
    ok { next_token(); ok = tok_type == '+'; }
    ok {
        up_plus[0] = tok_start; up_plus[1] = tok_len; up_plus[2] = tok_line; up_plus[3] = tok_lstart;
        next_token();
    }
    save_lexer();                         // e's first token
    depth = 0;
    first = true;
    * ok && !(tok_type == ';' && depth == 0) {
        ok = up_token_ok(tok_type);
        ok && tok_type == T_IDENT && peek_type() == '(' { ok = false; }   // a call
        ok && depth == 0 && (tok_type == '+' || tok_type == '-') && !(first && tok_type == '-') { ok = false; }
        tok_type == '[' || tok_type == '(' { depth = depth + 1; }
        tok_type == ']' || tok_type == ')' { depth = depth - 1; }
        ok && depth < 0 { ok = false; }
        first = false;
        ok { next_token(); }
    }
    ok = ok && !first;                    // e is not empty
    ok {
        back_lexer();                     // at e
        drop_lexer();
        drop_lexer();
        : true;
    }
    drop_lexer();
    back_lexer();                         // where it was
    drop_lexer();
    : false;
}

// m[k] = v;  /  m[k] = _;  (tok = "[", variable k of map type t)
map_assign(k = 0, t = 0) {
    emit_load_var(k);
    op_push(R_AX);                            // push rax (map)
    next_token();
    fuse = optimize && map_val(t) == TYPE_INT && up_key_scan();
    pi = tok_start; pl = tok_len; pn = tok_line; pli = tok_lstart;
    u = expression();
    u != map_key(t) && u != TYPE_UNKNOWN { map_mismatch("key", t, u, pi, pl, pn, pli); }
    expect(']', "']'");
    op_push(R_AX);
    expect('=', "'='");
    tok_type == T_UNDERSCORE {
        next_token();
        emit_kind(map_kind(t));
        call_prelude("__nihil_map_del", 24);
        expect(';', "';'");
        :;
    }
    fuse && up_match(k) {
        // m[k] = (m[k] || d) + e;  →  push e, push d, push kind: __nihil_map_add (one look-up)
        u = expression();
        u != TYPE_INT && u != TYPE_UNKNOWN { error_op_types(up_plus[0], up_plus[1], up_plus[2], up_plus[3], TYPE_INT, u); }
        op_push(R_AX);
        op_load(OP_IMM, R_AX, up_d);
        op_push(R_AX);
        emit_kind(map_kind(t));
        call_prelude("__nihil_map_add", 40);   // (map, key, e, d, kind)
        expect(';', "';'");
        :;
    }
    pi = tok_start; pl = tok_len; pn = tok_line; pli = tok_lstart;
    u = expression();
    !element_accepts(map_val(t), u) && u != TYPE_UNKNOWN { map_mismatch("value", t, u, pi, pl, pn, pli); }
    op_push(R_AX);
    emit_kind(map_kind(t));
    call_prelude("__nihil_map_set", 32);   // (map, key, value, kind)
    expect(';', "';'");
}

// m.contains(k) (or the older m.has(k)), m.keys(), m.values()  (tok = name, the map in rax)
map_method(t = 0, ns = 0, nl = 0) {
    next_token();                        // name → "("
    next_token();
    name_is(ns, nl, "contains") || name_is(ns, nl, "has") {     // has: the older name, kept as a synonym
        op_push(R_AX);
        pi = tok_start; pl = tok_len; pn = tok_line; pli = tok_lstart;
        u = expression();
        u != map_key(t) && u != TYPE_UNKNOWN { map_mismatch("key", t, u, pi, pl, pn, pli); }
        expect(')', "')'");
        op_push(R_AX);
        emit_kind(map_kind(t));
        call_prelude("__nihil_map_has", 24);
        : TYPE_BOOL;
    }
    name_is(ns, nl, "keys") || name_is(ns, nl, "values") {
        expect(')', "')': .keys() and .values() take nothing");
        op_push(R_AX);
        name_is(ns, nl, "keys") {
            call_prelude("__nihil_map_keys", 8);
            : map_key(t) | TYPE_ARR;
        }
        is_list(map_val(t)) {
            error_start();
            put_str("m.values() would be an ARRAY of ");
            put_type(map_val(t));
            put_str(", and an ARRAY cannot hold lists: loop over m.keys() and read m[k]");
            error_end();
        }
        call_prelude("__nihil_map_values", 8);
        map_val(t) == TYPE_BOOL { bool_array_of(); }
        : map_val(t) | TYPE_ARR;
    }
    error_start();
    put_type(t);
    put_str(" has no method '");
    put_source(ns, nl);
    put_str("': it has contains, keys and values (and m[k], m[k] = v, m[k] = _, #m)");
    error_end();
    : 0;
}

// default of a parameter: tok = "{" → {literal: literal}, an empty map of that type
read_map_literal() {
    next_token();
    read_literal();
    kt = lit_type;
    next_token();
    tok_type != ':' { error("the default of a MAP parameter is a pair of literals: {\"\": 0}"); }
    next_token();
    read_literal();
    vt = lit_type;
    next_token();
    tok_type != '}' { error("the default of a MAP parameter is a pair of literals: {\"\": 0}"); }
    kt != TYPE_INT && kt != TYPE_STR { error("a MAP key is INT or STRING"); }
    lit_type = map_type(kt, vt);
    lit_value = 0;
}

// ---- LIST (SPEC §28): an ARRAY that grows, [x ; *] ----------------------------------------
// The value is the address of a header [count, capacity, items] (prelude __nihil_list_*),
// so every name of a list sees the same items when it grows, as with a MAP.

list_type(e = 0) {
    e == TYPE_UNKNOWN { : TYPE_UNKNOWN; }
    : map_type(0, e);
}

is_list(t = 0) {
    : t & (TYPE_MAP | TYPE_ARR | TYPE_OPT) == TYPE_MAP && mt_key[t >> 8] == 0;
}

list_elem(t = 0) { : mt_val[t >> 8]; }

// a new empty list in rax (globals, parameter defaults)
emit_new_list() {
    op_zero(R_AX); op_push(R_AX);                   // xor eax, eax ; push rax (room: the least)
    call_prelude("__nihil_list_new", 8);
}

// [x ; *] / [x ; *n]: tok = "*", the sample x (type t) pushed → an empty LIST of t
list_literal(t = 0) {
    next_token();                          // "*" → "]" or the room
    tok_type == ']' {
        op_zero(R_AX);                     // xor eax, eax
    } || {
        pi = tok_start; pl = tok_len; pn = tok_line; pli = tok_lstart;
        u = expression();
        u != TYPE_INT && u != TYPE_UNKNOWN {
            restore_pos(pi, pl, pn, pli);
            error_start();
            put_str("the room in [value ; *room] must be INT, but it is ");
            put_type(u);
            error_end();
        }
    }
    expect(']', "']' (in [value ; *])");
    op_push(R_AX);
    call_prelude("__nihil_list_new", 8);
    op_stack(0x08);             // add rsp, 8 (the sample)
    : list_type(t);
}

list_mismatch(k = 0, t = 0, u = 0, pi = 0, pl = 0, pn = 0, pli = 0) {
    restore_pos(pi, pl, pn, pli);
    error_start();
    put_str("'");
    put_source(s_ofs[k], s_len[k]);
    put_str("' is ");
    put_type(t);
    put_str(" and cannot receive ");
    put_type(u);
    error_end();
}

index_int(u = 0) {
    u != TYPE_INT && u != TYPE_UNKNOWN {
        error_start();
        put_str("the index must be INT, but it is ");
        put_type(u);
        error_end();
    }
}

// tok = "[" after a list (type t, in rax): v[i]
list_get(t = 0) {
    op_push(R_AX);                            // push rax (list)
    next_token();
    index_int(expression());
    expect(']', "']'");
    op_push(R_AX);
    call_prelude("__nihil_list_get", 16);
    : list_elem(t);
}

// v[] = x;  /  v[i] = x;  (tok = "[", variable k: a list of type t, or of no type yet)
list_assign(k = 0, t = 0) {
    emit_load_var(k);
    op_push(R_AX);                            // push rax (list)
    next_token();                          // "[" → "]" or the index
    tok_type == ']' {
        next_token();
        expect('=', "'=' (v[] = value;)");
        pi = tok_start; pl = tok_len; pn = tok_line; pli = tok_lstart;
        u = expression();
        t != TYPE_UNKNOWN && u != TYPE_UNKNOWN && !element_accepts(list_elem(t), u) { list_mismatch(k, t, u, pi, pl, pn, pli); }
        op_push(R_AX);
        list_call(t, "__nihil_list_push", 16);
        expect(';', "';'");
        :;
    }
    index_int(expression());
    op_push(R_AX);
    expect(']', "']'");
    expect('=', "'='");
    pi = tok_start; pl = tok_len; pn = tok_line; pli = tok_lstart;
    u = expression();
    t != TYPE_UNKNOWN && u != TYPE_UNKNOWN && !element_accepts(list_elem(t), u) { list_mismatch(k, t, u, pi, pl, pn, pli); }
    op_push(R_AX);
    list_call(t, "__nihil_list_set", 24);
    expect(';', "';'");
}

// a call into the prelude's lists; with no type yet (v[] = x before v's type is known, in an
// early pass) only the arguments go away: the prelude may not be in the program at all
list_call(t = 0, name = "", bytes_args = 0) {
    t == TYPE_UNKNOWN {
        op_stack(bytes_args, 1);               // add rsp, bytes_args
        
        unknowns = unknowns + 1;
        :;
    }
    call_prelude(name, bytes_args);
}
