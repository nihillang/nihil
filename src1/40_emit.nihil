// =============================================================================
// Emission of machine code and of the ELF64 executable
// =============================================================================

emit(b = 0) {
    size_code >= SIZE_CODE { error_code_large(); }
    code[size_code] = b & 255;
    size_code = size_code + 1;
}

// up to 9 fixed bytes; -1 = absent
eb(a = -1, b = -1, c = -1, d = -1, e = -1, f = -1, g = -1, h = -1, x = -1) {
    a >= 0 { emit(a); }
    b >= 0 { emit(b); }
    c >= 0 { emit(c); }
    d >= 0 { emit(d); }
    e >= 0 { emit(e); }
    f >= 0 { emit(f); }
    g >= 0 { emit(g); }
    h >= 0 { emit(h); }
    x >= 0 { emit(x); }
}

emit_w(v = 0) {
    emit(v);
    emit(v >> 8);
}

emit_d(v = 0) {
    emit(v);
    emit(v >> 8);
    emit(v >> 16);
    emit(v >> 24);
}

emit_q(v = 0) {
    i = 0;
    8 { emit(v >> (i * 8)); i = i + 1; }
}

put_d(pos = 0, v = 0) {
    code[pos] = v & 255;
    code[pos + 1] = (v >> 8) & 255;
    code[pos + 2] = (v >> 16) & 255;
    code[pos + 3] = (v >> 24) & 255;
}

put_q(pos = 0, v = 0) {
    i = 0;
    8 { code[pos + i] = (v >> (i * 8)) & 255; i = i + 1; }
}

// ---- the operations (00_data.nihil: OP_*, the ring) ----

// the operation whose code is code[at .. size_code) was just emitted
op_note(k = 0, r = 0, v = 0, at = 0, o = 0) {
    n_ops - ops_low >= OPS_RING { ops_low = ops_low + 1; }
    i = n_ops % OPS_RING;
    op_at[i] = at;
    op_end[i] = size_code;
    op_k[i] = k;
    op_r[i] = r;
    op_v[i] = v;
    op_o[i] = o;
    n_ops = n_ops + 1;
}

// the last operation, if its code is exactly code[a .. size_code) → its place in the ring, else -1
op_last_at(a = 0) {
    n_ops == ops_low { : -1; }
    i = (n_ops - 1) % OPS_RING;
    op_at[i] == a && op_end[i] == size_code { : i; }
    : -1;
}

// the code is cut back to pos: the operations from there on are gone
code_cut(pos = 0) {
    size_code = pos;
    * n_ops > ops_low && op_end[(n_ops - 1) % OPS_RING] > pos { n_ops = n_ops - 1; }
}

// the operation i of the ring, as it is: k, r, v, o
op_same(i = 0, k = 0, r = 0, v = 0, o = 0) {
    : op_k[i] == k && op_r[i] == r && op_v[i] == v && op_o[i] == o;
}

// the last n operations, back to back up to the end of the code? (the place of the last one is
// op_back(0), the one before it op_back(1) …)
ops_last(n = 0) {
    n_ops - ops_low < n { : false; }
    op_end[op_back(0)] != size_code { : false; }
    j = 1;
    * j < n { op_end[op_back(j)] != op_at[op_back(j - 1)] { : false; } j = j + 1; }
    : true;
}

op_back(j = 0) { : (n_ops - 1 - j) % OPS_RING; }

// r ← (k, v): a load into rax or rcx (R_AX, R_CX), in the shortest x86 form; o = 1: an optional,
// its presence into rdx too
x86_load(k = 0, r = 0, v = 0, o = 0) {
    k == OP_IMM {
        v >= 0 && v < 4294967296 {
            emit(0xB8 | r);                // mov eax, imm32
            emit_d(v);
        } || v >= -2147483648 && v < 2147483648 {
            eb(0x48, 0xC7, 0xC0 | r);       // mov rax, simm32
            emit_d(v);
        } || {
            eb(0x48, 0xB8 | r);             // mov rax, imm64
            emit_q(v);
        }
    } || k == OP_LOCAL {
        eb(0x48, 0x8B, 0x85 | (r << 3));    // mov rax, [rbp + disp32]
        emit_d(v);
        o == 1 {
            eb(0x48, 0x8B, 0x95);           // mov rdx, [rbp + disp32 + 8]
            emit_d(v + 8);
        }
    } || k == OP_GLOBAL {
        eb(0x48, 0x8B, 0x04 | (r << 3), 0x25);   // mov rax, [disp32]
        emit_d(v);
        o == 1 {
            eb(0x48, 0x8B, 0x14, 0x25);     // mov rdx, [disp32 + 8]
            emit_d(v + 8);
        }
    } || {
        eb(0x48 | rex_r(v) | rex_b(r), 0x89, 0xC0 | ((v & 7) << 3) | (r & 7));   // mov r, rV
    }
}

op_load(k = 0, r = 0, v = 0, o = 0) {
    at = size_code;
    x86_load(k, r, v, o);
    op_note(k, r, v, at, o);
}

// r ← the address of the constant at offset c (fixed up when the constants are placed)
op_lea_const(r = 0, c = 0) {
    at = size_code;
    eb(0x48, 0x8D, 0x05 | (r << 3));        // lea r, [rip + rel32]
    register_fixup(size_code, c, false);
    emit_d(0);
    op_note(OP_LEA_CONST, r, c, at);
}

// a call of the method k (fixed up at the end of the pass)
op_call_method(k = 0) {
    at = size_code;
    emit(0xE8);
    register_fixup(size_code, k, true);
    emit_d(0);
    op_note(OP_CALL, 0, k, at);
}

op_ret() {
    at = size_code;
    emit(0xC3);
    op_note(OP_RET, 0, 0, at);
}

// r ← s
op_mov(r = 0, s = 0) {
    op_load(OP_REG, r, s);
}

// opc reg, [base + disp] (base R_ABS: [disp32], a global); wide = 1: disp32 even when a byte fits
x86_mem(opc = 0, reg = 0, base = 0, disp = 0, wide = 0) {
    base < 0 {
        eb(0x48 | rex_r(reg), opc, 0x04 | ((reg & 7) << 3), 0x25);
        emit_d(disp);
        :;
    }
    eb(0x48 | rex_r(reg) | rex_b(base), opc);
    md = 0x80;                             // disp32
    wide == 0 && disp == 0 && base & 7 != 5 {
        md = 0;
    } || wide == 0 && disp >= -128 && disp < 128 {
        md = 0x40;                         // disp8
    }
    emit(md | ((reg & 7) << 3) | (base & 7));
    base & 7 == 4 { emit(0x24); }          // rsp, r12: a SIB byte
    md == 0x40 { emit(disp & 255); }
    md == 0x80 { emit_d(disp); }
}

op_ld(r = 0, base = 0, disp = 0, wide = 0) {
    at = size_code;
    x86_mem(0x8B, r, base, disp, wide);    // mov r, [base + disp]
    op_note(OP_LD, r, disp, at, base * 2 + wide);
}

op_st(base = 0, disp = 0, r = 0, wide = 0) {
    at = size_code;
    x86_mem(0x89, r, base, disp, wide);    // mov [base + disp], r
    op_note(OP_ST, r, disp, at, base * 2 + wide);
}

// r ← [base + index * 8]
op_ldx(r = 0, base = 0, index = 0) {
    at = size_code;
    eb(0x48, 0x8B, 0x04 | (r << 3), 0xC0 | (index << 3) | base);
    op_note(OP_LDX, r, base, at, index);
}

// [base + index * 8] ← r
op_stx(base = 0, index = 0, r = 0) {
    at = size_code;
    eb(0x48, 0x89, 0x04 | (r << 3), 0xC0 | (index << 3) | base);
    op_note(OP_STX, r, base, at, index);
}

// r ← the byte at [base + index], zero-extended
op_ldbx(r = 0, base = 0, index = 0) {
    at = size_code;
    eb(0x0F, 0xB6, 0x04 | (r << 3), (index << 3) | base);   // movzx r32, byte [base + index]
    op_note(OP_LDBX, r, base, at, index);
}

op_push(r = 0) {
    at = size_code;
    r >= 8 { emit(0x41); }
    emit(0x50 | (r & 7));                  // push r
    op_note(OP_PUSH, r, 0, at);
}

op_pop(r = 0) {
    at = size_code;
    r >= 8 { emit(0x41); }
    emit(0x58 | (r & 7));                  // pop r
    op_note(OP_POP, r, 0, at);
}

op_zero(r = 0) {
    at = size_code;
    eb(0x31, 0xC0 | (r << 3) | r);          // xor eR, eR
    op_note(OP_ZERO, r, 0, at);
}

// rsp + n: n > 0 drops n bytes, n < 0 makes room; wide = 1: imm32 even when it fits a byte
op_stack(n = 0, wide = 0) {
    at = size_code;
    m = n;
    ext = 0xC4;                            // add rsp
    n < 0 { m = -n; ext = 0xEC; }          // sub rsp
    wide == 0 && m < 128 {
        eb(0x48, 0x83, ext, m);
    } || {
        eb(0x48, 0x81, ext);
        emit_d(m);
    }
    op_note(OP_STACK, 4, n, at, wide);
}

// rax ← rax ?cc rcx, 0 or 1
op_cmp_set(cc = 0) {
    at = size_code;
    eb(0x48, 0x39, 0xC8, 0x0F, 0x90 | cc, 0xC0, 0x0F, 0xB6, 0xC0);   // cmp rax, rcx ; setcc al ; movzx eax, al
    op_note(OP_CMP_SET, R_AX, cc, at);
}

// the flags ← rax - rcx
op_cmp() {
    at = size_code;
    eb(0x48, 0x39, 0xC8);                   // cmp rax, rcx
    op_note(OP_CMP, R_AX, 0, at);
}

// r ← r op s (alu: ALU_*)
op_alu(alu = 0, r = 0, s = 0) {
    at = size_code;
    eb(0x48 | rex_b(r) | rex_r(s), alu, 0xC0 | ((s & 7) << 3) | (r & 7));   // op r, s
    op_note(OP_ALU, r, alu, at, s);
}

// code that puts v in rax, in the shortest form
emit_immediate(v = 0) {
    op_load(OP_IMM, R_AX, v);
}

emit_store_local(d = 0) {
    op_st(R_BP, d, R_AX, 1);               // mov [rbp + disp32], rax
}

emit_store_global(a = 0) {
    op_st(R_ABS, a, R_AX, 1);              // mov [disp32], rax
}

// a loop's first instruction at an address multiple of 16 (the code is loaded at BASE_CODE, so
// the address is BASE_CODE + size_code): otherwise where the loop falls makes it 10 to 20% slower
// or faster, whatever the code. Long nops, which run once, on the way into the loop.
align_loop() {
    !optimize { :; }
    pad = (16 - (size_code & 15)) & 15;
    * pad >= 7 { eb(0x0F, 0x1F, 0x80, 0x00, 0x00, 0x00, 0x00); pad = pad - 7; }
    pad == 6 { eb(0x66, 0x0F, 0x1F, 0x44, 0x00, 0x00); }
    pad == 5 { eb(0x0F, 0x1F, 0x44, 0x00, 0x00); }
    pad == 4 { eb(0x0F, 0x1F, 0x40, 0x00); }
    pad == 3 { eb(0x0F, 0x1F, 0x00); }
    pad == 2 { eb(0x90, 0x90); }
    pad == 1 { emit(0x90); }
}

emit_load_var(k = 0) {
    note_use(k);
    s_flags[k] & FLAG_REG != 0 {
        op_load(OP_REG, R_AX, s_end[k]);
        :;
    }
    o = 0;
    s_flags[k] & FLAG_OPT != 0 { o = 1; }
    s_flags[k] & FLAG_GLOBAL != 0 && s_flags[k] & FLAG_TOP == 0 {
        op_load(OP_GLOBAL, R_AX, s_end[k], o);
    } || {
        op_load(OP_LOCAL, R_AX, s_end[k], o);
    }
}

// the operation emit_load_var(k) makes, as op_k/op_v/op_o of i?
is_load_var(i = 0, k = 0) {
    o = 0;
    s_flags[k] & FLAG_OPT != 0 { o = 1; }
    s_flags[k] & FLAG_REG != 0 { : op_same(i, OP_REG, R_AX, s_end[k], 0); }
    s_flags[k] & FLAG_GLOBAL != 0 && s_flags[k] & FLAG_TOP == 0 { : op_same(i, OP_GLOBAL, R_AX, s_end[k], o); }
    : op_same(i, OP_LOCAL, R_AX, s_end[k], o);
}

emit_store_var(k = 0) {
    note_use(k);
    s_flags[k] & FLAG_REG != 0 {
        emit_mov_reg_rax(s_end[k]);
        :;
    }
    s_flags[k] & FLAG_GLOBAL != 0 && s_flags[k] & FLAG_TOP == 0 {
        emit_store_global(s_end[k]);
        s_flags[k] & FLAG_OPT != 0 {
            op_st(R_ABS, s_end[k] + 8, R_DX, 1);   // mov [disp32 + 8], rdx
        }
    } || {
        emit_store_local(s_end[k]);
        s_flags[k] & FLAG_OPT != 0 {
            op_st(R_BP, s_end[k] + 8, R_DX, 1);    // mov [rbp + disp32 + 8], rdx
        }
    }
}

emit_jmp_to(dest = 0) {
    emit(0xE9);
    emit_d(dest - size_code - 4);
}

emit_call_rt(rt = 0) {
    at = size_code;
    emit(0xE8);
    emit_d(rt + SIZE_HEADER - size_code - 4);
    op_note(OP_CALL_RT, 0, rt, at);
}

// cmp rcx, [rax-8] ; jae erro_indice
emit_check_limit() {
    eb(0x48, 0x3B, 0x48, 0xF8, 0x0F, 0x83);
    emit_d(RT_ERROR_INDEX + SIZE_HEADER - size_code - 4);
}

// the rel32 at pos now points to the current position
patch_here(pos = 0) {
    put_d(pos, size_code - (pos + 4));
    last_target = size_code;               // a jump lands here: the code before it cannot change
}

// ---- registers: r = 3 (rbx) or 12 … 15 ----
rex_b(r = 0) { r >= 8 { : 1; } : 0; }
rex_r(r = 0) { r >= 8 { : 4; } : 0; }

emit_mov_rax_reg(r = 0) {                  // mov rax, r
    op_mov(R_AX, r);
}

emit_mov_reg_rax(r = 0) {                  // mov r, rax
    op_mov(r, R_AX);
}

// method epilogue: restores the saved registers and returns
emit_return() {
    limit_regs == 0 {
        eb(0xC9, 0xC3);                     // leave ; ret
        :;
    }
    eb(0x48, 0x8D, 0x65, (-8 * limit_regs) & 255);   // lea rsp, [rbp - 8·n]
    i = limit_regs;
    * i > 0 {
        i = i - 1;
        r = REGS[i];
        r >= 8 { eb(0x41, 0x58 | (r & 7)); } || { emit(0x58 | r); }   // pop r
    }
    eb(0x5D, 0xC3);                         // pop rbp ; ret
}

// ---- optimizations on code already emitted ----

// is the code from a on a single simple load into rax (OP_IMM, OP_LOCAL, OP_GLOBAL or OP_REG)?
// → its place in the ring, or -1. Nothing may have been registered for fixup in that stretch.
load_simple(a = 0) {
    !optimize { : -1; }
    n_fix > 0 && fix_pos[n_fix - 1] >= a { : -1; }
    last_target >= a { : -1; }             // (a jump into it: the code is going to move back)
    i = op_last_at(a);
    i < 0 || op_r[i] != R_AX || op_k[i] < OP_IMM || op_k[i] > OP_REG || op_o[i] != 0 { : -1; }
    : i;
}

// the simple load at from_ (load_simple) is done again at to, into rcx; the code between
// (a push, a jump) is dropped. None of the forms touches the flags.
simple_to_rcx(from_ = 0, to = 0) {
    i = op_last_at(from_);
    k = op_k[i];
    v = op_v[i];
    code_cut(to);
    op_load(k, R_CX, v);
}

// jump "if rax is false" after a condition → position of the rel32.
// If the condition ended in an INT comparison (cmp ; setcc ; movzx),
// it becomes a single jcc with the condition inverted.
emit_jump_if_false() {
    a = size_code - 9;
    i = -1;
    optimize && a >= 0 && last_target <= a && (n_fix == 0 || fix_pos[n_fix - 1] < a) { i = op_last_at(a); }
    i >= 0 && op_k[i] == OP_CMP_SET {
        cc = op_v[i];
        code_cut(a);
        op_cmp();                          // only the cmp is left
        eb(0x0F, 0x80 | (cc ^ 1));          // jcc, the condition inverted
        pos = size_code;
        emit_d(0);
        : pos;
    }
    eb(0x48, 0x85, 0xC0, 0x0F, 0x84);       // test rax, rax ; jz
    pos = size_code;
    emit_d(0);
    : pos;
}

// the rel32 at pos → constant at offset v (or method v, if m)
register_fixup(pos = 0, v = 0, m = false) {
    n_fix * 16 >= SIZE_FIX - 16 { error_code_large(); }
    fix_pos[n_fix] = pos;
    fix_val[n_fix] = v;
    fix_method[n_fix] = m;
    n_fix = n_fix + 1;
}

// ---- constants built by the compiler ----
const_init() {
    const_head = (size_const + 7) & -8;
    size_const = const_head + 8;
}

const_put_byte(b = 0) {
    cst[size_const] = b;
    size_const = size_const + 1;
}

const_put_str(s = "") {
    size_const + #s >= SIZE_CONST - 16 { error("too many constants (limit 16 MiB)"); }
    i = 0;
    #s { const_put_byte(s[i]); i = i + 1; }
}

const_put_source(start = 0, n = 0) {
    size_const + n >= SIZE_CONST - 16 { error("too many constants (limit 16 MiB)"); }
    i = 0;
    n { const_put_byte(source[start + i]); i = i + 1; }
}

const_close() {
    cst[size_const] = 0;
    put_qword_cst(const_head, size_const - const_head - 8);
    size_const = size_const + 1;
    : const_head + 8;
}

// appends the constants after the code (aligned to 8) and resolves the fixups
emit_constantes() {
    code_end = size_code;
    * size_code & 7 != 0 { emit(0xCC); }
    base = size_code;
    size_code + size_const > SIZE_CODE { error_code_large(); }
    i = 0;
    size_const {
        code[size_code] = cst[i];
        size_code = size_code + 1;
        i = i + 1;
    }
    i = 0;
    n_fix {
        pos = fix_pos[i];
        target = base + fix_val[i];
        fix_method[i] { target = s_end[fix_val[i]]; }
        put_d(pos, target - (pos + 4));
        i = i + 1;
    }
}

emit_header() {
    // ELF64 header
    eb(0x7F, 'E', 'L', 'F', 2, 1, 1, 0);
    8 { emit(0); }
    emit_w(2);                             // ET_EXEC
    emit_w(0x3E);                          // EM_X86_64
    emit_d(1);
    emit_q(BASE_CODE + SIZE_HEADER);   // entry
    emit_q(64);                            // e_phoff
    emit_q(0);
    emit_d(0);
    emit_w(64);
    emit_w(56);
    emit_w(2);
    emit_w(64);
    emit_w(0);
    emit_w(0);
    // PT_LOAD code (R+X)
    emit_d(1);
    emit_d(5);
    emit_q(0);
    emit_q(BASE_CODE);
    emit_q(BASE_CODE);
    emit_q(0);
    emit_q(0);
    emit_q(0x1000);
    // PT_LOAD data (R+W, in memory only)
    emit_d(1);
    emit_d(6);
    emit_q(0);
    emit_q(BASE_DATA);
    emit_q(BASE_DATA);
    emit_q(0);
    emit_q(0);
    emit_q(0x1000);
}

close_elf() {
    put_q(96, size_code);                  // p_filesz of the code
    put_q(104, size_code);                 // p_memsz of the code
    put_q(160, OFS_GLOBALS + n_globals * 8); // p_memsz of the data
}
