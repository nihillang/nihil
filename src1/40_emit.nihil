// =============================================================================
// Emission of machine code and of the ELF64 executable
// =============================================================================

emit(b = 0) {
    size_code >= SIZE_CODE { error_code_large(); }
    code[size_code] = b & 255;
    size_code = size_code + 1;
}

// up to 9 fixed bytes; -1 = absent
eb(a = -1, b = -1, c = -1, d = -1, e = -1, f = -1, g = -1, h = -1, x = -1) {
    a >= 0 { emit(a); }
    b >= 0 { emit(b); }
    c >= 0 { emit(c); }
    d >= 0 { emit(d); }
    e >= 0 { emit(e); }
    f >= 0 { emit(f); }
    g >= 0 { emit(g); }
    h >= 0 { emit(h); }
    x >= 0 { emit(x); }
}

emit_w(v = 0) {
    emit(v);
    emit(v >> 8);
}

emit_d(v = 0) {
    emit(v);
    emit(v >> 8);
    emit(v >> 16);
    emit(v >> 24);
}

emit_q(v = 0) {
    i = 0;
    8 { emit(v >> (i * 8)); i = i + 1; }
}

put_d(pos = 0, v = 0) {
    code[pos] = v & 255;
    code[pos + 1] = (v >> 8) & 255;
    code[pos + 2] = (v >> 16) & 255;
    code[pos + 3] = (v >> 24) & 255;
}

put_q(pos = 0, v = 0) {
    i = 0;
    8 { code[pos + i] = (v >> (i * 8)) & 255; i = i + 1; }
}

// ---- the operations (00_data.nihil: OP_*, the ring) ----

// the operation whose code is code[at .. size_code) was just emitted
op_note(k = 0, r = 0, v = 0, at = 0, o = 0) {
    want_arm && n_ops - ops_low >= ops_cap { ops_grow(); }   // -arm keeps them all: more room
    n_ops - ops_low >= ops_cap {
        ops_low = ops_low + 1;
    }
    i = n_ops % ops_cap;
    op_at[i] = at;
    op_end[i] = size_code;
    op_k[i] = k;
    op_r[i] = r;
    op_v[i] = v;
    op_o[i] = o;
    n_ops = n_ops + 1;
}

// the last operation, if its code is exactly code[a .. size_code) → its place in the ring, else -1
op_last_at(a = 0) {
    n_ops == ops_low { : -1; }
    i = (n_ops - 1) % ops_cap;
    op_at[i] == a && op_end[i] == size_code { : i; }
    : -1;
}

// the code is cut back to pos: the operations from there on are gone, and the labels bound after them
code_cut(pos = 0) {
    size_code = pos;
    * n_ops > ops_low && op_end[(n_ops - 1) % ops_cap] > pos { n_ops = n_ops - 1; }
    * n_binds > 0 && lab_op[binds[n_binds - 1]] > n_ops { n_binds = n_binds - 1; }
}

// the operation i of the ring, as it is: k, r, v, o
op_same(i = 0, k = 0, r = 0, v = 0, o = 0) {
    : op_k[i] == k && op_r[i] == r && op_v[i] == v && op_o[i] == o;
}

// the last n operations, back to back up to the end of the code? (the place of the last one is
// op_back(0), the one before it op_back(1) …)
ops_last(n = 0) {
    n_ops - ops_low < n { : false; }
    op_end[op_back(0)] != size_code { : false; }
    j = 1;
    * j < n { op_end[op_back(j)] != op_at[op_back(j - 1)] { : false; } j = j + 1; }
    : true;
}

// where the last operation starts, if it ends where the code does; else -1
op_last_start() {
    n_ops == ops_low || op_end[op_back(0)] != size_code { : -1; }
    : op_at[op_back(0)];
}

op_back(j = 0) { : (n_ops - 1 - j) % ops_cap; }

// r ← (k, v): a load into rax or rcx (R_AX, R_CX), in the shortest x86 form; o = 1: an optional,
// its presence into rdx too
x86_load(k = 0, r = 0, v = 0, o = 0) {
    k == OP_IMM {
        v >= 0 && v < 4294967296 {
            emit(0xB8 | r);                // mov eax, imm32
            emit_d(v);
        } || v >= -2147483648 && v < 2147483648 {
            eb(0x48, 0xC7, 0xC0 | r);       // mov rax, simm32
            emit_d(v);
        } || {
            eb(0x48, 0xB8 | r);             // mov rax, imm64
            emit_q(v);
        }
    } || k == OP_LOCAL {
        eb(0x48, 0x8B, 0x85 | (r << 3));    // mov rax, [rbp + disp32]
        emit_d(v);
        o == 1 {
            eb(0x48, 0x8B, 0x95);           // mov rdx, [rbp + disp32 + 8]
            emit_d(v + 8);
        }
    } || k == OP_GLOBAL {
        eb(0x48, 0x8B, 0x04 | (r << 3), 0x25);   // mov rax, [disp32]
        emit_d(v);
        o == 1 {
            eb(0x48, 0x8B, 0x14, 0x25);     // mov rdx, [disp32 + 8]
            emit_d(v + 8);
        }
    } || {
        eb(0x48 | rex_r(v) | rex_b(r), 0x89, 0xC0 | ((v & 7) << 3) | (r & 7));   // mov r, rV
    }
}

op_load(k = 0, r = 0, v = 0, o = 0) {
    at = size_code;
    x86_load(k, r, v, o);
    op_note(k, r, v, at, o);
}

// r ← the address of the constant at offset c (fixed up when the constants are placed)
op_lea_const(r = 0, c = 0) {
    at = size_code;
    eb(0x48, 0x8D, 0x05 | (r << 3));        // lea r, [rip + rel32]
    register_fixup(size_code, c, false);
    emit_d(0);
    op_note(OP_LEA_CONST, r, c, at);
}

// a call of the method k (fixed up at the end of the pass)
op_call_method(k = 0) {
    at = size_code;
    emit(0xE8);
    register_fixup(size_code, k, true);
    emit_d(0);
    op_note(OP_CALL, 0, k, at);
}

op_ret() {
    at = size_code;
    emit(0xC3);
    op_note(OP_RET, 0, 0, at);
}

// r ← s
op_mov(r = 0, s = 0) {
    op_load(OP_REG, r, s);
}

// opc reg, [base + disp] (base R_ABS: [disp32], a global); wide = 1: disp32 even when a byte fits
x86_mem(opc = 0, reg = 0, base = 0, disp = 0, wide = 0) {
    base < 0 {
        eb(0x48 | rex_r(reg), opc, 0x04 | ((reg & 7) << 3), 0x25);
        emit_d(disp);
        :;
    }
    eb(0x48 | rex_r(reg) | rex_b(base), opc);
    md = 0x80;                             // disp32
    wide == 0 && disp == 0 && base & 7 != 5 {
        md = 0;
    } || wide == 0 && disp >= -128 && disp < 128 {
        md = 0x40;                         // disp8
    }
    emit(md | ((reg & 7) << 3) | (base & 7));
    base & 7 == 4 { emit(0x24); }          // rsp, r12: a SIB byte
    md == 0x40 { emit(disp & 255); }
    md == 0x80 { emit_d(disp); }
}

op_ld(r = 0, base = 0, disp = 0, wide = 0) {
    at = size_code;
    x86_mem(0x8B, r, base, disp, wide);    // mov r, [base + disp]
    op_note(OP_LD, r, disp, at, base * 2 + wide);
}

op_st(base = 0, disp = 0, r = 0, wide = 0) {
    at = size_code;
    x86_mem(0x89, r, base, disp, wide);    // mov [base + disp], r
    op_note(OP_ST, r, disp, at, base * 2 + wide);
}

// r ← [base + index * 8]
op_ldx(r = 0, base = 0, index = 0) {
    at = size_code;
    eb(0x48, 0x8B, 0x04 | (r << 3), 0xC0 | (index << 3) | base);
    op_note(OP_LDX, r, base, at, index);
}

// [base + index * 8] ← r
op_stx(base = 0, index = 0, r = 0) {
    at = size_code;
    eb(0x48, 0x89, 0x04 | (r << 3), 0xC0 | (index << 3) | base);
    op_note(OP_STX, r, base, at, index);
}

// r ← the byte at [base + index], zero-extended
op_ldbx(r = 0, base = 0, index = 0) {
    at = size_code;
    eb(0x0F, 0xB6, 0x04 | (r << 3), (index << 3) | base);   // movzx r32, byte [base + index]
    op_note(OP_LDBX, r, base, at, index);
}

// ---- more operations: each one's x86 form, and a note of it ----

// opc reg, [base + disp] with no REX.W (push, movzx …): x86_mem's ModRM rules
x86_mem_now(opc = 0, reg = 0, base = 0, disp = 0, wide = 0) {
    base >= 8 { emit(0x41); }
    emit(opc);
    md = 0x80;
    wide == 0 && disp == 0 && base & 7 != 5 {
        md = 0;
    } || wide == 0 && disp >= -128 && disp < 128 {
        md = 0x40;
    }
    emit(md | ((reg & 7) << 3) | (base & 7));
    base & 7 == 4 { emit(0x24); }
    md == 0x40 { emit(disp & 255); }
    md == 0x80 { emit_d(disp); }
}

// [base + index] ← r's low byte
op_stbx(base = 0, index = 0, r = 0) {
    at = size_code;
    eb(0x88, 0x04 | (r << 3), (index << 3) | base);   // mov [base + index], r8
    op_note(OP_STBX, r, base, at, index);
}

op_lea(r = 0, base = 0, disp = 0, wide = 0) {
    at = size_code;
    x86_mem(0x8D, r, base, disp, wide);    // lea r, [base + disp]
    op_note(OP_LEA, r, disp, at, base * 2 + wide);
}

op_cmpm(r = 0, base = 0, disp = 0, wide = 0) {
    at = size_code;
    x86_mem(0x3B, r, base, disp, wide);    // cmp r, [base + disp]
    op_note(OP_CMPM, r, disp, at, base * 2 + wide);
}

op_subm(r = 0, base = 0, disp = 0, wide = 0) {
    at = size_code;
    x86_mem(0x2B, r, base, disp, wide);    // sub r, [base + disp]
    op_note(OP_SUBM, r, disp, at, base * 2 + wide);
}

op_addtom(base = 0, disp = 0, r = 0, wide = 0) {
    at = size_code;
    x86_mem(0x01, r, base, disp, wide);    // add [base + disp], r
    op_note(OP_ADDTOM, r, disp, at, base * 2 + wide);
}

// the place of a memory operand and the disp, in one o: (base * 2 + wide) * 2^32 + disp (disp
// is 32 bits, kept as unsigned)
mem_o(base = 0, disp = 0, wide = 0) { : ((base * 2 + wide) << 32) | (disp & 0xFFFFFFFF); }

// qword [base + disp] ← v (imm32, sign-extended)
op_sti(base = 0, disp = 0, v = 0, wide = 0) {
    at = size_code;
    x86_mem(0xC7, 0, base, disp, wide);    // mov qword [base + disp], imm32
    emit_d(v);
    op_note(OP_STI, 0, v, at, mem_o(base, disp, wide));
}

op_pushm(base = 0, disp = 0, wide = 0) {
    at = size_code;
    x86_mem_now(0xFF, 6, base, disp, wide);   // push qword [base + disp]
    op_note(OP_PUSHM, 0, disp, at, base * 2 + wide);
}

op_pushi(v = 0) {
    at = size_code;
    eb(0x6A, v & 255);                      // push imm8
    op_note(OP_PUSHI, 0, v, at);
}

// r ← r + v: inc, dec, or add imm32
op_addi(r = 0, v = 0) {
    at = size_code;
    v == 1 || v == -1 {
        eb(0x48 | rex_b(r), 0xFF);
        v == 1 { emit(0xC0 | (r & 7)); } || { emit(0xC8 | (r & 7)); }       // inc / dec r
    } || {
        eb(0x48 | rex_b(r), 0x81, 0xC0 | (r & 7));                         // add r, imm32
        emit_d(v);
    }
    op_note(OP_ADDI, r, v, at);
}

// qword [base + disp] += v: inc, dec, or add imm32
op_addim(base = 0, disp = 0, v = 0, wide = 0) {
    at = size_code;
    v == 1 || v == -1 {
        ext = 0;
        v == -1 { ext = 1; }
        x86_mem(0xFF, ext, base, disp, wide);   // inc / dec qword [base + disp]
    } || {
        x86_mem(0x81, 0, base, disp, wide);     // add qword [base + disp], imm32
        emit_d(v);
    }
    op_note(OP_ADDIM, 0, v, at, mem_o(base, disp, wide));
}

op_cmpi(r = 0, v = 0) {
    at = size_code;
    r == R_AX {
        eb(0x48, 0x3D);                     // cmp rax, imm32
    } || {
        eb(0x48 | rex_b(r), 0x81, 0xF8 | (r & 7));   // cmp r, imm32
    }
    emit_d(v);
    op_note(OP_CMPI, r, v, at);
}

// cmp qword [base + disp], imm8
op_cmpim(base = 0, disp = 0, v = 0, wide = 0) {
    at = size_code;
    x86_mem(0x83, 7, base, disp, wide);
    emit(v & 255);
    op_note(OP_CMPIM, 0, v, at, mem_o(base, disp, wide));
}

op_muli(r = 0, s = 0, v = 0) {
    at = size_code;
    eb(0x48 | rex_r(r) | rex_b(s), 0x69, 0xC0 | ((r & 7) << 3) | (s & 7));   // imul r, s, imm32
    emit_d(v);
    op_note(OP_MULI, r, v, at, s);
}

op_mul(r = 0, s = 0) {
    at = size_code;
    eb(0x48 | rex_r(r) | rex_b(s), 0x0F, 0xAF, 0xC0 | ((r & 7) << 3) | (s & 7));   // imul r, s
    op_note(OP_MUL, r, 0, at, s);
}

op_shri(r = 0, n = 0) {
    at = size_code;
    eb(0x48 | rex_b(r), 0xC1, 0xE8 | (r & 7), n);   // shr r, n
    op_note(OP_SHRI, r, n, at);
}

op_shl(r = 0) {
    at = size_code;
    eb(0x48 | rex_b(r), 0xD3, 0xE0 | (r & 7));   // shl r, cl
    op_note(OP_SHL, r, 0, at);
}

op_sar(r = 0) {
    at = size_code;
    eb(0x48 | rex_b(r), 0xD3, 0xF8 | (r & 7));   // sar r, cl
    op_note(OP_SAR, r, 0, at);
}

op_neg(r = 0) {
    at = size_code;
    eb(0x48 | rex_b(r), 0xF7, 0xD8 | (r & 7));   // neg r
    op_note(OP_NEG, r, 0, at);
}

op_not(r = 0) {
    at = size_code;
    eb(0x48 | rex_b(r), 0xF7, 0xD0 | (r & 7));   // not r
    op_note(OP_NOT, r, 0, at);
}

op_notb(r = 0) {
    at = size_code;
    eb(0x83, 0xF0 | r, 0x01);               // xor eR, 1
    op_note(OP_NOTB, r, 0, at);
}

op_fneg(r = 0) {
    at = size_code;
    eb(0x48 | rex_b(r), 0x0F, 0xBA, 0xF8 | (r & 7), 0x3F);   // btc r, 63
    op_note(OP_FNEG, r, 0, at);
}

op_test(r = 0) {
    at = size_code;
    eb(0x48 | rex_b(r) | rex_r(r), 0x85, 0xC0 | ((r & 7) << 3) | (r & 7));   // test r, r
    op_note(OP_TEST, r, 0, at);
}

op_setcc(cc = 0, r = 0) {
    at = size_code;
    eb(0x0F, 0x90 | cc, 0xC0 | r);          // setcc r8 (al, cl, dl, bl)
    op_note(OP_SETCC, r, cc, at);
}

// r ← s if cc
op_cmov(cc = 0, r = 0, s = 0) {
    at = size_code;
    eb(0x48 | rex_r(r) | rex_b(s), 0x0F, 0x40 | cc, 0xC0 | ((r & 7) << 3) | (s & 7));   // cmovcc r, s
    op_note(OP_CMOV, r, cc, at, s);
}

// a forward jump on cc → its label, to bind where it lands (patch_here)
op_jcc(cc = 0) {
    at = size_code;
    eb(0x0F, 0x80 | cc);
    l = label_new(LAB_JUMP, 0, size_code);
    emit_d(0);
    op_note(OP_JCC, 0, cc, at, l);
    : l;
}

// a forward jump → its label (patch_here)
op_jmp() {
    at = size_code;
    emit(0xE9);
    l = label_new(LAB_JUMP, 0, size_code);
    emit_d(0);
    op_note(OP_JMP, 0, 0, at, l);
    : l;
}

op_imm64(r = 0, v = 0) {
    at = size_code;
    eb(0x48 | rex_b(r), 0xB8 | (r & 7));    // mov r, imm64
    emit_q(v);
    op_note(OP_IMM64, r, v, at);
}

op_imms(r = 0, v = 0) {
    at = size_code;
    eb(0x48 | rex_b(r), 0xC7, 0xC0 | (r & 7));   // mov r, simm32
    emit_d(v);
    op_note(OP_IMMS, r, v, at);
}

// xmm x ← the bits of r
op_xmov(x = 0, r = 0) {
    at = size_code;
    eb(0x66, 0x48 | rex_r(x) | rex_b(r), 0x0F, 0x6E, 0xC0 | ((x & 7) << 3) | (r & 7));   // movq xmm, r
    op_note(OP_XMOV, x, 0, at, r);
}

// r ← the bits of xmm x
op_rmovx(r = 0, x = 0) {
    at = size_code;
    eb(0x66, 0x48 | rex_r(x) | rex_b(r), 0x0F, 0x7E, 0xC0 | ((x & 7) << 3) | (r & 7));   // movq r, xmm
    op_note(OP_RMOVX, r, 0, at, x);
}

// xmm x ← [rbp + d]
op_xld(x = 0, d = 0) {
    at = size_code;
    emit(0xF3);
    x >= 8 { emit(0x44); }
    eb(0x0F, 0x7E, 0x85 | ((x & 7) << 3));  // movq xmm, [rbp + disp32]
    emit_d(d);
    op_note(OP_XLD, x, d, at);
}

// xmm x ← xmm x op xmm y
op_xop(xop = 0, x = 0, y = 0) {
    at = size_code;
    emit(0xF2);
    x >= 8 || y >= 8 { emit(0x40 | rex_r(x) | rex_b(y)); }
    eb(0x0F, xop, 0xC0 | ((x & 7) << 3) | (y & 7));   // addsd / subsd / mulsd / divsd
    op_note(OP_XOP, x, xop, at, y);
}

op_i2f(x = 0, r = 0) {
    at = size_code;
    eb(0xF2, 0x48 | rex_r(x) | rex_b(r), 0x0F, 0x2A, 0xC0 | ((x & 7) << 3) | (r & 7));   // cvtsi2sd xmm, r
    op_note(OP_I2F, x, 0, at, r);
}

op_f2i(r = 0, x = 0) {
    at = size_code;
    eb(0xF2, 0x48 | rex_r(r) | rex_b(x), 0x0F, 0x2C, 0xC0 | ((r & 7) << 3) | (x & 7));   // cvttsd2si r, xmm
    op_note(OP_F2I, r, 0, at, x);
}

// rax ← xmm0 ?t xmm1 (t: '>' T_GE '<' T_LE T_EQ T_NE); NaN: only != is true
op_fcmp_set(t = 0) {
    at = size_code;
    t == '>' {
        eb(0x66, 0x0F, 0x2E, 0xC1, 0x0F, 0x97, 0xC0);   // ucomisd xmm0, xmm1 ; seta al
    } || t == T_GE {
        eb(0x66, 0x0F, 0x2E, 0xC1, 0x0F, 0x93, 0xC0);   // ucomisd xmm0, xmm1 ; setae al
    } || t == '<' {
        eb(0x66, 0x0F, 0x2E, 0xC8, 0x0F, 0x97, 0xC0);   // ucomisd xmm1, xmm0 ; seta al
    } || t == T_LE {
        eb(0x66, 0x0F, 0x2E, 0xC8, 0x0F, 0x93, 0xC0);   // ucomisd xmm1, xmm0 ; setae al
    } || t == T_EQ {
        eb(0x66, 0x0F, 0x2E, 0xC1, 0x0F, 0x94, 0xC0);   // ucomisd ; sete al
        eb(0x0F, 0x9B, 0xC1, 0x20, 0xC8);               // setnp cl ; and al, cl
    } || {
        eb(0x66, 0x0F, 0x2E, 0xC1, 0x0F, 0x95, 0xC0);   // ucomisd ; setne al
        eb(0x0F, 0x9A, 0xC1, 0x08, 0xC8);               // setp cl ; or al, cl
    }
    eb(0x0F, 0xB6, 0xC0);                   // movzx eax, al
    op_note(OP_FCMP_SET, R_AX, t, at);
}

op_zxb(r = 0) {
    at = size_code;
    eb(0x0F, 0xB6, 0xC0 | (r << 3) | r);    // movzx eR, r8
    op_note(OP_ZXB, r, 0, at);
}

// r ← the address of a place further on → its label (patch_to_here)
op_lea_fwd(r = 0) {
    at = size_code;
    eb(0x48, 0x8D, 0x05 | (r << 3));        // lea r, [rip + rel32]
    l = label_new(LAB_JUMP, 0, size_code);
    emit_d(0);
    op_note(OP_LEA_FWD, r, l, at);
    : l;
}

// a short forward jump on cc, over a few operations → its label (patch8_here)
op_jcc8(cc = 0) {
    at = size_code;
    emit(0x70 | cc);
    l = label_new(LAB_JUMP8, 0, size_code);
    emit(0);
    op_note(OP_JCC8, 0, cc, at, l);
    : l;
}

patch8_here(l = 0) {
    label_bind(l);
}

// rsp ← rsp - the frame's size, known at the end → the position for put_frame
op_frame() {
    at = size_code;
    eb(0x48, 0x81, 0xEC);                   // sub rsp, imm32
    pos = size_code;
    emit_d(0);
    op_note(OP_FRAME, 0, 0, at);
    want_arm { arm_frame(pos, n_ops - 1); }
    : pos;
}

put_frame(pos = 0, size = 0) {
    put_d(pos, size);
    want_arm { arm_put_frame(pos, size); }
}

// a call of a place further on → its label (patch_here), where the return address is kept
op_call_fwd() {
    at = size_code;
    emit(0xE8);
    l = label_new(LAB_CALLED, 0, size_code);
    emit_d(0);
    op_note(OP_CALL_FWD, 0, l, at);
    : l;
}

op_push(r = 0) {
    at = size_code;
    r >= 8 { emit(0x41); }
    emit(0x50 | (r & 7));                  // push r
    op_note(OP_PUSH, r, 0, at);
}

op_pop(r = 0) {
    at = size_code;
    r >= 8 { emit(0x41); }
    emit(0x58 | (r & 7));                  // pop r
    op_note(OP_POP, r, 0, at);
}

op_zero(r = 0) {
    at = size_code;
    eb(0x31, 0xC0 | (r << 3) | r);          // xor eR, eR
    op_note(OP_ZERO, r, 0, at);
}

// rsp + n: n > 0 drops n bytes, n < 0 makes room; wide = 1: imm32 even when it fits a byte
op_stack(n = 0, wide = 0) {
    at = size_code;
    m = n;
    ext = 0xC4;                            // add rsp
    n < 0 { m = -n; ext = 0xEC; }          // sub rsp
    wide == 0 && m < 128 {
        eb(0x48, 0x83, ext, m);
    } || {
        eb(0x48, 0x81, ext);
        emit_d(m);
    }
    op_note(OP_STACK, 4, n, at, wide);
}

// rax ← rax ?cc rcx, 0 or 1
op_cmp_set(cc = 0) {
    at = size_code;
    eb(0x48, 0x39, 0xC8, 0x0F, 0x90 | cc, 0xC0, 0x0F, 0xB6, 0xC0);   // cmp rax, rcx ; setcc al ; movzx eax, al
    op_note(OP_CMP_SET, R_AX, cc, at);
}

// the flags ← rax - rcx
op_cmp() {
    at = size_code;
    eb(0x48, 0x39, 0xC8);                   // cmp rax, rcx
    op_note(OP_CMP, R_AX, 0, at);
}

// r ← r op s (alu: ALU_*)
op_alu(alu = 0, r = 0, s = 0) {
    at = size_code;
    eb(0x48 | rex_b(r) | rex_r(s), alu, 0xC0 | ((s & 7) << 3) | (r & 7));   // op r, s
    op_note(OP_ALU, r, alu, at, s);
}

// code that puts v in rax, in the shortest form
emit_immediate(v = 0) {
    op_load(OP_IMM, R_AX, v);
}

emit_store_local(d = 0) {
    op_st(R_BP, d, R_AX, 1);               // mov [rbp + disp32], rax
}

emit_store_global(a = 0) {
    op_st(R_ABS, a, R_AX, 1);              // mov [disp32], rax
}

// a loop's first instruction at an address multiple of 16 (the code is loaded at BASE_CODE, so
// the address is BASE_CODE + size_code): otherwise where the loop falls makes it 10 to 20% slower
// or faster, whatever the code. Long nops, which run once, on the way into the loop.
align_loop() {
    !optimize { :; }
    at = size_code;
    pad = (16 - (size_code & 15)) & 15;
    n = pad;
    * pad >= 7 { eb(0x0F, 0x1F, 0x80, 0x00, 0x00, 0x00, 0x00); pad = pad - 7; }
    pad == 6 { eb(0x66, 0x0F, 0x1F, 0x44, 0x00, 0x00); }
    pad == 5 { eb(0x0F, 0x1F, 0x44, 0x00, 0x00); }
    pad == 4 { eb(0x0F, 0x1F, 0x40, 0x00); }
    pad == 3 { eb(0x0F, 0x1F, 0x00); }
    pad == 2 { eb(0x90, 0x90); }
    pad == 1 { emit(0x90); }
    op_note(OP_ALIGN, 0, n, at);
}

emit_load_var(k = 0) {
    note_use(k);
    s_flags[k] & FLAG_REG != 0 {
        op_load(OP_REG, R_AX, s_end[k]);
        :;
    }
    o = 0;
    s_flags[k] & FLAG_OPT != 0 { o = 1; }
    s_flags[k] & FLAG_GLOBAL != 0 && s_flags[k] & FLAG_TOP == 0 {
        op_load(OP_GLOBAL, R_AX, s_end[k], o);
    } || {
        op_load(OP_LOCAL, R_AX, s_end[k], o);
    }
}

// the operation emit_load_var(k) makes, as op_k/op_v/op_o of i?
is_load_var(i = 0, k = 0) {
    o = 0;
    s_flags[k] & FLAG_OPT != 0 { o = 1; }
    s_flags[k] & FLAG_REG != 0 { : op_same(i, OP_REG, R_AX, s_end[k], 0); }
    s_flags[k] & FLAG_GLOBAL != 0 && s_flags[k] & FLAG_TOP == 0 { : op_same(i, OP_GLOBAL, R_AX, s_end[k], o); }
    : op_same(i, OP_LOCAL, R_AX, s_end[k], o);
}

emit_store_var(k = 0) {
    note_use(k);
    s_flags[k] & FLAG_REG != 0 {
        emit_mov_reg_rax(s_end[k]);
        :;
    }
    s_flags[k] & FLAG_GLOBAL != 0 && s_flags[k] & FLAG_TOP == 0 {
        emit_store_global(s_end[k]);
        s_flags[k] & FLAG_OPT != 0 {
            op_st(R_ABS, s_end[k] + 8, R_DX, 1);   // mov [disp32 + 8], rdx
        }
    } || {
        emit_store_local(s_end[k]);
        s_flags[k] & FLAG_OPT != 0 {
            op_st(R_BP, s_end[k] + 8, R_DX, 1);    // mov [rbp + disp32 + 8], rdx
        }
    }
}

// a jump back to the label l (label_here)
emit_jmp_to(l = 0) {
    at = size_code;
    emit(0xE9);
    emit_d(lab_at[l] - size_code - 4);
    op_note(OP_JMP, 0, 0, at, l);
}

emit_call_rt(rt = 0) {
    at = size_code;
    emit(0xE8);
    emit_d(rt + SIZE_HEADER - size_code - 4);
    o = 0;
    arm_native { o = rt_method(rt) + 1; }  // -native: the routine written in Nihil, if there is one
    arm_native && rt == RT_ALLOC { alloc_slow_method(); }   // and its slow way (arm_alloc_slow)
    op_note(OP_CALL_RT, 0, rt, at, o);
}

// cmp rcx, [rax-8] ; jae erro_indice
emit_check_limit() {
    op_cmpm(R_CX, R_AX, -8, 0);
    op_jcc_rt(CC_AE, RT_ERROR_INDEX);
}

// a jump on cc to the runtime's routine rt
op_jcc_rt(cc = 0, rt = 0) {
    arm_native { rt_method(rt); }          // (-native: its method is kept)
    at = size_code;
    eb(0x0F, 0x80 | cc);
    emit_d(rt + SIZE_HEADER - size_code - 4);
    op_note(OP_JCC_RT, 0, cc, at, rt);
}

// the forward jump of label l lands here
patch_here(l = 0) {
    label_bind(l);
    last_target = size_code;               // a jump lands here: the code before it cannot change
}

// the same, for an address taken (op_lea_fwd), not a jump
patch_to_here(l = 0) {
    label_bind(l);
}

// ---- labels (00_data.nihil) ----

// a new label; fix: the displacement of the forward jump to it (-1: none)
label_new(kind = 0, v = 0, fix = -1) {
    l = lab_free;
    l >= 0 {
        lab_free = lab_next[l];
    } || {
        want_arm && n_labs >= lab_cap { labels_grow(); }
        n_labs >= lab_cap { error("too many labels"); }
        l = n_labs;
        n_labs = n_labs + 1;
    }
    lab_at[l] = -1;
    lab_fix[l] = fix;
    lab_kind[l] = kind;
    lab_v[l] = v;
    : l;
}

// the label l is here: its forward jump is patched
label_bind(l = 0) {
    lab_at[l] = size_code;
    f = lab_fix[l];
    f >= 0 && lab_kind[l] == LAB_JUMP8 { code[f] = size_code - (f + 1); }
    f >= 0 && lab_kind[l] != LAB_JUMP8 { put_d(f, size_code - (f + 4)); }
    want_arm {
        lab_op[l] = n_ops;                 // before the next operation
        n_binds >= binds_cap { binds = grown(binds, n_binds, 2 * binds_cap); binds_cap = 2 * binds_cap; }
        binds[n_binds] = l;
        n_binds = n_binds + 1;
    } || f >= 0 {
        label_drop(l);                     // nothing names it again
    }
}

// a label bound here, for jumps back to it
label_here() {
    l = label_new(LAB_JUMP);
    label_bind(l);
    : l;
}

// a label no longer used (its jump was cut): free again, without -arm
label_drop(l = 0) {
    lab_next[l] = lab_free;
    lab_free = l;
}

// ---- registers: r = 3 (rbx) or 12 … 15 ----
rex_b(r = 0) { r >= 8 { : 1; } : 0; }
rex_r(r = 0) { r >= 8 { : 4; } : 0; }

emit_mov_rax_reg(r = 0) {                  // mov rax, r
    op_mov(R_AX, r);
}

emit_mov_reg_rax(r = 0) {                  // mov r, rax
    op_mov(r, R_AX);
}

// method epilogue: restores the saved registers and returns
emit_return() {
    i = 0;
    * i < prot_depth { emit_call_rt(RT_UNPROTECT); i = i + 1; }   // ": x;" inside ?{ … } (keeps rax, rdx)
    at = size_code;
    limit_regs == 0 {
        eb(0xC9, 0xC3);                     // leave ; ret
        op_note(OP_EPILOGUE, 0, 0, at);
        :;
    }
    eb(0x48, 0x8D, 0x65, (-8 * limit_regs) & 255);   // lea rsp, [rbp - 8·n]
    i = limit_regs;
    * i > 0 {
        i = i - 1;
        r = REGS[i];
        r >= 8 { eb(0x41, 0x58 | (r & 7)); } || { emit(0x58 | r); }   // pop r
    }
    eb(0x5D, 0xC3);                         // pop rbp ; ret
    op_note(OP_EPILOGUE, 0, limit_regs, at);
}

// ---- optimizations on code already emitted ----

// is the code from a on a single simple load into rax (OP_IMM, OP_LOCAL, OP_GLOBAL or OP_REG)?
// → its place in the ring, or -1. Nothing may have been registered for fixup in that stretch.
load_simple(a = 0) {
    !optimize { : -1; }
    n_fix > 0 && fix_pos[n_fix - 1] >= a { : -1; }
    last_target >= a { : -1; }             // (a jump into it: the code is going to move back)
    i = op_last_at(a);
    i < 0 || op_r[i] != R_AX || op_k[i] < OP_IMM || op_k[i] > OP_REG || op_o[i] != 0 { : -1; }
    : i;
}

// the simple load at from_ (load_simple) is done again at to, into rcx; the code between
// (a push, a jump) is dropped. None of the forms touches the flags.
simple_to_rcx(from_ = 0, to = 0) {
    i = op_last_at(from_);
    k = op_k[i];
    v = op_v[i];
    code_cut(to);
    op_load(k, R_CX, v);
}

// jump "if rax is false" after a condition → position of the rel32.
// If the condition ended in an INT comparison (cmp ; setcc ; movzx),
// it becomes a single jcc with the condition inverted.
emit_jump_if_false() {
    i = -1;
    optimize && ops_last(1) { i = op_back(0); }
    i >= 0 && op_k[i] == OP_CMP_SET && last_target <= op_at[i] && (n_fix == 0 || fix_pos[n_fix - 1] < op_at[i]) {
        cc = op_v[i];
        code_cut(op_at[i]);
        op_cmp();                          // only the cmp is left
        : op_jcc(cc ^ 1);                  // jcc, the condition inverted
    }
    op_test(R_AX);                         // test rax, rax ; jz
    : op_jcc(CC_E);
}

// the rel32 at pos → constant at offset v (or method v, if m)
register_fixup(pos = 0, v = 0, m = false) {
    n_fix * 16 >= SIZE_FIX - 16 { error_code_large(); }
    fix_pos[n_fix] = pos;
    fix_val[n_fix] = v;
    fix_method[n_fix] = 0;
    m { fix_method[n_fix] = 1; }
    n_fix = n_fix + 1;
}

// ---- constants built by the compiler ----
const_init() {
    const_head = (size_const + 7) & -8;
    size_const = const_head + 8;
}

const_put_byte(b = 0) {
    cst[size_const] = b;
    size_const = size_const + 1;
}

const_put_str(s = "") {
    size_const + #s >= SIZE_CONST - 16 { error("too many constants (limit 16 MiB)"); }
    i = 0;
    #s { const_put_byte(s[i]); i = i + 1; }
}

const_put_source(start = 0, n = 0) {
    size_const + n >= SIZE_CONST - 16 { error("too many constants (limit 16 MiB)"); }
    i = 0;
    n { const_put_byte(source[start + i]); i = i + 1; }
}

const_close() {
    cst[size_const] = 0;
    put_qword_cst(const_head, size_const - const_head - 8);
    size_const = size_const + 1;
    : const_head + 8;
}

// appends the constants after the code (aligned to 8) and resolves the fixups
emit_constantes() {
    code_end = size_code;
    * size_code & 7 != 0 { emit(0xCC); }
    base = size_code;
    size_code + size_const > SIZE_CODE { error_code_large(); }
    i = 0;
    size_const {
        code[size_code] = cst[i];
        size_code = size_code + 1;
        i = i + 1;
    }
    i = 0;
    n_fix {
        pos = fix_pos[i];
        target = base + fix_val[i];
        fix_method[i] != 0 { target = s_end[fix_val[i]]; }
        put_d(pos, target - (pos + 4));
        i = i + 1;
    }
}

emit_header() {
    // ELF64 header
    eb(0x7F, 'E', 'L', 'F', 2, 1, 1, 0);
    8 { emit(0); }
    emit_w(2);                             // ET_EXEC
    emit_w(0x3E);                          // EM_X86_64
    emit_d(1);
    emit_q(BASE_CODE + SIZE_HEADER);   // entry
    emit_q(64);                            // e_phoff
    emit_q(0);
    emit_d(0);
    emit_w(64);
    emit_w(56);
    emit_w(2);
    emit_w(64);
    emit_w(0);
    emit_w(0);
    // PT_LOAD code (R+X)
    emit_d(1);
    emit_d(5);
    emit_q(0);
    emit_q(BASE_CODE);
    emit_q(BASE_CODE);
    emit_q(0);
    emit_q(0);
    emit_q(0x1000);
    // PT_LOAD data (R+W, in memory only)
    emit_d(1);
    emit_d(6);
    emit_q(0);
    emit_q(BASE_DATA);
    emit_q(BASE_DATA);
    emit_q(0);
    emit_q(0);
    emit_q(0x1000);
}

close_elf() {
    put_q(96, size_code);                  // p_filesz of the code
    put_q(104, size_code);                 // p_memsz of the code
    put_q(160, OFS_GLOBALS + n_globals * 8); // p_memsz of the data
}
