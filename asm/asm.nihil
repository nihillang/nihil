// =============================================================================
// asm/asm.nihil — the assembler of Nihil's runtime: src/runtime.asm into the bytes that
// src1/runtime_bin.nihil keeps, the same bytes `nasm -f bin` gives, without nasm.
//
// Input (one per line, on the standard input): the source (src/runtime.asm), the folders to
// look in for %include (separated by spaces), the file to write (runtime_bin.nihil), and names
// to define (-DNAME, separated by spaces; may be empty).
//
// It knows what the runtime uses, not the whole of nasm:
//   - the preprocessor: %include, %define (no parameters), %ifdef / %ifndef / %else / %endif,
//     %macro … %endmacro with %1 … %9 and %%labels;
//   - bits 64, default abs, org, align (filled with nop), db / dw / dd / dq (numbers, texts in
//     '…' or "…", expressions), times, equ, labels (.local after the last plain one);
//   - expressions: numbers (decimal, 0x, 0b, …h), 'chars', $, $$, labels, ( ), unary - + ~ !,
//     * / % + - << >> & ^ | and the comparisons, which give 1 or 0;
//   - the instructions the runtime uses (asm/asm.nihil's encode()), with nasm's choices: the
//     shortest form of each (a jump is short when its target is near, an immediate takes 8
//     bits when it fits, mov r64, imm takes 32 bits when it fits), so the bytes are the same.
// Jumps start short and become near only when their target is too far; the passes go on until
// no address changes, then the last one writes the bytes.
// =============================================================================

// ---- the lines, after the preprocessor ----
LT = ["" ; *4096];              // text
LF = ["" ; *4096];              // file, for the messages
LN = [0 ; *4096];               // line in that file

add_line(t = "", f = "", n = 0) { LT[] = t; LF[] = f; LN[] = n; }

WHERE = "";
fail(what = "") {
    !>> "asm: " + WHERE + what + "\n";
    :: 1;
}

// ---- text ----
is_word(c = 0) { : c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '_' || c == '.' || c == '$' || c == '@' || c == '?'; }
is_digit(c = 0) { : c >= '0' && c <= '9'; }

// the line without its comment (a ; outside quotes)
no_comment(s = "") {
    q = 0;
    i = 0;
    * i < #s {
        c = s[i];
        q == 0 && c == ';' { : s.slice(0, i); }
        q == 0 && (c == '\'' || c == '"' || c == '`') { q = c; } || q != 0 && c == q { q = 0; }
        i = i + 1;
    }
    : s;
}

// parts separated by commas outside quotes and brackets
split_commas(s = "") {
    parts = ["" ; *];
    q = 0; depth = 0; from = 0;
    i = 0;
    * i < #s {
        c = s[i];
        q != 0 { c == q { q = 0; } }
        || c == '\'' || c == '"' || c == '`' { q = c; }
        || c == '[' || c == '(' { depth = depth + 1; }
        || c == ']' || c == ')' { depth = depth - 1; }
        || c == ',' && depth == 0 { parts[] = s.slice(from, i).trim(); from = i + 1; }
        i = i + 1;
    }
    #s.trim() > 0 { parts[] = s.slice(from).trim(); }
    : parts.array();
}

// a before b, byte by byte
text_less(a = "", b = "") {
    i = 0;
    * i < #a && i < #b { a[i] != b[i] { : a[i] < b[i]; } i = i + 1; }
    : #a < #b;
}

// the first word and the rest
first_word(s = "") {
    i = 0;
    * i < #s && s[i] != ' ' && s[i] != '\t' { i = i + 1; }
    : s.slice(0, i);
}
after_word(s = "") {
    i = 0;
    * i < #s && s[i] != ' ' && s[i] != '\t' { i = i + 1; }
    : s.slice(i).trim();
}

// ---- the preprocessor ----
DEFS = {"": "" ; 256};
INCDIRS = ["" ; *];
MACRO_BODY = {"": "" ; 16};
MACRO_ARGS = {"": 0 ; 16};
UNIQ = 0;

// the %defines put in place of their names (outside quotes), again until none is left
expand(s = "") {
    t = s;
    round = 0;
    * round < 32 {
        out = ["" ; *];
        changed = false;
        q = 0;
        i = 0; from = 0;
        * i < #t {
            c = t[i];
            q != 0 { c == q { q = 0; } i = i + 1; }
            || c == '\'' || c == '"' || c == '`' { q = c; i = i + 1; }
            || is_word(c) && (i == 0 || !is_word(t[i - 1])) {
                j = i;
                * j < #t && is_word(t[j]) { j = j + 1; }
                w = t.slice(i, j);
                DEFS.contains(w) { out[] = t.slice(from, i); out[] = DEFS[w] || ""; from = j; changed = true; }
                i = j;
            }
            || { i = i + 1; }
        }
        !changed { : t; }
        t = out.join("") + t.slice(from);
        round = round + 1;
    }
    fail("a %define that never ends: " + s);
    : t;
}

dir_of(p = "") {
    k = -1;
    p : c, i { c == '/' { k = i; } }
    : p.slice(0, k + 1);
}

preprocess(path = "") {
    text? = @? path;
    text == _ { fail("could not read " + path); }
    lines = (text || "").split("\n");
    // the %if stack: each level is active or not
    act = [true ; 64];
    taken = [false ; 64];
    depth = 0;
    macro = "";                 // the name of the %macro being read
    body = ["" ; *];
    i = 0;
    * i < #lines {
        WHERE = path + ":" + $(i + 1) + ": ";
        t = no_comment(lines[i]).trim();
        word = first_word(t).lower();
        on = act[depth];
        #macro > 0 {
            word == "%endmacro" { MACRO_BODY[macro] = body.join("\n"); macro = ""; }
            || { body[] = t; }
        }
        || word == "%ifdef" || word == "%ifndef" {
            yes = DEFS.contains(after_word(t));
            word == "%ifndef" { yes = !yes; }
            depth = depth + 1;
            act[depth] = on && yes;
            taken[depth] = yes;
        }
        || word == "%else" {
            depth == 0 { fail("%else without %if"); }
            act[depth] = act[depth - 1] && !taken[depth];
        }
        || word == "%endif" {
            depth == 0 { fail("%endif without %if"); }
            depth = depth - 1;
        }
        || !on { }
        || word == "%define" {
            rest = after_word(t);
            first_word(rest).contains("(") { fail("%define with parameters is not known here"); }
            DEFS[first_word(rest)] = after_word(rest);
        }
        || word == "%include" {
            name = after_word(t).replace("\"", "").replace("'", "");
            found = "";
            cand = dir_of(path) + name;
            (@? cand) != _ { found = cand; }
            k = 0;
            * #found == 0 && k < #INCDIRS { c2 = INCDIRS[k] + name; (@? c2) != _ { found = c2; } k = k + 1; }
            #found == 0 { fail("%include: no " + name); }
            preprocess(found);
        }
        || word == "%macro" {
            rest = after_word(t);
            macro = first_word(rest);
            MACRO_ARGS[macro] = after_word(rest).int() || 0;
            body = ["" ; *];
        }
        || word.starts_with("%") { fail("not known here: " + word); }
        || MACRO_BODY.contains(first_word(t)) { call_macro(first_word(t), after_word(t), path, i + 1); }
        || #t > 0 { add_line(expand(t), path, i + 1); }
        i = i + 1;
    }
    depth != 0 { fail("%if without %endif"); }
    #macro > 0 { fail("%macro " + macro + " without %endmacro"); }
}

// a macro's lines, its %1 … %9 replaced by the arguments and its %%labels made unique
call_macro(name = "", args = "", path = "", n = 0) {
    a = split_commas(args);
    #a != (MACRO_ARGS[name] || 0) { fail(name + " takes " + $(MACRO_ARGS[name] || 0) + " arguments"); }
    UNIQ = UNIQ + 1;
    b = (MACRO_BODY[name] || "").replace("%%", "..@" + $UNIQ + ".");
    k = #a;
    * k > 0 { b = b.replace("%" + $k, a[k - 1]); k = k - 1; }
    b.split("\n") : ln { #ln > 0 { add_line(expand(ln), path, n); } }
}

// ---- symbols ----
SYM = {"": 0 ; 2048};
SYMRL = {"": 0 ; 2048};          // its RL (see the expressions): 1 for a label
DEFINED = {"": 0 ; 2048};        // the pass that defined it (a second definition in a pass is an error)
PASS = 0;
CHANGED = false;                // a label moved in this pass
UNRES = false;                  // the expression used a label not known yet
FINAL = false;                  // the last pass: everything must be known
LAST = "";                      // the last plain label (for .local)
PLAIN_NAMES = ["" ; *256];      // the plain labels and their offsets, in the final pass (profiler)
PLAIN_ADDRS = [0 ; *256];
HERE = 0;                       // $: the address of the line
ORG = 0;

full_name(w = "") {
    w.starts_with(".") && !w.starts_with("..@") { : LAST + w; }
    : w;
}

set_sym(name = "", v = 0, rl = 0) {
    (DEFINED[name] || 0) == PASS { fail(name + " is defined twice"); }
    DEFINED[name] = PASS;
    SYMRL[name] = rl;
    old? = SYM[name];
    old == _ || (old || 0) != v { CHANGED = true; }
    SYM[name] = v;
}

// ---- expressions ----
EX = "";
EP = 0;

skip_sp() { * EP < #EX && (EX[EP] == ' ' || EX[EP] == '\t') { EP = EP + 1; } }
peek2(t = "") { skip_sp(); : EP + #t <= #EX && EX.slice(EP, EP + #t) == t; }

eval(s = "") {
    EX = s; EP = 0;
    v = ex_cmp();
    skip_sp();
    EP < #EX { fail("cannot read the expression '" + s + "' at '" + EX.slice(EP) + "'"); }
    : v;
}

// RL: how the value depends on labels, which nasm keeps relocatable (a label counts 1, $ too;
// label - label is 0, a plain number): set by each ex_ for the value it gives. -1000: mixed in
// a way that is neither (a label times 2, a label & 15…)
RL = 0;
mixed(a = 0, b = 0) { a == 0 && b == 0 { : 0; } : -1000; }

ex_cmp() {
    a = ex_or();
    ra = RL;
    * true {
        peek2("==") { EP = EP + 2; e = ex_or(); a = bool_int(a == e); ra = 0; }
        || peek2("!=") || peek2("<>") { EP = EP + 2; e = ex_or(); a = bool_int(a != e); ra = 0; }
        || peek2("<=") { EP = EP + 2; e = ex_or(); a = bool_int(a <= e); ra = 0; }
        || peek2(">=") { EP = EP + 2; e = ex_or(); a = bool_int(a >= e); ra = 0; }
        || peek2("<") && !peek2("<<") { EP = EP + 1; e = ex_or(); a = bool_int(a < e); ra = 0; }
        || peek2(">") && !peek2(">>") { EP = EP + 1; e = ex_or(); a = bool_int(a > e); ra = 0; }
        || peek2("=") { EP = EP + 1; e = ex_or(); a = bool_int(a == e); ra = 0; }
        || { RL = ra; : a; }
    }
    RL = ra;
    : a;
}
bool_int(b = false) { b { : 1; } : 0; }
ex_or() { a = ex_xor(); ra = RL; * peek2("|") && !peek2("||") { EP = EP + 1; a = a | ex_xor(); ra = mixed(ra, RL); } RL = ra; : a; }
ex_xor() { a = ex_and(); ra = RL; * peek2("^") && !peek2("^^") { EP = EP + 1; a = a ^ ex_and(); ra = mixed(ra, RL); } RL = ra; : a; }
ex_and() { a = ex_shift(); ra = RL; * peek2("&") && !peek2("&&") { EP = EP + 1; a = a & ex_shift(); ra = mixed(ra, RL); } RL = ra; : a; }
ex_shift() {
    a = ex_add();
    ra = RL;
    * true {
        peek2("<<") { EP = EP + 2; a = a << ex_add(); ra = mixed(ra, RL); }
        || peek2(">>") { EP = EP + 2; a = a >> ex_add(); ra = mixed(ra, RL); }
        || { RL = ra; : a; }
    }
    RL = ra;
    : a;
}
ex_add() {
    a = ex_mul();
    ra = RL;
    * true {
        peek2("+") { EP = EP + 1; a = a + ex_mul(); ra = ra + RL; }
        || peek2("-") { EP = EP + 1; a = a - ex_mul(); ra = ra - RL; }
        || { RL = ra; : a; }
    }
    RL = ra;
    : a;
}
ex_mul() {
    a = ex_unary();
    ra = RL;
    * true {
        peek2("*") {                            // label × n: n labels (nasm folds L*0 to 0)
            EP = EP + 1; e = ex_unary();
            ra != 0 && RL != 0 { ra = -1000; } || ra != 0 { ra = ra * e; } || RL != 0 { ra = RL * a; }
            a = a * e;
        }
        || peek2("/") { EP = EP + 1; d = ex_unary(); ra = mixed(ra, RL); d == 0 { d = 1; FINAL && !UNRES { fail("division by zero"); } } a = a / d; }
        || peek2("%") { EP = EP + 1; d = ex_unary(); ra = mixed(ra, RL); d == 0 { d = 1; FINAL && !UNRES { fail("division by zero"); } } a = a % d; }
        || { RL = ra; : a; }
    }
    RL = ra;
    : a;
}
ex_unary() {
    peek2("-") { EP = EP + 1; v = -ex_unary(); RL = -RL; : v; }
    peek2("+") { EP = EP + 1; : ex_unary(); }
    peek2("~") { EP = EP + 1; v = ~ex_unary(); RL = mixed(RL, 0); : v; }
    peek2("!") { EP = EP + 1; v = bool_int(ex_unary() == 0); RL = 0; : v; }
    : ex_atom();
}
ex_atom() {
    skip_sp();
    RL = 0;
    EP >= #EX { fail("an expression ends too soon: '" + EX + "'"); }
    c = EX[EP];
    c == '(' {
        EP = EP + 1;
        v = ex_cmp();
        !peek2(")") { fail("')' missing in '" + EX + "'"); }
        EP = EP + 1;
        : v;
    }
    c == '\'' || c == '"' || c == '`' {             // 'ab': the bytes, the first lowest
        j = EP + 1;
        * j < #EX && EX[j] != c { j = j + 1; }
        j >= #EX { fail("a quote is not closed: " + EX); }
        v = 0;
        k = j - 1;
        * k > EP { v = (v << 8) | EX[k]; k = k - 1; }
        EP = j + 1;
        : v;
    }
    j = EP;
    * j < #EX && is_word(EX[j]) { j = j + 1; }
    j == EP { fail("cannot read '" + EX.slice(EP) + "'"); }
    w = EX.slice(EP, j);
    EP = j;
    w == "$" { RL = 1; : HERE; }
    w == "$$" { RL = 1; : ORG; }
    is_digit(w[0]) { : number(w); }
    name = full_name(w);
    v? = SYM[name];
    RL = SYMRL[name] || 0;
    v == _ {
        FINAL { fail("not defined: " + name); }
        UNRES = true;
        RL = 1;                                 // not known yet: as a label (nasm cannot tell either)
        : 0;
    }
    : v || 0;
}

number(w = "") {
    t = w.lower().replace("_", "");
    v = 0;
    t.starts_with("0x") {
        k = 2;
        * k < #t { v = (v << 4) | hex_digit(t[k], w); k = k + 1; }
        : v;
    }
    t.starts_with("0b") {
        k = 2;
        * k < #t { t[k] != '0' && t[k] != '1' { fail("not a number: " + w); } v = (v << 1) | (t[k] - '0'); k = k + 1; }
        : v;
    }
    t.ends_with("h") {
        k = 0;
        * k < #t - 1 { v = (v << 4) | hex_digit(t[k], w); k = k + 1; }
        : v;
    }
    t : c { !is_digit(c) { fail("not a number: " + w); } v = v * 10 + (c - '0'); }
    : v;
}
hex_digit(c = 0, w = "") {
    c >= '0' && c <= '9' { : c - '0'; }
    c >= 'a' && c <= 'f' { : c - 'a' + 10; }
    fail("not a number: " + w);
    : 0;
}

// ---- registers ----
// each: number (0–15) + size × 16; 8-bit ah ch dh bh get +1024, spl bpl sil dil +2048 (they need REX)
REGS = {"": 0 ; 128};
reg_names(names = "", size = 0, extra = 0) {
    names.split(" ") : name, i { #name > 0 { REGS[name] = i + size * 16 + extra; } }
}
setup_regs() {
    reg_names("rax rcx rdx rbx rsp rbp rsi rdi r8 r9 r10 r11 r12 r13 r14 r15", 8, 0);
    reg_names("eax ecx edx ebx esp ebp esi edi r8d r9d r10d r11d r12d r13d r14d r15d", 4, 0);
    reg_names("ax cx dx bx sp bp si di r8w r9w r10w r11w r12w r13w r14w r15w", 2, 0);
    reg_names("al cl dl bl", 1, 0);
    reg_names("    spl bpl sil dil r8b r9b r10b r11b r12b r13b r14b r15b", 1, 0);
    REGS["spl"] = 4 + 16 + 2048; REGS["bpl"] = 5 + 16 + 2048; REGS["sil"] = 6 + 16 + 2048; REGS["dil"] = 7 + 16 + 2048;
    REGS["ah"] = 4 + 16 + 1024; REGS["ch"] = 5 + 16 + 1024; REGS["dh"] = 6 + 16 + 1024; REGS["bh"] = 7 + 16 + 1024;
    reg_names("xmm0 xmm1 xmm2 xmm3 xmm4 xmm5 xmm6 xmm7 xmm8 xmm9 xmm10 xmm11 xmm12 xmm13 xmm14 xmm15", 16, 0);
}

// ---- operands: kind 1 register, 2 memory, 3 immediate ----
OK = [0 ; 3];
OR = [0 ; 3];                   // register number
OS = [0 ; 3];                   // size in bytes (a register's, or a memory operand's keyword; 0: none)
OREX = [false ; 3];             // spl bpl sil dil: REX needed
OHI = [false ; 3];              // ah ch dh bh: no REX may be used with them
OREL = [false ; 3];             // the immediate depends on a label (nasm keeps it relocatable)
OSTRICT = [false ; 3];          // "strict": no shorter form for this immediate
MREL = [false ; 3];             // the displacement depends on a label: 32 bits, as nasm
OV = [0 ; 3];                   // immediate value
OUN = [false ; 3];              // the immediate used a label not known yet
MB = [0 ; 3];                   // memory: base (-1 none)
MI = [0 ; 3];                   // index (-1 none)
MSC = [0 ; 3];                  // scale (1, 2, 4, 8)
MD = [0 ; 3];                   // displacement
MRIP = [false ; 3];             // [rel x]
NOPS = 0;
STRICT = false;                 // "strict near": the long form
NEARJ = false;                  // "near" / "short" before a jump's target
SHORTJ = false;

size_word(w = "") {
    w == "byte" { : 1; } w == "word" { : 2; } w == "dword" { : 4; } w == "qword" { : 8; }
    : 0;
}

operand(k = 0, text = "") {
    t = text.trim();
    size = 0;
    w = first_word(t).lower();
    st = false;
    w == "strict" { STRICT = true; st = true; t = after_word(t); w = first_word(t).lower(); }
    size_word(w) > 0 { size = size_word(w); t = after_word(t); w = first_word(t).lower(); }
    w == "near" { NEARJ = true; t = after_word(t); } || w == "short" { SHORTJ = true; t = after_word(t); }
    OS[k] = size; OREX[k] = false; OHI[k] = false; OUN[k] = false; OREL[k] = false; MRIP[k] = false;
    r? = REGS[t.lower()];
    r != _ {
        size != 0 { fail("a size before a register: " + text); }
        OK[k] = 1;
        rv = r || 0;
        OR[k] = rv & 15; OS[k] = (rv >> 4) & 31; OREX[k] = (rv & 2048) != 0; OHI[k] = (rv & 1024) != 0;
        :;
    }
    t.starts_with("[") {
        !t.ends_with("]") { fail("a memory operand without ']': " + t); }
        OK[k] = 2;
        mem(k, t.slice(1, #t - 1).trim());
        :;
    }
    OK[k] = 3;
    UNRES = false;
    OV[k] = eval(t);
    OUN[k] = UNRES;
    OREL[k] = RL != 0;
    OSTRICT[k] = st;
    one_label(t);
}
// a value from labels must hold one of them, added or subtracted (nasm refuses L*2 and L & 15)
one_label(t = "") { FINAL && (RL < -1 || RL > 1) { fail("labels can only be added or subtracted here: " + t); } }

// [base + index*scale + disp], [abs], [rel label]
MBN = ["" ; 3];                  // the base's and the index's names (nasm's order, below)
MIN = ["" ; 3];
mem(k = 0, s = "") {
    MB[k] = -1; MI[k] = -1; MSC[k] = 1; MD[k] = 0; MBN[k] = ""; MIN[k] = "";
    t = s;
    first_word(t).lower() == "rel" { MRIP[k] = true; t = after_word(t); }
    first_word(t).lower() == "abs" { t = after_word(t); }
    // the terms between + and - at depth 0; registers are taken out, the rest is the displacement
    disp = ["" ; *];
    sign = "+";
    from = 0; depth = 0;
    i = 0;
    * i <= #t {
        c = 0;
        i < #t { c = t[i]; }
        c == '(' { depth = depth + 1; } || c == ')' { depth = depth - 1; }
        i == #t || depth == 0 && (c == '+' || c == '-') && i > from {
            term = t.slice(from, i).trim();
            !reg_term(k, term, sign) { disp[] = sign + "(" + term + ")"; }
            i < #t { sign = t.slice(i, i + 1); }
            from = i + 1;
        }
        i = i + 1;
    }
    MRIP[k] && (MB[k] >= 0 || MI[k] >= 0) { fail("[rel …] with a register: " + s); }
    UNRES = false;
    RL = 0;
    #disp > 0 { MD[k] = eval(disp.join(" ")); one_label(s); }
    OUN[k] = UNRES;
    MREL[k] = RL != 0;
    // two registers, each once: the first is the base, as nasm reads [a + b] — but with two or
    // more other terms nasm adds them up in its expression evaluator, which orders the registers
    // by name (checked with nasm: [rsi + 8 + rcx - 1] has the base rcx, [rsi + 8 + rcx] rsi)
    MI[k] >= 0 && MB[k] >= 0 && MSC[k] == 1 && #disp >= 2 && text_less(MIN[k], MBN[k]) {
        x = MB[k]; MB[k] = MI[k]; MI[k] = x;
        xn = MBN[k]; MBN[k] = MIN[k]; MIN[k] = xn;
    }
    // rsp cannot be an index: with scale 1 it is the base instead
    MI[k] == 4 && MSC[k] == 1 && MB[k] >= 0 { x = MB[k]; MB[k] = MI[k]; MI[k] = x; }
    MI[k] == 4 { fail("rsp cannot be an index: " + s); }
    // [r*2] as nasm writes it: [r + r*1], which has a base and so a short displacement
    MB[k] < 0 && MI[k] >= 0 && MSC[k] == 2 { MB[k] = MI[k]; MSC[k] = 1; }
}

// a term that is a register (base or index) or register*scale: true, and kept
reg_term(k = 0, term = "", sign = "") {
    parts = term.replace(" ", "").split("*");
    #parts > 2 { fail("one factor only with a register: " + term); }
    r? = REGS[parts[0].lower()];
    r2? = 0;
    r2 = _;
    #parts == 2 { r2 = REGS[parts[1].lower()]; }
    r == _ && r2 == _ { : false; }
    r != _ && r2 != _ { fail("two registers multiplied: " + term); }
    sign == "-" { fail("a register cannot be subtracted: " + term); }
    reg = 0; scale = 1; name = "";
    r != _ { reg = r || 0; name = parts[0].lower(); #parts == 2 { scale = eval(parts[1]); } } || { reg = r2 || 0; name = parts[1].lower(); scale = eval(parts[0]); }
    ((reg >> 4) & 31) != 8 { fail("an address takes 64-bit registers: " + term); }
    #parts == 1 && MB[k] < 0 { MB[k] = reg & 15; MBN[k] = name; : true; }
    MI[k] >= 0 { fail("two index registers: " + term); }
    MI[k] = reg & 15; MSC[k] = scale; MIN[k] = name;
    : true;
}

// ---- the bytes of one instruction ----
INS = [0 ; 32];
NI = 0;
RIP_AT = -1;                    // where a rip-relative displacement goes, and its target
RIP_TO = 0;
put(x = 0) { INS[NI] = x & 255; NI = NI + 1; }
// an immediate or a displacement of n bytes; in the last pass it must fit (signed or not)
imm(v = 0, n = 0) {
    FINAL && n < 8 {
        lim = 1 << (8 * n);
        v < -(lim / 2) || v >= lim { fail("the value " + $v + " does not fit in " + $n + " byte(s)"); }
    }
    k = 0;
    * k < n { put(v >> (8 * k)); k = k + 1; }
}
// a 32-bit immediate that the CPU extends to 64 bits must fit as a signed 32-bit number
se32(v = 0, s = 0) { FINAL && s == 8 && !fits32(v) { fail("the value " + $v + " does not fit in a 32-bit immediate (64-bit operation)"); } }
fits8(v = 0) { : v >= -128 && v <= 127; }
// operand k's immediate v in 8 bits: a plain number (not a label, as nasm) that fits, not strict
short8(k = 0, v = 0) { : fits8(v) && !OUN[k] && !OREL[k] && !OSTRICT[k]; }
fits32(v = 0) { : v >= -2147483648 && v <= 2147483647; }

// prefix (0: none), REX.W, the opcode's bytes, the ModRM reg field, the r/m operand k
op_rm(pfx = 0, w = false, op = [0], reg = 0, k = 0) {
    pfx != 0 { put(pfx); }
    rex = 0x40;
    w { rex = rex | 8; }
    reg >= 8 { rex = rex | 4; }
    OK[k] == 1 {
        OR[k] >= 8 { rex = rex | 1; }
    } || {
        MI[k] >= 8 { rex = rex | 2; }
        MB[k] >= 8 { rex = rex | 1; }
    }
    force = false;
    j = 0;
    * j < NOPS { OK[j] == 1 && OREX[j] { force = true; } j = j + 1; }
    rex != 0x40 || force {
        j = 0;
        * j < NOPS { OK[j] == 1 && OHI[j] { fail("ah, bh, ch or dh cannot go with r8–r15, sil, dil, spl, bpl or a 64-bit operation"); } j = j + 1; }
        put(rex);
    }
    op : ob { put(ob); }
    modrm(reg & 7, k);
}

modrm(reg = 0, k = 0) {
    OK[k] == 1 { put(0xC0 | (reg << 3) | (OR[k] & 7)); :; }
    MRIP[k] {
        put(0x05 | (reg << 3));
        RIP_AT = NI; RIP_TO = MD[k];
        imm(0, 4);
        :;
    }
    base = MB[k]; index = MI[k]; d = MD[k];
    FINAL && !fits32(d) { fail("a displacement past 32 bits: " + $d); }
    base < 0 && index < 0 {                     // [abs]: SIB without base or index
        put(0x04 | (reg << 3)); put(0x25); imm(d, 4);
        :;
    }
    sc = 0;
    MSC[k] == 2 { sc = 1; } || MSC[k] == 4 { sc = 2; } || MSC[k] == 8 { sc = 3; } || MSC[k] != 1 { fail("a scale is 1, 2, 4 or 8"); }
    base < 0 {                                  // [index*scale + disp32]
        put(0x04 | (reg << 3)); put((sc << 6) | ((index & 7) << 3) | 5); imm(d, 4);
        :;
    }
    mode = 0;
    d != 0 || (base & 7) == 5 { mode = 1; }
    !fits8(d) || OUN[k] || MREL[k] { mode = 2; }
    index < 0 && (base & 7) != 4 {
        put((mode << 6) | (reg << 3) | (base & 7));
    } || {
        index == 4 { fail("rsp is not an index"); }
        ix = 4;
        index >= 0 { ix = index & 7; }
        put((mode << 6) | (reg << 3) | 4);
        put((sc << 6) | (ix << 3) | (base & 7));
    }
    mode == 1 { imm(d, 1); } || mode == 2 { imm(d, 4); }
}

// ---- the instructions ----
CC = {"": 0 ; 64};
setup_cc() {
    names = ["o", "no", "b c nae", "ae nb nc", "e z", "ne nz", "be na", "a nbe", "s", "ns", "p pe", "np po", "l nge", "ge nl", "le ng", "g nle"];
    i = 0;
    * i < 16 { v = names[i].split(" "); j = 0; * j < #v { CC[v[j]] = i; j = j + 1; } i = i + 1; }
}
ALU = {"add": 0, "or": 1, "adc": 2, "sbb": 3, "and": 4, "sub": 5, "xor": 6, "cmp": 7};
UNARY = {"not": 2, "neg": 3, "mul": 4, "imul": 5, "div": 6, "idiv": 7};
SHIFT = {"rol": 0, "ror": 1, "rcl": 2, "rcr": 3, "shl": 4, "sal": 4, "shr": 5, "sar": 7};
BITS = {"bt": 4, "bts": 5, "btr": 6, "btc": 7};

LONGJ = [false ; 0];            // this line's jump is near (rel32); assemble() gives it one per line
GROW_ONLY = false;
CUR = 0;                        // the line being assembled

// the size of the operation: a register's, or a memory operand's keyword
op_size(k = 0) {
    OS[k] == 0 { fail("the size is not known: say byte, word, dword or qword"); }
    : OS[k];
}
p66(s = 0) { s == 2 { : 0x66; } : 0; }

// what every instruction must have before it is encoded (what is not checked here is not
// emitted wrong: each form below refuses what it does not know)
ARITY = {"ret": 0, "syscall": 0, "cqo": 0, "nop": 0, "push": 1, "pop": 1, "inc": 1, "dec": 1, "not": 1, "neg": 1,
         "mul": 1, "div": 1, "idiv": 1, "bswap": 1, "prefetcht0": 1, "call": 1, "jmp": 1, "test": 2, "mov": 2,
         "lea": 2, "movzx": 2, "movsx": 2, "xchg": 2, "bsr": 2, "bsf": 2, "cvtsi2sd": 2, "divsd": 2, "mulsd": 2,
         "addsd": 2, "subsd": 2, "movq": 2};
check(mn = "") {
    want? = ARITY[mn];
    mn.starts_with("j") && CC.contains(mn.slice(1)) || mn.starts_with("set") && CC.contains(mn.slice(3)) { want = 1; }
    ALU.contains(mn) || SHIFT.contains(mn) || BITS.contains(mn) { want = 2; }
    mn == "imul" { NOPS < 1 || NOPS > 3 { fail("imul takes 1, 2 or 3 operands"); } want = _; }
    want != _ && NOPS != (want || 0) { fail(mn + " takes " + $(want || 0) + " operand(s), not " + $NOPS); }
    // 16 bits: only mov and the arithmetic (add … cmp) are made with 0x66 here
    k = 0;
    * k < NOPS {
        OK[k] != 3 && OS[k] == 2 && mn != "mov" && !ALU.contains(mn) && !(k == 1 && (mn == "movzx" || mn == "movsx")) {
            fail("16-bit operands: only mov, add … cmp and the source of movzx/movsx here");
        }
        k = k + 1;
    }
    // the two operands of the same size (a memory operand without a keyword takes the register's)
    same = mn == "mov" || ALU.contains(mn) || mn == "test" || mn == "xchg";
    same && NOPS == 2 && OK[0] != 3 && OK[1] != 3 && OS[0] != 0 && OS[1] != 0 && OS[0] != OS[1] {
        fail(mn + ": operands of different sizes (" + $OS[0] + " and " + $OS[1] + " bytes)");
    }
    same && NOPS == 2 && OK[0] == 2 && OK[1] == 1 { OS[0] = OS[1]; }
    same && NOPS == 2 && OK[1] == 2 && OK[0] == 1 { OS[1] = OS[0]; }
    (mn == "lea" || mn == "divsd" || mn == "mulsd" || mn == "addsd" || mn == "subsd") && OK[1] != 2 && OK[1] != 1 { fail(mn + " takes a register and memory"); }
    mn == "lea" && OK[1] != 2 { fail("lea takes memory"); }
    (mn == "lea" || mn == "movzx" || mn == "movsx" || mn == "bsr" || mn == "bsf" || mn == "imul" && NOPS > 1) && OK[0] != 1 { fail(mn + ": the first operand is a register"); }
    k = 0;
    * k < NOPS { OK[k] == 1 && OS[k] == 16 && !mn.ends_with("sd") && mn != "movq" && mn != "cvtsi2sd" { fail(mn + " does not take an xmm register"); } k = k + 1; }
}
// an immediate as the operation's size reads it: 0xFFFFFFF0 for a 32-bit operation is -16
sx(v = 0, s = 0) {
    s == 4 && v >= 2147483648 && v <= 4294967295 { : v - 4294967296; }
    s == 2 && v >= 32768 && v <= 65535 { : v - 65536; }
    : v;
}

encode(mn = "", ops = [""]) {
    NI = 0; RIP_AT = -1; STRICT = false; NEARJ = false; SHORTJ = false;
    NOPS = #ops;
    NOPS > 3 { fail("too many operands"); }
    mn == "rep" || mn == "repe" || mn == "repne" {
        mn == "repne" { put(0xF2); } || { put(0xF3); }
        s = ops[0].lower();
        s == "movsb" { put(0xA4); } || s == "movsq" { put(0x48); put(0xA5); } || s == "stosb" { put(0xAA); }
        || s == "stosq" { put(0x48); put(0xAB); } || s == "cmpsb" { put(0xA6); } || s == "scasb" { put(0xAE); }
        || { fail("not known: " + mn + " " + s); }
        :;
    }
    k = 0;
    * k < NOPS { operand(k, ops[k]); k = k + 1; }
    a = OK[0]; c = OK[1];
    check(mn);

    mn == "ret" { put(0xC3); :; }
    mn == "syscall" { put(0x0F); put(0x05); :; }
    mn == "cqo" { put(0x48); put(0x99); :; }
    mn == "nop" { put(0x90); :; }
    mn == "jmp" || mn == "call" || mn.starts_with("j") && CC.contains(mn.slice(1)) {
        a != 3 {                                // jmp [m] / jmp reg
            mn != "jmp" && mn != "call" { fail(mn + " takes a label"); }
            ext = 4;
            mn == "call" { ext = 2; }
            op_rm(0, false, [0xFF], ext, 0);
            :;
        }
        target = OV[0];
        mn == "call" { put(0xE8); imm(target - (HERE + 5), 4); :; }
        short_rel = target - (HERE + 2);
        // short when the target is near, from this pass's addresses (as nasm, each pass decides
        // again; after many passes a jump only grows, so the passes end)
        !STRICT && !NEARJ && !SHORTJ && !OUN[0] {
            want = !fits8(short_rel);
            GROW_ONLY && LONGJ[CUR] { want = true; }
            want != LONGJ[CUR] { LONGJ[CUR] = want; CHANGED = true; }
        }
        SHORTJ { FINAL && !fits8(short_rel) { fail("a short jump whose target is too far"); } LONGJ[CUR] = false; }
        NEARJ { LONGJ[CUR] = true; }
        near = LONGJ[CUR] || STRICT;
        mn == "jmp" {
            near { put(0xE9); imm(target - (HERE + 5), 4); } || { put(0xEB); put(short_rel); }
            :;
        }
        cc = CC[mn.slice(1)] || 0;
        near { put(0x0F); put(0x80 + cc); imm(target - (HERE + 6), 4); } || { put(0x70 + cc); put(short_rel); }
        :;
    }
    mn.starts_with("set") && CC.contains(mn.slice(3)) {
        op_rm(0, false, [0x0F, 0x90 + (CC[mn.slice(3)] || 0)], 0, 0);
        :;
    }
    ALU.contains(mn) {
        n = ALU[mn] || 0;
        c == 1 {                                // r/m, reg
            s = OS[1];
            s == 1 { op_rm(0, false, [n * 8], OR[1], 0); } || { op_rm(p66(s), s == 8, [n * 8 + 1], OR[1], 0); }
            :;
        }
        c == 2 {                                // reg, mem
            s = OS[0];
            s == 1 { op_rm(0, false, [n * 8 + 2], OR[0], 1); } || { op_rm(p66(s), s == 8, [n * 8 + 3], OR[0], 1); }
            :;
        }
        s = op_size(0);
        v = sx(OV[1], s);
        s == 1 {
            a == 1 && OR[0] == 0 && !OREX[0] { put(n * 8 + 4); imm(v, 1); :; }
            op_rm(0, false, [0x80], n, 0); imm(v, 1);
            :;
        }
        short8(1, v) { op_rm(p66(s), s == 8, [0x83], n, 0); imm(v, 1); :; }
        se32(v, s);
        isz = 4;
        s == 2 { isz = 2; }
        a == 1 && OR[0] == 0 {
            p66(s) != 0 { put(0x66); }
            s == 8 { put(0x48); }
            put(n * 8 + 5); imm(v, isz);
            :;
        }
        op_rm(p66(s), s == 8, [0x81], n, 0); imm(v, isz);
        :;
    }
    mn == "test" {
        c == 1 {
            s = OS[1];
            s == 1 { op_rm(0, false, [0x84], OR[1], 0); } || { op_rm(p66(s), s == 8, [0x85], OR[1], 0); }
            :;
        }
        s = op_size(0);
        v = OV[1];
        s == 1 {
            a == 1 && OR[0] == 0 && !OREX[0] { put(0xA8); imm(v, 1); :; }
            op_rm(0, false, [0xF6], 0, 0); imm(v, 1);
            :;
        }
        se32(v, s);
        a == 1 && OR[0] == 0 { s == 8 { put(0x48); } put(0xA9); imm(v, 4); :; }
        op_rm(p66(s), s == 8, [0xF7], 0, 0); imm(v, 4);
        :;
    }
    mn == "mov" {
        c == 1 {                                // r/m, reg
            s = OS[1];
            s == 1 { op_rm(0, false, [0x88], OR[1], 0); } || { op_rm(p66(s), s == 8, [0x89], OR[1], 0); }
            :;
        }
        c == 2 {                                // reg, mem
            s = OS[0];
            s == 1 { op_rm(0, false, [0x8A], OR[0], 1); } || { op_rm(p66(s), s == 8, [0x8B], OR[0], 1); }
            :;
        }
        s = op_size(0);
        v = OV[1];
        a == 1 {                                // reg, imm
            r = OR[0];
            s == 1 {
                r >= 8 || OREX[0] { rx = 0x40; r >= 8 { rx = 0x41; } put(rx); }
                put(0xB0 + (r & 7)); imm(v, 1);
                :;
            }
            s == 8 && (OREL[1] || OSTRICT[1] && OS[1] == 8) {    // a label (or strict qword): 64 bits, as nasm
                rx = 0x48; r >= 8 { rx = 0x49; }
                put(rx); put(0xB8 + (r & 7)); imm(v, 8);
                :;
            }
            s == 8 && !(v >= 0 && v <= 4294967295 && !OUN[1]) && fits32(v) {
                op_rm(0, true, [0xC7], 0, 0); imm(v, 4);
                :;
            }
            s == 8 && !(v >= 0 && v <= 4294967295) {
                rx = 0x48; r >= 8 { rx = 0x49; }
                put(rx); put(0xB8 + (r & 7)); imm(v, 8);
                :;
            }
            s == 2 { put(0x66); }
            r >= 8 { put(0x41); }
            put(0xB8 + (r & 7));
            s == 2 { imm(v, 2); } || { imm(v, 4); }
            :;
        }
        s == 1 { op_rm(0, false, [0xC6], 0, 0); imm(v, 1); :; }      // mem, imm
        se32(v, s);
        op_rm(p66(s), s == 8, [0xC7], 0, 0);
        s == 2 { imm(v, 2); } || { imm(v, 4); }
        :;
    }
    mn == "lea" { op_rm(0, OS[0] == 8, [0x8D], OR[0], 1); :; }
    mn == "movzx" || mn == "movsx" {
        OS[0] != 4 && OS[0] != 8 || OS[1] != 1 && OS[1] != 2 { fail(mn + " goes from 8 or 16 bits into 32 or 64"); }
        op = 0xB6;
        mn == "movsx" { op = 0xBE; }
        op_size(1) == 2 { op = op + 1; }
        op_rm(0, OS[0] == 8, [0x0F, op], OR[0], 1);
        :;
    }
    mn == "push" || mn == "pop" {
        a == 1 {
            OS[0] != 8 { fail(mn + " takes a 64-bit register"); }
            OR[0] >= 8 { put(0x41); }
            mn == "push" { put(0x50 + (OR[0] & 7)); } || { put(0x58 + (OR[0] & 7)); }
            :;
        }
        a == 3 {
            mn == "pop" { fail("pop takes a register or memory"); }
            se32(OV[0], 8);
            short8(0, OV[0]) { put(0x6A); imm(OV[0], 1); } || { put(0x68); imm(OV[0], 4); }
            :;
        }
        OS[0] != 0 && OS[0] != 8 { fail(mn + " takes a 64-bit register or qword memory"); }
        mn == "push" { op_rm(0, false, [0xFF], 6, 0); } || { op_rm(0, false, [0x8F], 0, 0); }
        :;
    }
    mn == "inc" || mn == "dec" {
        ext = 0;
        mn == "dec" { ext = 1; }
        s = op_size(0);
        s == 1 { op_rm(0, false, [0xFE], ext, 0); } || { op_rm(p66(s), s == 8, [0xFF], ext, 0); }
        :;
    }
    UNARY.contains(mn) && NOPS == 1 {
        s = op_size(0);
        s == 1 { op_rm(0, false, [0xF6], UNARY[mn] || 0, 0); } || { op_rm(p66(s), s == 8, [0xF7], UNARY[mn] || 0, 0); }
        :;
    }
    mn == "imul" {
        NOPS == 2 { op_rm(0, OS[0] == 8, [0x0F, 0xAF], OR[0], 1); :; }
        v = OV[2];
        short8(2, v) { op_rm(0, OS[0] == 8, [0x6B], OR[0], 1); imm(v, 1); :; }
        se32(v, OS[0]);
        op_rm(0, OS[0] == 8, [0x69], OR[0], 1); imm(v, 4);
        :;
    }
    SHIFT.contains(mn) {
        ext = SHIFT[mn] || 0;
        s = op_size(0);
        w = s == 8;
        c == 1 {                                // by cl
            OR[1] != 1 || OS[1] != 1 { fail("a shift by a register takes cl"); }
            NOPS = 1;
            s == 1 { op_rm(0, false, [0xD2], ext, 0); } || { op_rm(p66(s), w, [0xD3], ext, 0); }
            :;
        }
        v = OV[1];
        v == 1 && !OUN[1] { s == 1 { op_rm(0, false, [0xD0], ext, 0); } || { op_rm(p66(s), w, [0xD1], ext, 0); } :; }
        s == 1 { op_rm(0, false, [0xC0], ext, 0); } || { op_rm(p66(s), w, [0xC1], ext, 0); }
        imm(v, 1);
        :;
    }
    BITS.contains(mn) {
        c == 3 { op_rm(p66(OS[0]), OS[0] == 8, [0x0F, 0xBA], BITS[mn] || 0, 0); imm(OV[1], 1); :; }
        op = 0xA3;
        mn == "bts" { op = 0xAB; } || mn == "btr" { op = 0xB3; } || mn == "btc" { op = 0xBB; }
        op_rm(p66(OS[1]), OS[1] == 8, [0x0F, op], OR[1], 0);
        :;
    }
    mn == "bsr" || mn == "bsf" {
        op = 0xBD;
        mn == "bsf" { op = 0xBC; }
        op_rm(0, OS[0] == 8, [0x0F, op], OR[0], 1);
        :;
    }
    mn == "bswap" {
        OR[0] >= 8 || OS[0] == 8 { rx = 0x40; OS[0] == 8 { rx = rx | 8; } OR[0] >= 8 { rx = rx | 1; } put(rx); }
        put(0x0F); put(0xC8 + (OR[0] & 7));
        :;
    }
    mn == "xchg" {
        s = OS[0];
        c == 1 && a == 1 && s >= 4 && (OR[0] == 0 || OR[1] == 0) {        // with rax / eax: 90 + r (nasm)
            other = OR[0] + OR[1];
            other == 0 { fail("xchg of rax with itself"); }
            rx = 0x40; s == 8 { rx = rx | 8; } other >= 8 { rx = rx | 1; }
            rx != 0x40 { put(rx); }
            put(0x90 + (other & 7));
            :;
        }
        c == 1 && a == 1 { s == 1 { op_rm(0, false, [0x86], OR[0], 1); } || { op_rm(p66(s), s == 8, [0x87], OR[0], 1); } :; }
        fail("xchg: only between registers here");
    }
    mn == "cvtsi2sd" { op_rm(0xF2, OS[1] == 8, [0x0F, 0x2A], OR[0], 1); :; }
    mn == "divsd" || mn == "mulsd" || mn == "addsd" || mn == "subsd" {
        op = 0x5E;
        mn == "mulsd" { op = 0x59; } || mn == "addsd" { op = 0x58; } || mn == "subsd" { op = 0x5C; }
        op_rm(0xF2, false, [0x0F, op], OR[0], 1);
        :;
    }
    mn == "movq" {
        (OS[0] == 16) == (OS[1] == 16) || OK[0] == 3 || OK[1] == 3 { fail("movq here: an xmm register and a 64-bit register or memory"); }
        OK[0] == 2 { op_rm(0x66, false, [0x0F, 0xD6], OR[1], 0); :; }      // movq m64, xmm (nasm: 66 0F D6)
        OK[1] == 2 { op_rm(0xF3, false, [0x0F, 0x7E], OR[0], 1); :; }      // movq xmm, m64 (nasm: F3 0F 7E)
        OS[1] == 16 { op_rm(0x66, true, [0x0F, 0x7E], OR[1], 0); :; }       // movq r64, xmm
        op_rm(0x66, true, [0x0F, 0x6E], OR[0], 1);                         // movq xmm, r64
        :;
    }
    mn == "prefetcht0" { op_rm(0, false, [0x0F, 0x18], 1, 0); :; }
    fail("not known: " + mn);
}

// ---- the passes ----
OUT = [0 ; *16384];             // the bytes, written by the last pass only
NOUT = 0;                       // the bytes so far in every pass (the address), written or not
LADDR = [0 ; 0];                // each line's address (assemble() gives it one per line)

out_byte(x = 0) {
    FINAL { OUT[] = x & 255; }
    NOUT = NOUT + 1;
}

// db / dw / dd / dq: numbers, expressions and (db) texts
data(size = 0, args = "") {
    split_commas(args) : it {
        q = 0;
        #it > 0 { q = it[0]; }
        (q == '\'' || q == '"' || q == '`') && it.ends_with(it.slice(0, 1)) && #it >= 2 && is_text(it) {
            k = 1;
            * k < #it - 1 { out_byte(it[k]); k = k + 1; }
            n = #it - 2;
            * n % size != 0 { out_byte(0); n = n + 1; }
        } || size == 8 && #it > 0 && is_digit(it[0]) && it.contains(".") {
            v = float_bits(it);
            k = 0;
            * k < 8 { out_byte(v >> (8 * k)); k = k + 1; }
        } || {
            UNRES = false;
            v = eval(it);
            one_label(it);
            FINAL && size < 8 {
                lim = 1 << (8 * size);
                v < -(lim / 2) || v >= lim { fail("the value " + $v + " does not fit in " + $size + " byte(s)"); }
            }
            k = 0;
            * k < size { out_byte(v >> (8 * k)); k = k + 1; }
        }
    }
}
// dq 1.0e22: the bits of the double, for a decimal that a double holds exactly (the digits as
// an integer m, times 10^e = 5^e × 2^e, with m × 5^e below 2^53); anything else is refused
// rather than rounded in some other way than nasm's
float_bits(t = "") {
    m = 0; e = 0; seen_dot = false;
    i = 0;
    * i < #t && t[i] != 'e' && t[i] != 'E' {
        c = t[i];
        c == '.' { seen_dot = true; } || is_digit(c) {
            m > 99999999999999999 { fail("too many digits: " + t); }
            m = m * 10 + (c - '0');
            seen_dot { e = e - 1; }
        } || { fail("not a number: " + t); }
        i = i + 1;
    }
    i < #t { x? = t.slice(i + 1).int(); x == _ { fail("not a number: " + t); } e = e + (x || 0); }
    m == 0 { : 0; }
    * e < 0 && m % 10 == 0 { m = m / 10; e = e + 1; }
    e < 0 || e > 26 { fail("not exact as a double here: " + t); }
    k = 0;
    * k < e { m > 1844674407370955161 { fail("not exact as a double here: " + t); } m = m * 5; k = k + 1; }
    bits = 0;
    * bits < 63 && (m >> bits) > 0 { bits = bits + 1; }
    bits > 53 { fail("not exact as a double here: " + t); }
    exp = bits - 1 + e;
    frac = (m << (53 - bits)) & 4503599627370495;
    : ((exp + 1023) << 52) | frac;
}

// '…' as a whole item (not 'a' + 1)
is_text(it = "") {
    q = it[0];
    k = 1;
    * k < #it - 1 { it[k] == q { : false; } k = k + 1; }
    : true;
}

// one line: its label, equ, a directive or an instruction
line(i = 0) {
    CUR = i;
    WHERE = LF[i] + ":" + $LN[i] + ": ";
    t = LT[i];
    HERE = ORG + NOUT;
    LADDR[i] = HERE;
    // label:
    j = 0;
    * j < #t && is_word(t[j]) { j = j + 1; }
    j > 0 && j < #t && t[j] == ':' {
        name = t.slice(0, j);
        !name.starts_with(".") && !name.starts_with("..@") {
            LAST = name;
            FINAL { PLAIN_NAMES[] = name; PLAIN_ADDRS[] = HERE - ORG; }   // for the profiler (runtime_sym_*)
        }
        set_sym(full_name(name), HERE, 1);
        t = t.slice(j + 1).trim();
    }
    #t == 0 { :; }
    w = first_word(t).lower();
    rest = after_word(t);
    // NAME equ expr
    first_word(rest).lower() == "equ" {
        UNRES = false;
        v = eval(after_word(rest));
        set_sym(full_name(first_word(t)), v, RL);
        :;
    }
    w == "bits" { rest != "64" { fail("bits 64 only"); } :; }
    w == "default" { rest.lower() != "abs" { fail("default abs only (the runtime's addresses are absolute)"); } :; }
    w == "org" { NOUT > 0 { fail("org after the first byte"); } UNRES = false; ORG = eval(rest); :; }
    w == "align" {
        UNRES = false;
        n = eval(rest);
        n <= 0 { fail("align takes a positive number"); }
        * (ORG + NOUT) % n != 0 { out_byte(0x90); }
        :;
    }
    w == "times" {
        // times COUNT what: the count is the expression up to the first word that is not part of it
        k = 0;
        at = -1;
        * k < #rest && at < 0 { (rest[k] == ' ' || rest[k] == '\t') && kind_word(rest.slice(k).trim()) { at = k; } k = k + 1; }
        at < 0 { fail("times: what does it repeat?"); }
        UNRES = false;
        n = eval(rest.slice(0, at));
        what = rest.slice(at).trim();
        n < 0 {
            FINAL || !UNRES { fail("times with a negative count (" + $n + "): an ASSERT that does not hold"); }
            n = 0;
        }
        c2 = 0;
        * c2 < n { one(what); c2 = c2 + 1; }
        :;
    }
    one(t);
}
// the next word starts what times repeats (a directive or an instruction)
kind_word(s = "") {
    w = first_word(s).lower();
    : w == "db" || w == "dw" || w == "dd" || w == "dq" || w == "nop";
}

one(t = "") {
    w = first_word(t).lower();
    rest = after_word(t);
    w == "db" { data(1, rest); :; }
    w == "dw" { data(2, rest); :; }
    w == "dd" { data(4, rest); :; }
    w == "dq" { data(8, rest); :; }
    mn = w;
    ops = split_commas(rest);
    (w == "rep" || w == "repe" || w == "repne") { ops = [first_word(rest).lower()]; }
    encode(mn, ops);
    RIP_AT >= 0 {
        d = RIP_TO - (HERE + NI);
        k = 0;
        * k < 4 { INS[RIP_AT + k] = (d >> (8 * k)) & 255; k = k + 1; }
    }
    k = 0;
    * k < NI { out_byte(INS[k]); k = k + 1; }
}

assemble() {
    LADDR = [0 ; #LT];
    LONGJ = [false ; #LT];
    pass = 0;
    * true {
        pass = pass + 1;
        PASS = pass;
        pass > 60 { fail("the addresses do not settle"); }
        GROW_ONLY = pass > 30;
        CHANGED = false;
        NOUT = 0; ORG = 0; LAST = "";
        i = 0;
        * i < #LT { line(i); i = i + 1; }
        !CHANGED { FINAL = true; PASS = pass + 1; NOUT = 0; ORG = 0; LAST = ""; i = 0; * i < #LT { line(i); i = i + 1; } :; }
    }
}

ALL_BYTES = "\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0A\x0B\x0C\x0D\x0E\x0F\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1A\x1B\x1C\x1D\x1E\x1F\x20\x21\x22\x23\x24\x25\x26\x27\x28\x29\x2A\x2B\x2C\x2D\x2E\x2F\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x3A\x3B\x3C\x3D\x3E\x3F\x40\x41\x42\x43\x44\x45\x46\x47\x48\x49\x4A\x4B\x4C\x4D\x4E\x4F\x50\x51\x52\x53\x54\x55\x56\x57\x58\x59\x5A\x5B\x5C\x5D\x5E\x5F\x60\x61\x62\x63\x64\x65\x66\x67\x68\x69\x6A\x6B\x6C\x6D\x6E\x6F\x70\x71\x72\x73\x74\x75\x76\x77\x78\x79\x7A\x7B\x7C\x7D\x7E\x7F\x80\x81\x82\x83\x84\x85\x86\x87\x88\x89\x8A\x8B\x8C\x8D\x8E\x8F\x90\x91\x92\x93\x94\x95\x96\x97\x98\x99\x9A\x9B\x9C\x9D\x9E\x9F\xA0\xA1\xA2\xA3\xA4\xA5\xA6\xA7\xA8\xA9\xAA\xAB\xAC\xAD\xAE\xAF\xB0\xB1\xB2\xB3\xB4\xB5\xB6\xB7\xB8\xB9\xBA\xBB\xBC\xBD\xBE\xBF\xC0\xC1\xC2\xC3\xC4\xC5\xC6\xC7\xC8\xC9\xCA\xCB\xCC\xCD\xCE\xCF\xD0\xD1\xD2\xD3\xD4\xD5\xD6\xD7\xD8\xD9\xDA\xDB\xDC\xDD\xDE\xDF\xE0\xE1\xE2\xE3\xE4\xE5\xE6\xE7\xE8\xE9\xEA\xEB\xEC\xED\xEE\xEF\xF0\xF1\xF2\xF3\xF4\xF5\xF6\xF7\xF8\xF9\xFA\xFB\xFC\xFD\xFE\xFF";           // each byte, to write them as they are

plain_names() {
    parts = ["" ; #PLAIN_NAMES];
    k = 0;
    * k < #PLAIN_NAMES { parts[k] = PLAIN_NAMES[k]; k = k + 1; }
    : parts.join(" ");
}

plain_offsets() {
    parts = ["" ; #PLAIN_ADDRS];
    k = 0;
    * k < #PLAIN_ADDRS { parts[k] = $PLAIN_ADDRS[k]; k = k + 1; }
    : parts.join(", ");
}

main() {
    src = ""; dirs = ""; out = ""; defs = ""; listing = "";
    << src;
    << dirs;
    << out;
    << defs;
    << listing;
    setup_regs();
    setup_cc();
    dirs.split(" ") : part { d = part.trim(); #d > 0 { !d.ends_with("/") { d = d + "/"; } INCDIRS[] = d; } }
    defs.split(" ") : part {
        d = part.trim();
        d.starts_with("-D") {
            eq? = d.find("=");
            eq == _ { DEFS[d.slice(2)] = ""; } || { DEFS[d.slice(2, eq || 0)] = d.slice((eq || 0) + 1); }
        } || #d > 0 { fail("a name to define is -DNAME or -DNAME=VALUE: " + d); }
    }
    preprocess(src);
    assemble();
    // out.bin: the bytes themselves (to compare with nasm -f bin); else src1/runtime_bin.nihil's text
    out.ends_with(".bin") {
        bytes = ["" ; NOUT];
        k = 0;
        * k < NOUT { bytes[k] = ALL_BYTES.slice(OUT[k], OUT[k] + 1); k = k + 1; }
        @>> out, bytes.join("");
        :;
    }
    nums = ["" ; NOUT];
    k = 0;
    * k < NOUT { nums[k] = $OUT[k]; k = k + 1; }
    @>> out, "// generated from src/runtime.asm by `make runtime` (asm/asm.nihil; nasm gives the same bytes) — do not edit; `make runtime-check` compares\nruntime_bin = ["
        + nums.join(", ") + "\n];\n"
        + "// the runtime's plain labels (the profiler names the code by them): names, then offsets\n"
        + "runtime_sym_names = \"" + plain_names() + "\";\n"
        + "runtime_sym_ofs = [" + plain_offsets() + "];\n";
    !>> "asm: " + $NOUT + " bytes, " + $#LT + " lines\n";
    // a listing (for finding a difference with nasm's): file:line address size text
    #listing > 0 {
        ls = ["" ; #LT];
        k = 0;
        * k < #LT {
            size = NOUT - (LADDR[k] - ORG);
            k + 1 < #LT { size = LADDR[k + 1] - LADDR[k]; }
            ls[k] = $LN[k] + " " + $(LADDR[k] - ORG) + " " + $size + " " + LT[k];
            k = k + 1;
        }
        @>> listing, ls.join("\n") + "\n";
    }
}

main();
