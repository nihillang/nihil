#!/bin/sh
# nihil — the command line of the Nihil compiler (https://nihil-lang.dev)
#
#   nihil PROGRAM.nihil [OUT]        compile into a native executable (OUT: PROGRAM without .nihil)
#   nihil run PROGRAM.nihil [ARG…]   compile into a temporary file and run it
#   nihil ide [--no-window]          the IDE, in an app window (workspace: ~/Nihil); its server
#                                    runs in the background (--foreground: in this terminal)
#   nihil ide stop                   stop the IDE's server
#   nihil version                    the version installed
#
#   NIHIL_O0=1   no optimizations
#
# The same script for every platform: on Linux x86_64 the compiler writes the executable itself;
# on macOS (Apple silicon) its x86-64 code is translated to ARM64 and linked by clang with the
# runtime (docs/macos-arm64.md), which needs the Xcode Command Line Tools (clang, objdump).
set -eu

# where this installation is: bin/nihil, resolving the symbolic link that put it on the PATH
self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in
        /*) self=$link ;;
        *) self=$(dirname "$self")/$link ;;
    esac
done
home=$(cd "$(dirname "$self")/.." && pwd -P)
lib=$home/libexec/nihil

usage() {
    echo "usage: nihil PROGRAM.nihil [OUT] | nihil run PROGRAM.nihil [ARG…] | nihil ide [stop] | nihil version" >&2
    exit 2
}

# opens URL in an app window (a browser with --app: no tabs, no address bar), or in the default browser
open_window() {
    url=$1
    if [ "$(uname -s)" = Darwin ]; then
        # the package's own app: a window of its own, with the Nihil icon
        # (its copy in ~/Applications, when it is this installation's, so there is one app in the Dock)
        app="$lib/Nihil IDE.app"
        copy="$HOME/Applications/Nihil IDE.app"
        if [ "$(cat "$copy/Contents/Resources/nihil-home" 2>/dev/null)" = "$home" ]; then app=$copy; fi
        if [ -d "$app" ]; then
            open -a "$app" --args "$url"
            return
        fi
        for app in "Google Chrome" "Microsoft Edge" "Brave Browser" "Chromium"; do
            if [ -d "/Applications/$app.app" ] || [ -d "$HOME/Applications/$app.app" ]; then
                open -na "$app" --args --app="$url" --new-window
                return
            fi
        done
        open "$url"
        return
    fi
    if [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
        echo "No display: open $url in a browser (through an SSH tunnel from another machine)"
        return
    fi
    # a browser of its own (its own profile), with the window class NihilIDE: the menu entry the
    # installer writes (nihil-ide.desktop, StartupWMClass=NihilIDE) gives it the Nihil icon in the
    # taskbar and in Alt+Tab. Returns when the window is closed.
    for b in google-chrome google-chrome-stable chromium chromium-browser microsoft-edge brave-browser; do
        if command -v "$b" >/dev/null 2>&1; then
            profile=${XDG_STATE_HOME:-$HOME/.local/state}/nihil/browser
            mkdir -p "$profile"
            "$b" --app="$url" --class=NihilIDE --user-data-dir="$profile" --no-first-run \
                --no-default-browser-check >/dev/null 2>&1
            return
        fi
    done
    if command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$url" >/dev/null 2>&1 &
    else
        echo "Open $url in a browser"
    fi
}

# the IDE: in a terminal, its server (in Nihil) starts in the background and the prompt comes back
# (`nihil ide stop` stops it); with --foreground, or when the output is not a terminal (the macOS
# app, scripts), it runs in the foreground instead. The window opens once the server answers.
ide() {
    server=$lib/ide-server
    [ -x "$server" ] || { echo "nihil: this installation has no IDE" >&2; exit 1; }
    window=true
    foreground=false
    for a in "$@"; do
        case $a in
            --no-window) window=false ;;
            --foreground) foreground=true ;;
            *) usage ;;
        esac
    done
    [ -t 1 ] || foreground=true
    ws=${NIHIL_WORKSPACE:-$HOME/Nihil}
    port=${NIHIL_IDE_PORT:-8730}
    url=http://127.0.0.1:$port/
    mkdir -p "$ws"
    # the examples are copied once, so they are the user's to change
    [ -e "$ws/examples" ] || cp -R "$home/share/nihil/examples" "$ws/examples"
    if curl -fs -o /dev/null "$url" 2>/dev/null; then
        echo "The IDE is already running: $url   (nihil ide stop stops it)"
        "$window" && open_window "$url"
        exit 0
    fi
    if ! "$foreground"; then
        state=$ws/.nihil-ide
        log=$state/server.log
        mkdir -p "$state"
        cd "$ws"
        NIHIL_IDE_INSTALL=$home NIHIL_IDE_ROOT=$ws NIHIL_IDE_PORT=$port nohup "$server" >> "$log" 2>&1 < /dev/null &
        server_pid=$!
        echo "$server_pid" > "$state/server.pid"
        i=0
        until curl -fs -o /dev/null "$url" 2>/dev/null; do
            if ! kill -0 "$server_pid" 2>/dev/null || [ $i -ge 50 ]; then
                tail -n 5 "$log" >&2
                echo "nihil: the IDE did not start (log: $log)" >&2
                kill "$server_pid" 2>/dev/null || true
                rm -f "$state/server.pid"
                exit 1
            fi
            sleep 0.2
            i=$((i + 1))
        done
        echo "Nihil IDE: $url   (workspace: $ws)"
        echo "Running in the background, log in $log; nihil ide stop stops it"
        "$window" || exit 0
        if [ "$(uname -s)" = Darwin ]; then
            open_window "$url"
        else
            # Linux: the IDE's own browser; closing its window stops the server, as in the foreground
            (
                trap '' HUP
                started=$(date +%s)
                open_window "$url"
                if [ $(($(date +%s) - started)) -gt 3 ] && [ -n "${profile:-}" ]; then
                    kill "$server_pid" 2>/dev/null || true
                    rm -f "$state/server.pid"
                fi
            ) > /dev/null 2>&1 &
        fi
        exit 0
    fi
    if "$window"; then
        server_pid=$$      # the server below takes this shell's place (exec)
        (
            i=0
            while [ $i -lt 50 ]; do
                if curl -fs -o /dev/null "$url" 2>/dev/null; then
                    started=$(date +%s)
                    open_window "$url"
                    # Linux: the window was the IDE's own browser and it was closed, so the server
                    # stops too (unless it came back at once: the window belonged to another one)
                    if [ "$(uname -s)" != Darwin ] && [ $(($(date +%s) - started)) -gt 3 ] && [ -n "${profile:-}" ]; then
                        kill "$server_pid" 2>/dev/null || true
                    fi
                    exit 0
                fi
                sleep 0.2
                i=$((i + 1))
            done
        ) &
    fi
    echo "Nihil IDE: $url   (workspace: $ws; Ctrl+C stops it)"
    cd "$ws"
    NIHIL_IDE_INSTALL=$home NIHIL_IDE_ROOT=$ws NIHIL_IDE_PORT=$port exec "$server"
}

# stops the IDE's server: the one `nihil ide` started in the background, or the one on the port
ide_stop() {
    ws=${NIHIL_WORKSPACE:-$HOME/Nihil}
    port=${NIHIL_IDE_PORT:-8730}
    file=$ws/.nihil-ide/server.pid
    pid=$(cat "$file" 2>/dev/null || true)
    if [ -z "$pid" ] || ! ps -p "$pid" -o command= 2>/dev/null | grep -q ide-server; then
        pid=$(lsof -t -nP -iTCP:"$port" -sTCP:LISTEN 2>/dev/null | head -n 1 || true)
        if [ -z "$pid" ] || ! ps -p "$pid" -o command= 2>/dev/null | grep -q ide-server; then
            rm -f "$file"
            echo "The IDE is not running"
            return 0
        fi
    fi
    kill "$pid"
    i=0
    while kill -0 "$pid" 2>/dev/null && [ $i -lt 25 ]; do
        sleep 0.2
        i=$((i + 1))
    done
    rm -f "$file"
    echo "Stopped the IDE (process $pid)"
}

# compile SRC into OUT
compile() {
    src=$1
    out=$2
    [ -f "$src" ] && [ -r "$src" ] || { echo "nihil: could not open $src" >&2; exit 1; }
    option=""
    [ "${NIHIL_O0:-0}" = 1 ] && option="-O0 "
    work=$(mktemp -d)
    trap 'rm -rf "$work"' EXIT
    if [ -x "$lib/nihilc1-native" ]; then
        # macOS: the compiler emits x86-64 code and a map; the translator makes ARM64 assembly of it
        if ! printf '%s\n' "$option-map $src" | "$lib/nihilc1-native" > "$work/p.x86" 2> "$work/p.map"; then
            grep -v '^nihil-map' "$work/p.map" >&2 || true
            exit 1
        fi
        grep -v '^nihil-map' "$work/p.map" >&2 || true
        printf '%s\n%s\n%s\n' "$work/p.x86" "$work/p.map" "$work/p.s" | "$lib/translate" 2> "$work/t.err" || { cat "$work/t.err" >&2; exit 1; }
        clang -arch arm64 -o "$out" "$work/p.s" "$lib/rt.o"
    else
        # Linux x86_64: the compiler writes the ELF executable to its standard output
        printf '%s\n' "$option$src" | "$lib/nihilc1" > "$work/p.out" || exit 1
        cat "$work/p.out" > "$out" 2>/dev/null && chmod 755 "$out" 2>/dev/null || { echo "nihil: could not create $out" >&2; exit 1; }
    fi
    rm -rf "$work"
    trap - EXIT
}

[ $# -ge 1 ] || usage
case $1 in
    version|--version|-v)
        echo "nihil $(cat "$home/VERSION" 2>/dev/null || echo unknown)"
        ;;
    help|--help|-h)
        sed -n '2,12p' "$self" | sed 's/^# \{0,1\}//'
        ;;
    ide)
        shift
        if [ "${1:-}" = stop ]; then ide_stop; else ide "$@"; fi
        ;;
    run)
        [ $# -ge 2 ] || usage
        src=$2
        shift 2
        dir=$(mktemp -d)
        compile "$src" "$dir/program"
        set +e
        "$dir/program" "$@"
        code=$?
        rm -rf "$dir"
        exit $code
        ;;
    -*)
        usage
        ;;
    *)
        src=$1
        out=${2:-${1%.nihil}}
        [ "$out" != "$src" ] || out=$src.out
        compile "$src" "$out"
        ;;
esac
