/// Welcome to the Nihil IDE.
//   Ctrl+Enter  run          Ctrl+S  save
//   Ctrl+D in the terminal ends the input
fib(n = 0) {
    n < 2 { : n; }
    : fib(n - 1) + fib(n - 2);
}

i = 0;
10 { >> fib(i); >> " "; i = i + 1; }
>> "\n";

>> "Your name? ";
name = "";
<< name;
>> "Hello, " + name + "!\n";

2
{
    >> 1;
}
