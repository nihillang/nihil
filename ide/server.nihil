// =============================================================================
// ide/server.nihil — the Nihil IDE server, written in Nihil (it replaces server.py).
//
//   make ide        (builds build/ide-server)      then   ./build/ide-server
//   nihil ide       an installed Nihil (dist/nihil): the workspace is ~/Nihil
//
// Open http://127.0.0.1:8730 (through an SSH tunnel from another machine). The server
// keeps a list of projects (folders), lists their programs and tables, saves files,
// compiles them with nihilc1 and runs them in the project's folder; the page polls
// the output. It runs whatever code it is given: it only listens on 127.0.0.1.
// =============================================================================

PORT = 8730;
MAX_RUN_MS = 600000;            // a program is stopped after 10 minutes
ABANDONED_MS = 30000;           // … or when the page has not asked for its output for 30 s
MAX_RUNS = 8;                   // programs running at a time
RUNS_DIR = "";                  // build/runs: the programs and their output (not /tmp, where
                                // another user could put a link with the name before us)
SKIP = ["build", "node_modules", "__pycache__", "venv", "gerado_antes"];

ROOT = "";                      // the Nihil repository (the folder the server starts in), or the workspace
HOME = "";
// started by `nihil ide` from an installed Nihil (NIHIL_IDE_INSTALL): ROOT is then the user's
// workspace (~/Nihil), a project like any other, and the compiler, the page, the SPEC and the
// examples come from the installation
REPO = true;
INSTALL = "";
COMPILER = "";                  // nihilc1.sh in the repository, bin/nihil when installed
STATIC_DIR = "";                // the page
DOCS = "";                      // where SPEC.md and examples/ are
// a secret drawn at every start: the page carries it and sends it with every /api/ call, so a
// page of another site (which cannot read this page) cannot use the API
TOKEN = "";

// ---- small helpers --------------------------------------------------------------------
now_ms() {
    up = (@ "/proc/uptime").split(" ");
    : #((up[0].float() || 0.0) * 1000.0 + 0.5);
}

q(s = "") {
    : s.json_quote();
}

// FNV-1a (32 bits) of the bytes: the page sends the one of the text it loaded, so a file
// changed on disk since then is not overwritten without asking
fnv(s = "") {
    h = 2166136261;
    i = 0;
    * i < #s { h = ((h ^ s[i]) * 16777619) & 0xFFFFFFFF; i = i + 1; }
    : h;
}

// the length of t without an incomplete UTF-8 character at its end (output read while the
// program writes it may stop in the middle of one)
utf8_whole(t = "") {
    n = #t;
    k = n - 1;
    back = 0;
    * k >= 0 && back < 4 && (t[k] & 0xC0) == 0x80 { k = k - 1; back = back + 1; }
    k < 0 { : n; }
    c = t[k];
    need = 1;
    (c & 0xE0) == 0xC0 { need = 2; }
    (c & 0xF0) == 0xE0 { need = 3; }
    (c & 0xF8) == 0xF0 { need = 4; }
    n - k < need { : k; }
    : n;
}

// a relative path the page may use: no "..", not absolute, not empty, no control bytes (a
// zero byte would cut the path the kernel sees: "notes.txt\0.nihil" would open notes.txt)
safe_rel(p = "") {
    #p == 0 || p.starts_with("/") { : false; }
    i = 0;
    * i < #p { p[i] < 32 { : false; } i = i + 1; }
    parts = p.split("/");
    i = 0;
    * i < #parts { parts[i] == ".." || parts[i] == "" { : false; } i = i + 1; }
    : true;
}

base_name(p = "") {
    parts = p.split("/");
    : parts[#parts - 1];
}

// ---- projects -----------------------------------------------------------------------------
PROJECTS_FILE = "";

projects() {
    t? = @? PROJECTS_FILE;
    lines = (t || "").split("\n");
    out = [ROOT];
    i = 0;
    * i < #lines {
        l = lines[i].trim();
        #l > 0 && l != ROOT && !out.contains(l) { out = out + [l]; }
        i = i + 1;
    }
    : out;
}

projects_json() {
    ps = projects();
    parts = ["" ; #ps];
    i = 0;
    * i < #ps {
        name = base_name(ps[i]);
        ps[i] == ROOT && REPO { name = "nihil (the language)"; }
        ps[i] == ROOT && !REPO { name = "Nihil (workspace)"; }
        parts[i] = "{\"name\": " + q(name) + ", \"path\": " + q(ps[i]) + ", \"ok\": " + $ps[i].is_dir() + "}";
        i = i + 1;
    }
    : "{\"projects\": [" + parts.join(", ") + "]}";
}

save_projects(ps = [""]) {
    extra = ["" ; 0];
    i = 0;
    * i < #ps { ps[i] != ROOT { extra = extra + [ps[i]]; } i = i + 1; }
    @>> PROJECTS_FILE, extra.join("\n") + "\n";
}

// the project a request names (one of the list), or ""
project_of(p = "") {
    ps = projects();
    ps.contains(p) { : p; }
    : "";
}

// ---- the project's database: DATABASE_DIR in its .env ---------------------------------------
// a key of the project's .env ("" when it is not set)
project_env(project = "", key = "") {
    t? = @? (project + "/.env");
    lines = (t || "").split("\n");
    i = 0;
    * i < #lines {
        l = lines[i].trim();
        eq? = l.find("=");
        !l.starts_with("#") && eq != _ && l.slice(0, eq || 0).trim() == key { : l.slice((eq || 0) + 1).trim(); }
        i = i + 1;
    }
    : "";
}

// the database folder when it is outside the project (absolute DATABASE_DIR), else ""
outside_db(project = "") {
    d = project_env(project, "DATABASE_DIR");
    * #d > 1 && d.ends_with("/") { d = d.slice(0, #d - 1); }
    !d.starts_with("/") || d == project || d.starts_with(project + "/") { : ""; }
    : d;
}

// the file of a table the page names: "@db/…" is in the outside database folder
table_file(project = "", rel = "") {
    rel.starts_with("@db/") {
        db = outside_db(project);
        #db == 0 || !safe_rel(rel.slice(4)) { : ""; }
        : db + "/" + rel.slice(4);
    }
    !safe_rel(rel) { : ""; }
    : project + "/" + rel;
}

// the .dat files under the outside database folder (as "@db/…")
walk_db(dir = "", rel = "", depth = 0) {
    depth > 4 { :; }
    full = dir;
    #rel > 0 { full = dir + "/" + rel; }
    names? = full.list();
    ns = names || ["" ; 0];
    i = 0;
    * i < #ns {
        r = ns[i];
        #rel > 0 { r = rel + "/" + ns[i]; }
        !ns[i].starts_with(".") {
            (dir + "/" + r).is_dir() { walk_db(dir, r, depth + 1); }
            || ns[i].ends_with(".dat") { TABLES = TABLES + ["@db/" + r]; }
        }
        i = i + 1;
    }
}

// ---- files of a project -------------------------------------------------------------------
FILES = ["" ; 0];
TABLES = ["" ; 0];
DIRS = ["" ; 0];                // the folders walked (empty ones too), relative to the project

// the folders that are listed and can be saved: the whole project, or for the language
// repository only the workspace and the examples (its sources are not edited from here)
roots_of(project = "") {
    REPO && project == ROOT { : ["ide/workspace", "examples"]; }
    : [""];
}

// a folder that may be made: inside the project, not in build/; in the language repository
// only inside ide/workspace or examples
folder_ok(project = "", rel = "") {
    !safe_rel(rel) || rel == "build" || rel.starts_with("build/") { : false; }
    project != ROOT || !REPO { : true; }
    : rel.starts_with("ide/workspace/") || rel.starts_with("examples/");
}

editable(project = "", rel = "") {
    !safe_rel(rel) || !rel.ends_with(".nihil") || rel.starts_with("build/") { : false; }
    project != ROOT || !REPO { : true; }
    : rel.starts_with("ide/workspace/") || rel.starts_with("examples/");
}

walk(project = "", rel = "", depth = 0) {
    depth > 6 || #FILES + #TABLES > 5000 { :; }
    dir = project;
    #rel > 0 { dir = project + "/" + rel; }
    names? = dir.list();
    ns = names || ["" ; 0];
    i = 0;
    * i < #ns {
        n = ns[i];
        r = n;
        #rel > 0 { r = rel + "/" + n; }
        !n.starts_with(".") && !SKIP.contains(n) {
            (project + "/" + r).is_dir() { DIRS = DIRS + [r]; walk(project, r, depth + 1); }
            || n.ends_with(".nihil") { FILES = FILES + [r]; }
            || n.ends_with(".dat") { TABLES = TABLES + [r]; }
        }
        i = i + 1;
    }
}

files_json(project = "") {
    FILES = ["" ; 0];
    TABLES = ["" ; 0];
    DIRS = ["" ; 0];
    rs = roots_of(project);
    i = 0;
    * i < #rs { #rs[i] > 0 && (project + "/" + rs[i]).is_dir() { DIRS = DIRS + [rs[i]]; } walk(project, rs[i], 0); i = i + 1; }
    db = outside_db(project);
    #db > 0 { walk_db(db, "", 0); }
    f = ["" ; #FILES];
    i = 0;
    * i < #FILES { f[i] = q(FILES[i]); i = i + 1; }
    t = ["" ; #TABLES];
    info = ["" ; #TABLES];
    i = 0;
    * i < #TABLES {
        t[i] = q(TABLES[i]);
        // size and records without reading the table: its lines all have the first one's width
        full = table_file(project, TABLES[i]);
        size = full.size() || 0;
        first = full.read_from(0, 4096) || "";
        nl? = first.find("\n");
        width = size;
        nl != _ { width = nl || 0; }
        records = 0;
        size > 0 { records = (size + 1) / (width + 1); }
        info[i] = "{\"path\": " + q(TABLES[i]) + ", \"bytes\": " + $size + ", \"records\": " + $records + "}";
        i = i + 1;
    }
    d = ["" ; #DIRS];
    i = 0;
    * i < #DIRS { d[i] = q(DIRS[i]); i = i + 1; }
    : "{\"files\": [" + f.join(", ") + "], \"tables\": [" + t.join(", ") + "], \"table_info\": [" + info.join(", ")
      + "], \"dirs\": [" + d.join(", ") + "]}";
}

// ---- tables: the data model that fits a .dat file ---------------------------------------------
// A model is "NAME = @[field: TYPE(width); …];" in a program of the project. The one chosen
// has the width of the file's lines, preferring a program that names the file.
M_NAME = ["" ; 0];          // every model found: name, file, fields (as JSON), width, the text
M_FILE = ["" ; 0];
M_FIELDS = ["" ; 0];        // "name|TYPE|width|key;…"
M_WIDTH = [0 ; 0];
M_TEXT = ["" ; 0];

ident_char(c = 0) {
    : c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '_';
}

// the text without // comments
no_comments(t = "") {
    ls = t.split("\n");
    i = 0;
    * i < #ls { c? = ls[i].find("//"); c != _ { ls[i] = ls[i].slice(0, c || 0); } i = i + 1; }
    : ls.join("\n");
}

// "#key: INT(5)" → "key|INT|5|1" ("#+id: …" → "…|2": automatic); "" if it is not a field
field_spec(part = "") {
    p = part.trim();
    key = "0";
    p.starts_with("#") { key = "1"; p = p.slice(1).trim(); }
    p.starts_with("+") && key == "1" { key = "2"; p = p.slice(1).trim(); }   // #+: an automatic key
    colon? = p.find(":");
    colon == _ { : ""; }
    name = p.slice(0, colon || 0).trim();
    rest = p.slice((colon || 0) + 1).trim();
    #name == 0 { : ""; }
    i = 0;
    * i < #name { !ident_char(name[i]) { : ""; } i = i + 1; }
    typ = rest;
    width = 0;
    paren? = rest.find("(");
    paren != _ {
        typ = rest.slice(0, paren || 0).trim();
        close? = rest.find(")");
        close == _ { : ""; }
        width = rest.slice((paren || 0) + 1, close || 0).trim().int() || 0;
    }
    typ != "INT" && typ != "STRING" && typ != "FLOAT" && typ != "BOOL" { : ""; }
    typ == "BOOL" { width = 1; }
    : name + "|" + typ + "|" + $width + "|" + key;
}

find_models(project = "") {
    M_NAME = ["" ; 0]; M_FILE = ["" ; 0]; M_FIELDS = ["" ; 0]; M_WIDTH = [0 ; 0]; M_TEXT = ["" ; 0];
    FILES = ["" ; 0];
    TABLES = ["" ; 0];
    rs = roots_of(project);
    i = 0;
    * i < #rs { walk(project, rs[i], 0); i = i + 1; }
    fi = 0;
    * fi < #FILES {
        text? = @? (project + "/" + FILES[fi]);
        clean = no_comments(text || "");
        at = 0;
        going = true;
        * going {
            m? = clean.find("@[", at);
            m == _ { going = false; } || {
                mp = m || 0;
                // backwards: "=" and the name, at the start of a line
                k = mp - 1;
                * k >= 0 && (clean[k] == ' ' || clean[k] == 9) { k = k - 1; }
                ok = k >= 0 && clean[k] == '=';
                k = k - 1;
                * ok && k >= 0 && (clean[k] == ' ' || clean[k] == 9) { k = k - 1; }
                e = k + 1;
                * ok && k >= 0 && ident_char(clean[k]) { k = k - 1; }
                name = clean.slice(k + 1, e);
                ok = ok && #name > 0;
                j = k;
                * ok && j >= 0 && (clean[j] == ' ' || clean[j] == 9) { j = j - 1; }
                ok = ok && (j < 0 || clean[j] == 10);
                close? = clean.find("]", mp);
                ok && close != _ {
                    cp = close || 0;
                    after = cp + 1;
                    * after < #clean && (clean[after] == ' ' || clean[after] == 9 || clean[after] == 10) { after = after + 1; }
                    after < #clean && clean[after] == ';' {
                        parts = clean.slice(mp + 2, cp).split(";");
                        specs = ["" ; 0];
                        width = 0;
                        good = true;
                        pi = 0;
                        * pi < #parts {
                            #parts[pi].trim() > 0 {
                                sp = field_spec(parts[pi]);
                                #sp == 0 { good = false; } || {
                                    specs = specs + [sp];
                                    width = width + (sp.split("|")[2].int() || 0);
                                }
                            }
                            pi = pi + 1;
                        }
                        good && #specs > 0 {
                            M_NAME = M_NAME + [name]; M_FILE = M_FILE + [FILES[fi]]; M_FIELDS = M_FIELDS + [specs.join(";")];
                            M_WIDTH = M_WIDTH + [width]; M_TEXT = M_TEXT + [text || ""];
                        }
                    }
                }
                at = mp + 2;
            }
        }
        fi = fi + 1;
    }
}

// the data model a table is read with: among the models of the programs whose lines have its
// width, the one in a program that names the table (else the first); -1 if none fits
pick_model(project = "", rel = "", width = 0) {
    find_models(project);
    base = base_name(rel);
    chosen = -1;
    i = 0;
    * i < #M_NAME {
        width < 0 || M_WIDTH[i] == width {
            chosen < 0 { chosen = i; } || !M_TEXT[chosen].contains(base) && M_TEXT[i].contains(base) { chosen = i; }
        }
        i = i + 1;
    }
    : chosen;
}

// "model", "from_file", "fields" and "rows" of a page: its lines, cut into cells
model_rows(chosen = 0, lines = [""], n = 0) {
    specs = M_FIELDS[chosen].split(";");
    fields = ["" ; #specs];
    types = ["" ; #specs];
    widths = [0 ; #specs];
    i = 0;
    * i < #specs {
        f = specs[i].split("|");
        types[i] = f[1];
        widths[i] = f[2].int() || 0;
        fields[i] = "{\"name\": " + q(f[0]) + ", \"type\": " + q(f[1]) + ", \"key\": " + $(f[3] != "0") + ", \"auto\": " + $(f[3] == "2") + ", \"width\": " + f[2] + "}";
        i = i + 1;
    }
    rows = ["" ; n];
    r = 0;
    * r < n {
        l = lines[r];
        #l != M_WIDTH[chosen] { rows[r] = "{\"bad\": " + q(l) + "}"; }
        || {
            cells = ["" ; #specs];
            pos = 0;
            c = 0;
            * c < #specs {
                cell = l.slice(pos, pos + widths[c]);
                pos = pos + widths[c];
                types[c] == "STRING" {
                    e = #cell;
                    * e > 0 && cell[e - 1] == ' ' { e = e - 1; }
                    cell = cell.slice(0, e);
                } || { cell = cell.trim(); }
                cells[c] = q(cell);
                c = c + 1;
            }
            rows[r] = "{\"cells\": [" + cells.join(", ") + "]}";
        }
        r = r + 1;
    }
    : "\"model\": " + q(M_NAME[chosen]) + ", \"from_file\": " + q(M_FILE[chosen]) + ", \"fields\": ["
      + fields.join(", ") + "], \"rows\": [" + rows.join(", ") + "]";
}

// a page of a table: rows from … from + limit - 1. Only that part of the file is read: a
// table has lines of one width, so line i starts at i × (width + 1) and the count comes
// from the size. Big tables (hundreds of MB) open as fast as small ones.
table_json(project = "", rel = "", from = 0, limit = 100) {
    !rel.ends_with(".dat") { : ""; }
    full = table_file(project, rel);
    #full == 0 { : ""; }
    sz? = full.size();
    sz == _ { : ""; }
    size = sz || 0;
    limit < 1 { limit = 1; }
    limit > 1000 { limit = 1000; }
    from < 0 { from = 0; }
    first = (full.read_from(0, 65536) || "");
    nl? = first.find("\n");
    width = -1;
    nl != _ { width = nl || 0; } || size > 0 && size <= 65536 { width = size; }
    chosen = pick_model(project, rel, width);
    others = ["" ; 0];
    i = 0;
    * i < #M_NAME {
        i != chosen && (width < 0 || M_WIDTH[i] == width) && (chosen < 0 || M_FIELDS[i] != M_FIELDS[chosen] || M_NAME[i] != M_NAME[chosen]) {
            o = q(M_NAME[i] + " (" + M_FILE[i] + ")");
            !others.contains(o) { others = others + [o]; }
        }
        i = i + 1;
    }
    // the count: whole lines of width + 1 bytes (the last one may lack its "\n")
    total = 0;
    width > 0 { total = (size + 1) / (width + 1); }
    lines = ["" ; 0];
    chosen >= 0 && width > 0 {
        from >= total && total > 0 { from = ((total - 1) / limit) * limit; }
        part = full.read_from(from * (width + 1), limit * (width + 1)) || "";
        lines = part.split("\n");
    } || {                                          // no model fits: the lines as they are
        text = (full.read_from(0, 4194304) || "");
        all = text.split("\n");
        n = #all;
        n > 0 && all[n - 1] == "" { n = n - 1; }
        total = n;
        from >= total && total > 0 { from = ((total - 1) / limit) * limit; }
        k = from;
        * k < n && k < from + limit { lines = lines + [all[k]]; k = k + 1; }
    }
    n = #lines;
    n > 0 && lines[n - 1] == "" { n = n - 1; }
    n > limit { n = limit; }
    head = "{\"path\": " + q(rel) + ", \"bytes\": " + $size + ", \"total\": " + $total + ", \"width\": " + $width
           + ", \"from\": " + $from + ", \"limit\": " + $limit + ", \"others\": [" + others.sort().join(", ") + "]";
    chosen < 0 || width <= 0 {
        raw = ["" ; n];
        i = 0;
        * i < n { raw[i] = q(lines[i]); i = i + 1; }
        : head + ", \"raw\": [" + raw.join(", ") + "]}";
    }
    : head + ", " + model_rows(chosen, lines, n) + "}";
}

// ---- queries on a table -------------------------------------------------------------------
// The filter and the order are Nihil: the server writes a program with the table's model,
// `rows = NAME @ path; sel = rows.where(filter).sort(order);`, compiles it with the language's
// compiler and runs it; its output is the selected lines, a table of the same width, which the
// page reads by pages like the table itself. The last result is kept until the query or the
// table changes.
Q_KEY = "";
Q_OUT = "";
Q_SCANNED = 0;
Q_MS = 0;

// a STRING literal of the language
lit(s = "") {
    : "\"" + s.replace("\\", "\\\\").replace("\"", "\\\"") + "\"";
}

// the program of a query; `path` is how the program names the table
query_program(chosen = 0, path = "", filter = "", order = "") {
    specs = M_FIELDS[chosen].split(";");
    decl = ["" ; #specs];
    i = 0;
    * i < #specs {
        f = specs[i].split("|");
        k = "";
        f[3] == "1" { k = "#"; }
        f[3] == "2" { k = "#+"; }
        f[1] == "BOOL" { decl[i] = k + f[0] + ": BOOL"; } || { decl[i] = k + f[0] + ": " + f[1] + "(" + f[2] + ")"; }
        i = i + 1;
    }
    m = M_NAME[chosen];
    sel = "rows";
    #filter > 0 { sel = sel + ".where(" + filter + ")"; }
    #order > 0 { sel = sel + ".sort(" + order + ")"; }
    : m + " = @[" + decl.join("; ") + "];\n\nrows = " + m + " @ " + lit(path) + ";\nsel = " + sel + ";\n"
      + ">> $(#sel) + \" of \" + $(#rows) + \" records\\n\";\n";
}

query_json(project = "", body = "") {
    rel = (body.json("path") || "\"\"").json_text() || "";
    filter = ((body.json("filter") || "\"\"").json_text() || "").trim();
    order = ((body.json("sort") || "\"\"").json_text() || "").trim();
    from = ((body.json("from") || "0").int()) || 0;
    limit = ((body.json("limit") || "100").int()) || 100;
    limit < 1 { limit = 1; }
    limit > 1000 { limit = 1000; }
    from < 0 { from = 0; }
    !rel.ends_with(".dat") { : "{\"error\": \"not a table\"}"; }
    full = table_file(project, rel);
    #full == 0 { : "{\"error\": \"table not found\"}"; }
    sz? = full.size();
    sz == _ { : "{\"error\": \"table not found\"}"; }
    size = sz || 0;
    first = (full.read_from(0, 65536) || "");
    nl? = first.find("\n");
    width = -1;
    nl != _ { width = nl || 0; } || size > 0 && size <= 65536 { width = size; }
    chosen = pick_model(project, rel, width);
    chosen < 0 || width <= 0 { : "{\"error\": " + q("no data model in the programs has lines of " + $width + " bytes, so the table cannot be queried") + "}"; }
    (filter + order).contains("\n") || (filter + order).contains(";") || (filter + order).contains("{") || (filter + order).contains("}") {
        : "{\"error\": \"the filter and the order are expressions: no ; { } or new lines\"}";
    }
    key = project + "|" + rel + "|" + $size + "|" + M_NAME[chosen] + "|" + M_FIELDS[chosen] + "|" + filter + "|" + order;
    key != Q_KEY || !Q_OUT.is_file() {
        Q_OUT.remove();
        Q_KEY = "";
        id = NEXT_RUN;
        NEXT_RUN = NEXT_RUN + 1;
        base = RUNS_DIR + "/query" + $id;
        src = base + ".nihil";
        // the program writes the selection to a file next to its output: `$sel` is its lines
        prog = query_program(chosen, full, filter, order) + "@>> " + lit(base + ".sel") + ", sel;\n";
        @>> src, prog;
        t0 = now_ms();
        ok = compile(project, src, base + ".bin", true, base);
        src.remove();
        !ok {
            (base + ".bin").remove();
            e = COMPILE_ERRORS.replace(src, "query");
            : "{\"error\": \"the query does not compile\", \"errors\": " + e + ", \"program\": " + q(query_program(chosen, rel, filter, order)) + "}";
        }
        p? = [base + ".bin"].start(base + ".out", base + ".err", project);
        p == _ { (base + ".bin").remove(); : "{\"error\": \"could not start the query\"}"; }
        code = (p || 0).wait();
        Q_MS = now_ms() - t0;
        out? = @? (base + ".out");
        err? = @? (base + ".err");
        (base + ".bin").remove(); (base + ".out").remove(); (base + ".err").remove();
        code != 0 {
            (base + ".sel").remove();
            : "{\"error\": " + q("the query stopped: " + (err || "").trim()) + "}";
        }
        // "n of m records"
        said = (out || "").trim().split(" of ");
        Q_SCANNED = 0;
        #said > 1 { Q_SCANNED = (said[1].split(" ")[0].int()) || 0; }
        Q_OUT = base + ".sel";
        Q_KEY = key;
    }
    osz? = Q_OUT.size();
    osize = osz || 0;
    total = (osize + 1) / (width + 1);
    from >= total && total > 0 { from = ((total - 1) / limit) * limit; }
    part = Q_OUT.read_from(from * (width + 1), limit * (width + 1)) || "";
    lines = part.split("\n");
    n = #lines;
    n > 0 && lines[n - 1] == "" { n = n - 1; }
    n > limit { n = limit; }
    : "{\"path\": " + q(rel) + ", \"query\": true, \"bytes\": " + $size + ", \"total\": " + $total + ", \"scanned\": " + $Q_SCANNED
      + ", \"ms\": " + $Q_MS + ", \"width\": " + $width + ", \"from\": " + $from + ", \"limit\": " + $limit + ", \"others\": []"
      + ", \"program\": " + q(query_program(chosen, rel, filter, order)) + ", " + model_rows(chosen, lines, n) + "}";
}

// ---- changing records ---------------------------------------------------------------------
// Inserting, changing and deleting records are Nihil too: a program with the table's model
// does it with the language's own writes. With a key field (#), by key: `@{}>>` and `= _`;
// without one, by record number: `@[i]>>`, `@+>>`, and a delete rewrites the table (`@>>`),
// keeping the order. Values are checked here and go into the program as literals.

// the cells of a line of the table (its fields as the page shows them), joined by \x1f
line_cells(chosen = 0, l = "") {
    specs = M_FIELDS[chosen].split(";");
    cells = ["" ; #specs];
    pos = 0;
    c = 0;
    * c < #specs {
        f = specs[c].split("|");
        w = f[2].int() || 0;
        cell = l.slice(pos, pos + w);
        pos = pos + w;
        f[1] == "STRING" {
            e = #cell;
            * e > 0 && cell[e - 1] == ' ' { e = e - 1; }
            cell = cell.slice(0, e);
        } || { cell = cell.trim(); }
        cells[c] = cell;
        c = c + 1;
    }
    : cells.join("\x1f");
}

VALUE_ERROR = "";
// a value the page sent, as a literal of the field's type ("" and VALUE_ERROR if it is not one)
value_lit(name = "", typ = "", v = "") {
    VALUE_ERROR = "";
    typ == "STRING" {
        v.contains("\n") || v.contains("\r") { VALUE_ERROR = name + ": a STRING field cannot have a new line"; : ""; }
        : lit(v);
    }
    t = v.trim();
    t == "" && typ == "INT" { : "(0)"; }
    t == "" && typ == "FLOAT" { : "0.0"; }
    typ == "INT" {
        n? = t.int();
        n == _ { VALUE_ERROR = name + ": '" + t + "' is not an INT"; : ""; }
        : "(" + $(n || 0) + ")";
    }
    typ == "FLOAT" {
        x? = t.float();
        x == _ { VALUE_ERROR = name + ": '" + t + "' is not a number"; : ""; }
        : "(" + lit(t) + ".float() || 0.0)";
    }
    t == "T" || t == "true" || t == "1" { : "true"; }
    t == "F" || t == "false" || t == "0" || t == "" { : "false"; }
    VALUE_ERROR = name + ": '" + t + "' is not a BOOL (T or F)";
    : "";
}

record_json(project = "", body = "") {
    rel = (body.json("path") || "\"\"").json_text() || "";
    op = (body.json("op") || "\"\"").json_text() || "";
    index = ((body.json("index") || "-1").int()) || -1;
    old = (body.json("old") || "\"\"").json_text() || "";
    values = body.json("values") || "{}";
    op != "insert" && op != "update" && op != "delete" { : "{\"error\": \"unknown change\"}"; }
    !rel.ends_with(".dat") { : "{\"error\": \"not a table\"}"; }
    full = table_file(project, rel);
    #full == 0 { : "{\"error\": \"table not found\"}"; }
    REPO && project == ROOT && !rel.starts_with("ide/workspace/") && !rel.starts_with("examples/") && !rel.starts_with("@db/") {
        : "{\"error\": \"in the language repository, tables are changed in ide/workspace or examples\"}";
    }
    size = (full.size()) || 0;
    first = (full.read_from(0, 65536) || "");
    nl? = first.find("\n");
    width = -1;
    nl != _ { width = nl || 0; } || size > 0 && size <= 65536 { width = size; }
    chosen = -1;
    width < 0 {                                     // an empty table: the model is the one the page chose
        mname = (body.json("model") || "\"\"").json_text() || "";
        find_models(project);
        i = 0;
        * i < #M_NAME { M_NAME[i] == mname && chosen < 0 { chosen = i; } i = i + 1; }
    } || { chosen = pick_model(project, rel, width); }
    chosen < 0 { : "{\"error\": \"no data model in the programs fits this table\"}"; }
    specs = M_FIELDS[chosen].split(";");
    total = 0;
    width > 0 { total = (size + 1) / (width + 1); }
    keyf = -1;
    i = 0;
    * i < #specs { specs[i].split("|")[3] != "0" { keyf = i; } i = i + 1; }
    m = M_NAME[chosen];
    // the record as the page saw it: the change is refused if it changed since
    op != "insert" && (keyf < 0 || index >= 0) {
        index < 0 || index >= total { : "{\"error\": " + q("the table has no record " + $index + " now: refresh it") + "}"; }
        now = line_cells(chosen, full.read_from(index * (width + 1), width) || "");
        now != old { : "{\"error\": \"the record changed on disk since it was shown: refresh the table\", \"stale\": true}"; }
    }
    // the values: literals of each field
    lits = ["" ; #specs];
    cells = old.split("\x1f");
    i = 0;
    * i < #specs {
        f = specs[i].split("|");
        v? = values.json(f[0]);
        text = "";
        v != _ { text = (v || "\"\"").json_text() || ""; } || i < #cells { text = cells[i]; }
        op != "delete" {
            lits[i] = value_lit(f[0], f[1], text);
            #VALUE_ERROR > 0 { : "{\"error\": " + q(VALUE_ERROR) + "}"; }
        }
        i = i + 1;
    }
    decl = ["" ; #specs];
    i = 0;
    * i < #specs {
        f = specs[i].split("|");
        k = "";
        f[3] == "1" { k = "#"; }
        f[3] == "2" { k = "#+"; }
        f[1] == "BOOL" { decl[i] = k + f[0] + ": BOOL"; } || { decl[i] = k + f[0] + ": " + f[1] + "(" + f[2] + ")"; }
        i = i + 1;
    }
    prog = m + " = @[" + decl.join("; ") + "];\nFILE = " + lit(full) + ";\n";
    oldkey = "";
    keyf >= 0 && op != "insert" { oldkey = value_lit("key", specs[keyf].split("|")[1], cells[keyf]); }
    sets = "";
    i = 0;
    * i < #specs { sets = sets + "r." + specs[i].split("|")[0] + " = " + lits[i] + ";\n"; i = i + 1; }
    op == "insert" {
        prog = prog + "r = " + m + "();\n" + sets;
        keyf >= 0 {
            kn = specs[keyf].split("|")[0];
            prog = prog + "had? = " + m + " @?{r." + kn + "} FILE;\nhad != _ { >> \"there is already a record with " + kn + " \" + $r." + kn + "; :: 3; }\n@{}>> FILE, r;\n>> $r." + kn + ";\n";
        } || { prog = prog + "@+>> FILE, r;\n"; }
    }
    op == "update" {
        keyf >= 0 {
            kn = specs[keyf].split("|")[0];
            prog = prog + "r = " + m + " @{" + oldkey + "} FILE;\n" + sets
                 + "r." + kn + " != " + oldkey + " {\n    had? = " + m + " @?{r." + kn + "} FILE;\n    had != _ { >> \"there is already a record with " + kn + " \" + $r." + kn + "; :: 3; }\n    "
                 + m + " @{" + oldkey + "} FILE = _;\n}\n@{}>> FILE, r;\n";
        } || { prog = prog + "r = " + m + " @[" + $index + "] FILE;\n" + sets + "@[" + $index + "]>> FILE, r;\n"; }
    }
    op == "delete" {
        keyf >= 0 { prog = prog + m + " @{" + oldkey + "} FILE = _;\n"; }
        || {
            prog = prog + "rows = " + m + " @ FILE;\nkeep = [" + m + "() ; #rows - 1];\nj = 0;\ni = 0;\n* i < #rows {\n    i != " + $index
                 + " { keep[j] = rows[i]; j = j + 1; }\n    i = i + 1;\n}\n@>> FILE, keep;\n";
        }
    }
    id = NEXT_RUN;
    NEXT_RUN = NEXT_RUN + 1;
    base = RUNS_DIR + "/record" + $id;
    src = base + ".nihil";
    @>> src, prog;
    ok = compile(project, src, base + ".bin", true, base);
    src.remove();
    !ok {
        (base + ".bin").remove();
        es = COMPILE_ERRORS;
        : "{\"error\": \"the change does not compile\", \"errors\": " + es + "}";
    }
    p? = [base + ".bin"].start(base + ".out", base + ".err", project);
    p == _ { (base + ".bin").remove(); : "{\"error\": \"could not start the change\"}"; }
    code = (p || 0).wait();
    out? = @? (base + ".out");
    err? = @? (base + ".err");
    (base + ".bin").remove(); (base + ".out").remove(); (base + ".err").remove();
    Q_KEY = "";                                     // a query result is old now
    code != 0 {
        msg = (out || "").trim();
        #msg == 0 { msg = (err || "").trim().replace(full, rel); }
        : "{\"error\": " + q(msg) + "}";
    }
    : "{\"ok\": true, \"keyed\": " + $(keyf >= 0) + ", \"key\": " + q((out || "").trim()) + "}";
}

// ---- compiling ------------------------------------------------------------------------
// "nihilc: f.nihil:3:7: message" → the parts; a line without a position keeps the file
error_json(rel = "", l = "") {
    t = l;
    t.starts_with("nihilc: ") { t = t.slice(8); }
    i = 0;
    * i < #t {
        t[i] == ':' {
            j = i + 1;
            * j < #t && t[j] >= '0' && t[j] <= '9' { j = j + 1; }
            j > i + 1 && j < #t && t[j] == ':' {
                k = j + 1;
                * k < #t && t[k] >= '0' && t[k] <= '9' { k = k + 1; }
                k > j + 1 && k + 1 < #t && t[k] == ':' && t[k + 1] == ' ' {
                    : "{\"file\": " + q(t.slice(0, i)) + ", \"line\": " + t.slice(i + 1, j) + ", \"col\": " + t.slice(j + 1, k)
                      + ", \"message\": " + q(t.slice(k + 2)) + "}";
                }
            }
        }
        i = i + 1;
    }
    : "{\"file\": " + q(rel) + ", \"line\": 0, \"col\": 0, \"message\": " + q(t) + "}";
}

COMPILE_MS = 0;
MAC = false;                // macOS: native ARM64 executables (nihilc1.sh builds them with macos/nihil)
COMPILE_ERRORS = "";        // a JSON array

// compiles project/rel into bin; true if it worked
compile(project = "", rel = "", bin = "", optimize = true, base = "") {
    t0 = now_ms();
    cmd = [COMPILER, rel, bin];
    !optimize { cmd = ["env", "NIHIL_O0=1"] + cmd; }
    p? = cmd.start(base + ".cout", base + ".cerr", project);
    code = -1;
    p != _ { pr = p || 0; pr.close_input(); code = pr.wait(); }
    COMPILE_MS = now_ms() - t0;
    errs? = @? (base + ".cerr");
    ls = (errs || "").split("\n");
    parts = ["" ; 0];
    i = 0;
    // the native compiler of the Mac names files by their whole path: the page wants them relative to the project
    * i < #ls { #ls[i].trim() > 0 { parts = parts + [error_json(rel, ls[i].replace(project + "/", ""))]; } i = i + 1; }
    p == _ { parts = parts + [error_json(rel, "could not start the compiler")]; }
    COMPILE_ERRORS = "[" + parts.join(", ") + "]";
    (base + ".cout").remove();
    (base + ".cerr").remove();
    : code == 0;
}

// ---- running ------------------------------------------------------------------------------
NEXT_RUN = 1;
RUN_PROC = {0: 0 ; 64};         // run → the process
RUN_BASE = {0: "" ; 64};        // run → build/runs/N (.bin .out .err)
RUN_T0 = {0: 0 ; 64};
RUN_SEEN = {0: 0 ; 64};         // the last time the page asked for its output
RUN_CODE = {0: 0 ; 64};         // the exit code, once it finished
RUN_STOPPED = {0: false ; 64};
RUN_IN = {0: false ; 64};       // its input is still open (closed once: never written or closed again)
RUN_KIND = {0: "" ; 64};        // "program" or "claude" (for /api/activity)
RUN_LABEL = {0: "" ; 64};       // the program's path, or the start of the message
RUN_PROJECT = {0: "" ; 64};

finish_run(id = 0) {
    b = RUN_BASE[id] || "";
    RUN_IN[id] || false { (RUN_PROC[id] || 0).close_input(); }     // stopped before its input was closed
    RUN_IN[id] = _;
    (b + ".bin").remove(); (b + ".out").remove(); (b + ".err").remove();
    RUN_PROC[id] = _; RUN_BASE[id] = _; RUN_T0[id] = _; RUN_SEEN[id] = _; RUN_CODE[id] = _; RUN_STOPPED[id] = _;
    RUN_KIND[id] = _; RUN_LABEL[id] = _; RUN_PROJECT[id] = _;
}

// programs past their time, or whose page went away, are stopped
watch_runs() {
    t = now_ms();
    ids = RUN_PROC.keys();
    i = 0;
    * i < #ids {
        id = ids[i];
        RUN_CODE.contains(id) == false {
            t - (RUN_T0[id] || t) > MAX_RUN_MS || t - (RUN_SEEN[id] || t) > ABANDONED_MS {
                (RUN_PROC[id] || 0).kill();
                RUN_STOPPED[id] = true;
            }
        }
        t - (RUN_SEEN[id] || t) > ABANDONED_MS * 4 { (RUN_PROC[id] || 0).kill(); (RUN_PROC[id] || 0).done(); finish_run(id); }
        i = i + 1;
    }
}

run_json(project = "", body = "", asm = false) {
    rel = (body.json("path") || "\"\"").json_text() || "";
    optimize = (body.json("optimize") || "true") != "false";
    !safe_rel(rel) || !(project + "/" + rel).is_file() { : "{\"ok\": false, \"errors\": [" + error_json(rel, "cannot compile " + rel) + "]}"; }
    running = 0;
    ids = RUN_PROC.keys();
    k = 0;
    * k < #ids { RUN_CODE.contains(ids[k]) == false { running = running + 1; } k = k + 1; }
    running >= MAX_RUNS { : "{\"ok\": false, \"errors\": [" + error_json(rel, $MAX_RUNS + " programs are running: stop one first") + "]}"; }
    id = NEXT_RUN;
    NEXT_RUN = NEXT_RUN + 1;
    base = RUNS_DIR + "/" + $id;
    bin = base + ".bin";
    !compile(project, rel, bin, optimize, base) {
        bin.remove();
        : "{\"ok\": false, \"errors\": " + COMPILE_ERRORS + ", \"compile_ms\": " + $COMPILE_MS + "}";
    }
    size = #((bin.read_from(0)) || "");
    asm {
        // Linux: the x86-64 code after the header; macOS: the native ARM64 executable
        cmd = ["env", "LC_ALL=C", "objdump", "-D", "-b", "binary", "-mi386:x86-64", "-M", "intel", "--adjust-vma=0x400000",
               "--start-address=0x4000b0", bin];
        MAC { cmd = ["objdump", "-d", "--no-show-raw-insn", bin]; }
        p? = cmd.start(base + ".asm", "", "");
        p != _ { pr = p || 0; pr.close_input(); pr.wait(); }
        dump? = @? (base + ".asm");
        ls = (dump || "").split("\n");
        keep = ["" ; 0];
        i = 0;
        * i < #ls {
            l = ls[i];
            k = 0;
            * k < #l && l[k] == ' ' { k = k + 1; }
            j = k;
            * j < #l && (l[j] >= '0' && l[j] <= '9' || l[j] >= 'a' && l[j] <= 'f') { j = j + 1; }
            (k > 0 || MAC) && j > k && j < #l && l[j] == ':' { keep = keep + [l]; }
            i = i + 1;
        }
        (base + ".asm").remove();
        bin.remove();
        : "{\"ok\": true, \"asm\": " + q(keep.join("\n")) + ", \"size\": " + $size + ", \"compile_ms\": " + $COMPILE_MS + "}";
    }
    p? = [bin].start(base + ".out", base + ".err", project);
    p == _ { bin.remove(); : "{\"ok\": false, \"errors\": [" + error_json(rel, "could not start the program") + "]}"; }
    RUN_PROC[id] = p || 0;
    RUN_IN[id] = true;
    RUN_BASE[id] = base;
    RUN_T0[id] = now_ms();
    RUN_SEEN[id] = now_ms();
    RUN_KIND[id] = "program"; RUN_LABEL[id] = rel; RUN_PROJECT[id] = project;
    : "{\"ok\": true, \"errors\": " + COMPILE_ERRORS + ", \"compile_ms\": " + $COMPILE_MS + ", \"size\": " + $size + ", \"run\": " + $id + "}";
}

// the live check: the editor's text (saved or not) is compiled, not run, and its problems go back.
// The text is written next to the file, as a hidden .check- file, because its @ includes are
// relative to it; the file is removed at once.
check_json(project = "", body = "") {
    rel = (body.json("path") || "\"\"").json_text() || "";
    content = (body.json("content") || "\"\"").json_text() || "";
    !safe_rel(rel) || !rel.ends_with(".nihil") || !(project + "/" + rel).is_file() { : "{\"ok\": false, \"errors\": []}"; }
    last = 0;
    i = 0;
    * i < #rel { rel[i] == '/' { last = i + 1; } i = i + 1; }
    tmp = rel.slice(0, last) + ".check-" + rel.slice(last);
    @>> (project + "/" + tmp), content;
    id = NEXT_RUN;
    NEXT_RUN = NEXT_RUN + 1;
    base = RUNS_DIR + "/check" + $id;
    ok = compile(project, tmp, base + ".bin", true, base);
    (project + "/" + tmp).remove();
    (base + ".bin").remove();
    : "{\"ok\": " + $ok + ", \"errors\": " + COMPILE_ERRORS.replace(tmp, rel) + ", \"compile_ms\": " + $COMPILE_MS + "}";
}

// what the program wrote since the offsets the page has, and its exit code once it ended
output_json(req = "") {
    id = (req.http_param("id") || "0").int() || 0;
    RUN_PROC.contains(id) == false { : ""; }
    RUN_SEEN[id] = now_ms();
    code = "null";
    !RUN_CODE.contains(id) {
        d? = (RUN_PROC[id] || 0).done();
        d != _ { RUN_CODE[id] = d || 0; }
    }
    RUN_CODE.contains(id) {                     // ended: its files are complete
        code = $(RUN_CODE[id] || 0);
        RUN_STOPPED[id] || false { code = "-1"; }
    }
    b = RUN_BASE[id] || "";
    out = (b + ".out").read_from((req.http_param("out") || "0").int() || 0) || "";
    err = (b + ".err").read_from((req.http_param("err") || "0").int() || 0) || "";
    out = out.slice(0, utf8_whole(out));
    err = err.slice(0, utf8_whole(err));
    j = "{\"out\": " + q(out) + ", \"err\": " + q(err) + ", \"out_bytes\": " + $#out + ", \"err_bytes\": " + $#err
        + ", \"ms\": " + $(now_ms() - (RUN_T0[id] || 0)) + ", \"code\": " + code + "}";
    code != "null" && #out == 0 && #err == 0 { finish_run(id); }
    : j;
}

// The IDE's Claude Code has its own folder (CLAUDE_CONFIG_DIR): its own sign-in, settings,
// MCP servers and sessions, apart from the terminal's ~/.claude. NIHIL_IDE_CLAUDE_DIR chooses
// another folder; "shared" uses the terminal's.
CLAUDE_DIR = "";
claude(args = [""]) {
    CLAUDE_DIR == "shared" { : ["claude"] + args; }
    : ["env", "CLAUDE_CONFIG_DIR=" + CLAUDE_DIR, "claude"] + args;
}

// ---- Claude Code (the chat panel) ---------------------------------------------------------
// The panel's message runs `claude -p` (Claude Code without its screen) in the project's folder,
// like a program: its answer, one JSON event per line (stream-json), goes to build/runs/N.out
// and the page reads it with /api/output as it is written, and stops it with /api/stop. The page
// sends what is open in the IDE (the active file, the selection, the tabs, the errors) after the
// message. Claude may read the project, the language's SPEC and examples; with "edits" it may also
// change files inside the project; it runs no commands (the IDE compiles and runs).

// a session id from the page: letters, digits and "-" only (it goes on a command line)
session_ok(s = "") {
    #s == 0 || #s > 64 { : false; }
    i = 0;
    * i < #s {
        ch = s[i];
        !((ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || ch == '-') { : false; }
        i = i + 1;
    }
    : true;
}

claude_prompt(project = "", shell = false, reads = false) {
    run = "You cannot run commands: the IDE compiles and runs the programs (the user presses Run). ";
    // Codex reads the project with commands (cat, ls, rg): in ask and plan its sandbox lets them only read
    reads { run = "You may run commands that only read (ls, cat, rg…): the sandbox lets nothing change. The IDE compiles "
                  + "and runs the programs (the user presses Run). "; }
    shell { run = "You may run shell commands on this Mac (Bash, starting in the project folder; long ones in the background, "
                  + "which the IDE shows live). Say what you run, keep to the project, and do not change anything outside it "
                  + "unless asked. A Nihil program is compiled with " + COMPILER + " FILE.nihil OUTPUT. "; }
    : "You are working inside the Nihil IDE, in the project folder " + project + ". Nihil is a small programming language "
      + "without keywords (symbols only); its specification is " + DOCS + "/SPEC.md and there are examples in " + DOCS
      + "/examples: read the parts of the SPEC you need before you write or explain Nihil code, and do not assume it works "
      + "like another language. The user's message may be followed by an <ide> block with what is open in the IDE: the "
      + "active file and the cursor, the selected text, the open tabs, unsaved text and the last compile errors; \"this\" "
      + "or \"here\" means the selection, or else the active file. " + run
      + "Change files only inside the project folder, and only when asked. Answer in "
      + "the language the user writes in, briefly.";
}

// how many runs (programs, conversations, sign-ins) have not finished
running_runs() {
    running = 0;
    ids = RUN_PROC.keys();
    k = 0;
    * k < #ids { RUN_CODE.contains(ids[k]) == false { running = running + 1; } k = k + 1; }
    : running;
}

// "mcp__server": letters, digits, "_" and "-" (it goes on a command line)
mcp_ok(s = "") {
    !s.starts_with("mcp__") || #s > 100 { : false; }
    i = 0;
    * i < #s {
        ch = s[i];
        !((ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || ch == '-' || ch == '_') { : false; }
        i = i + 1;
    }
    : true;
}

claude_json(project = "", body = "") {
    msg = (body.json("message") || "\"\"").json_text() || "";
    ctx = (body.json("context") || "\"\"").json_text() || "";
    session = (body.json("session") || "\"\"").json_text() || "";
    edits = (body.json("edits") || "false") == "true";
    #msg.trim() == 0 { : "{\"ok\": false, \"error\": \"write a message\"}"; }
    running_runs() >= MAX_RUNS { : "{\"ok\": false, \"error\": " + q($MAX_RUNS + " programs are running: stop one first") + "}"; }
    id = NEXT_RUN;
    NEXT_RUN = NEXT_RUN + 1;
    base = RUNS_DIR + "/" + $id;
    // the tab's mode: "ask" (reads only), "edits" (changes files in the project), "plan" (a plan
    // first, nothing changes) or "auto" (Claude Code's auto mode, with the same edits allowed)
    mode = (body.json("mode") || "\"\"").json_text() || "";
    #mode == 0 { mode = "ask"; edits { mode = "edits"; } }
    pm = "default";
    mode == "edits" { pm = "acceptEdits"; }
    mode == "plan" { pm = "plan"; }
    mode == "auto" { pm = "auto"; }
    model = (body.json("model") || "\"\"").json_text() || "";
    // reading and searching inside the project are allowed by default; outside it, only the SPEC and examples
    tools = ["Read(./**)", "Read(/" + DOCS + "/SPEC.md)", "Read(/" + DOCS + "/examples/**)"];
    // MCP: the servers the project's .env trusts in every mode (CLAUDE_MCP=mcp__a mcp__b, for
    // servers that only read); other servers when the tab allowed them ("allow": "mcp__server
    // mcp__other", from the button on a refusal)
    trusted = project_env(project, "CLAUDE_MCP").replace("\"", "").split(" ");
    t = 0;
    * t < #trusted { mcp_ok(trusted[t]) { tools = tools + [trusted[t]]; } t = t + 1; }
    allow = ((body.json("allow") || "\"\"").json_text() || "").split(" ");
    a = 0;
    * a < #allow { mcp_ok(allow[a]) { tools = tools + [allow[a]]; } a = a + 1; }
    // edits and auto also run commands (Bash, in the background too, and monitors); ask and plan do not
    shell = mode == "edits" || mode == "auto";
    shell { tools = tools + ["Edit(./**)", "Write(./**)", "Bash", "Monitor", "TaskStop"]; }
    // stream-json in: the input stays open, so the page can send more messages to the same run
    // (/api/stdin) while Claude works or waits for its background tasks; Claude Code takes them as
    // in its terminal (at once when it is only waiting, else after the tool that is running) and
    // echoes each one (--replay-user-messages) when it takes it. The page closes the input when
    // a turn ends with nothing left to wait for, and the run ends as before.
    cmd = claude(["-p", "--input-format", "stream-json", "--output-format", "stream-json", "--verbose",
                  "--include-partial-messages", "--replay-user-messages", "--permission-mode", pm, "--append-system-prompt", claude_prompt(project, shell)]);
    session_ok(session) { cmd = cmd + ["--resume", session]; }
    session_ok(model) { cmd = cmd + ["--model", model]; }
    // the tab's name names the session too (as in Claude Code's /resume); it is one argument, not a shell line
    name = ((body.json("name") || "\"\"").json_text() || "").replace("\n", " ").trim();
    #name > 60 { name = name.slice(0, 60); name = name.slice(0, utf8_whole(name)); }
    #name > 0 && !name.starts_with("-") { cmd = cmd + ["--name", name]; }     // an alias (opus, sonnet…) or a model's name
    // no web; and in ask and plan no commands (not even the read-only ones Claude Code allows by default)
    blocked = ["WebFetch", "WebSearch"];
    !shell { blocked = ["Bash", "Monitor"] + blocked; }
    cmd = cmd + ["--disallowedTools"] + blocked + ["--allowedTools"] + tools;
    p? = cmd.start(base + ".out", base + ".err", project);
    p == _ { : "{\"ok\": false, \"error\": " + q("could not start claude: is Claude Code installed, and on the PATH of the IDE's server?") + "}"; }
    pr = p || 0;
    text = msg;
    #ctx > 0 { text = text + "\n\n" + ctx; }
    pr.write("{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":" + q(text) + "}}\n");
    RUN_PROC[id] = pr;
    RUN_IN[id] = true;
    RUN_BASE[id] = base;
    RUN_T0[id] = now_ms();
    RUN_SEEN[id] = now_ms();
    label = msg.trim().replace("\n", " ");
    #label > 80 { label = label.slice(0, 80) + "…"; }
    RUN_KIND[id] = "claude"; RUN_LABEL[id] = label; RUN_PROJECT[id] = project;
    : "{\"ok\": true, \"run\": " + $id + "}";
}

// ---- Codex (the panel's other agent) ------------------------------------------------------
// A tab may talk to OpenAI's Codex CLI instead of Claude Code: `codex exec --json` in the
// project's folder, with its own sign-in (`codex login`: a ChatGPT plan or an API key, in
// ~/.codex). Its events (JSONL: thread.started, item.started/completed, turn.completed) go to the
// run's .out like Claude's, and the page turns them into the panel's lines. The message goes on
// its input, which is closed at once: a message sent while Codex works waits for the run to end.
// The tab's mode chooses the sandbox: ask and plan read only, edits and auto may write in the
// project (no network, Codex's default). The next message resumes the thread (exec resume).

// a model's name from the page: letters, digits, ".", "-" and "_" (it goes on a command line)
model_ok(s = "") {
    #s == 0 || #s > 64 || s.starts_with("-") { : false; }
    i = 0;
    * i < #s {
        ch = s[i];
        !((ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || ch == '-' || ch == '.' || ch == '_') { : false; }
        i = i + 1;
    }
    : true;
}

codex_json(project = "", body = "") {
    msg = (body.json("message") || "\"\"").json_text() || "";
    ctx = (body.json("context") || "\"\"").json_text() || "";
    session = (body.json("session") || "\"\"").json_text() || "";
    mode = (body.json("mode") || "\"\"").json_text() || "";
    model = (body.json("model") || "\"\"").json_text() || "";
    #msg.trim() == 0 { : "{\"ok\": false, \"error\": \"write a message\"}"; }
    running_runs() >= MAX_RUNS { : "{\"ok\": false, \"error\": " + q($MAX_RUNS + " programs are running: stop one first") + "}"; }
    id = NEXT_RUN;
    NEXT_RUN = NEXT_RUN + 1;
    base = RUNS_DIR + "/" + $id;
    shell = mode == "edits" || mode == "auto";
    sandbox = "read-only";
    shell { sandbox = "workspace-write"; }
    cmd = ["codex", "exec"];
    resume = session_ok(session);
    resume { cmd = cmd + ["resume"]; }
    cmd = cmd + ["--json", "--skip-git-repo-check", "-c", "sandbox_mode=\"" + sandbox + "\""];
    model_ok(model) { cmd = cmd + ["-m", model]; }
    resume { cmd = cmd + [session]; }
    cmd = cmd + ["-"];                                          // the message, from its input
    p? = cmd.start(base + ".out", base + ".err", project);
    p == _ { : "{\"ok\": false, \"error\": " + q("could not start codex: is the Codex CLI installed (brew install codex), and on the PATH of the IDE's server?") + "}"; }
    pr = p || 0;
    text = msg;
    #ctx > 0 { text = text + "\n\n" + ctx; }
    // the IDE's instructions go with the first message (Codex keeps them in the thread)
    !resume { text = "<instructions from the Nihil IDE>\n" + claude_prompt(project, shell, !shell) + "\n</instructions from the Nihil IDE>\n\n" + text; }
    mode == "plan" { text = text + "\n\n(Plan mode: read what you need and answer with a plan, step by step; change nothing yet.)"; }
    pr.write(text);
    pr.close_input();
    RUN_PROC[id] = pr;
    RUN_BASE[id] = base;
    RUN_T0[id] = now_ms();
    RUN_SEEN[id] = now_ms();
    label = msg.trim().replace("\n", " ");
    #label > 80 { label = label.slice(0, 80) + "…"; }
    RUN_KIND[id] = "codex"; RUN_LABEL[id] = label; RUN_PROJECT[id] = project;
    : "{\"ok\": true, \"run\": " + $id + "}";
}

// ---- the account Claude Code uses (the panel's /login, /logout and /status) ----------------
// the earlier messages of a conversation, from the file Claude Code keeps of it
// (CLAUDE_DIR/projects/<folder>/<session>.jsonl): what was typed and what Claude answered, without
// the tools' results nor the helpers' work, the latest HISTORY_MAX bytes of them. Reading it asks
// Claude nothing, so it costs no tokens: the panel shows it when a tab with a conversation opens.
HISTORY_MAX = 1500000;
claude_history_json(session = "") {
    !session_ok(session) { : "{\"ok\": false, \"error\": \"not a conversation\"}"; }
    home = CLAUDE_DIR;
    CLAUDE_DIR == "shared" { home = HOME + "/.claude"; }
    base = home + "/projects";
    ds? = base.list();
    dl = ds || ["" ; 0];
    file = "";
    i = 0;
    * i < #dl && #file == 0 {
        f = base + "/" + dl[i] + "/" + session + ".jsonl";
        !dl[i].starts_with(".") && f.is_file() { file = f; }
        i = i + 1;
    }
    #file == 0 { : "{\"ok\": true, \"found\": false, \"more\": false, \"lines\": \"\"}"; }
    size = file.size() || 0;
    from = 0;
    size > 8 * HISTORY_MAX { from = size - 8 * HISTORY_MAX; }      // a very long one: only its end
    t = file.read_from(from) || "";
    ls = t.split("\n");
    keep = ["" ; 0];
    total = 0;
    more = from > 0;
    k = #ls - 1;
    * k >= 0 {
        l = ls[k];
        // the first line of a read from the middle is cut: left out
        ok = (k > 0 || from == 0) && l.contains("\"isSidechain\":false") && !l.contains("\"isMeta\":true")
             && (l.contains("\"role\":\"assistant\"") || l.contains("\"role\":\"user\",\"content\":\""));
        ok && total + #l > HISTORY_MAX { more = true; ok = false; k = 0; }
        ok { keep = keep + [l]; total = total + #l + 1; }
        k = k - 1;
    }
    : "{\"ok\": true, \"found\": true, \"more\": " + $more + ", \"lines\": " + q(keep.reverse().join("\n")) + "}";
}

// `claude -p` cannot sign in, but `claude auth login` can without a screen: it opens the browser
// on this machine, prints the sign-in link, and reads the code from its input when the page asks
// for one. It runs like a program (kind "login"): the page reads its output with /api/output,
// sends the code with /api/stdin and stops it with /api/stop.

NO_CLAUDE = "could not start claude: is Claude Code installed, and on the PATH of the IDE's server?";

// `claude auth status --json` as it is, inside {"ok": true, "status": …}
claude_auth_json() {
    out = RUNS_DIR + "/auth-status.out";
    p? = claude(["auth", "status", "--json"]).start(out, "", "");
    p == _ { : "{\"ok\": false, \"error\": " + q(NO_CLAUDE) + "}"; }
    (p || 0).close_input();
    (p || 0).wait();
    t? = @? out;
    out.remove();
    s = (t || "").trim();
    #s == 0 { s = "claude auth status said nothing"; }
    !s.starts_with("{") { : "{\"ok\": false, \"error\": " + q(s) + "}"; }
    : "{\"ok\": true, \"status\": " + s + "}";
}

claude_logout_json() {
    p? = claude(["auth", "logout"]).start(RUNS_DIR + "/auth-logout.out", RUNS_DIR + "/auth-logout.out", "");
    p == _ { : "{\"ok\": false, \"error\": " + q(NO_CLAUDE) + "}"; }
    (p || 0).close_input();
    (p || 0).wait();
    (RUNS_DIR + "/auth-logout.out").remove();
    : claude_auth_json();
}

claude_login_json(project = "", body = "") {
    running_runs() >= MAX_RUNS { : "{\"ok\": false, \"error\": " + q($MAX_RUNS + " programs are running: stop one first") + "}"; }
    id = NEXT_RUN;
    NEXT_RUN = NEXT_RUN + 1;
    base = RUNS_DIR + "/" + $id;
    cmd = claude(["auth", "login"]);
    (body.json("console") || "false") == "true" { cmd = cmd + ["--console"]; }
    p? = cmd.start(base + ".out", base + ".err", "");
    p == _ { : "{\"ok\": false, \"error\": " + q(NO_CLAUDE) + "}"; }
    RUN_PROC[id] = p || 0;                      // its input stays open: the code may come later
    RUN_IN[id] = true;
    RUN_BASE[id] = base;
    RUN_T0[id] = now_ms();
    RUN_SEEN[id] = now_ms();
    RUN_KIND[id] = "login"; RUN_LABEL[id] = "signing in to Claude"; RUN_PROJECT[id] = project;
    : "{\"ok\": true, \"run\": " + $id + "}";
}

// /mcp: `claude mcp list` in the project (it checks each server, which takes a few seconds, so it
// runs like a program and the page reads its output)
claude_mcp_json(project = "") {
    running_runs() >= MAX_RUNS { : "{\"ok\": false, \"error\": " + q($MAX_RUNS + " programs are running: stop one first") + "}"; }
    id = NEXT_RUN;
    NEXT_RUN = NEXT_RUN + 1;
    base = RUNS_DIR + "/" + $id;
    p? = claude(["mcp", "list"]).start(base + ".out", base + ".err", project);
    p == _ { : "{\"ok\": false, \"error\": " + q(NO_CLAUDE) + "}"; }
    (p || 0).close_input();
    RUN_PROC[id] = p || 0;
    RUN_BASE[id] = base;
    RUN_T0[id] = now_ms();
    RUN_SEEN[id] = now_ms();
    RUN_KIND[id] = "mcp"; RUN_LABEL[id] = "MCP servers"; RUN_PROJECT[id] = project;
    : "{\"ok\": true, \"run\": " + $id + "}";
}

// what is running: the programs and the Claude conversations of this server, every project
activity_json() {
    ids = RUN_PROC.keys().sort();
    parts = ["" ; 0];
    i = 0;
    * i < #ids {
        id = ids[i];
        running = RUN_CODE.contains(id) == false;
        running {
            d? = (RUN_PROC[id] || 0).done();
            d != _ { RUN_CODE[id] = d || 0; running = false; }
        }
        running {
            parts = parts + ["{\"run\": " + $id + ", \"kind\": " + q(RUN_KIND[id] || "program") + ", \"label\": " + q(RUN_LABEL[id] || "")
                             + ", \"project\": " + q(RUN_PROJECT[id] || "") + ", \"ms\": " + $(now_ms() - (RUN_T0[id] || 0)) + "}"];
        }
        i = i + 1;
    }
    : "{\"running\": [" + parts.join(", ") + "]}";
}

// ---- HTTP -------------------------------------------------------------------------------
send_static(c = 0, name = "") {
    ok = #name > 0 && !name.contains("..") && !name.contains("/");
    t? = "";
    ok { t = @? (STATIC_DIR + "/" + name); }
    !ok || t == _ { c.respond(404, "application/json", "{\"error\": \"not found\"}"); :; }
    kind = "application/octet-stream";
    name.ends_with(".html") { kind = "text/html; charset=utf-8"; }
    name.ends_with(".js") { kind = "text/javascript; charset=utf-8"; }
    name.ends_with(".css") { kind = "text/css; charset=utf-8"; }
    name.ends_with(".png") { kind = "image/png"; }
    name.ends_with(".webmanifest") { kind = "application/manifest+json"; }
    name == "index.html" { t = (t || "").replace("{{NIHIL_TOKEN}}", TOKEN); }
    c.respond(200, kind, t || "");
}

handle(c = 0, req = "") {
    watch_runs();
    !req.http_host_is_local() { c.respond(403, "application/json", "{\"error\": \"this server answers only to localhost\"}"); :; }
    req.http_path().starts_with("/api/") && (req.http_header("x-nihil-token") || "") != TOKEN {
        c.respond(403, "application/json", "{\"error\": \"reload the page (the server was restarted)\"}"); :;
    }
    method = req.http_method();
    path = req.http_path();
    body = req.http_body();
    path == "/" || path == "/index.html" { send_static(c, "index.html"); :; }
    path.starts_with("/static/") { send_static(c, path.slice(8)); :; }
    path == "/api/projects" && method == "GET" { c.respond(200, "application/json", projects_json()); :; }
    path == "/api/projects" {
        p = ((body.json("path") || "\"\"").json_text() || "").trim();
        * #p > 1 && p.ends_with("/") { p = p.slice(0, #p - 1); }
        !p.starts_with(HOME + "/") || p.contains("/.") || !safe_rel(p.slice(1)) {
            c.respond(400, "application/json", "{\"error\": " + q("a project is a folder inside " + HOME + ", not a hidden one") + "}"); :;
        }
        (body.json("create") || "false") == "true" { p.make_dir(); }
        !p.is_dir() { c.respond(400, "application/json", "{\"error\": " + q("no folder " + p) + "}"); :; }
        ps = projects();
        !ps.contains(p) { save_projects(ps + [p]); }
        c.respond(200, "application/json", projects_json());
        :;
    }
    path == "/api/projects/remove" {
        p = (body.json("path") || "\"\"").json_text() || "";
        ps = projects();
        keep = ["" ; 0];
        i = 0;
        * i < #ps { ps[i] != p { keep = keep + [ps[i]]; } i = i + 1; }
        save_projects(keep);
        c.respond(200, "application/json", projects_json());
        :;
    }
    // the rest works inside a project
    project = project_of(req.http_param("project") || "");
    method == "POST" && #project == 0 { project = project_of((body.json("project") || "\"\"").json_text() || ""); }
    path.starts_with("/api/") && #project == 0 && path != "/api/output" && path != "/api/stdin" && path != "/api/stop" {
        c.respond(400, "application/json", "{\"error\": \"open a project first\"}"); :;
    }
    path == "/api/files" { c.respond(200, "application/json", files_json(project)); :; }
    path == "/api/table" {
        t = table_json(project, req.http_param("path") || "", (req.http_param("from") || "0").int() || 0,
                       (req.http_param("limit") || "100").int() || 100);
        #t == 0 { c.respond(404, "application/json", "{\"error\": \"table not found\"}"); :; }
        c.respond(200, "application/json", t);
        :;
    }
    path == "/api/record" { c.respond(200, "application/json", record_json(project, body)); :; }
    path == "/api/query" { c.respond(200, "application/json", query_json(project, body)); :; }
    path == "/api/file" && method == "GET" {
        rel = req.http_param("path") || "";
        t? = "";
        // std:name.nihil: a file of the standard library (SPEC §16), read only (go to definition)
        std = rel.starts_with("std:");
        name = rel;
        std { name = rel.slice(4); }
        std && safe_rel(name) && !name.contains("/") && name.ends_with(".nihil") {
            t = @? (DOCS + "/std/" + name);
        } || !std && safe_rel(rel) && rel.ends_with(".nihil") {
            t = @? (project + "/" + rel);
        } || { t = _; }
        t == _ { c.respond(404, "application/json", "{\"error\": \"file not found\"}"); :; }
        c.respond(200, "application/json", "{\"path\": " + q(rel) + ", \"content\": " + q(t || "") + ", \"editable\": "
            + $(!std && editable(project, rel)) + ", \"hash\": " + $fnv(t || "") + "}");
        :;
    }
    path == "/api/file" {
        rel = (body.json("path") || "\"\"").json_text() || "";
        !editable(project, rel) {
            msg = "files can only be saved as .nihil inside the project";
            project == ROOT { msg = "in the language repository, files are saved as .nihil in ide/workspace or examples"; }
            c.respond(400, "application/json", "{\"error\": " + q(msg) + "}"); :;
        }
        full = project + "/" + rel;
        content = (body.json("content") || "\"\"").json_text() || "";
        base? = body.json("base");
        force = (body.json("force") || "false") == "true";
        old? = @? full;
        !force && base != _ && old != _ && ((base || "").int() || -1) != fnv(old || "") {
            c.respond(409, "application/json", "{\"conflict\": true, \"error\": " + q(rel + " changed on disk since it was opened") + "}"); :;
        }
        last = 0;
        i = 0;
        * i < #full { full[i] == '/' { last = i; } i = i + 1; }
        full.slice(0, last).make_dir();
        @>> full, content;
        c.respond(200, "application/json", "{\"ok\": true, \"path\": " + q(rel) + ", \"hash\": " + $fnv(content) + "}");
        :;
    }
    path == "/api/folder" {
        rel = (body.json("path") || "\"\"").json_text() || "";
        * #rel > 0 && rel.ends_with("/") { rel = rel.slice(0, #rel - 1); }
        !folder_ok(project, rel) {
            msg = "a folder is made inside the project";
            project == ROOT { msg = "in the language repository, folders are made in ide/workspace or examples"; }
            c.respond(400, "application/json", "{\"error\": " + q(msg) + "}"); :;
        }
        !(project + "/" + rel).make_dir() { c.respond(500, "application/json", "{\"error\": " + q("could not make " + rel) + "}"); :; }
        c.respond(200, "application/json", "{\"ok\": true, \"path\": " + q(rel) + "}");
        :;
    }
    // the file tree's menu: rename (or duplicate) and delete a program of the project
    path == "/api/rename" {
        from = (body.json("from") || "\"\"").json_text() || "";
        to = (body.json("to") || "\"\"").json_text() || "";
        keep = (body.json("keep") || "false") == "true";       // duplicate: the original stays
        !editable(project, from) || !editable(project, to) {
            c.respond(400, "application/json", "{\"error\": " + q("only .nihil files inside the project can be renamed") + "}"); :;
        }
        text? = @? (project + "/" + from);
        text == _ { c.respond(404, "application/json", "{\"error\": " + q(from + " not found") + "}"); :; }
        (project + "/" + to).is_file() || (project + "/" + to).is_dir() {
            c.respond(409, "application/json", "{\"error\": " + q(to + " already exists") + "}"); :;
        }
        last = 0;
        i = 0;
        * i < #to { to[i] == '/' { last = i; } i = i + 1; }
        last > 0 { (project + "/" + to.slice(0, last)).make_dir(); }
        @>> project + "/" + to, text || "";
        !keep { (project + "/" + from).remove(); }
        c.respond(200, "application/json", "{\"ok\": true, \"path\": " + q(to) + "}");
        :;
    }
    path == "/api/delete" {
        rel = (body.json("path") || "\"\"").json_text() || "";
        !editable(project, rel) {
            c.respond(400, "application/json", "{\"error\": " + q("only .nihil files inside the project can be deleted") + "}"); :;
        }
        !(project + "/" + rel).remove() { c.respond(500, "application/json", "{\"error\": " + q("could not delete " + rel) + "}"); :; }
        c.respond(200, "application/json", "{\"ok\": true, \"path\": " + q(rel) + "}");
        :;
    }
    path == "/api/activity" { c.respond(200, "application/json", activity_json()); :; }
    path == "/api/claude" && (body.json("engine") || "\"\"") == "\"codex\"" { c.respond(200, "application/json", codex_json(project, body)); :; }
    path == "/api/claude" { c.respond(200, "application/json", claude_json(project, body)); :; }
    path == "/api/claude/auth" { c.respond(200, "application/json", claude_auth_json()); :; }
    path == "/api/claude/login" { c.respond(200, "application/json", claude_login_json(project, body)); :; }
    // the output of a command Claude runs in the background: the file Claude Code writes it to
    path == "/api/claude/taskout" {
        f = req.http_param("path") || "";
        ok = f.ends_with(".output") && f.contains("/tasks/") && !f.contains("..")
             && (f.starts_with("/private/tmp/claude-") || f.starts_with("/tmp/claude-"));
        !ok { c.respond(400, "application/json", "{\"error\": \"not the output of a command\"}"); :; }
        t = f.read_from((req.http_param("from") || "0").int() || 0) || "";
        #t > 200000 { t = t.slice(0, 200000); }
        t = t.slice(0, utf8_whole(t));
        c.respond(200, "application/json", "{\"out\": " + q(t) + ", \"bytes\": " + $#t + "}");
        :;
    }
    path == "/api/claude/history" { c.respond(200, "application/json", claude_history_json(req.http_param("session") || "")); :; }
    path == "/api/claude/mcp" { c.respond(200, "application/json", claude_mcp_json(project)); :; }
    path == "/api/claude/logout" { c.respond(200, "application/json", claude_logout_json()); :; }
    path == "/api/check" { c.respond(200, "application/json", check_json(project, body)); :; }
    path == "/api/run" || path == "/api/asm" { c.respond(200, "application/json", run_json(project, body, path == "/api/asm")); :; }
    path == "/api/output" {
        j = output_json(req);
        #j == 0 { c.respond(404, "application/json", "{\"error\": \"no such run\"}"); :; }
        c.respond(200, "application/json", j);
        :;
    }
    path == "/api/stdin" {
        id = ((body.json("id") || "0").int()) || 0;
        // false: it has ended, or its input was closed, so nothing was written (a closed input's
        // number may already belong to another file or connection)
        ok = RUN_PROC.contains(id) && !RUN_CODE.contains(id) && (RUN_IN[id] || false);
        ok {
            data = (body.json("data") || "\"\"").json_text() || "";
            #data > 0 { (RUN_PROC[id] || 0).write(data); }
            (body.json("eof") || "false") == "true" { (RUN_PROC[id] || 0).close_input(); RUN_IN[id] = false; }
        }
        c.respond(200, "application/json", "{\"ok\": " + $ok + "}");
        :;
    }
    path == "/api/stop" {
        id = ((body.json("id") || "0").int()) || 0;
        RUN_PROC.contains(id) && !RUN_CODE.contains(id) { (RUN_PROC[id] || 0).kill(); RUN_STOPPED[id] = true; }
        c.respond(200, "application/json", "{\"ok\": true}");
        :;
    }
    c.respond(404, "application/json", "{\"error\": \"not found\"}");
}

main() {
    env = (@ "/proc/self/environ").split("\0");
    i = 0;
    * i < #env {
        env[i].starts_with("PWD=") { ROOT = env[i].slice(4); }
        env[i].starts_with("HOME=") { HOME = env[i].slice(5); }
        env[i].starts_with("NIHIL_IDE_PORT=") { PORT = env[i].slice(15).int() || PORT; }
        env[i].starts_with("NIHIL_IDE_CLAUDE_DIR=") { CLAUDE_DIR = env[i].slice(21); }
        env[i].starts_with("NIHIL_IDE_INSTALL=") { INSTALL = env[i].slice(18); }
        env[i].starts_with("NIHIL_IDE_ROOT=") { ROOT = env[i].slice(15); }
        i = i + 1;
    }
    #CLAUDE_DIR == 0 { CLAUDE_DIR = HOME + "/.claude-ide"; }
    MAC = "/System/Library/CoreServices/SystemVersion.plist".is_file();
    TOKEN = ((@ "/proc/sys/kernel/random/uuid") + (@ "/proc/sys/kernel/random/uuid")).replace("\n", "").replace("-", "");
    #INSTALL > 0 {
        REPO = false;
        COMPILER = INSTALL + "/bin/nihil";
        STATIC_DIR = INSTALL + "/share/nihil/ide/static";
        DOCS = INSTALL + "/share/nihil";
        !COMPILER.is_file() { !>> "nihil ide: no compiler in " + INSTALL + "/bin\n"; :: 1; }
        ROOT.make_dir();
        (ROOT + "/.nihil-ide").make_dir();
        PROJECTS_FILE = ROOT + "/.nihil-ide/projects.txt";
        RUNS_DIR = ROOT + "/.nihil-ide/runs";
    } || {
        COMPILER = ROOT + "/nihilc1.sh";
        STATIC_DIR = ROOT + "/ide/static";
        DOCS = ROOT;
        !COMPILER.is_file() { !>> "nihil ide: start it in the Nihil repository (no nihilc1.sh in " + ROOT + ")\n"; :: 1; }
        PROJECTS_FILE = ROOT + "/ide/projects.txt";
        (ROOT + "/ide/workspace").make_dir();
        RUNS_DIR = ROOT + "/build/runs";
    }
    RUNS_DIR.make_dir();
    s? = PORT.listen();
    s == _ { !>> "nihil ide: port " + $PORT + " is taken\n"; :: 1; }
    srv = s || -1;
    where = "repository";
    !REPO { where = "workspace"; }
    >> "Nihil IDE on http://127.0.0.1:" + $PORT + "  (" + where + ": " + ROOT + ")\n";
    * true {
        a? = srv.accept();
        c = a || -1;
        r? = "";
        c >= 0 { r = c.receive(); }
        c >= 0 && r == _ { c.close(); }
        c >= 0 && r != _ { handle(c, r || ""); }
    }
}

main();
