// Harness: each input line is "bits text" (bits as a signed decimal).
// Output per line: "<text generated from bits> <bits parsed from text> <1 if the general algorithm
// gives the same text, 0 if not>"
@ "../../src1/bigint.nihil";
@ "../../src1/float_text.nihil";

read_line_bytes() {
    buf = [0 ; 4096];
    n = 0;
    c = 0;
    <<< c;
    c == -1 { : [0 ; 0]; }
    * c != 10 && c != -1 { buf[n] = c; n = n + 1; <<< c; }
    r = [0 ; n];
    i = 0;
    n { r[i] = buf[i]; i = i + 1; }
    : r;
}

line = read_line_bytes();
* #line > 0 {
    // the bits (a signed INT) up to the space
    i = 0;
    neg = false;
    line[0] == '-' { neg = true; i = 1; }
    v = 0;
    * line[i] != ' ' { v = v * 10 + line[i] - '0'; i = i + 1; }
    neg { v = -v; }
    i = i + 1;
    rest = [0 ; #line - i];
    j = 0;
    #line - i { rest[j] = line[i + j]; j = j + 1; }
    t = __nihil_ft_text(v);
    __nihil_ft_general = true;                  // the general algorithm gives the same text
    g = __nihil_ft_text(v);
    __nihil_ft_general = false;
    same = 0;
    t == g { same = 1; }
    >> t; >> " "; >> __nihil_ft_text_to_bits($rest); >> " "; >> same; >> "\n";
    line = read_line_bytes();
}
