// make profilecheck: a program built with -profile that spends almost all its time in spin, and
// some in words (texts joined: the runtime's time, which the report gives to words)
spin(n = 0) {
    s = 0;
    i = 0;
    * i < n { s = (s * 31 + i) & 1048575; i = i + 1; }
    : s;
}

words(n = 0) {
    t = "";
    i = 0;
    * i < n { t = t + $i + " "; #t > 1000 { t = ""; } i = i + 1; }
    : #t;
}

>> spin(300000000) + words(2000000);
>> "\n";
