// a / 2^k and a % 2^k by a constant (shifts on x86) against the same by a divisor the compiler cannot see
vals = [0, 1, -1, 2, -2, 3, -3, 7, -7, 8, -8, 15, -15, 16, -16, 17, -17, 1000, -1000, 2147483647, -2147483648, 2147483648, -2147483649, 9223372036854775807, -9223372036854775807 - 1, 123456789012, -123456789012];
ds = [2, 4, 8, 16, 1024, 65536, 2147483648];
bad = 0;
n = 0;
vals : v {
    ds : d {
        q = 0; r = 0;
        d == 2 { q = v / 2; r = v % 2; }
        d == 4 { q = v / 4; r = v % 4; }
        d == 8 { q = v / 8; r = v % 8; }
        d == 16 { q = v / 16; r = v % 16; }
        d == 1024 { q = v / 1024; r = v % 1024; }
        d == 65536 { q = v / 65536; r = v % 65536; }
        d == 2147483648 { q = v / 2147483648; r = v % 2147483648; }
        q != v / d || r != v % d { bad = bad + 1; >> $v + " " + $d + ": " + $q + " " + $r + " / " + $(v / d) + " " + $(v % d) + "\n"; }
        n = n + 1;
    }
}
>> $n + " checked, " + $bad + " wrong\n";
f(x = 0) { : x / 8 + x % 8 * 100; }
>> $f(-13) + " " + $f(13) + " " + $(f(-13) % 4) + "\n";
seed = 12345;
rnd(n = 1) { seed = (seed * 1103515245 + 12345) % 2147483648; : seed / 16 % n; }
s = 0; i = 0;
* i < 100000 { s = s + rnd(1000); i = i + 1; }
>> $s + "\n";
// as an optional's value (its presence set apart), and in x = x / 2, x = x % 8 inside a method
half(x = 0) { x < 0 { : _; } : x / 2; }
low? = half(-7);
h? = half(-6) || half(13);
>> $(low || 99) + " " + $(h || 0) + " " + $(half(7) == _) + "\n";
steps(x = 0) {
    n = 0;
    * x != 0 { x = x / 2; n = n + 1; }
    y = -1000;
    y = y % 8;
    z = 12345;
    z = z % 256;
    : n * 1000000 + (y + 8) * 1000 + z;
}
>> $steps(-1000) + " " + $steps(1 << 40) + "\n";
