// "…" + $n is joined in one step; the result is the same as joining the two texts
n = 0;
>> "zero " + $(n) + "\n";
>> "neg " + $(-42) + "|" + $(-9223372036854775807 - 1) + "|" + $(9223372036854775807) + "\n";
i = 1;
s = "";
* i <= 100000 { s = "item " + $(i); i = i * 10; >> s + ";"; }
>> "\n";
x = "a" + $(12) + "b" + $(345) + $(6);
>> x + " " + $(#x) + "\n";
t(k = 0) { : "k=" + $(k * 3); }
>> t(7) + " " + t(-5) + "\n";
