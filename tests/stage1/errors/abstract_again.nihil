// a child may make an inherited method abstract again
SHAPE = @[name: STRING(12)];
SHAPE.area(s = SHAPE()) { ... : 0.0; }
CIRCLE = @[SHAPE; r: FLOAT(8)];
CIRCLE.area(c = CIRCLE()) { : 3.0 * c.r * c.r; }
as_shape(s = SHAPE()) { : s; }
ROUND = @[CIRCLE; tag: STRING(4)];
ROUND.area(r = ROUND()) { ... : 0.0; }
>> ROUND("r", 1.0, "x").name;
