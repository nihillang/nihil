// a record query (sum, sort, where) in a method with many locals: on the Mac the translator
// computed the address of a local past the 32nd into the register that held the value to store,
// so the query's hidden total started with an address (fixed in macos/translate.nihil: x15)
RANKED = @[ean: STRING(24); revenue: FLOAT(20); qty: FLOAT(20); companies: INT(4); stores: INT(6)];
m10() {
    v0 = 0; v1 = 1; v2 = 2; v3 = 3; v4 = 4; v5 = 5; v6 = 6; v7 = 7; v8 = 8; v9 = 9;
    res = [RANKED() ; 3];
    res[0] = RANKED("a", 10.0, 1.0, 1, 1); res[1] = RANKED("b", 30.0, 1.0, 1, 1); res[2] = RANKED("c", 20.0, 1.0, 1, 1);
    : $(res.sum(revenue)) + " " + res.sort(-revenue)[0].ean + " (" + $(v0 + v9) + ")";
}
>> "10 locals: " + m10() + "\n";
