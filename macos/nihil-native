#!/bin/bash
# nihil-native PROGRAM.nihil [OUT] — compiles a Nihil program straight into ARM64 (the compiler's
# -native): no x86 code, no translator; linked with the C runtime (macos/native/rt.c).
#   NIHIL_O0=1   no optimizations
#   NIHILC1_NATIVE=path   another native compiler (e.g. build/macos/nihilc1-cand)
#   NIHIL_KEEP_S=path     keeps the assembly there
set -e
here=$(cd "$(dirname "$0")/.." && pwd)
src=$1; out=${2:-${1%.nihil}}
[ -n "$src" ] || { echo "usage: nihil-native PROGRAM.nihil [OUT]" >&2; exit 2; }
abs=$(cd "$(dirname "$src")" && pwd)/$(basename "$src")
w=$(mktemp -d); trap 'rm -rf "$w"' EXIT
option=""; [ "${NIHIL_O0:-0}" = 1 ] && option="-O0 "
compiler=${NIHILC1_NATIVE:-$here/build/macos/nihilc1-native}
printf '%s\n' "$option-native $abs" | "$compiler" > "$w/p.s" 2> "$w/msg" || { cat "$w/msg" >&2; exit 1; }
cat "$w/msg" >&2
[ -n "${NIHIL_KEEP_S:-}" ] && cp "$w/p.s" "$NIHIL_KEEP_S"
rt=$here/build/macos/native-rt.o
[ -f "$rt" ] && [ "$rt" -nt "$here/macos/native/rt.c" ] || clang -O2 -arch arm64 -c "$here/macos/native/rt.c" -o "$rt"
clang -arch arm64 -o "$out" "$w/p.s" "$rt"
